		internal void AddNote(string text) { if (textNote != null) Post(delegate { textNote(text); }); }
		internal void NoteTo(string text, string book) { if (noteInto != null) Post(delegate { noteInto(text, book); }); else AddNote(text); }
		internal string Note(string what, string book)
		{
			Tab t = tab;
			if (what == null) { if (t == null || t.OnReader || t.Private) return "ok"; Post(delegate { pickBook = book; ShotToNotes(t); }); return "ok"; }
			NoteTo(what.Length > 0 || t == null || t.Private || t.OnReader ? what : t.Title + "\n" + t.Address, book);
			return "ok";
		}
		Action<string, string> noteInto;
		Action ShowBook = delegate { };
		internal string NoteBookShown = "";     // the Noted chat on show ("" is Noted, null is All), for "work out my open notes"
		internal bool NotesOpen { get { return notes.Visible; } }

		// Their own notebooks, by name, in the order they made them.
		internal string[] Notebooks() { return Kept("notebooks").Split(new[] { '\u001e' }, StringSplitOptions.RemoveEmptyEntries); }

		// The notebook a name means: one of theirs (any case), or "" for Browser notes.
		string BookFor(string name)
		{
			name = Regex.Replace((name ?? "").Trim(), @"\s+notes?(?:book)?$", "", RegexOptions.IgnoreCase).Trim();
			foreach (string book in Notebooks()) if (string.Equals(book, name, Loose)) return book;
			return "";
		}

		static void SetCue(TextBox box, string cue) { box.HandleCreated += delegate { SendMessage(box.Handle, 0x1501, (IntPtr)1, cue); }; }

		// A small box asking for a name. Null if they cancel.
		string AskName(string title, string question, string start)
		{
			Look look = mod.look;
			using (var ask = new Form { Text = title, FormBorderStyle = FormBorderStyle.FixedDialog, StartPosition = FormStartPosition.CenterParent, ClientSize = new Size(360, 132), MaximizeBox = false, MinimizeBox = false, ShowInTaskbar = false, BackColor = look.Shade(1), ForeColor = look.Shade(2), Font = new Font(Ui, 10f) })
			{
				var words = new Label { Text = question, Left = 16, Top = 14, Width = 330, Height = 40 };
				var box = new TextBox { Text = start, Left = 16, Top = 58, Width = 328, MaxLength = 40, BackColor = look.Shade(0), ForeColor = look.Shade(2), BorderStyle = BorderStyle.FixedSingle };
				var ok = new Button { Text = "OK", Left = 172, Top = 94, Width = 82, Height = 28, DialogResult = DialogResult.OK, FlatStyle = FlatStyle.Flat, BackColor = look.Shade(0) };
				var cancel = new Button { Text = "Cancel", Left = 262, Top = 94, Width = 82, Height = 28, DialogResult = DialogResult.Cancel, FlatStyle = FlatStyle.Flat, BackColor = look.Shade(0) };
				ok.FlatAppearance.BorderColor = look.Shade(5);
				cancel.FlatAppearance.BorderColor = look.Shade(6);
				ask.Controls.AddRange(new Control[] { words, box, ok, cancel });
				ask.AcceptButton = ok;
				ask.CancelButton = cancel;
				if (ask.ShowDialog(FindForm()) != DialogResult.OK) return null;
				string name = Regex.Replace(box.Text, @"[\u0000-\u001f\u001e]+", " ").Trim();
				name = Regex.Replace(name, @"\s+notes?(?:book)?$", "", RegexOptions.IgnoreCase).Trim();
				return name.Length == 0 || Regex.IsMatch(name, "^(?:browser|all|noted|all chats)$", RegexOptions.IgnoreCase) ? null : name;
			}
		}
		string pickBook;

		// A screenshot (what is null), what they said, or the page in front's name and link. Private tabs aren't noted.
		internal string Note(string what)
		{
			Tab t = tab;
			if (textNote == null) return null;
			if (what == null) Post(delegate { ShotToNotes(t); });
			else AddNote(what.Length > 0 || t == null || t.Private || t.OnReader ? what : t.Title + "\n" + t.Address);
			return "ok";
		}

		internal void ShowWelcome()
		{
			foreach (Tab open in tabs) if (open.Special == "welcome") { ShowReader(open); Select(open); return; }
			OpenTab(null, null, true);
			tab.Special = "welcome";
			ShowReader(tab);
		}

		string WelcomePage()
		{
			string[] c = mod.look.Colors;
			string[] got = Kept("page-welcome").Replace("\r", "").Split(new[] { "\n%%\n" }, StringSplitOptions.None);
			string css, body;
			if (got.Length < 2)
			{
				GetLook();
				css = ".w{padding:40px}.w a{color:%C5%;margin-right:18px}";
				body = "<div class=\"w\"><h1>CAPRI BROWSER</h1><p>Getting the welcome page ready...</p>%DL%<a href=\"%OWN%go?w=download\">DOWNLOAD BROWSER</a><a href=\"%OWN%go?w=quiet\">DOWNLOAD QUIETLY IN THE BACKGROUND</a><a href=\"%OWN%go?w=video\">SET UP VIDEO PLAYBACK</a><a href=\"%OWN%go?w=settings\">SETTINGS</a><a href=\"%OWN%go?w=home\">START BROWSING</a></div>";
			}
			else { css = SafeCss(got[0]) ? got[0] : ""; body = got[1]; }
			css = Colored(css, c);
			return Start(mod.look, css).Replace("<head>", "<head><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none';style-src 'unsafe-inline';img-src data:;form-action " + Own.TrimEnd('/') + "\">").Append(body.Replace("%OWN%", Own).Replace("%DL%", dlNote == null ? "" : "<p style=\"border:1px solid " + c[5] + ";padding:10px 14px\">" + WebUtility.HtmlEncode(dlNote) + "</p>"))
				.Append(body.Contains("value=\"send\"") ? "" : "<div style=\"margin:28px 40px;padding:14px 18px;border:1px solid " + c[6] + ";max-width:640px\"><b style=\"color:" + c[5] + ";letter-spacing:2px\">FOUND A BUG? GOT AN IDEA?</b>"
				+ "<p style=\"color:" + c[3] + ";font-size:13px\">Opens a short form on GitHub. You sign in and send it yourself, and nothing about you is added to it.</p>"
				+ "<a style=\"color:" + c[4] + ";margin-right:22px\" href=\"" + Own + "go?w=bug\">REPORT A BUG</a><a style=\"color:" + c[4] + "\" href=\"" + Own + "go?w=idea\">SUGGEST AN IDEA</a></div>")
				.Append("</body></html>").ToString();
		}

		internal void ShotToNotes(Tab t)
		{
			Bump("shots", 1);
			if (t == null || t.OnReader || t.Address == null) { mod.Tell("Open a page first and I'll snap it into your notes, choom."); return; }
			string file = Path.Combine(Path.GetTempPath(), "capri-note-shot.png"), title = t.Title + "  " + t.Address;
			t.Viewer.Shot(file, failed =>
			{
				Post(delegate
				{
					if (failed != null || snapNote == null) { mod.Tell("I couldn't take that screenshot, choom."); return; }
					try
					{
						using (Image shot = Image.FromFile(file))
						{
							float k = Math.Min(1f, 900f / Math.Max(1, shot.Width));
							using (var small = new Bitmap(shot, Math.Max(1, (int)(shot.Width * k)), Math.Max(1, (int)(shot.Height * k)))) snapNote(title, small);
						}
						File.Delete(file);
					}
					catch (Exception) { mod.Tell("I couldn't put that screenshot in your notes, choom."); }
				});
			});
		}

		internal void Screenshot(Tab t)
		{
			Bump("shots", 1);
			if (t == null || t.OnReader || t.Address == null) return;
			Uri at;
			string host = Uri.TryCreate(t.Address, UriKind.Absolute, out at) ? Regex.Replace(at.Host, @"[^\w.-]", "_") : "page";
			string file;
			try
			{
				string folder = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyPictures), "Capri Browser");
				Directory.CreateDirectory(folder);
				file = Path.Combine(folder, host + " " + DateTime.Now.ToString("yyyy-MM-dd HH.mm.ss", CultureInfo.InvariantCulture) + ".png");
			}
			catch (Exception error) { mod.Tell("I couldn't save that screenshot, choom: " + error.Message); return; }
			t.Viewer.Shot(file, failed =>
			{
				Post(delegate
				{
					if (failed != null) { try { File.Delete(file); } catch { } mod.Tell("I couldn't save that screenshot, choom: " + failed); return; }
					LastShot = file;
					if (!ShowShots) return;
					try { Process.Start("explorer.exe", "/select,\"" + file + "\""); } catch { }
				});
			});
		}

		// Privacy settings changed: every tab gets them now.
		void Guard()
		{
			mod.Save();
			foreach (Tab t in tabs) t.Viewer.Privacy(mod.look);
			ShowShield();
		}

		void ShowSaveFolder()
		{
			saveText.Text = string.IsNullOrEmpty(mod.look.Downloads) ? Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "Downloads") : mod.look.Downloads;
		}

		void PickSaveFolder()
		{
			using (var pick = new FolderBrowserDialog { Description = T(44), SelectedPath = saveText.Text })
			{
				if (pick.ShowDialog(FindForm()) != DialogResult.OK) return;
				mod.look.Downloads = pick.SelectedPath;
				ShowSaveFolder();
				Guard();
			}
