				return "Pressed Enter on it." + Here();
			case "scroll":
				string where = rest.StartsWith("up") ? "window.scrollBy(0,-innerHeight*.8)" : rest.StartsWith("top") ? "window.scrollTo(0,0)" : rest.StartsWith("bottom") ? "window.scrollTo(0,document.documentElement.scrollHeight)" : "if(!" + NextTok + ")window.scrollBy(0,innerHeight*.8)";
				got = OnPage("(function(){" + where + ";return 'ok';})()", out why);
