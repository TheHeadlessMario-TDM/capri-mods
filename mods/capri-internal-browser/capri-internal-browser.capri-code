			Item(m.Items, "Remove wallpaper", "", mod.Wallpaper() != null, delegate { mod.RemoveWallpaper(); ShowWallState(null); RefreshHomes(); });
			m.Items.Add(new ToolStripSeparator());
			Item(m.Items, "Add to Speed Dial", "", true, delegate { adding = true; address.Text = ""; Cue(); address.Focus(); });
			m.Items.Add(new ToolStripSeparator());
			Item(m.Items, "Noted", "", true, delegate { ShowNoted(); });
			Item(m.Items, "Bookmarks", "Ctrl+Shift+B", true, delegate { ShowSide(marks, marks.Width); });
			Item(m.Items, T(49), "", true, delegate { ShowHistory(); });
