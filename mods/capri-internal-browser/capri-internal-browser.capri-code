// capri-mod: 1
// id: capri-internal-browser
// name: Capri Browser
// version: 2.0.2
// author: tob7as
// description: A real browser Capri uses with you. Say "find me a funny video", "research this" or "find it cheaper". Ad blocker, jobs, games. Safe: asks before sending, never types passwords. 23 languages.
// permissions: chat, brain, tools, voice

using System;
