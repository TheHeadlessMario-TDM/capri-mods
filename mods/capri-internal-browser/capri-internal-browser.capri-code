		{
			{ "capri", "Capri website", "", "CAPRI", "1", "" },
			{ "discord", "Discord", "", "CAPRI", "1", "" },
			{ "github", "Capri on GitHub", "", "CAPRI", "1", "" },
			{ "marks", "Bookmarks", "", "BROWSER FEATURES", "1", "" },
			{ "noted", "Noted", "", "BROWSER FEATURES", "1", "" },
			{ "cleaner", "Capri Cleaner", "", "BROWSER FEATURES", "1", "" },
			{ "history", "History", "", "BROWSER FEATURES", "1", "" },
			{ "games", "Games", "", "FUN", "1", "" },
			{ "jobs", "Custom jobs", "", "FUN", "1", "" },
			{ "passwords", "Passwords", "", "BROWSER FEATURES", "1", "" },
			{ "chatgpt", "ChatGPT", "", "AI SERVICES", "0", "https://chatgpt.com/" },
			{ "gemini", "Gemini", "", "AI SERVICES", "0", "https://gemini.google.com/" },
			{ "claude", "Claude", "", "AI SERVICES", "0", "https://claude.ai/" },
			{ "whatsapp", "WhatsApp", "", "MESSENGERS", "0", "https://web.whatsapp.com/" },
			{ "messenger", "Facebook Messenger", "", "MESSENGERS", "0", "https://www.messenger.com/" },
			{ "telegram", "Telegram", "", "MESSENGERS", "0", "https://web.telegram.org/" },
			{ "x", "X", "", "SOCIAL MEDIA", "0", "https://x.com/" },
			{ "instagram", "Instagram", "", "SOCIAL MEDIA", "0", "https://www.instagram.com/" },
			{ "twitch", "Twitch", "", "SOCIAL MEDIA", "0", "https://www.twitch.tv/" },
			{ "youtube", "YouTube", "", "SOCIAL MEDIA", "0", "https://www.youtube.com/" },
			{ "reddit", "Reddit", "", "SOCIAL MEDIA", "0", "https://www.reddit.com/" }
		};
		static readonly string[] SideGroups = { "CAPRI", "BROWSER FEATURES", "FUN", "AI SERVICES", "MESSENGERS", "SOCIAL MEDIA" };
		readonly Dictionary<string, Button> sideByKey = new Dictionary<string, Button>();
		readonly Panel sideSetup = new Panel();
		Panel setupScroll, setupBody;
		readonly List<KeyValuePair<Rectangle, string>> setupRows = new List<KeyValuePair<Rectangle, string>>();
		readonly List<KeyValuePair<Rectangle, string>> setupCards = new List<KeyValuePair<Rectangle, string>>();
		string setupHover;

		static int SideRow(string key) { for (int i = 0; i < SideItems.GetLength(0); i++) if (SideItems[i, 0] == key) return i; return -1; }
		bool SideShown(string key) { string v = Kept("side-" + key); int row = SideRow(key); return v.Length == 0 ? row >= 0 && SideItems[row, 4] == "1" : v == "1"; }
		void ApplySide()
		{
			// A hidden button still needs its window, so its site logo can arrive while it is switched off.
			foreach (KeyValuePair<string, Button> one in sideByKey) { if (!one.Value.IsHandleCreated) { IntPtr made = one.Value.Handle; } one.Value.Visible = SideShown(one.Key); }
			side.Invalidate(true);
		}

		// Called while the sidebar is built: names its buttons, adds Passwords and the sites they can switch on.
		void SideExtras(int start)
		{
			string[] built = { "capri", "discord", "github", "marks", "noted", "cleaner", "history", "games", "jobs" };
			for (int i = 0; i < built.Length && start + i < sideButtons.Count; i++) sideByKey[built[i]] = sideButtons[start + i];
			Button pw = SideButton("", "Passwords", null);
			pw.Click += delegate { ToggleSide(pwPanel, pwPanel.Width); };
			sideByKey["passwords"] = pw;
			for (int i = 0; i < SideItems.GetLength(0); i++)
			{
				string url = SideItems[i, 5];
				if (url.Length == 0) continue;
				Button b = SideButton(SideItems[i, 2], SideItems[i, 1], "https://www.google.com/s2/favicons?sz=64&domain=" + new Uri(url).Host);
				b.Click += delegate { OpenTab(null, url, true); };
				sideByKey[SideItems[i, 0]] = b;
			}
			foreach (KeyValuePair<string, Button> one in sideByKey)
			{
				Button b = one.Value;
				b.Click += delegate { Blip("click"); };
				if (one.Key != "discord") b.MouseUp += (sender, e) => { if (e.Button == MouseButtons.Right) ToggleSide(sideSetup, sideSetup.Width); };
			}
			side.MouseUp += (sender, e) => { if (e.Button == MouseButtons.Right) ToggleSide(sideSetup, sideSetup.Width); };
		}

		void BuildSideSetup()
		{
			int saved;
			sideSetup.Width = int.TryParse(Kept("sidesetupwidth"), out saved) ? Math.Max(280, Math.Min(520, saved)) : 320;
			sideSetup.Visible = false;
			Buffered(sideSetup);
			Label title;
			Panel head = SideHead(sideSetup, "", "Sidebar setup", out title);
			setupScroll = new Panel { Dock = DockStyle.Fill, AutoScroll = true };
			setupBody = new Panel { Left = 0, Top = 0 };
			Buffered(setupBody);
			Buffered(setupScroll);
			DarkScroll(setupScroll);
			setupScroll.Controls.Add(setupBody);
			setupScroll.Resize += delegate { SetupLayout(); };
			setupBody.Paint += (sender, e) => { DrawSetup(e.Graphics); };
			setupBody.MouseMove += (sender, e) =>
			{
				string over = null;
				foreach (KeyValuePair<Rectangle, string> row in setupRows) if (row.Key.Contains(e.Location)) over = row.Value;
				setupBody.Cursor = over != null ? Cursors.Hand : Cursors.Default;
				if (over != setupHover) { setupHover = over; setupBody.Invalidate(); }
			};
			setupBody.MouseLeave += delegate { setupHover = null; setupBody.Invalidate(); };
			setupBody.MouseClick += (sender, e) =>
			{
				foreach (KeyValuePair<Rectangle, string> row in setupRows)
					if (row.Key.Contains(e.Location)) { Keep("side-" + row.Value, SideShown(row.Value) ? "0" : "1"); ApplySide(); Blip("click"); setupBody.Invalidate(); return; }
			};
			Action tint = delegate
			{
				Look look = mod.look;
				sideSetup.BackColor = head.BackColor = setupScroll.BackColor = setupBody.BackColor = look.Shade(1);
				title.ForeColor = look.Shade(2);
				TintHead(head, title, look);
				setupBody.Invalidate();
			};
			tint();
			sideSetup.VisibleChanged += delegate { if (sideSetup.Visible) { tint(); SetupLayout(); } };
			sideSetup.Controls.Add(setupScroll);
			sideSetup.Controls.Add(head);
		}

		void SetupLayout()
		{
			if (setupBody == null) return;
			int w = setupScroll.ClientSize.Width, pad = 14, y = 6;
			setupRows.Clear();
			setupCards.Clear();
			foreach (string group in SideGroups)
			{
				y += 34;
				int top = y;
				y += 8;
				for (int i = 0; i < SideItems.GetLength(0); i++)
				{
					if (SideItems[i, 3] != group) continue;
					setupRows.Add(new KeyValuePair<Rectangle, string>(new Rectangle(pad + 8, y, w - 2 * pad - 16, 40), SideItems[i, 0]));
					y += 40;
				}
				y += 8;
				setupCards.Add(new KeyValuePair<Rectangle, string>(new Rectangle(pad, top, w - 2 * pad, y - top), group));
				y += 6;
			}
			setupBody.Width = w;
			setupBody.Height = y + 16;
			setupBody.Invalidate();
		}

		void DrawSetup(Graphics g)
		{
			Look look = mod.look;
			Color back = look.Shade(1), deep = look.Shade(0), ink = look.Shade(2), faint = look.Shade(3), red = look.Shade(5), edge = look.Shade(6);
			Color card = Mix(back, deep, .45f), soft = Mix(edge, faint, .35f);
			g.SmoothingMode = SmoothingMode.AntiAlias;
			g.TextRenderingHint = TextRenderingHint.ClearTypeGridFit;
			using (var heading = new Font(UiBold, 9f))
			using (var words = new Font(Ui, 10.5f))
			using (Font glyph = Icons(12f))
			using (var mid = new StringFormat { LineAlignment = StringAlignment.Center, Trimming = StringTrimming.EllipsisCharacter, FormatFlags = StringFormatFlags.NoWrap })
			{
				foreach (KeyValuePair<Rectangle, string> c in setupCards)
				{
					Rectangle r = c.Key;
					using (var b = new SolidBrush(Mix(faint, look.Shade(4), .3f))) g.DrawString(c.Value, heading, b, new RectangleF(r.X + 2, r.Y - 28, r.Width, 22), mid);
					using (var p = new GraphicsPath())
					{
						p.AddPolygon(new[] { new Point(r.X, r.Y), new Point(r.Right, r.Y), new Point(r.Right, r.Bottom - 12), new Point(r.Right - 12, r.Bottom), new Point(r.X, r.Bottom) });
						using (var fill = new SolidBrush(card)) g.FillPath(fill, p);
						using (var line = new Pen(edge)) g.DrawPath(line, p);
					}
				}
				foreach (KeyValuePair<Rectangle, string> row in setupRows)
				{
					Rectangle r = row.Key;
					int i = SideRow(row.Value);
					bool on = SideShown(row.Value), over = setupHover == row.Value;
					if (over) using (SolidBrush hover = new SolidBrush(Mix(card, ink, .06f))) g.FillRectangle(hover, r);
					Button b;
					Image logo = sideByKey.TryGetValue(row.Value, out b) ? b.Image : null;
					if (logo != null) g.DrawImage(logo, r.X + 8, r.Y + (r.Height - 20) / 2, 20, 20);
					else using (var icon = new SolidBrush(on ? red : faint)) g.DrawString(SideItems[i, 2], glyph, icon, new RectangleF(r.X + 6, r.Y, 26, r.Height), mid);
					using (var text = new SolidBrush(on ? ink : faint)) g.DrawString(SideItems[i, 1], words, text, new RectangleF(r.X + 40, r.Y, r.Width - 100, r.Height), mid);
					var pill = new Rectangle(r.Right - 46, r.Y + 10, 36, 20);
					using (var fill = new SolidBrush(on ? Mix(red, deep, .35f) : deep)) g.FillRectangle(fill, pill);
					using (var line = new Pen(on ? red : soft)) g.DrawRectangle(line, pill);
					Rectangle knob = on ? new Rectangle(pill.Right - 16, pill.Y + 3, 13, 14) : new Rectangle(pill.X + 3, pill.Y + 3, 13, 14);
					using (var k = new SolidBrush(on ? Color.White : Mix(faint, look.Shade(4), .25f))) g.FillRectangle(k, knob);
				}
			}
		}

		// ---- Passwords: their own list, kept encrypted by Windows, in the sidebar ----
		sealed class Login { public string Site = "", User = "", Pass = ""; public DateTime When = DateTime.Now; }
		readonly Panel pwPanel = new Panel();
		List<Login> logins;
		bool pwBad;  // the file is there but couldn't be opened: kept as a spare, never saved over
		FlowLayoutPanel pwList;
		TextBox pwFind;
		bool pwAlertsOnly, pwWhy;
		Label pwAll, pwAlerts;

		[StructLayout(LayoutKind.Sequential)]
		struct Blob { public int Size; public IntPtr Data; }
		[DllImport("crypt32.dll", CharSet = CharSet.Unicode)] private static extern bool CryptProtectData(ref Blob data, string about, IntPtr entropy, IntPtr reserved, IntPtr prompt, int flags, ref Blob result);
		[DllImport("crypt32.dll", CharSet = CharSet.Unicode)] private static extern bool CryptUnprotectData(ref Blob data, IntPtr about, IntPtr entropy, IntPtr reserved, IntPtr prompt, int flags, ref Blob result);
		[DllImport("kernel32.dll")] private static extern IntPtr LocalFree(IntPtr memory);

		// Windows' own encryption for the current user (what Edge and Chrome use too): only this Windows account can open it.
		static byte[] Locked(byte[] plain, bool locking)
		{
			Blob input = new Blob { Size = plain.Length, Data = Marshal.AllocHGlobal(Math.Max(1, plain.Length)) }, output = new Blob();
			try
			{
				Marshal.Copy(plain, 0, input.Data, plain.Length);
				bool ok = locking ? CryptProtectData(ref input, "Capri Browser passwords", IntPtr.Zero, IntPtr.Zero, IntPtr.Zero, 1, ref output)
					: CryptUnprotectData(ref input, IntPtr.Zero, IntPtr.Zero, IntPtr.Zero, IntPtr.Zero, 1, ref output);
				if (!ok) return null;
				byte[] done = new byte[output.Size];
				Marshal.Copy(output.Data, done, 0, output.Size);
				return done;
			}
			finally
			{
				Marshal.FreeHGlobal(input.Data);
				if (output.Data != IntPtr.Zero) LocalFree(output.Data);
			}
		}

		string VaultFile { get { return Path.Combine(mod.Folder, "passwords.dat"); } }

		List<Login> Logins()
		{
			if (logins != null) return logins;
			logins = new List<Login>();
			pwBad = File.Exists(VaultFile);
			if (!pwBad) return logins;
			try
			{
				string hex = File.ReadAllText(VaultFile).Trim();
				byte[] sealedBytes = new byte[hex.Length / 2];
				for (int i = 0; i < sealedBytes.Length; i++) sealedBytes[i] = Convert.ToByte(hex.Substring(i * 2, 2), 16);
				byte[] plain = Locked(sealedBytes, false);
				if (plain == null) return logins;
				foreach (string line in Encoding.UTF8.GetString(plain).Split('\n'))
				{
					string[] p = line.Split('\t');
					long ticks;
					if (p.Length < 4) continue;
					logins.Add(new Login { Site = p[0], User = p[1], Pass = p[2], When = long.TryParse(p[3], out ticks) ? new DateTime(ticks) : DateTime.Now });
				}
				Array.Clear(plain, 0, plain.Length);
				pwBad = false;
			}
			catch { }
			return logins;
		}

		static string NoTabs(string s) { return Regex.Replace(s ?? "", @"[\t\r\n]", " ").Trim(); }

		void SaveLogins()
		{
			var all = new StringBuilder();
			foreach (Login l in Logins()) all.Append(NoTabs(l.Site)).Append('\t').Append(NoTabs(l.User)).Append('\t').Append(NoTabs(l.Pass)).Append('\t').Append(l.When.Ticks).Append('\n');
			byte[] plain = Encoding.UTF8.GetBytes(all.ToString());
			byte[] sealedBytes = Locked(plain, true);
			Array.Clear(plain, 0, plain.Length);
			if (sealedBytes == null) { mod.Tell("Windows wouldn't lock the passwords file, so nothing was saved, choom."); return; }
			try
			{
				Directory.CreateDirectory(mod.Folder);
				string fresh = VaultFile + ".new";
				File.WriteAllText(fresh, BitConverter.ToString(sealedBytes).Replace("-", ""));
				if (!File.Exists(VaultFile)) File.Move(fresh, VaultFile);
				else File.Replace(fresh, VaultFile, pwBad ? VaultFile + "." + DateTime.Now.Ticks + ".old" : null);
				if (pwBad) mod.Tell("I couldn't open your old passwords file, so I kept it as a spare and started a new one, choom.");
				pwBad = false;
			}
			catch (Exception error) { mod.Tell("I couldn't save the passwords: " + error.Message); }
		}

		// With the "hello" setting on, Windows checks it's them first; a yes lasts 5 minutes. No answer means no.
		DateTime pwOpenTill;
		bool pwAsking;
		void Unlocked(string why, Action then)
		{
			if (!Flag("hello", false) || DateTime.Now < pwOpenTill) { then(); return; }
			AskHello(why, got =>
			{
				if (got == "0") { pwOpenTill = DateTime.Now.AddMinutes(5); then(); }
				else if (got == "n1" || got == "n2" || got == "n3") mod.Tell("Windows Hello isn't set up on this PC any more, so your passwords stay locked. You can switch it off in Settings > Privacy, choom.");
				else mod.Tell("Windows didn't get a yes, so that stays locked, choom.");
			});
		}
		void AskHello(string why, Action<string> then)
		{
			if (pwAsking) return;
			pwAsking = true;
			IntPtr window = FindForm().Handle;
			Behind(delegate
			{
				string got = Hello(window, why);
				Later(delegate { pwAsking = false; then(got); });
			});
		}
		// Turning it on needs Windows Hello to work; turning it off needs a yes from it (or a PC that hasn't got it any more).
		void SetHello(bool on)
		{
			AskHello(on ? "Protect Capri Browser's passwords" : "Stop protecting Capri Browser's passwords", got =>
			{
				bool none = got == "n1" || got == "n2" || got == "n3";
				if (Host != null && (got == "0" || none && !on)) Host.Store.Set("opt-hello", on ? "1" : "0");
				else mod.Tell(none ? "Windows Hello isn't set up on this PC. Add a PIN in Windows Settings > Accounts > Sign-in options first, choom." : "Windows didn't get a yes, so I left that as it was, choom.");
				pwOpenTill = DateTime.MinValue;
				foreach (Tab open in tabs) if (open.Special == "settings") ShowReader(open);
				if (pwList != null) FillLogins();
			});
		}

		bool Risky(Login l)
		{
			if (l.Pass.Length < 8) return true;
			foreach (Login other in Logins()) if (other != l && other.Pass == l.Pass && other.Site != l.Site) return true;
			return false;
		}

		// Copied: wiped from the clipboard after 30 seconds, unless something else was copied since.
		void CopySecret(string text)
		{
			if (string.IsNullOrEmpty(text)) return;
			// Windows' own marks for "leave this out of clipboard history (Win+V) and off my other devices".
			var data = new DataObject(DataFormats.UnicodeText, text);
			foreach (string mark in new[] { "ExcludeClipboardContentFromMonitorProcessing", "CanIncludeInClipboardHistory", "CanUploadToCloudClipboard" }) data.SetData(mark, false, new MemoryStream(new byte[4]));
			try { Clipboard.SetDataObject(data, true); } catch (Exception) { return; }
			// Its own thread, so it still happens if the browser's closed.
			var wipe = new Thread(delegate() { Thread.Sleep(30000); try { if (Clipboard.GetText() == text) Clipboard.Clear(); } catch { } }) { IsBackground = true };
			wipe.SetApartmentState(ApartmentState.STA);
			wipe.Start();
		}

		const string WhySafe = "Why it's safe\n\n"
			+ "• Locked with Windows' own encryption, the same kind Edge and Chrome use. Only your Windows account on this PC can open it: copied anywhere else, the file is just noise. It can't stop a virus running as you, so keep Windows up to date and only install mods you trust.\n"
			+ "• Kept only on this PC. Nothing is uploaded, synced or sent anywhere.\n"
			+ "• Capri can't see them. Her voice commands, custom jobs and page reading never touch this list, and she never types passwords.\n"
			+ "• Passwords stay hidden until you press the eye (hidden again after 20 seconds). A copied one is wiped after 30 seconds and kept out of clipboard history.\n"
			+ "• When you sign in on a site, a card offers to save it here, and next time to fill it in. Nothing is saved or filled unless you press the button, and never in private tabs. Passwords Edge saved before still fill in too.";

		void BuildPasswords()
		{
			int saved;
			pwPanel.Width = int.TryParse(Kept("passwordswidth"), out saved) ? Math.Max(300, Math.Min(600, saved)) : 360;
			pwPanel.Visible = false;
			Buffered(pwPanel);
			Label title;
			Panel head = SideHead(pwPanel, "", "Passwords", out title);
			pwFind = new TextBox();
			Panel findRow = Ring(pwFind, "Search passwords");
			pwFind.TextChanged += delegate { FillLogins(); };
			var tools = new FlowLayoutPanel { Dock = DockStyle.Top, Height = 34, Padding = new Padding(14, 2, 10, 4), WrapContents = false };
			Func<string, Label> tab = words =>
			{
				var l = new Label { Text = words, AutoSize = true, Margin = new Padding(0, 4, 14, 0), Cursor = Cursors.Hand, Font = new Font(Ui, 10f) };
				tools.Controls.Add(l);
				return l;
			};
			pwAll = tab("");
			pwAlerts = tab("");
			pwAll.Click += delegate { pwAlertsOnly = false; FillLogins(); };
			pwAlerts.Click += delegate { pwAlertsOnly = true; FillLogins(); };
			Label add = tab("+ Add");
			add.Click += delegate { EditLogin(null); };
			Label more = tab("⋯");
			more.Click += delegate
			{
				ContextMenuStrip m = NewMenu();
				Item(m.Items, "Add a password", "", true, delegate { EditLogin(null); });
				Item(m.Items, "Import from a CSV file", "", true, delegate { ImportLogins(); });
				Item(m.Items, "Why it's safe", "", true, delegate { pwWhy = true; FillLogins(); });
				m.Show(more, new Point(0, more.Height));
			};
			pwList = new FlowLayoutPanel { Dock = DockStyle.Fill, FlowDirection = FlowDirection.TopDown, WrapContents = false, AutoScroll = true, Padding = new Padding(12, 4, 0, 8) };
			Buffered(pwList);
			DarkScroll(pwList);
			pwList.Resize += delegate { foreach (Control c in pwList.Controls) c.Width = Math.Max(200, pwList.ClientSize.Width - 26 - SystemInformation.VerticalScrollBarWidth); };
			var why = new Label { Text = "Why it's safe", Dock = DockStyle.Bottom, Height = 30, TextAlign = ContentAlignment.MiddleCenter, Cursor = Cursors.Hand, Font = new Font(Ui, 9.5f, FontStyle.Underline) };
			why.Click += delegate { pwWhy = !pwWhy; FillLogins(); };
			Action tint = delegate
			{
				Look look = mod.look;
				pwPanel.BackColor = head.BackColor = findRow.BackColor = tools.BackColor = pwList.BackColor = why.BackColor = look.Shade(1);
				title.ForeColor = look.Shade(2);
				TintHead(head, title, look);
				pwFind.BackColor = look.Shade(0);
				pwFind.ForeColor = look.Shade(2);
				foreach (Control c in tools.Controls) c.ForeColor = look.Shade(3);
				why.ForeColor = look.Shade(5);
				((Control)findRow.Controls[0]).Invalidate();
			};
			tint();
			pwPanel.VisibleChanged += delegate { if (pwPanel.Visible) { tint(); FillLogins(); } };
			pwPanel.Controls.Add(pwList);
			pwPanel.Controls.Add(why);
			pwPanel.Controls.Add(tools);
			pwPanel.Controls.Add(findRow);
			pwPanel.Controls.Add(head);
		}

		void FillLogins()
		{
			if (pwList == null) return;
			Look look = mod.look;
			Color back = look.Shade(1), card = Mix(look.Shade(1), look.Shade(0), .45f), ink = look.Shade(2), faint = look.Shade(3), red = look.Shade(5), edge = look.Shade(6);
			if (pwBad) logins = null;
			List<Login> all = Logins();
			int risky = 0;
			foreach (Login l in all) if (Risky(l)) risky++;
			pwAll.Text = (pwAlertsOnly ? "○" : "◉") + " All (" + all.Count + ")";
			pwAlerts.Text = (pwAlertsOnly ? "◉" : "○") + " Alerts (" + risky + ")";
			pwAll.ForeColor = pwAlertsOnly ? faint : ink;
			pwAlerts.ForeColor = pwAlertsOnly ? red : faint;
			pwList.SuspendLayout();
			var old = new List<Control>();
			foreach (Control c in pwList.Controls) old.Add(c);
			pwList.Controls.Clear();
			Later(delegate { foreach (Control c in old) c.Dispose(); });
			int wide = Math.Max(200, pwList.ClientSize.Width - 26 - SystemInformation.VerticalScrollBarWidth);
			Func<string, int, Panel, Label> small = (words, y, into) =>
			{
				var l = new Label { Text = words, Left = 14, Top = y, AutoSize = true, ForeColor = faint, BackColor = Color.Transparent, Font = new Font(UiBold, 7.5f) };
				into.Controls.Add(l);
				return l;
			};
			Func<string, string, Panel, Label> icon = (glyph, tip, into) =>
			{
				var l = new Label { Text = glyph, Width = 30, Height = 30, TextAlign = ContentAlignment.MiddleCenter, ForeColor = faint, BackColor = Color.Transparent, Font = Icons(10.5f), Cursor = Cursors.Hand, Anchor = AnchorStyles.Top | AnchorStyles.Right };
				new ToolTip().SetToolTip(l, tip);
				l.MouseEnter += delegate { l.ForeColor = red; };
				l.MouseLeave += delegate { l.ForeColor = faint; };
				into.Controls.Add(l);
				return l;
			};
			if (pwWhy)
			{
				var box = new Label { Text = WhySafe, Width = wide, ForeColor = ink, BackColor = card, Font = new Font(Ui, 9.5f), Padding = new Padding(14, 12, 14, 12), Margin = new Padding(0, 0, 0, 10), UseMnemonic = false };
				box.Height = TextRenderer.MeasureText(WhySafe, box.Font, new Size(wide - 28, 0), TextFormatFlags.WordBreak).Height + 30;
				box.Click += delegate { pwWhy = false; FillLogins(); };
				pwList.Controls.Add(box);
			}
			string q = pwFind.Text.Trim().ToLowerInvariant();
			int shown = 0;
			foreach (Login one in all)
			{
				Login l = one;
				if (pwAlertsOnly && !Risky(l)) continue;
				if (q.Length > 0 && l.Site.ToLowerInvariant().IndexOf(q) < 0 && l.User.ToLowerInvariant().IndexOf(q) < 0) continue;
				shown++;
				var c = new Panel { Width = wide, Height = 196, BackColor = card, Margin = new Padding(0, 0, 0, 12) };
				small("WEB SITE", 12, c);
				var site = new LinkLabel { Text = l.Site, Left = 14, Top = 26, Width = wide - 28, Height = 22, LinkColor = ink, ActiveLinkColor = red, BackColor = Color.Transparent, Font = new Font(Ui, 10.5f), AutoEllipsis = true, UseMnemonic = false };
				site.LinkClicked += delegate { OpenTab(null, l.Site.Contains("://") ? l.Site : "https://" + l.Site, true); };
				c.Controls.Add(site);
				small("USERNAME", 58, c);
				c.Controls.Add(new Label { Text = l.User, Left = 14, Top = 72, Width = wide - 70, Height = 22, ForeColor = ink, BackColor = Color.Transparent, Font = new Font(Ui, 10.5f), AutoEllipsis = true, UseMnemonic = false });
				Label copyUser = icon("", "Copy username", c);
				copyUser.Location = new Point(wide - 44, 66);
				copyUser.Click += delegate { CopySecret(l.User); mod.Tell("Username copied, choom."); };
				small("PASSWORD", 104, c);
				var dots = new Label { Text = new string('●', Math.Min(12, Math.Max(8, l.Pass.Length))), Left = 14, Top = 118, Width = wide - 100, Height = 22, ForeColor = ink, BackColor = Color.Transparent, Font = new Font(Ui, 10.5f), AutoEllipsis = true, UseMnemonic = false };
				c.Controls.Add(dots);
				Label copyPass = icon("", "Copy password (cleared from the clipboard after 30 seconds)", c);
				copyPass.Location = new Point(wide - 78, 112);
				copyPass.Click += delegate { Unlocked("Copy your password for " + l.Site, delegate { CopySecret(l.Pass); mod.Tell("Password copied. It's wiped from the clipboard in 30 seconds, choom."); }); };
				Label eye = icon("", "Show password", c);
				eye.Location = new Point(wide - 44, 112);
				bool shownNow = false;
				Action flip = delegate { shownNow = !shownNow; dots.Text = shownNow ? l.Pass : new string('●', Math.Min(12, Math.Max(8, l.Pass.Length))); eye.Text = shownNow ? "" : ""; };
				var hide = new WinTimer { Interval = 20000 };
				hide.Tick += delegate { hide.Stop(); if (shownNow) flip(); };
				Action press = delegate { if (c.IsDisposed) return; flip(); hide.Stop(); if (shownNow) hide.Start(); };
				eye.Click += delegate { if (shownNow) press(); else Unlocked("Show your password for " + l.Site, press); };
				c.Disposed += delegate { hide.Dispose(); };
				if (Risky(l)) c.Controls.Add(new Label { Text = l.Pass.Length < 8 ? "⚠ Short password" : "⚠ Used on another site too", Left = 14, Top = 160, Width = wide - 110, Height = 22, ForeColor = red, BackColor = Color.Transparent, Font = new Font(Ui, 9f), UseMnemonic = false });
				var edit = new Button { Text = "Edit", Left = wide - 84, Top = 152, Width = 70, Height = 32, FlatStyle = FlatStyle.Flat, BackColor = card, ForeColor = ink, Font = new Font(UiBold, 10f), Cursor = Cursors.Hand, TabStop = false, Anchor = AnchorStyles.Top | AnchorStyles.Right };
				edit.FlatAppearance.BorderColor = red;
				edit.FlatAppearance.MouseOverBackColor = Mix(card, red, .25f);
				edit.Click += delegate { Unlocked("Edit your password for " + l.Site, delegate { EditLogin(l); }); };
				c.Controls.Add(edit);
				c.Paint += (sender, e) => { using (Pen line = new Pen(edge)) e.Graphics.DrawRectangle(line, 0, 0, c.Width - 1, c.Height - 1); };
				pwList.Controls.Add(c);
			}
			if (shown == 0)
				pwList.Controls.Add(new Label
				{
					Text = pwBad ? "I couldn't open the passwords file. It may have come from another PC or Windows account. It's kept safe." : all.Count == 0 ? "No passwords yet. Press + Add, or import a CSV file exported from another browser (⋯ menu)." : pwAlertsOnly ? "No alerts. Every password is long enough and only used once." : "Nothing matches that.",
					Width = wide, Height = 60, ForeColor = faint, BackColor = back, Font = new Font(Ui, 10f), UseMnemonic = false
				});
			pwList.ResumeLayout();
		}

		// A site's name for matching saved logins: no https://, path, port or www.
		static string SiteHost(string site)
		{
			string h = Regex.Replace((site ?? "").Trim().ToLowerInvariant(), "^[a-z]+://", "");
			int end = h.IndexOfAny(new[] { '/', '?', '#', ':' });
			if (end >= 0) h = h.Substring(0, end);
			return h.Begins("www.") ? h.Substring(4) : h;
		}

		// They signed in: offer to save it (or update it) in Passwords. Only on https pages in normal tabs, and not on sites they said never to.
		void OfferSave(Tab t, string from, string user, string pass)
		{
			Uri at;
			if (t == null || t.Private || !tabs.Contains(t) || pass == null || pass.Length == 0 || pass.Length > 500 || !Uri.TryCreate(from, UriKind.Absolute, out at) || at.Scheme != "https") return;
			string host = SiteHost(at.Host), name = NoTabs(user);
			if (host.Length == 0 || ("|" + Kept("pw-never") + "|").Contains("|" + host + "|")) return;
			Login same = Logins().Find(l => SiteHost(l.Site) == host && l.User == name);
			if (same != null && same.Pass == pass) return;
			PwCard(t, (same == null ? "Save password for " : "Update password for ") + host + "?", name.Length > 0 ? name : "No username", same == null ? "Save" : "Update", delegate
			{
				if (same == null) Logins().Insert(0, new Login { Site = host, User = name, Pass = pass });
				else { same.Pass = pass; same.When = DateTime.Now; }
				SaveLogins();
				if (pwList != null) FillLogins();
			}, "Never for this site", delegate { Keep("pw-never", (Kept("pw-never") + "|" + host).Trim('|')); });
		}

		// The page has a password box and they've saved a login for this site: offer to fill it in (the newest one).
		void OfferFill(Tab t, string from)
		{
			Uri at;
			if (t == null || t.Private || !tabs.Contains(t) || pwCard != null || !Uri.TryCreate(from, UriKind.Absolute, out at) || at.Scheme != "https") return;
			string host = SiteHost(at.Host);
			Login l = Logins().Find(x => SiteHost(x.Site) == host);
			if (l == null) return;
			PwCard(t, "Fill your saved password?", (l.User.Length > 0 ? l.User + " on " : "") + host, "Fill", delegate
			{
				Unlocked("Fill your password for " + host, delegate
				{
					// Only into the same site, still open in that tab.
					if (!tabs.Contains(t) || t.Private || SiteHost(HostOf(t.Address) ?? "") != host) return;
					t.Viewer.Script(FillScript + "(" + Quote(l.User) + "," + Quote(l.Pass) + "," + Quote(host) + ")");
				});
			}, null, null);
		}

		// Puts the username (if its box is empty) and the password into the page's visible password box, as typing would.
		const string FillScript = "(function(u,p,h){if(location.protocol!='https:'||location.hostname.replace(/^www\\./,'')!=h)return 'moved';var ps=[].slice.call(document.querySelectorAll('input[type=password]')).filter(function(e){return e.offsetParent!==null});if(!ps.length)return 'none';var pw=ps[0];"
			+ "function set(e,v){Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set.call(e,v);e.dispatchEvent(new Event('input',{bubbles:true}));e.dispatchEvent(new Event('change',{bubbles:true}))}"
			+ "if(u){var ins=[].slice.call((pw.form||document).querySelectorAll('input')),un=null;for(var i=0;i<ins.length;i++){if(ins[i]===pw)break;if(/^(text|email|tel)$/i.test(ins[i].type)&&ins[i].offsetParent!==null)un=ins[i]}if(un&&!un.value)set(un,u)}if(pw.form&&/^http:/i.test(pw.form.getAttribute('action')||''))return 'unsafe';set(pw,p);return 'ok'})";

		Panel pwCard;
		Tab pwCardTab;

		// The small save / fill card at the top right of the page, in her colours.
		void PwCard(Tab t, string head, string body, string okText, Action ok, string altText, Action alt)
		{
			if (t != tab) return;
			ClosePwCard();
			Look look = mod.look;
			var c = new Panel { Width = 330, Height = 104, BackColor = look.Shade(1) };
			c.Paint += (sender, e) => { using (Pen line = new Pen(look.Shade(4))) e.Graphics.DrawRectangle(line, 0, 0, c.Width - 1, c.Height - 1); using (SolidBrush bar = new SolidBrush(look.Shade(5))) e.Graphics.FillRectangle(bar, 0, 0, 3, c.Height); };
			var h = new Label { Text = head, Left = 14, Top = 10, Width = 280, Height = 20, ForeColor = look.Shade(5), BackColor = look.Shade(1), Font = new Font(UiBold, 10f), AutoEllipsis = true, UseMnemonic = false };
			var b = new Label { Text = body, Left = 14, Top = 34, Width = 300, Height = 20, ForeColor = look.Shade(2), BackColor = look.Shade(1), Font = new Font(Ui, 10f), AutoEllipsis = true, UseMnemonic = false };
			var x = new Label { Text = "", Left = 300, Top = 10, Width = 22, Height = 22, ForeColor = look.Shade(3), BackColor = look.Shade(1), Font = Icons(9f), Cursor = Cursors.Hand };
			Func<string, int, Label> button = (text, left) =>
			{
				var font = new Font(UiBold, 9.5f);
				return new Label { Text = text, Left = left, Top = 64, Height = 28, Width = TextRenderer.MeasureText(text, font).Width + 26, TextAlign = ContentAlignment.MiddleCenter, Font = font, BorderStyle = BorderStyle.FixedSingle, BackColor = look.Shade(1), ForeColor = look.Shade(5), Cursor = Cursors.Hand, UseMnemonic = false };
			};
			Label go = button(okText, 14);
			go.Click += delegate { ClosePwCard(); ok(); };
			c.Controls.AddRange(new Control[] { h, b, x, go });
			if (altText != null)
			{
				Label other = button(altText, go.Right + 8);
				other.ForeColor = look.Shade(3);
				other.Click += delegate { ClosePwCard(); alt(); };
				c.Controls.Add(other);
			}
			x.Click += delegate { ClosePwCard(); };
			pwCard = c;
			pwCardTab = t;
			Controls.Add(c);
			c.BringToFront();
			Point at = PointToClient(holder.PointToScreen(Point.Empty));
			c.Left = at.X + holder.Width - c.Width - 14;
			int top = at.Y + 14;
			c.Top = top - 20;
			Ease(c, 200, e => { c.Top = top - 20 + (int)(20 * e); }, null);
			DateTime shown = DateTime.UtcNow;
			var away = new WinTimer { Interval = 2000 };
			away.Tick += delegate
			{
				if (c.IsDisposed || pwCard != c) { away.Dispose(); return; }
				if ((DateTime.UtcNow - shown).TotalSeconds > 45 && !c.ClientRectangle.Contains(c.PointToClient(Cursor.Position))) { away.Dispose(); ClosePwCard(); }
			};
			away.Start();
		}

		void ClosePwCard()
		{
			Panel c = pwCard;
			pwCard = null;
			pwCardTab = null;
			if (c == null || c.IsDisposed) return;
			int from = c.Top;
			Ease(c, -140, e => { c.Top = from - (int)(20 * e); }, delegate { Controls.Remove(c); c.Dispose(); });
		}

		// Add or change one: a small window in her colours with the site, username and password.
		void EditLogin(Login l)
		{
			Look look = mod.look;
			bool fresh = l == null;
			using (var f = new Form { Text = fresh ? "Add a password" : "Edit password", FormBorderStyle = FormBorderStyle.FixedDialog, MaximizeBox = false, MinimizeBox = false, ShowInTaskbar = false, StartPosition = FormStartPosition.CenterParent, ClientSize = new Size(380, 262), BackColor = look.Shade(1), ForeColor = look.Shade(2), Font = new Font(Ui, 10f) })
			{
				Func<string, int, TextBox> field = (name, y) =>
				{
					f.Controls.Add(new Label { Text = name, Left = 18, Top = y, AutoSize = true, ForeColor = look.Shade(3), Font = new Font(UiBold, 8f) });
					var t = new TextBox { Left = 18, Top = y + 18, Width = 344, BackColor = look.Shade(0), ForeColor = look.Shade(2), BorderStyle = BorderStyle.FixedSingle };
					f.Controls.Add(t);
					return t;
				};
				TextBox site = field("WEB SITE", 14), user = field("USERNAME", 70), pass = field("PASSWORD", 126);
				pass.UseSystemPasswordChar = true;
				var show = new CheckBox { Text = "Show password", Left = 18, Top = 176, AutoSize = true, ForeColor = look.Shade(3) };
				show.CheckedChanged += delegate { pass.UseSystemPasswordChar = !show.Checked; };
				f.Controls.Add(show);
				if (!fresh) { site.Text = l.Site; user.Text = l.User; pass.Text = l.Pass; }
				else if (tab != null && !tab.OnReader && HostOf(tab.Address) != null) site.Text = HostOf(tab.Address);
				Func<string, int, DialogResult, Button> button = (words, left, result) =>
				{
					var b = new Button { Text = words, Left = left, Top = 214, Width = 84, Height = 32, FlatStyle = FlatStyle.Flat, BackColor = look.Shade(0), ForeColor = look.Shade(2), DialogResult = result };
					b.FlatAppearance.BorderColor = look.Shade(6);
					f.Controls.Add(b);
					return b;
				};
				Button save = button("Save", 278, DialogResult.OK);
				save.FlatAppearance.BorderColor = look.Shade(5);
				f.AcceptButton = save;
				f.CancelButton = button("Cancel", 188, DialogResult.Cancel);
				Button delete = fresh ? null : button("Delete", 18, DialogResult.Abort);
				DialogResult said = f.ShowDialog(FindForm());
				if (said == DialogResult.Abort && delete != null)
				{
					if (MessageBox.Show(FindForm(), "Delete the saved password for " + l.Site + "?", "Passwords", MessageBoxButtons.YesNo, MessageBoxIcon.Question) != DialogResult.Yes) return;
					Logins().Remove(l);
				}
				else if (said == DialogResult.OK)
				{
					string s = Regex.Replace(site.Text.Trim(), @"^https?://", "", RegexOptions.IgnoreCase).TrimEnd('/');
					if (s.Length == 0 || pass.Text.Length == 0) { mod.Tell("A password needs a web site and the password itself, choom."); return; }
					if (fresh) { l = new Login(); Logins().Insert(0, l); }
					l.Site = s;
					l.User = user.Text.Trim();
					l.Pass = pass.Text;
					l.When = DateTime.Now;
				}
				else return;
				SaveLogins();
				FillLogins();
			}
		}

		// A CSV file exported from Chrome, Edge, Opera or Firefox: url (or origin), username and password columns.
		void ImportLogins()
		{
			string file;
			using (var pick = new OpenFileDialog { Title = "Import passwords", Filter = "Passwords CSV file|*.csv" })
			{
				if (pick.ShowDialog(FindForm()) != DialogResult.OK) return;
				file = pick.FileName;
			}
			int added = 0;
			try
			{
				List<string[]> rows = Csv(File.ReadAllText(file));
				if (rows.Count < 2) { mod.Tell("That file doesn't have any passwords in it, choom."); return; }
				string[] head = rows[0];
				int url = -1, user = -1, pass = -1;
				for (int i = 0; i < head.Length; i++)
				{
					string h = head[i].Trim().ToLowerInvariant();
					if ((h == "url" || h == "origin" || h == "website" || h == "login_uri") && url < 0) url = i;
					else if ((h == "username" || h == "login_username" || h == "user") && user < 0) user = i;
					else if ((h == "password" || h == "login_password") && pass < 0) pass = i;
				}
				if (url < 0 || pass < 0) { mod.Tell("I couldn't find the web site and password columns in that file, choom."); return; }
				for (int r = 1; r < rows.Count; r++)
				{
					string[] row = rows[r];
					if (row.Length <= Math.Max(url, pass) || row[pass].Length == 0) continue;
					string s = HostOf(row[url]) ?? row[url].Trim();
					string u = user >= 0 && row.Length > user ? row[user] : "";
					if (Logins().Exists(x => x.Site == s && x.User == u)) continue;
					Logins().Add(new Login { Site = s, User = u, Pass = row[pass] });
					added++;
				}
			}
			catch (Exception error) { mod.Tell("I couldn't read that file: " + error.Message); return; }
			SaveLogins();
			FillLogins();
			mod.Tell("Imported " + added + (added == 1 ? " password" : " passwords") + ", choom. That CSV file isn't encrypted, so delete it once you're happy.");
		}

		static List<string[]> Csv(string text)
		{
			var rows = new List<string[]>();
			var row = new List<string>();
			var cell = new StringBuilder();
			bool quoted = false;
			for (int i = 0; i < text.Length; i++)
			{
				char ch = text[i];
				if (quoted) { if (ch == '"') { if (i + 1 < text.Length && text[i + 1] == '"') { cell.Append('"'); i++; } else quoted = false; } else cell.Append(ch); continue; }
				if (ch == '"') quoted = true;
				else if (ch == ',') { row.Add(cell.ToString()); cell.Length = 0; }
				else if (ch == '\n' || ch == '\r') { if (ch == '\r' && i + 1 < text.Length && text[i + 1] == '\n') i++; row.Add(cell.ToString()); cell.Length = 0; if (row.Count > 1 || row[0].Length > 0) rows.Add(row.ToArray()); row = new List<string>(); }
				else cell.Append(ch);
			}
			row.Add(cell.ToString());
			if (row.Count > 1 || row[0].Length > 0) rows.Add(row.ToArray());
			return rows;
		}

		// ---- Capri's brain first (Settings > Capri features, on unless they switch it off) ----
		// Capri's own process gets the PC first, and Edge's engine processes behind this browser wait their turn.
		WinTimer brainTimer;
		bool brainWasFirst, gameMode;
		Button gameBtn;
		Thinking thinking;

		readonly DateTime openedAt = DateTime.UtcNow;
		int adsNew, tracksNew;
		void Suggest()
		{
			long last;
			if (DateTime.UtcNow - openedAt < TimeSpan.FromMinutes(30) || gameMode || full || mod.Driving || !Notice("gamehint") || Kept("gamesopened").Length > 0 || Kept("gamehint-no").Length > 0 || (tab != null && tab.Playing)) return;
			if (long.TryParse(Kept("gamehint-at"), out last) && DateTime.UtcNow.Ticks - last < TimeSpan.FromDays(7).Ticks) return;
			Keep("gamehint-at", DateTime.UtcNow.Ticks.ToString());
			mod.AskThen("Wanna take a quick break, choom? I've got Snake, a typing race, Guess the Site and a daily word search. Want to see them?",
				delegate { Post(delegate { ShowGames(); }); return "Here you go, choom. Have fun."; }, delegate { Keep("gamehint-no", "1"); });
		}

		// Game mode by itself (Settings, off at first): on while a full-screen window that isn't a browser, a video player or Capri is in front, off
		// again a little after it's gone.
		[DllImport("user32.dll")] private static extern IntPtr GetForegroundWindow();
		[DllImport("user32.dll")] private static extern bool GetWindowRect(IntPtr w, out Edges r);
		[DllImport("user32.dll")] private static extern int GetWindowThreadProcessId(IntPtr w, out int pid);
		struct Edges { public int Left, Top, Right, Bottom; }
		bool autoGame, autoSaid;
		int autoOff;
		void AutoGame()
		{
			if (!Flag("gameauto", false)) return;
			bool playing = false;
			try
			{
				IntPtr w = GetForegroundWindow();
				Edges e;
				int pid;
				if (w != IntPtr.Zero && GetWindowRect(w, out e) && GetWindowThreadProcessId(w, out pid) != 0 && pid != Process.GetCurrentProcess().Id)
				{
					Rectangle screen = Screen.FromHandle(w).Bounds;
					if (e.Left <= screen.Left && e.Top <= screen.Top && e.Right >= screen.Right && e.Bottom >= screen.Bottom)
						using (Process p = Process.GetProcessById(pid))
							playing = !Regex.IsMatch(p.ProcessName, "^(explorer|chrome|msedge|msedgewebview2|firefox|opera|opera_gx|brave|vivaldi|vlc|mpc-hc(64)?|wmplayer|Video[.]UI|ApplicationFrameHost|Discord|obs64|Spotify|Capri.*)$", RegexOptions.IgnoreCase);
				}
			}
			catch { }
			if (playing) autoOff = 0;
			if (playing && !gameMode)
			{
				autoGame = true;
				string said = GameMode(true);
				if (!autoSaid) { autoSaid = true; mod.Tell("A game's running, so " + said.Substring(said.IndexOf(' ') + 1)); }
			}
			else if (!playing && gameMode && autoGame && ++autoOff >= 2) { autoGame = false; GameMode(false); }
		}

		internal string GameMode(bool on)
		{
			gameMode = on;
			int n = 0;
			if (on) foreach (Tab t in tabs) if (t != tab && !(Split && (t == splitA || t == splitB)) && !t.Asleep && !t.Playing && !t.OnReader && !t.Hidden && t.Viewer.Sleep()) { t.Asleep = true; Retitle(t, t.Title); n++; }
			foreach (Tab t in tabs) t.Viewer.Saver(on);
			BrainFirst();
			GameLook();
			if (!on) return "Game mode's off, choom. Back to full speed.";
			return "Game mode's on, choom. " + (n > 0 ? "I snoozed " + n + (n == 1 ? " tab" : " tabs") + " and I'm" : "I'm") + " running super low so your game gets the PC.";
		}

		void GameLook()
		{
			if (gameBtn == null) return;
			gameBtn.ForeColor = gameMode ? mod.look.Shade(4) : mod.look.Shade(5);
			gameBtn.BackColor = gameMode ? Mix(mod.look.Shade(0), mod.look.Shade(4), .22f) : Color.Transparent;
		}

		// The research card, bottom left over the page.
		Thinking studyCard;
		internal void StudyCard()
		{
			if (mod.StudyNote == null || !Notice("studycard")) { if (studyCard != null) studyCard.Off(); return; }
			if (studyCard == null)
			{
				studyCard = new Thinking(delegate { return mod.look; }) { Visible = false, Head = "CAPRI // RESEARCH", Width = 320, Cursor = Cursors.Hand };
				studyCard.MouseClick += (sender, e) =>
				{
					if (e.X > studyCard.Width - 26 && e.Y < 24) { mod.StudyNote = null; studyCard.Off(); }
					else if (mod.studyFind != null) ShowFinding(mod.studyFind);
				};
				holder.Controls.Add(studyCard);
				holder.Resize += delegate { PlaceStudyCard(); };
			}
			studyCard.Still = mod.StudyAt >= 1;
			PlaceStudyCard();
			studyCard.On(mod.StudyAt >= 1 ? mod.StudyNote : mod.StudyNote + " (" + mod.studyTopic + ")", (int)(mod.StudyAt * 100), 100);
			studyCard.BringToFront();
		}
		void PlaceStudyCard() { studyCard.Location = new Point((side.Visible && side.Parent == holder ? side.Width : 0) + 16, holder.ClientSize.Height - studyCard.Height - 16); }

		// Her thinking card over the page while she works: what she's on (null hides it), and step of steps (0 when unknown).
		internal void Working(string doing, int step, int steps)
		{
			if (thinking == null)
			{
				if (doing == null) return;
				thinking = new Thinking(delegate { return mod.look; }) { Visible = false };
				holder.Controls.Add(thinking);
				holder.Resize += delegate { thinking.Left = holder.ClientSize.Width - thinking.Width - 16; };
			}
			if (doing == null) { thinking.Off(); return; }
			thinking.Location = new Point(holder.ClientSize.Width - thinking.Width - 16, 12);
			thinking.On(doing, step, steps);
			thinking.BringToFront();
		}

		[StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]
		struct ProcessEntry
		{
			public int Size, Usage, Id; public IntPtr Heap; public int Module, Threads, Parent, Priority, Flags;
			[MarshalAs(UnmanagedType.ByValTStr, SizeConst = 260)] public string File;
		}
		[DllImport("kernel32.dll", SetLastError = true)] private static extern IntPtr CreateToolhelp32Snapshot(int flags, int id);
		[DllImport("kernel32.dll", CharSet = CharSet.Unicode)] private static extern bool Process32FirstW(IntPtr snap, ref ProcessEntry entry);
		[DllImport("kernel32.dll", CharSet = CharSet.Unicode)] private static extern bool Process32NextW(IntPtr snap, ref ProcessEntry entry);
		[DllImport("kernel32.dll")] private static extern bool CloseHandle(IntPtr handle);

		// The engine's main process and everything it started (pages, GPU, audio), and nothing from other apps.
		static List<int> EngineFamily(int root)
		{
			var family = new List<int>();
			if (root <= 0) return family;
			family.Add(root);
			var parents = new Dictionary<int, int>();
			IntPtr snap = CreateToolhelp32Snapshot(2, 0);
			if (snap == IntPtr.Zero || snap == new IntPtr(-1)) return family;
			try
			{
				var e = new ProcessEntry { Size = Marshal.SizeOf(typeof(ProcessEntry)) };
				for (bool more = Process32FirstW(snap, ref e); more; more = Process32NextW(snap, ref e)) parents[e.Id] = e.Parent;
			}
			finally { CloseHandle(snap); }
			for (bool grew = true; grew; )
			{
				grew = false;
				foreach (KeyValuePair<int, int> p in parents) if (!family.Contains(p.Key) && family.Contains(p.Value)) { family.Add(p.Key); grew = true; }
			}
			return family;
		}

		void StartBrainFirst()
		{
			brainTimer = new WinTimer { Interval = 8000 };
			brainTimer.Tick += delegate { BrainFirst(); };
			brainTimer.Start();
			Disposed += delegate { brainTimer.Dispose(); };
		}

		void BrainFirst()
		{
			Suggest();
			AutoGame();
			// The ad blocker's counts, saved every few seconds rather than on every block.
			if (adsNew > 0) { Bump("ads", adsNew); adsNew = 0; }
			if (tracksNew > 0) { Bump("trackers", tracksNew); tracksNew = 0; }
			bool game = gameMode, on = Flag("brainfirst", true) || game;
			if (!on && !brainWasFirst) return;
			if (game) foreach (Tab t in tabs) t.Viewer.Saver(true);
			var roots = new List<int>();
			foreach (Tab t in tabs) { int id = t.Viewer.EngineId; if (id > 0 && !roots.Contains(id)) roots.Add(id); }
			// Her hidden Discord counts too, though it has no tab in the strip.
			if (hiddenDc != null && !hiddenDc.Viewer.Control.IsDisposed) { int hid = hiddenDc.Viewer.EngineId; if (hid > 0 && !roots.Contains(hid)) roots.Add(hid); }
			Behind(delegate
			{
				try { Process.GetCurrentProcess().PriorityClass = on && !game ? ProcessPriorityClass.AboveNormal : ProcessPriorityClass.Normal; } catch { }
				foreach (int root in roots)
					foreach (int id in EngineFamily(root))
						try { using (Process p = Process.GetProcessById(id)) p.PriorityClass = game ? ProcessPriorityClass.Idle : on ? ProcessPriorityClass.BelowNormal : ProcessPriorityClass.Normal; }
						catch { }
			});
			brainWasFirst = on;
		}

		internal void SetAds(bool on)
		{
			mod.look.Ads = on;
			Guard();
		}
		internal Action<string> TitleChanged;
		readonly List<string> closed = new List<string>();
		bool full, byKey;
		FormBorderStyle wasBorder;
		FormWindowState wasState;
		Rectangle wasBounds;

		[DllImport("user32.dll")] private static extern bool SetWindowPos(IntPtr w, IntPtr after, int x, int y, int wide, int tall, int flags);
		// To the front without being given the focus.
		internal static void ToTop(IntPtr w, bool on = true) { SetWindowPos(w, new IntPtr(on ? -1 : -2), 0, 0, 0, 0, 0x13); }

		// Full screen: for a video's own button (or F11) the bars go and her window covers the whole screen.
		internal void SetFullScreen(bool on)
		{
			if (on == full) return;
			full = on;
			mod.HideHer(on && !byKey && Flag("hideher", false), FindForm());
			Form whole = FindForm();
			if (whole != null) whole.SuspendLayout();
			SuspendLayout();
			if (on) notesWere = notes.Visible;
			strip.Visible = top.Visible = side.Visible = !on;
			notes.Visible = false;
			if (!on && notesWere) ToggleSide(notes, NotesWide());
			marks.Visible = false;
			loading.Visible = !on && tab != null && tab.Busy;
			if (on) SettingsShown = false;
			BrowserWindow form = whole as BrowserWindow;
			if (form == null) { ResumeLayout(true); if (whole != null) whole.ResumeLayout(true); return; }
			if (on)
			{
				wasBorder = form.FormBorderStyle;
				wasState = form.WindowState;
				wasBounds = form.WindowState == FormWindowState.Normal ? form.Bounds : form.RestoreBounds;
				form.FormBorderStyle = FormBorderStyle.None;
				form.WindowState = FormWindowState.Normal;
				form.Bounds = Screen.FromControl(form).Bounds;
			}
			else
			{
				form.FormBorderStyle = wasBorder;
				form.Bounds = wasBounds;
				form.WindowState = wasState;
			}
			ResumeLayout(true);
			form.ResumeLayout(true);
			form.Invalidate(true);
		}

		bool notesWere;

		void ReopenClosed() { ReopenLast(); }

		// Brings back the last tab they closed; its name, or null when there's none.
		internal string ReopenLast()
		{
			if (closed.Count == 0) return null;
			string last = closed[closed.Count - 1];
			closed.RemoveAt(closed.Count - 1);
			string name = closedNames.ContainsKey(last) ? closedNames[last] : HostOf(last);
			OpenTab(null, last, true);
			return name;
		}

		readonly Dictionary<string, string> closedNames = new Dictionary<string, string>();

		// "Recently closed": the last ten, newest first, to pick from.
		ToolStripMenuItem RecentlyClosed()
		{
			var recent = new ToolStripMenuItem("Recently closed") { Enabled = closed.Count > 0, ForeColor = mod.look.Shade(2) };
			for (int i = closed.Count - 1; i >= 0 && i >= closed.Count - 10; i--)
			{
				string url = closed[i];
				var one = new ToolStripMenuItem(Clip(closedNames.ContainsKey(url) ? closedNames[url] : HostOf(url) ?? url, 50)) { ToolTipText = url, ForeColor = mod.look.Shade(2) };
				one.Click += delegate { closed.Remove(url); Later(delegate { OpenTab(null, url, true); }); };
				recent.DropDownItems.Add(one);
			}
			return recent;
		}

		// The tab in front, for her: its address and name (nothing for private tabs or her own pages), and whether it's playing.
		internal string FrontAddress { get { Tab t = Work; return t == null || t.Private || t.OnReader ? null : t.Address; } }
		internal string FrontTitle { get { Tab t = Work; return t == null || t.Private || t.OnReader ? null : t.Title; } }
		internal bool FrontPlaying { get { Tab t = tab; return t != null && !t.Private && !t.OnReader && t.Playing && !t.Muted; } }
		internal string Snapshot() { Tab t = tab; return t == null ? null : t.Seen; }

		internal static string[] Hoards = { "TWENTY TABS?! Choom, my circuits are melting. Close some before I combust!" };

		static readonly Random dice = new Random();
		DateTime hoarded;

		sealed class Race { public Tab Tab; public string Goal, From, Code, Level; public string[] Route; public DateTime Started, Ended; public int Clicks, Limit, Helps, HelpUntil; public bool Cheated, Thinking; public string[] HelpText; }
		Race race;

		// Snooze: tabs nobody has looked at for 20 minutes are suspended (not while they play sound, race or show her pages); a click wakes them.
		void Doze()
		{
			if (!Flag("sleep", true)) return;
			var sleepy = new List<Tab>();
			foreach (Tab w in tabs) if (w != tab && !w.Asleep && !w.Playing && !w.OnReader && w.Special == null && (race == null || race.Tab != w) && !Watched(w) && (DateTime.UtcNow - w.Used).TotalMinutes > 20) sleepy.Add(w);
			if (sleepy.Count == 0) return;
			long before = WebMemory();
			foreach (Tab w in sleepy) if (w.Viewer.Sleep()) { w.Asleep = true; Retitle(w, w.Title); }
			var check = new WinTimer { Interval = 5000 };
			check.Tick += delegate
			{
				check.Dispose();
				long freed = (before - WebMemory()) / 1048576;
				if (freed >= 50) mod.Tell("I put " + sleepy.Count + (sleepy.Count == 1 ? " tab" : " tabs") + " you weren't using to sleep and freed about " + freed + " MB. Click one to wake it up.");
			};
			check.Start();
		}

		static long WebMemory()
		{
			long sum = 0;
			foreach (Process p in Process.GetProcessesByName("msedgewebview2")) { try { sum += p.WorkingSet64; } catch { } p.Dispose(); }
			return sum;
		}

		// Sundays (or when asked): a short summary of the week.
		internal void Wrap(bool asked)
		{
			if (!asked && (DateTime.Now.DayOfWeek != DayOfWeek.Sunday || Kept("wrapped") == Week())) return;
			Keep("wrapped", Week());
			var hosts = new Dictionary<string, int>();
			foreach (string[] one in mod.History())
			{
				Uri u;
				if (!Uri.TryCreate(one[0], UriKind.Absolute, out u)) continue;
				string h = u.Host.Begins("www.") ? u.Host.Substring(4) : u.Host;
				int n;
				hosts.TryGetValue(h, out n);
				hosts[h] = n + 1;
			}
			string most = null;
			int top = 0;
			foreach (KeyValuePair<string, int> p in hosts) if (p.Value > top) { top = p.Value; most = p.Key; }
			int best = Stat("typingbest");
			mod.Tell("Your week, choom: " + Stat(RoundKey("pages")) + " pages, " + Took(Stat(RoundKey("watchall"))) + " of video" + (most != null ? ", mostly on " + most : "") + ", and " + Stat("wiki" + Week()) + " wiki races finished" + (best > 0 ? ". Best typing speed: " + best + " WPM." : "."));
		}

		// Capri's pick: something related to the last thing they read, from Wikipedia's "more like this".
		void Pick()
		{
			string seed = null;
			bool wiki = false;
			foreach (string[] one in mod.History())
			{
				Match m = Regex.Match(one[0], "wikipedia[.]org/wiki/([^#?]+)");
				if (m.Success && !m.Groups[1].Value.Contains(":")) { seed = Uri.UnescapeDataString(m.Groups[1].Value).Replace('_', ' '); wiki = true; break; }
				if (seed == null && one[1].Length > 3) seed = Regex.Split(one[1], " [-|·] ")[0].Trim();
			}
			if (seed == null) { Roulette(); return; }
			mod.Tell("Let me find you something...");
			Behind(delegate
			{
				string title = null;
				try
				{
					using (var web = new WebClient())
					{
						web.Headers[HttpRequestHeader.UserAgent] = "CapriBrowser/1.9";
						web.Encoding = Encoding.UTF8;
						string got = web.DownloadString("https://en.wikipedia.org/w/api.php?action=query&list=search&format=json&srlimit=10&srsearch=" + Uri.EscapeDataString((wiki ? "morelike:" : "") + seed));
						var found = new List<string>();
						foreach (Match m in Regex.Matches(got, "\"title\":\"((?:[^\"\\\\]|\\\\.)*)\"")) { string one = Regex.Unescape(m.Groups[1].Value); if (!string.Equals(one, seed, Loose)) found.Add(one); }
						if (found.Count > 0) title = found[dice.Next(Math.Min(5, found.Count))];
					}
				}
				catch { }
				Post(delegate
				{
					if (title == null) { mod.Tell("Couldn't find anything right now, so here's something random."); Roulette(); return; }
					OpenTab(null, "https://en.wikipedia.org/wiki/" + Uri.EscapeDataString(title.Replace(' ', '_')), true);
					mod.Tell("You were looking at " + seed + ", so try this: " + title + ".");
				});
			});
		}

		// Guess the Site: a popular site opens blurred, with four names to pick from.
			Tab guessTab;
		string[] guessing;
		int guessAnswer, guessStreak, guessLives = 3, guessScore;

		bool Masked(Tab t) { return t != null && t == guessTab && guessing != null; }
		const string Mask = "? ? ?   Which site is this?";
		void GuessOver()
		{
			guessing = null;
			guessTab.Secret = false;
			guessTab.Viewer.Blurred(false);
			if (guessTab == tab) address.ReadOnly = false;
			Retitle(guessTab, guessTab.Title);
		}

		void Guess(Tab t)
		{
			string[] quoted = new string[guessing.Length];
			for (int i = 0; i < quoted.Length; i++) quoted[i] = Quote(guessing[i]);
			string game = Kept("js-guess");
			if (game.Length < 100) { Fetch("pages/guess.js", got => { Keep("js-guess", got); if (Masked(t)) Guess(t); }); return; }
			t.Viewer.Script(game + "([" + string.Join(",", quoted) + "]," + guessAnswer + "," + guessLives + "," + guessScore + ")");
		}

		// Gets a file from Browser addons on GitHub (in the background), then hands it over on the browser's thread.
		void Fetch(string file, Action<string> done)
		{
			mod.Tell("Getting that from Browser addons...");
			Behind(delegate
			{
				string got = null;
				try { using (WebClient web = new WebClient()) { web.Encoding = Encoding.UTF8; got = Pinned(web, file); } } catch { }
				Post(delegate { if (got == null) mod.Tell("Couldn't reach Browser addons right now. Try again later."); else done(got); });
			});
		}

		void Hoarding()
		{
			if (!Notice("hoard") || (DateTime.UtcNow - hoarded).TotalMinutes < 10) return;
			hoarded = DateTime.UtcNow;
			mod.Tell(Hoards[dice.Next(Hoards.Length)]);
		}

		// Their all-time stats: never reset, never sent, only shown here.
		void ShowAllTime()
		{
			foreach (Tab open in tabs) if (open.Special == "alltime") { ShowReader(open); Select(open); return; }
			OpenTab(null, null, true);
			tab.Special = "alltime";
			ShowReader(tab);
		}

		// ---- Featured ----
		// The worker's featured.txt: up to three boxes, each a title, a line of text and an https link (or none). Anything that doesn't fit is
		// dropped, and it's only ever shown as escaped text.
		List<string[]> Featured()
		{
			var all = new List<string[]>();
			foreach (string line in Kept("featured").Split('\n'))
			{
				string[] p = line.TrimEnd('\r').Split('\t');
				if (p.Length != 5 || p[0] != "featured" || !Regex.IsMatch(p[1], "^[1-3]$") || p[2].Trim().Length == 0 || p[2].Length > 40 || p[3].Length > 200) continue;
				if (p[4].Length > 0 && FeaturedLink(p[4]) == null) continue;
				all.Add(new[] { p[1], p[2].Trim(), p[3].Trim(), p[4] });
			}
			return all;
		}

		// Only a full https address with no name or password in it.
		static Uri FeaturedLink(string link)
		{
			Uri u;
			if (link == null || link.Length > 300 || !Uri.TryCreate(link, UriKind.Absolute, out u) || u.Scheme != Uri.UriSchemeHttps || u.UserInfo.Length > 0 || u.Host.IndexOf('.') < 0) return null;
			return u;
		}

		// Gets the newest Featured boxes, off the UI thread, and redraws the Games page if they changed.
		DateTime featuredAt;
		void LoadFeatured()
		{
			if (!Flag("featured", true) || DateTime.UtcNow - featuredAt < TimeSpan.FromMinutes(2)) return;
			featuredAt = DateTime.UtcNow;
			Behind(delegate
			{
				string got = null;
				try { using (WebClient web = new WebClient()) { web.Encoding = Encoding.UTF8; web.CachePolicy = new RequestCachePolicy(RequestCacheLevel.NoCacheNoStore); got = web.DownloadString(WorkerUrl + "featured.txt"); } } catch { }
				if (got == null || got.Length > 5000 || !got.Begins("# Capri Browser featured")) return;
				Post(delegate
				{
					if (got == Kept("featured")) return;
					Keep("featured", got);
					RefreshGames();
				});
			});
		}

		void OpenFeatured(string all)
		{
			if (!Flag("featured", true)) return;
			string slot = Regex.Match(all, "[&]n=([1-3])").Groups[1].Value;
			foreach (string[] box in Featured())
			{
				if (box[0] != slot) continue;
				Uri u = FeaturedLink(box[3]);
				if (u != null) OpenTab(null, u.AbsoluteUri, true);
				return;
			}
		}

		string FeaturedBox()
		{
			List<string[]> boxes = Flag("featured", true) ? Featured() : new List<string[]>();
			if (boxes.Count == 0) return "";
			var html = new StringBuilder("<h1>FEATURED <span>&gt;</span></h1><div class=\"row\">");
			foreach (string[] box in boxes)
			{
				Uri u = FeaturedLink(box[3]);
				string inside = "<b>" + Esc(box[1]) + "</b>" + (box[2].Length > 0 ? "<div class=\"s\">" + Esc(box[2]) + "</div>" : "")
					+ (u != null ? "<div class=\"s\" style=\"margin-top:6px\">&#8599; " + Esc(u.Host) + "</div>" : "");
				if (u != null) html.Append("<a class=\"b\" style=\"text-decoration:none;cursor:pointer\" href=\"").Append(Own).Append("play?g=lbfeat&n=").Append(box[0]).Append("\">").Append(inside).Append("</a>");
				else html.Append("<div class=\"b\">").Append(inside).Append("</div>");
			}
			return html.Append("</div>").ToString();
		}

		// What's new in this version: the first part of whats-new.txt, its first line big.
		internal void ShowNews()
		{
			foreach (Tab open in tabs) if (open.Special == "news") { ShowReader(open); Select(open); return; }
			OpenTab(null, null, true);
			tab.Special = "news";
			ShowReader(tab);
		}

		string NewsPage()
		{
			Look look = mod.look;
			string[] c = look.Colors;
			string[] parts = Kept("whats-new").Replace("\r", "").Trim().Split(new[] { "\n\n" }, StringSplitOptions.None);
			string[] lines = parts[0].Split('\n');
			StringBuilder html = Start(look, Styled(2, ".g{max-width:900px;margin:0 auto}", c, null, null)
				+ Colored(".g{max-width:760px}.nw{border:1px solid %C6%;border-left:3px solid %C5%;background:%C1%;padding:14px 18px;margin:10px 0;color:%C2%;line-height:1.5;animation:nwup .45s both}"
				+ ".nw.big{border-left-color:%C4%;font-size:1.2em;font-weight:700}.nw.big:before{content:'NEW';display:block;color:%C4%;font-size:.6em;letter-spacing:4px;margin-bottom:4px}"
				+ "@keyframes nwup{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}", c));
			html.Append("<div class=\"g\"><h1>WHAT'S NEW <span>&gt;</span></h1><div class=\"s\">").Append(Esc(lines[0])).Append("</div>");
			int n = 0;
			for (int i = 1; i < lines.Length; i++)
			{
				string l = lines[i].Trim().TrimStart('\u2022', '-', '*').Trim();
				if (l.Length == 0) continue;
				html.Append("<div class=\"nw").Append(n == 0 ? " big" : "").Append("\" style=\"animation-delay:").Append(n * 70).Append("ms\">").Append(Esc(l)).Append("</div>");
				n++;
			}
			html.Append("<div class=\"cr\"><a class=\"bt go\" href=\"").Append(Own).Append("play?g=lbgames\">Play the games</a></div>");
			return html.Append("</div></body></html>").ToString();
		}

		string AllTimePage()
		{
			Look look = mod.look;
			string[] c = look.Colors;
			StringBuilder html = Start(look, Styled(2, ".g{max-width:900px;margin:0 auto}.g .b{display:inline-block;margin:4px;padding:12px;border:1px solid %C6%;color:%C2%}", c, null, null));
			html.Append("<div class=\"g\"><h1>ALL-TIME STATS <span>&gt;</span></h1><div class=\"s\">Everything since you started. These never reset and are never sent anywhere: only you see them. The leaderboards use this week's numbers instead.</div><div class=\"row\">");
			string[,] stats = { { Took(Stat("watchall")), "watching videos" }, { Stat("videos").ToString(), "videos finished" }, { Stat("pages").ToString(), "pages visited" },
				{ Stat("typingbest") + " WPM", "best typing speed" }, { Stat("survival").ToString(), "best survival run" }, { Stat("guessbest").ToString(), "best Guess the Site run" },
				{ Stat("guess").ToString(), "sites guessed right" }, { Stat("wiki").ToString(), "Wiki Races finished" }, { Stat("coop").ToString(), "co-op races" },
				{ Stat("roulette").ToString(), "roulette spins" }, { Stat("maxtabs").ToString(), "most tabs at once" }, { Stat("shielded").ToString(), "pop-ups and redirects blocked" }, { Stat("ads").ToString(), "ads blocked" }, { Stat("trackers").ToString(), "trackers stopped" },
				{ Stat("shots").ToString(), "screenshots" }, { Stat("notes").ToString(), "notes saved" }, { Stat("extensions").ToString(), "extensions added" },
				{ Stat("daily").ToString(), "word searches done" }, { Stat("dailyhard").ToString(), "hard ones done" }, { Stat("dailystreak").ToString(), "longest daily streak" }, { Clock(Stat("dailyfast")), "fastest word search" } };
			for (int i = 0; i < stats.GetLength(0); i++) html.Append("<div class=\"b\"><div class=\"n\">").Append(stats[i, 0]).Append("</div><div class=\"s\">").Append(stats[i, 1]).Append("</div></div>");
			string[,] helped = { { Stat("researched").ToString(), "things researched" }, { Stat("jobs").ToString(), "jobs done" }, { Stat("readout").ToString(), "messages read out" }, { Stat("skips").ToString(), "ads and intros skipped" } };
			html.Append("</div><h1>CAPRI HELPED YOU <span>&gt;</span></h1><div class=\"row\">");
			for (int i = 0; i < helped.GetLength(0); i++) html.Append("<div class=\"b\"><div class=\"n\">").Append(helped[i, 0]).Append("</div><div class=\"s\">").Append(helped[i, 1]).Append("</div></div>");
			html.Append("</div><div class=\"cr\"><a class=\"bt\" href=\"").Append(Own).Append("play?g=lbgames\">Back to Games</a><a class=\"bt\" href=\"").Append(Own).Append("play?g=lbopen\">Open leaderboards</a></div>");
			return html.Append("</div></body></html>").ToString();
		}

		// This round's numbers for THIS WEEK on the Games page; they start from 0 with each new round.
		static string[,] WeekStats()
		{
			return new string[,] { { Took(Stat(RoundKey("watchall"))), "watching videos" }, { Took(Stat(RoundKey("yt"))), "of it on YouTube" }, { Stat(RoundKey("videos")).ToString(), "videos finished" },
				{ Stat(RoundKey("pages")).ToString(), "pages visited" }, { Stat(RoundKey("typingbest")) + " WPM", "best typing speed" }, { Stat(RoundKey("survival")).ToString(), "best survival run" },
				{ Stat(RoundKey("guessbest")).ToString(), "best Guess the Site run" }, { Stat(RoundKey("daily")).ToString(), "word searches done" }, { Clock(Stat(RoundKey("dailyfast"))), "fastest word search" } };
		}

		// Puts the newest THIS WEEK numbers on an open Games page without reloading it.
		void LiveWeek(Tab g)
		{
			string[,] stats = WeekStats();
			var js = new StringBuilder("(function(v){for(var i=0;i<v.length;i++){var e=document.getElementById('wk'+i);if(e&&e.textContent!=v[i])e.textContent=v[i];}})([");
			for (int i = 0; i < stats.GetLength(0); i++) js.Append(i > 0 ? "," : "").Append(Quote(stats[i, 0]));
			try { g.Viewer.Script(js.Append("])").ToString()); } catch { }
		}

		void RefreshGames() { foreach (Tab open in tabs) if (open.Special == "games") ShowReader(open); }

		void ShowGames()
		{
			LoadFeatured();
			Keep("gamesopened", "1");
			if (Catalogue().Count == 0) Fetch("games.txt", got => { Keep("gamepack", got); RefreshGames(); });
			foreach (Tab open in tabs) if (open.Special == "games") { ShowReader(open); Select(open); return; }
			OpenTab(null, null, true);
			tab.Special = "games";
			ShowReader(tab);
		}

		string[] Lines(string id)
		{
			var all = new List<string>();
			foreach (string l in Kept("game-" + id).Split('\n')) if (l.Trim().Length > 0) all.Add(l.Trim());
			return all.ToArray();
		}

		string[] Targets { get { string[] w = Lines("wiki"); return w.Length > 0 ? w[0].Split(',') : new[] { "Pizza" }; } }
		string[] Starts { get { string[] w = Lines("wiki"); return w.Length > 1 ? w[1].Split(',') : new[] { "Banana" }; } }

		// The repo's games.txt: id, title, description, and what to download (page, data or none).
		List<string[]> Catalogue()
		{
			var all = new List<string[]>();
			foreach (string l in Kept("gamepack").Split('\n')) { string[] g = l.Trim().Split('\t'); if (g.Length == 4 && Regex.IsMatch(g[0], "^[a-z0-9-]+$")) all.Add(g); }
			return all;
		}

		void Installed(string name)
		{
			RefreshGames();
			mod.Tell(name + " is ready. Have fun, choom.");
		}

		// Update from GitHub: the catalogue, every installed game, and the languages if they have them.
		void UpdateAll() { UpdateAll(false, null); }

		// Downloads every file this version is pinned to, one by one, and keeps the ones whose SHA-256 matches. silent: no chat messages (the
		// Welcome page's background choice). show: a tab to show the progress on (the Welcome page).
		volatile string dlNote;
		void UpdateAll(bool silent, Tab show)
		{
			if (!silent) mod.Tell("Downloading Capri Browser's add-ons...");
			int before = Catalogue().Count, total = AddonHashes.Split(';').Length;
			Behind(delegate
			{
				var got = new Dictionary<string, string>();
				int done = 0, bad = 0;
				using (var web = new WebClient())
				{
					web.Encoding = Encoding.UTF8;
					Func<string, string> get = file =>
					{
						string one = null;
						try { one = Pinned(web, file); } catch (Exception) { bad++; }
						done++;
						if (show != null) { dlNote = "Downloading " + done + " of " + total + ": " + file + (one == null ? " (didn't match, thrown away)" : " (checked)"); Post(delegate { if (show.Special == "welcome") ShowReader(show); }); }
						return one;
					};
					string list = get("games.txt");
					got["gamepack"] = list;
					got["css-settings"] = get("settings.css");
					got["help"] = get("help.txt");
					got["whats-new"] = get("whats-new.txt");
					got["page-welcome"] = get("pages/welcome.html");
					got["lists"] = get("data/lists.txt");
					got["adblock"] = get("data/adblock.txt");
					got["commands"] = get("data/commands.txt");
					got["css-home"] = get("pages/home.css");
					got["css-pages"] = get("pages/pages.css");
					got["lang"] = get("languages.txt");
					foreach (string p in AddonHashes.Split(';'))
					{
						Match h = Regex.Match(p, "^help/([a-z-]+)[.]txt=");
						if (h.Success) got["help-" + h.Groups[1].Value] = get("help/" + h.Groups[1].Value + ".txt");
					}
					foreach (string l in (list ?? "").Split('\n'))
					{
						string[] g = l.Trim().Split('\t');
						if (g.Length != 4 || !Regex.IsMatch(g[0], "^[a-z0-9-]+$")) continue;
						string gf = "games/" + g[0] + (g[3] == "page" ? ".html" : ".txt");
						if (g[3] == "none") got["game-" + g[0]] = "1";
						else if (IsPinned(gf)) got["game-" + g[0]] = get(gf);
					}
				}
				Post(delegate
				{
					int kept = 0;
					foreach (KeyValuePair<string, string> p in got)
					{
						if (p.Value == null) continue;
						kept++;
						if (p.Key == "lang") { UseLanguages(p.Value); Host.Store.Set("langpack", p.Value); } else Keep(p.Key, p.Value);
						if (p.Key == "adblock") Keep("adblock-pin", AddonsCommit);
						if (p.Key == "lists") Keep("look-pin", AddonsCommit);
					}
					if (kept == 0) { dlNote = "Couldn't reach Browser addons right now. The browser still works, try again later."; if (!silent) mod.Tell("Couldn't reach Browser addons right now. Try again later."); }
					else
					{
						Keep("updated", DateTime.Now.ToString("d MMM yyyy, HH:mm"));
						bool updated = bad == 0 && Kept("addons-pin").Length > 0 && Kept("addons-pin") != AddonsCommit;
						if (bad == 0) Keep("addons-pin", AddonsCommit);
						if (updated && Notice("news")) Later(delegate { ShowNews(); });
						dlNote = "Done: " + (done - bad) + " of " + total + " files downloaded and checked" + (bad > 0 ? ", " + bad + " thrown away." : ".");
						if (!silent) mod.Tell(bad > 0 ? "Downloaded, choom, but " + bad + " files didn't match and were thrown away." : "All downloaded and checked, choom. Every game, language and page is installed.");
						else if (Catalogue().Count > before) mod.Tell("Capri Browser finished downloading in the background, choom.");
					}
					foreach (Tab open in tabs) if (open.Special == "games" || open.Special == "settings" || open.Special == "welcome" || open.Special == "home" || open.Special == "boards" || open.Special == "alltime") ShowReader(open);
				});
			});
		}

		// Daily Word Search: day 1 is 1 Nov 2026 (UTC), the same puzzle for everyone each day.
		static int DayNow() { return (int)(DateTime.UtcNow - new DateTime(2026, 11, 1, 0, 0, 0, DateTimeKind.Utc)).TotalDays + 1; }

		// Today's word search is done: the streak and time are kept, and a result to share is copied.
		string Daily(int secs, int day)
		{
			if (secs <= 0 || Math.Abs(day - DayNow()) > 1) return "That word search result didn't look right, choom.";
			int last, streak;
			int.TryParse(Kept("daily-day"), out last);
			int.TryParse(Kept("daily-streak"), out streak);
			if (day != last)
			{
				streak = day == last + 1 ? streak + 1 : 1;
				Keep("daily-day", day.ToString());
				Keep("daily-time", secs.ToString());
				Keep("daily-streak", streak.ToString());
				Bump("daily", 1);
				Bump("dailystreak", streak, true);
				Fastest("dailyfast", secs);
				if (day % 3 == 0) Bump("dailyhard", 1);
			}
			string took = secs / 60 + ":" + (secs % 60).ToString("00");
			try { Clipboard.SetText("Capri Daily Word Search #" + day + "\n\u23F1 " + took + "   \uD83D\uDD25 " + streak + (streak == 1 ? " day" : " days") + "\nPlay it in Capri Browser"); } catch { }
			return "Done in " + took + ", choom! " + (streak > 1 ? "That's a " + streak + "-day streak. " : "") + "Your result's copied, paste it anywhere to show it off.";
		}

		internal void Roulette()
		{
			var sites = new List<string>();
			foreach (string l in Lines("roulette")) if (l.Begins("https://")) sites.Add(l);
			if (sites.Count == 0) { Fetch("games/roulette.txt", got => { if (got.IndexOf("https://", Exact) < 0) return; Keep("game-roulette", got); Roulette(); }); return; }
			Bump("roulette", 1);
			OpenTab(null, sites[dice.Next(sites.Count)], true);
			mod.Tell("Spinning the wheel... here's a weird corner of the web, choom.");
		}

		// A game by its name: finds it in the list, downloads it if needed, and starts it.
		internal void PlayGame(string name)
		{
			List<string[]> list = Catalogue();
			if (list.Count == 0) { Fetch("games.txt", got => { Keep("gamepack", got); if (Catalogue().Count > 0) PlayGame(name); }); return; }
			string want = Regex.Replace(Regex.Replace(name.ToLowerInvariant(), @"\bwebsite\b", "site"), "[^a-z0-9]", "");
			if (want == "survival" || want == "typingsurvival") want = "typing";
			foreach (string[] g in list)
			{
				string id = g[0], title = Regex.Replace(g[1].ToLowerInvariant(), "[^a-z0-9]", "");
				if (want != id.Replace("-", "") && want != title && !(want.Length >= 4 && (title.Contains(want) || want.Contains(title)))) continue;
				string go = g[3] == "page" && id != "typing" ? "addon&id=" + id : id;
				if (Kept("game-" + id).Length > 0) { Game(go); return; }
				if (g[3] == "none") { Keep("game-" + id, "1"); Game(go); return; }
				Fetch("games/" + id + (g[3] == "page" ? ".html" : ".txt"), got => { Keep("game-" + id, got); Game(go); });
				return;
			}
			mod.Tell("I don't have a game called " + name + " yet, choom. Try Update all in Settings, under Updates.");
		}

		internal void Game(string which)
		{
			string all = which;
			if (which.IndexOf('&') >= 0) which = which.Substring(0, which.IndexOf('&'));
			string need = which == "coop" || which == "join" || which == "go" ? "wiki" : which;
			if (Regex.IsMatch(need, "^(wiki|roulette|guess|quiz|typing|minecraft)$") && Kept("game-" + need).Length == 0) { mod.Tell("Download " + (need == "wiki" ? "Wiki Race" : "that game") + " on the Games page first, choom."); return; }
			if (which == "start") { PlayGame(Regex.Match(all, "[&]id=([a-z0-9-]+)$").Groups[1].Value); return; }
			if (which == "daily") { int secs, day; int.TryParse(Regex.Match(all, "[&]s=([0-9]{1,5})").Groups[1].Value, out secs); int.TryParse(Regex.Match(all, "[&]d=([0-9]{1,6})").Groups[1].Value, out day); mod.Tell(Daily(secs, day)); return; }
			if (which == "studynote") { int n; if (int.TryParse(Regex.Match(all, "n=([0-9]+)").Groups[1].Value, out n) && n < shownFindings.Count) mod.KeepFinding(shownFindings[n]); return; }
			if (which.Begins("lb")) { Board(which, all); return; }
			if (which == "get")
			{
				string id = Regex.Match(all, "[&]id=([a-z0-9-]+)$").Groups[1].Value;
				foreach (string[] g in Catalogue())
				{
					if (g[0] != id) continue;
					string name = g[1];
					if (g[3] == "none") { Keep("game-" + id, "1"); Installed(name); }
					else Fetch("games/" + id + (g[3] == "page" ? ".html" : ".txt"), got => { Keep("game-" + id, got); Installed(name); });
				}
				return;
			}
			if (which == "coop")
			{
				string made = "CAPRI-";
				int lv = Array.IndexOf(Levels, RaceLevel);
				made += CodeLetters[dice.Next(CodeLetters.Length / 3) * 3 + lv];
				for (int i = 1; i < 4; i++) made += CodeLetters[dice.Next(CodeLetters.Length)];
				try { Clipboard.SetText(made); } catch { }
				Lobby(made, "Race code " + made + " (" + LevelName(CodeLevel(made)) + ") is copied. Send it to your friend, then you both press Start.");
				return;
			}
			if (which == "join")
			{
				string code = Tidy(Uri.UnescapeDataString(Regex.Match(all, "[&]c=([^&]*)").Groups[1].Value));
				if (code == null) { mod.Tell("That race code doesn't look right, choom. It looks like CAPRI-7F3K."); return; }
				Lobby(code, "Joined race " + code + " (" + LevelName(CodeLevel(code)) + "). Press Start when your friend does.");
				return;
			}
			if (which == "go") { StartRace(); return; }
			if (which == "cancel") { CancelRace(); return; }
			if (which == "hint") { Hint(); return; }
			if (which == "pick") { Pick(); return; }
			if (which == "addon")
			{
				string id = Regex.Match(all, "[&]id=([a-z0-9-]+)$").Groups[1].Value, name = id;
				foreach (string[] g in Catalogue()) if (g[0] == id) name = g[1];
				string page = Kept("game-" + id);
				if (page.Length < 20) { mod.Tell("Download that game on the Games page first, choom."); return; }
				if (id == "daily") page = page.Replace("var played=0;", "var played=" + (Kept("daily-day") == DayNow().ToString() ? Kept("daily-time") : "0") + ",streak=" + (Kept("daily-streak").Length > 0 ? Kept("daily-streak") : "0") + ";");
				OpenTab(null, null, true); tab.Special = "addon"; tab.Html = page; tab.Title = name; ShowReader(tab);
				return;
			}
			if (which == "more") { Fetch("games.txt", got => { Keep("gamepack", got); RefreshGames(); mod.Tell("Here are the games, choom. Pick one to download it."); }); return; }
			if (which == "guess")
			{
				if (guessLives < 1) { guessLives = 3; guessScore = 0; guessStreak = 0; }
				var sites = new List<string[]>();
				foreach (string l in Lines("guess")) { string[] p = l.Split('\t'); if (p.Length == 2 && p[1].Begins("https://")) sites.Add(p); }
				if (sites.Count < 4) return;
				int n = sites.Count, answer = dice.Next(n);
				var pick = new List<int> { answer };
				while (pick.Count < 4) { int k = dice.Next(n); if (!pick.Contains(k)) pick.Add(k); }
				for (int i = pick.Count - 1; i > 0; i--) { int j = dice.Next(i + 1), x = pick[i]; pick[i] = pick[j]; pick[j] = x; }
				guessing = new string[4];
				for (int i = 0; i < 4; i++) guessing[i] = sites[pick[i]][0];
				guessAnswer = pick.IndexOf(answer);
				if (guessTab == null || !tabs.Contains(guessTab)) { OpenTab(null, null, true); guessTab = tab; }
				guessTab.Secret = true;
				Select(guessTab);
				address.ReadOnly = true;
				guessTab.Viewer.Blurred(true);
				guessTab.Viewer.Go(sites[answer][1]);
				address.Text = Mask;
				Retitle(guessTab, guessTab.Title);
				return;
			}
			if (which == "guessed")
			{
				if (guessing == null) return;
				bool right = all.Contains("r=1");
				GuessOver();
				if (guessTab == tab) address.Text = guessTab.Address ?? "";
				if (right) { guessStreak++; guessScore++; Bump("guess", 1); Bump("guessbest", guessScore, true); } else { guessStreak = 0; guessLives--; }
				if (guessLives < 1) AutoSend(false);
				mod.Tell(guessLives < 1 ? "Game over, choom! You got " + guessScore + " right." : right ? (guessStreak > 2 ? guessStreak + " in a row!" : "Got it.") : "Nope. " + guessLives + (guessLives == 1 ? " life" : " lives") + " left.");
				return;
			}
			if (which == "survived")
			{
				int score, best = Stat("survival");
				int.TryParse(Regex.Match(all, "[&]s=([0-9]+)").Groups[1].Value, out score);
				Bump("survival", score, true);
				AutoSend(false);
				mod.Tell(score + (score == 1 ? " word" : " words") + " before they got you." + (score > best ? " New best!" : " Your best is " + best + "."));
				return;
			}
			if (which == "timed") { bool on = !Flag("timed", false); if (Host != null) Host.Store.Set("opt-timed", on ? "1" : "0"); RefreshGames(); mod.Tell(on ? "Wiki races now have a 3-minute limit." : "Time limit off. Take as long as you like."); return; }
			if (which == "quit") { Tab here = tab; if (here != null) { here.Special = "games"; here.Html = null; ShowReader(here); } return; }
			if (which == "typing") { TypingRace(); return; }
			if (which == "typed")
			{
				int wpm, accuracy;
				int.TryParse(Regex.Match(all, "[&]w=([0-9]+)").Groups[1].Value, out wpm);
				int.TryParse(Regex.Match(all, "[&]a=([0-9]+)").Groups[1].Value, out accuracy);
				Typed(wpm, accuracy);
				AutoSend(false);
				return;
			}
			if (which == "roulette") { Roulette(); return; }
			if (which == "minecraft") { OpenTab(null, "https://github.com/tob7as/Minecraft-with-Capri-#setup", true); return; }
			if (which == "wiki")
			{
				if (!WikiCurrent(delegate { Game("wiki"); })) return;
				string level = RaceLevel;
				List<string[]> pairs = Pairs(level);
				if (pairs.Count == 0)
				{
					string goal = Targets[dice.Next(Targets.Length)];
					BeginRace(null, goal, null, null, null);
					mod.Tell("Wiki race! Get to the " + goal.Replace('_', ' ') + " page using only links. Go on the countdown, choom.");
					return;
				}
				string[] route = pairs[dice.Next(pairs.Count)];
				BeginRace(StepPage(route[0]), StepPage(route[route.Length - 1]), null, level, route);
				mod.Tell("Wiki race, " + LevelName(level) + "! From " + StepPage(route[0]) + " to " + StepPage(route[route.Length - 1]) + ", using only links. Go on the countdown, choom.");
				return;
			}
			if (which == "level")
			{
				string next = Levels[(Array.IndexOf(Levels, RaceLevel) + 1) % Levels.Length];
				if (Host != null) Host.Store.Set("opt-racelevel", next);
				RefreshGames();
				mod.Tell("Wiki races are " + LevelName(next) + " now: the goal is " + LevelClicks(next) + ".");
				return;
			}
			if (which == "quiz")
			{
				foreach (Tab w in tabs) if (w.Address != null && !w.Private) { Select(w); Behind(delegate { mod.StartQuiz(); }); return; }
				mod.Tell("Open a page first and I'll quiz you on it, choom.");
				return;
			}
		}

		// ---- co-op wiki race: a short code decides the start and target, so friends get the same race without any server ----

		const string CodeLetters = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
		string lobby;

		// Every website tab (not private ones), and for comparing, a read of each page's words.
		internal void WebTabs(List<string[]> into, List<Task<string>> reads, bool read)
		{
			foreach (Tab t in tabs)
			{
				if (t.Private || t.OnReader || t.Address == null || into.Count >= 10) continue;
				into.Add(new[] { t.Title ?? t.Address, t.Address });
				Task<string> run = null;
				if (read) try { run = t.Viewer.Script(Viewer.ReadScript); } catch { }
				reads.Add(run);
			}
		}

		// A finding as its own page: the write-up with its sources, and a button that puts it in Noted.
		readonly List<ResearchResult> shownFindings = new List<ResearchResult>();
		internal void ShowFinding(ResearchResult f)
		{
			string[] c = mod.look.Colors;
			int n = shownFindings.IndexOf(f);
			if (n < 0) { shownFindings.Add(f); n = shownFindings.Count - 1; }
			if (PagesCss.Replace("\r", "").Split(new[] { "\n%%\n" }, StringSplitOptions.None).Length < 5) GetLook();
			var h = new StringBuilder("<!doctype html><html><head><meta charset='utf-8'><style>");
			h.Append(Styled(5, "body{margin:0;background:%C0%;color:%C2%;font:16px/1.6 'Segoe UI',sans-serif}.w{max-width:760px;margin:0 auto;padding:40px 28px}.k,.d,ol span{color:%C3%}a{color:%C4%}.t{background:%C1%;padding:16px 22px}.b{display:inline-block;margin-top:24px;padding:9px 18px;color:%C0%;background:%C4%}", c, null, null))
				.Append("</style></head><body><div class='w'>");
			string kind = f.Kind == "best" ? "BEST PICKS" : f.Kind == "site" ? "BEST WEBSITES" : f.Kind == "fact" ? "FACT CHECK" : f.Kind == "compare" ? "YOUR TABS COMPARED" : f.Kind == "tabs" ? "YOUR TABS" : f.Kind == "solve" ? "WORKED OUT" : "RESEARCH";
			h.Append("<div class='k'>CAPRI " + kind + "</div><h1>" + Esc(f.Title) + "</h1><div class='d'>" + DateTime.Now.ToString("d MMMM yyyy") + (f.Sources.Count > 0 ? " · " + f.Sources.Count + " sources" : "") + "</div><div class='t'>");
			bool list = false;
			foreach (string raw in f.Text.Split('\n'))
			{
				string line = raw.Trim();
				bool point = line.Begins("- ") || line.Begins("• ");
				if (list && !point) { h.Append("</ul>"); list = false; }
				if (line.Length == 0) continue;
				string html = Regex.Replace(Esc(point ? line.Substring(2) : line), @"\[(\d{1,2})\]", "<sup><a href='#s$1'>$1</a></sup>");
				if (point && !list) { h.Append("<ul>"); list = true; }
				h.Append(point ? "<li>" + html + "</li>" : "<p>" + html + "</p>");
			}
			h.Append(list ? "</ul></div>" : "</div>");
			if (f.Sources.Count > 0) h.Append("<h2>SOURCES</h2><ol>");
			for (int i = 0; i < f.Sources.Count; i++)
			{
				string at = f.Sources[i].Address ?? "", site = "";
				try { site = new Uri(at).Host; } catch { }
				h.Append("<li id='s" + (i + 1) + "'>" + (at.Begins("http") ? "<a target='_blank' href='" + Esc(at) + "'>" + Esc(f.Sources[i].Title) + "</a>" : Esc(f.Sources[i].Title)) + "<span>" + Esc(site) + "</span></li>");
			}
			if (f.Sources.Count > 0) h.Append("</ol>");
			h.Append("<a class='b' href='" + Own + "play?g=studynote&amp;n=" + n + "'>ADD TO NOTES</a></div></body></html>");
			OpenTab(null, null, true);
			tab.Special = "addon"; tab.Html = h.ToString(); tab.Title = f.Title;
			ShowReader(tab);
		}
		static readonly string[] Levels = { "easy", "hard", "challenging" };
		static string LevelName(string level) { return level == "hard" ? "Hard" : level == "challenging" ? "Challenging" : "Easy"; }
		static string LevelClicks(string level) { return level == "hard" ? "3 clicks from the start" : level == "challenging" ? "anywhere, from a random page" : "2 clicks from the start"; }
		static string RaceLevel { get { string v = Host == null ? "" : Host.Store.Get("opt-racelevel", "") ?? ""; return Array.IndexOf(Levels, v) >= 0 ? v : "easy"; } }
		// A race code's first letter carries its level, so whoever joins gets the same one.
		static string CodeLevel(string code) { return Levels[Math.Max(0, CodeLetters.IndexOf(code[6])) % 3]; }
		static string StepPage(string step) { int k = step.IndexOf('~'); return k < 0 ? step : step.Substring(0, k); }
		static string LinkOf(string step) { int k = step.IndexOf('~'); return k < 0 ? step : step.Substring(k + 1); }
		bool wikiChecked;

		List<string[]> Pairs(string level)
		{
			var got = new List<string[]>();
			string[] w = Lines("wiki");
			for (int i = 2; i < w.Length; i++)
			{
				string[] p = w[i].Split('|');
				if (p.Length < 3 || p[0] != level) continue;
				string[] route = new string[p.Length - 1];
				Array.Copy(p, 1, route, 0, route.Length);
				got.Add(route);
			}
			return got;
		}

		// Once a session, before a race: an older saved Wiki Race file is swapped for this version's, so friends race the same pages.
		bool WikiCurrent(Action then)
		{
			if (wikiChecked) return true;
			wikiChecked = true;
			if (Matches("games/wiki.txt", Kept("game-wiki"))) return true;
			Fetch("games/wiki.txt", got => { Keep("game-wiki", got); then(); });
			return false;
		}

		void BeginRace(string from, string goal, string code, string level, string[] route)
		{
			OpenTab(null, "https://en.wikipedia.org/wiki/" + (from == null ? "Special:Random" : Uri.EscapeDataString(from.Replace(' ', '_'))), true);
			race = new Race { Tab = tab, Goal = goal.Replace(' ', '_'), From = from == null ? null : from.Replace(' ', '_'), Code = code, Level = level, Route = route, Helps = level == "easy" ? 2 : 1, Clicks = -1, Started = DateTime.UtcNow.AddMilliseconds(3500) };
			Arm(race);
		}

		static int Seed(string code)
		{
			int seed = 0;
			foreach (char c in code.Substring(6)) seed = seed * 32 + CodeLetters.IndexOf(c);
			return seed;
		}

		static string Tidy(string code)
		{
			code = Regex.Replace((code ?? "").ToUpperInvariant(), "[^A-Z0-9]", "");
			if (code.Begins("CAPRI")) code = code.Substring(5);
			if (code.Length != 4) return null;
			foreach (char c in code) if (CodeLetters.IndexOf(c) < 0) return null;
			return "CAPRI-" + code;
		}

		void Lobby(string code, string said)
		{
			lobby = code;
			RefreshGames();
			mod.Tell(said);
		}

		WinTimer countdown;

		void CancelRace()
		{
			Race r = race;
			race = null;
			if (countdown != null) { countdown.Dispose(); countdown = null; }
			StopLimit();
			bool any = r != null || lobby != null;
			lobby = null;
			if (r != null && r.Tab != null) try { r.Tab.Viewer.Script("(function(){clearInterval(window.__cr);['capri-race','capri-count'].forEach(function(i){var d=document.getElementById(i);if(d)d.remove();});})()"); } catch { }
			RefreshGames();
			mod.Tell(any ? "Race cancelled." : "There's no race going, choom.");
		}

		void StartRace()
		{
			if (lobby == null) return;
			if (!WikiCurrent(StartRace)) return;
			int seed = Seed(lobby);
			string code = lobby, level = CodeLevel(lobby), from, goal;
			List<string[]> pairs = Pairs(level);
			string[] route = pairs.Count > 0 ? pairs[seed % pairs.Count] : null;
			if (route != null) { from = StepPage(route[0]); goal = StepPage(route[route.Length - 1]); }
			else { from = Starts[seed % Starts.Length]; goal = Targets[seed / Starts.Length % Targets.Length]; level = null; }
			mod.Tell("Race " + code + (level != null ? ", " + LevelName(level) : "") + ": from " + from.Replace('_', ' ') + " to " + goal.Replace('_', ' ') + ". Three, two, one... go!");
			BeginRace(from, goal, code, level, route);
		}

	
		// The race clock in the top corner of the page: time, clicks and the goal (frozen once they finish).
		void RaceClock(Race r, bool done)
		{
			if (r == null || r.Tab == null || r.Tab.Viewer == null) return;
			long ms = (long)((done ? r.Ended : DateTime.UtcNow) - r.Started).TotalMilliseconds;
			string help = r.HelpText != null && r.Clicks < r.HelpUntil ? "[" + string.Join(",", new List<string>(r.HelpText).ConvertAll(Quote).ToArray()) + "]" : "[]";
			string clock = Kept("js-clock");
			if (clock.Length < 100) { GetLook(); return; }
			try { r.Tab.Viewer.Script(clock + "(" + ms + "," + Math.Max(0, r.Clicks) + "," + Quote(r.Goal.Replace('_', ' ')) + "," + (done ? "true" : "false") + "," + r.Limit + "," + r.Helps + "," + Quote(r.Level == null ? "" : LevelName(r.Level).ToUpperInvariant()) + "," + Quote(r.From == null ? "" : r.From.Replace('_', ' ')) + "," + (r.Route == null ? 0 : r.Route.Length - 1) + "," + help + "," + (r.Thinking ? "true" : "false") + ")"); if (!done) r.Tab.Viewer.Script(RaceGuard); } catch { }
		}

		// The page's title says they're there, even if the address was a redirect.
		void RaceTitle(Tab t, string title)
		{
			Race r = race;
			if (r == null || r.Tab != t || title == null) return;
			if (string.Equals(title.Replace(" - Wikipedia", "").Trim(), r.Goal.Replace('_', ' '), Loose)) Finish(r);
		}

		void Raced(string url)
		{
			Race r = race;
			Uri at;
			if (!Uri.TryCreate(url, UriKind.Absolute, out at)) return;
			if (at.Host.EndsWith("wikipedia.org", Exact) && (at.Query.Contains("search=") || at.AbsolutePath.Contains("Special:Search")))
			{
				try { r.Tab.Viewer.Script("history.back()"); } catch { }
				mod.Tell("No searching in a wiki race, choom. Links only!");
				return;
			}
			if (!at.Host.EndsWith("wikipedia.org", Exact)) r.Cheated = true;
			if (at.AbsolutePath.Contains("Special:Random")) return;
			r.Clicks++;
			if (Regex.IsMatch(Uri.UnescapeDataString(at.AbsolutePath), "^/wiki/" + Regex.Escape(r.Goal) + "$", RegexOptions.IgnoreCase)) Finish(r);
		}

		// In a race, Wikipedia's own search box is hidden and can't be typed in, so the goal can only be reached by links.
		const string RaceGuard = "(function(){if(window.__capriGuard)return '';window.__capriGuard=1;var s=document.createElement('style');"
			+ "s.textContent='#p-search,#searchform,#simpleSearch,.vector-search-box,.search-toggle,.cdx-typeahead-search,.minerva-search-form,.header-search,#searchIcon{display:none!important}';"
			+ "(document.head||document.documentElement).appendChild(s);function no(e){var t=e.target;if(t&&(t.name==='search'||(t.closest&&t.closest('#searchform,.cdx-typeahead-search,.vector-search-box')))){e.preventDefault();e.stopPropagation();if(t.blur)t.blur();}}"
			+ "document.addEventListener('submit',no,true);document.addEventListener('keydown',no,true);document.addEventListener('focusin',no,true);return '';})()";

		// Their one help in a race: she lights up links that could get them there.
		internal void Hint()
		{
			Race r = race;
			if (r == null) { mod.Tell("There's no race going, choom."); return; }
			if (DateTime.UtcNow < r.Started) { mod.Tell("Wait for the go, choom."); return; }
			if (r.Helps <= 0) { mod.Tell("No help left this race, choom. You've got this."); return; }
			if (r.Thinking) return;
			r.Helps--;
			r.Thinking = true;
			if (tabs.Contains(r.Tab)) Select(r.Tab);
			RaceClock(r, false);
			string goal = r.Goal;
			// The checked route's pages still ahead of them, furthest first, so the help skips them as far along as it can.
			var ahead = new List<string>();
			string via = null;
			if (r.Route != null)
			{
				string here = Regex.Replace(r.Tab.Title ?? "", @"\s+-\s+Wikipedia$", "").Trim();
				int at = -1;
				for (int i = 0; i < r.Route.Length; i++) if (string.Equals(StepPage(r.Route[i]), here, Loose)) at = i;
				for (int i = r.Route.Length - 1; i > at && i >= 1; i--) ahead.Add(LinkOf(r.Route[i]) + "|" + StepPage(r.Route[i]));
				if (at < 0 && r.Route.Length > 2) { List<string> mid = new List<string>(); for (int i = 1; i < r.Route.Length - 1; i++) mid.Add(StepPage(r.Route[i])); via = string.Join(" → ", mid.ToArray()); }
			}
			Behind(delegate
			{
				string[] got = null;
				int keep = 2;
				try
				{
					got = mod.RouteHint(ahead);
					if (got == null) { keep = 1; got = mod.RaceHint(goal); }
					if (got != null && via != null) { List<string> more = new List<string>(got); more.Add(" You're off my checked route, it goes via "); more.Add(via); got = more.ToArray(); }
				}
				catch { }
				Post(delegate
				{
					r.Thinking = false;
					if (got == null) r.Helps++;
					else { r.HelpText = got; r.HelpUntil = Math.Max(0, r.Clicks) + keep; }
					if (race == r) RaceClock(r, false);
				});
			});
		}

		WinTimer limitTimer;
		void StopLimit() { if (limitTimer != null) { limitTimer.Dispose(); limitTimer = null; } }

		void Arm(Race r)
		{
			StopLimit();
			if (!Flag("timed", false)) return;
			r.Limit = 180;
			WinTimer up = limitTimer = new WinTimer { Interval = r.Limit * 1000 + Math.Max(1, (int)(r.Started - DateTime.UtcNow).TotalMilliseconds) };
			up.Tick += delegate
			{
				up.Dispose();
				if (limitTimer == up) limitTimer = null;
				if (race != r) return;
				race = null;
				try { r.Tab.Viewer.Script("(function(){clearInterval(window.__cr);var d=document.getElementById('capri-race');if(d)d.innerHTML='<span style=\"color:#e84246\">TIME\\'S UP</span><br><span style=\"color:#92828c;font-size:13px\">Goal was: " + Esc(r.Goal.Replace('_', ' ')).Replace("'", "") + "</span>';setTimeout(function(){d.remove();},8000);})()"); } catch { }
				mod.Tell("Time's up! You didn't reach " + r.Goal.Replace('_', ' ') + " in 3 minutes, choom. Try again?");
			};
			up.Start();
		}

		void Finish(Race r)
		{
			if (race != r) return;
			StopLimit();
			race = null;
			r.Ended = DateTime.UtcNow;
			RaceClock(r, true);
			TimeSpan took = r.Ended - r.Started;
			string time = (int)took.TotalMinutes + "m " + took.Seconds + "s";
			Bump("wiki", 1);
			Bump("wiki" + Week(), 1);
			if (took.TotalSeconds < 120 && !r.Cheated) Bump("wikifast", 1);
			string known = r.Route == null ? "" : r.Clicks <= r.Route.Length - 1 ? " That's as short as the best route I checked!" : " The shortest route I checked was " + (r.Route.Length - 1) + " clicks.";
			if (r.Code == null) { mod.Tell("You made it to " + r.Goal.Replace('_', ' ') + " in " + time + " and " + r.Clicks + " clicks!" + known + " Not bad for a meatbag, choom."); return; }
			Bump("coop", 1);
			string card = r.Code + (r.Level != null ? " · " + LevelName(r.Level) : "") + " · " + r.From.Replace('_', ' ') + " → " + r.Goal.Replace('_', ' ') + " · " + time + " · " + r.Clicks + " clicks" + (r.Cheated ? " · used search" : "");
			int best, seconds = (int)took.TotalSeconds;
			bool record = !r.Cheated && (!int.TryParse(Kept("race-" + r.Code), out best) || seconds < best);
			if (record) Keep("race-" + r.Code, seconds.ToString());
			try { Clipboard.SetText(card); } catch { }
			mod.Tell("Finished in " + time + "!" + known + (r.Cheated ? " You used search though, choom, I saw that." : "") + (record ? " Your best on this code." : "") + " Your result card is copied, paste it in Discord.");
		}

		// ---- typing race: a paragraph from the page they were reading, typed against the clock ----

		void TypingRace()
		{
			// No text from their pages: the game picks one of its own paragraphs.
			ShowTyping();
		}

		void ShowTyping()
		{
			OpenTab(null, null, true); tab.Special = "addon"; tab.Title = "Typing Race"; tab.Html = Kept("game-typing").Replace("\"%TEXT%\"", "\"\"").Replace("%FROM%", "Capri").Replace("%BEST%", Stat("typingbest").ToString()); ShowReader(tab);
		}

		void Typed(int wpm, int accuracy)
		{
			int best = Stat("typingbest");
			if (accuracy >= 90) { Bump("typingbest", wpm, true); }
			mod.Tell(wpm + " words per minute at " + accuracy + "% accuracy." + (accuracy < 90 ? " Under 90% accuracy doesn't count for your best, choom." : wpm > best ? " New personal best!" : " Your best is " + best + "."));
		}

		// ---- Leaderboards (all time) ----
		// They pick a name, and "Send my stats" sends only that name and their six best-ever numbers to Capri Browser's leaderboard server, which
		// refuses rude, taken or unbelievable ones.
		const string BoardData = WorkerUrl + "board.txt";

		// Rude bits caught anywhere in a name, and words only caught on their own.
		static readonly string[] RudeBits = { "fuck", "fuk", "fck", "fcuk", "fack", "fcker", "phuck", "shit", "cunt", "bitch", "biatch", "nigg", "niga", "nigr", "negro", "fag", "retard", "spastic", "whore", "slut", "skank", "pussy", "penis", "vagin", "porn", "nazi", "hitler", "heil", "kkk", "twat", "wank", "jizz", "killyourself", "killurself", "suicide", "tranny", "molest", "pedo", "paedo", "bastard", "asshole", "arsehole", "dumbass", "jackass", "asshat", "asswipe", "dildo", "vibrator", "buttplug", "boob", "titty", "titties", "tits", "nipple", "horny", "nude", "naked", "cock", "dick", "sex", "raper", "sexx", "sexual", "sexting", "cumshot", "cumming", "semen", "sperm", "orgasm", "orgy", "blowjob", "handjob", "rimjob", "boner", "erection", "hentai", "milf", "xxx", "nsfw", "onlyfans", "rapist", "raping", "raped", "chink", "kike", "dyke", "piss", "prick", "bollock", "bellend", "knob", "cocaine", "heroin", "admin", "moderat", "official" };
		static readonly string[] RudeWords = { "sex", "rape", "cum", "anal", "anus", "ass", "arse", "hoe", "thot", "shag", "spic", "coon", "paki", "gook", "isis", "kys", "kms", "meth", "capri", "tobtas", "lachy", "staff", "system", "null", "everyone", "anthropic" };
		// Real words that only look rude, taken out before the check (Sussex, Scunthorpe, peacock, torpedo...).
		static readonly string[] RudeAllowed = { "essex", "sussex", "wessex", "middlesex", "scunthorpe", "penistone", "peacock", "hancock", "woodcock", "babcock", "hitchcock", "cockatoo", "cockatiel", "cockpit", "cockney", "cockroach", "shuttlecock", "dickens", "dickinson", "dickson", "torpedo", "speedo", "pedometer", "knobbly", "therapist", "scraper", "scrapper", "draper", "grapes" };

		// How names are compared: "Cool_Guy" and "cool guy" are the same name.
		internal static string NameKey(string name) { return Regex.Replace((name ?? "").ToLowerInvariant(), "[ _-]", ""); }

		// Why a name can't be used, or null when it's fine.
		internal static string BadName(string name)
		{
			if (name == null || !Regex.IsMatch(name, @"^[A-Za-z0-9][A-Za-z0-9 _-]{1,14}[A-Za-z0-9]$") || name.Contains("  ")) return "Names are 3 to 16 letters or numbers (spaces, - and _ in the middle are fine), choom.";
			string spaced = Regex.Replace(Regex.Replace(name, "[_-]", " "), "([a-z])([A-Z])", "$1 $2").ToLowerInvariant(), plain = "";
			foreach (char ch in spaced)
			{
				int k = "01345789@$!|".IndexOf(ch);
				char c = k >= 0 ? "oieastbgasii"[k] : ch;
				if ((c >= 'a' && c <= 'z') || c == ' ') plain += c;
			}
			string squashed = Regex.Replace(plain.Replace(" ", ""), @"(.)\1+", "$1"), joined = plain.Replace(" ", "");
			string cleanJoined = joined, cleanSquashed = squashed;
			foreach (string ok in RudeAllowed)
			{
				string okSquashed = Regex.Replace(ok, @"(.)+", "$1");
				cleanJoined = cleanJoined.Replace(ok, "").Replace(okSquashed, "");
				cleanSquashed = cleanSquashed.Replace(ok, "").Replace(okSquashed, "");
			}
			foreach (string bit in RudeBits) if (cleanSquashed.Contains(bit) || cleanJoined.Contains(bit)) return "That name won't fly on the board, choom. Pick another?";
			var words = new List<string>(plain.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries)) { joined, squashed };
			foreach (string w in words) foreach (string bad in RudeWords) if (w == bad || Regex.Replace(w, @"(.)\1+", "$1") == bad || w == bad + "s") return "That name won't fly on the board, choom. Pick another?";
			return null;
		}

		// Their numbers for the board, all time: hours watched, videos finished, sites visited, best survival, Guess the Site, typing.
		static readonly string[] BoardKeys = { "hours", "videos", "sites", "survival", "guess", "wpm" }, BoardNames = { "hours watched", "videos", "sites", "survival", "Guess the Site", "WPM" };
		// This week's six numbers to send, with 0 for any they keep off the boards.
		string[] BoardSend() { string[] n = BoardWeek(); for (int i = 0; i < n.Length; i++) if (Kept("lboff-" + BoardKeys[i]) == "1") n[i] = "0"; return n; }
		string[] BoardWeek()
		{
			return new[] { (Stat(RoundKey("watchall")) / 360 / 10.0).ToString("0.0", CultureInfo.InvariantCulture), Stat(RoundKey("videos")).ToString(), Stat(RoundKey("pages")).ToString(),
				Stat(RoundKey("survival")).ToString(), Stat(RoundKey("guessbest")).ToString(), Stat(RoundKey("typingbest")).ToString() };
		}

		// This copy's random leaderboard key, made once and kept here. The server only keeps its hash; it's what lets only you use your name.
		string BoardKey()
		{
			string key = Kept("lbkey");
			if (Regex.IsMatch(key, "^[a-f0-9]{32}$")) return key;
			byte[] b = new byte[16];
			using (RandomNumberGenerator r = RandomNumberGenerator.Create()) r.GetBytes(b);
			key = BitConverter.ToString(b).Replace("-", "").ToLowerInvariant();
			Keep("lbkey", key);
			return key;
		}

		// Capri's brain looks at a new name too, for rude words hidden by odd spellings, mixed letters or meanings the lists can't know. Only a
		// clear yes lets it through. Run off the UI thread.
		string NameJudge(string name)
		{
			string said = null;
			var done = new ManualResetEvent(false);
			CapriInternalBrowser.Host.Brain.Ask("You check player names for a public game leaderboard that children can see. A name is NOT OK if it is or hides anything rude, sexual, hateful, a slur, about drugs, violence or self-harm, bullying, or pretends to be staff, even when it is misspelt, uses numbers for letters, has letters mixed up or swapped, is backwards, or sounds like a bad word. Ordinary names, nicknames, words and gamer tags are OK. Reply with only the word OK or the word NO.",
				"The name is: " + name, a => { said = a; done.Set(); });
			done.WaitOne(30000);
			string verdict = Regex.Replace((said ?? "").Trim().ToUpperInvariant(), "[^A-Z]", "");
			if (verdict == "OK") return null;
			return said == null || verdict != "NO" ? "I couldn't check that name just now, choom. Try again in a bit?" : "That name won't fly on the board, choom. Pick another?";
		}

		// Checks their name and claims it on the leaderboards. Run off the UI thread.
		string SaveBoardName(string name)
		{
			name = (name ?? "").Trim();
			string why = BadName(name) ?? NameJudge(name);
			if (why != null) return why;
			string[] got = ToWorker("name", "{\"name\":" + Quote(name) + ",\"key\":" + Quote(BoardKey()) + "}");
			if (got != null && got[0] != "ok") return got[1].Length > 0 ? got[1] : "That name didn't work, choom. Try another?";
			Keep("lbname", name);
			return got == null ? "Saved " + name + ". I couldn't reach the leaderboards just now, so it'll be checked when you send your stats."
				: "You're " + name + " on the leaderboards now, choom. Press Send my stats to put your numbers up.";
		}

		// With a leaderboard name (and only then), this week's stats send themselves every 12 hours and as soon as a new round starts (checked after
		// games, when the Leaderboards tab opens and every half hour). The same name and six numbers as Send my stats, and quiet.
		DateTime autoSent;
		int autoTicks;
		void AutoSend(bool thenLoad)
		{
			long last;
			bool due = !long.TryParse(Kept("lbsent"), out last) || DateTime.UtcNow - new DateTime(last, DateTimeKind.Utc) > TimeSpan.FromHours(12) || Kept("lbsent-round") != RoundNow().ToString();
			if (Kept("lbname").Length == 0 || !due || DateTime.UtcNow - autoSent < TimeSpan.FromMinutes(2.5)) { if (thenLoad) LoadBoards(); return; }
			autoSent = DateTime.UtcNow;
			Behind(delegate
			{
				SendWeek();
				Post(delegate { bool shown = thenLoad; foreach (Tab open in tabs) if (open.Special == "boards") shown = true; if (shown) LoadBoards(); });
			});
		}

		// A new best with no leaderboard name yet: where it would place this week, and an invite.
		void Invite(string key, int score)
		{
			long until;
			if (Kept("lbname").Length > 0 || !Notice("lbinvite") || Kept("lbinvite-round") == RoundNow().ToString() || (long.TryParse(Kept("lbinvite-no"), out until) && DateTime.UtcNow.Ticks < until)) return;
			string board = key == "typingbest" ? "wpm" : key == "guessbest" ? "guess" : "survival";
			int place = 1;
			foreach (Match m in Regex.Matches(Kept("lb-board").Replace("\r", ""), "^row\t" + board + "\t[^\t\n]*\t([0-9.]+)$", RegexOptions.Multiline))
			{
				double v;
				if (double.TryParse(m.Groups[1].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out v) && v > score) place++;
			}
			Keep("lbinvite-round", RoundNow().ToString());
			mod.AskThen("That score would be number " + place + " on this week's leaderboard, choom! Want to add a name and compete?",
				delegate { Post(delegate { ShowGames(); Later(delegate { if (tab != null && tab.Special == "games") tab.Viewer.Script("(function(){var b=document.getElementById('lb');if(b){b.scrollIntoView({block:'center'});b.focus();}})()"); }); }); return "Type a name in the box, choom, then press Add."; },
				delegate { Keep("lbinvite-no", DateTime.UtcNow.AddDays(30).Ticks.ToString()); });
		}

		// Sends their name and six numbers, nothing else. Run off the UI thread.
		string SendWeek()
		{
			// Which round the boards are on first, so a reset or a new week starts their numbers from 0 before they're sent.
			try { using (WebClient web = new WebClient()) { web.Encoding = Encoding.UTF8; web.CachePolicy = new RequestCachePolicy(RequestCacheLevel.NoCacheNoStore); LearnRound(web.DownloadString(BoardData)); } } catch { }
			int round = RoundNow();
			string[] n = BoardSend();
			string[] got = ToWorker("stats", "{\"name\":" + Quote(Kept("lbname")) + ",\"key\":" + Quote(BoardKey()) + ",\"hours\":" + n[0] + ",\"videos\":" + n[1]
				+ ",\"sites\":" + n[2] + ",\"survival\":" + n[3] + ",\"guess\":" + n[4] + ",\"wpm\":" + n[5] + ",\"round\":" + round + "}");
			if (got == null) return "I couldn't reach the leaderboards just now, choom. Try again in a bit.";
			if (got[0] == "ok") Post(delegate { Keep("lbsent", DateTime.UtcNow.Ticks.ToString()); Keep("lbsent-round", round.ToString()); });
			return got[1].Length > 0 ? got[1] : got[0] == "ok" ? "You're on the boards, choom." : "That didn't go through, choom. Try again in a bit.";
		}

		string BoardPicks()
		{
			var b = new StringBuilder();
			for (int i = 0; i < BoardKeys.Length; i++)
			{
				bool off = Kept("lboff-" + BoardKeys[i]) == "1";
				b.Append("<a class=\"bt").Append(off ? "" : " go").Append("\" style=\"padding:3px 9px;margin:2px\" title=\"").Append(off ? "Kept off the boards. Click to send it again." : "Sent to the boards. Click to keep it off.").Append("\" href=\"").Append(Own).Append("play?g=lboff&k=").Append(BoardKeys[i]).Append("\">")
					.Append(off ? "&#10007; " : "&#10003; ").Append(BoardNames[i]).Append("</a>");
			}
			return b.ToString();
		}

		string BoardBox()
		{
			string name = Kept("lbname");
			string[] n = BoardWeek();
			return "<h1>LEADERBOARDS <span>&gt;</span></h1><div class=\"row\"><div class=\"b\" style=\"flex-basis:100%\"><div class=\"s\">This week's top 100s: hours watched, videos finished, sites visited, survival, Guess the Site and typing speed. Everyone starts again from 0 every Monday at 00:00 UTC. Only your leaderboard name and those numbers are shown.</div>"
				+ (name.Length > 0 ? "<div class=\"n\" style=\"margin:12px 0 4px;letter-spacing:3px\">" + Esc(name) + "</div>" : "")
				+ "<div class=\"cr\"><input id=\"lb\" maxlength=\"16\" placeholder=\"Leaderboard name\" value=\"" + Esc(name) + "\"><a class=\"bt\" href=\"#\" onclick=\"location.href='" + Own + "play?g=lbname&n='+encodeURIComponent(document.getElementById('lb').value);return false\">"
				+ (name.Length > 0 ? "Change name" : "Add leaderboard name to compete") + "</a>" + (name.Length > 0 ? "<a class=\"bt go\" href=\"" + Own + "play?g=lbsend\">Send my stats</a>" : "") + "<a class=\"bt\" href=\"" + Own + "play?g=lbopen\">Open leaderboards</a><a class=\"bt\" href=\"" + Own + "play?g=lballtime\">All-time stats</a></div>"
				+ "<div class=\"s\" style=\"margin-top:10px\">Your stats this week: " + n[0] + " h watched &middot; " + n[1] + " videos &middot; " + n[2] + " sites &middot; survival " + n[3] + " &middot; Guess the Site " + n[4] + " &middot; " + n[5] + " WPM</div>"
				+ "<div class=\"s\" style=\"margin-top:6px\">On the boards: " + BoardPicks() + "</div>"
				+ "<div class=\"s\">With a leaderboard name, your week's stats send by themselves, or press Send my stats. Only your leaderboard name and those six numbers are sent. No account needed. Your all-time stats never reset and are never sent.</div></div>";
		}

		// ---- The Leaderboards tab ----
		// The six boards, drawn here from leaderboard/board.txt, which the check on GitHub rewrites with every send and every Monday. It changes all
		// the time so it can't be pinned: every line is checked, each name must pass BadName and each number must be a number, and all of it is
		// escaped.
		static readonly string[,] Boards = { { "hours", "MOST HOURS WATCHED", "h" }, { "videos", "MOST VIDEOS FINISHED", "" }, { "sites", "MOST SITES VISITED", "" }, { "survival", "BEST SURVIVAL RUN", " words" }, { "guess", "BEST GUESS THE SITE RUN", "" }, { "wpm", "BEST TYPING SPEED", " WPM" } };
		const string BoardsBasic = ".g .bds{display:flex;flex-wrap:wrap;gap:12px}.g .bd{flex:1 1 270px;border:1px solid %C6%;padding:12px}.g .rw{display:flex;gap:10px;padding:4px 0}.g .nm{flex:1}.g .vl,.g .r1 .nm{color:%C5%}.g .wk,.g .none{color:%C3%}.g .me{outline:1px solid %C4%}";
		bool boardBusy, boardFailed;

		void ShowBoards()
		{
			Tab have = null;
			foreach (Tab open in tabs) if (open.Special == "boards") have = open;
			if (have != null) Select(have); else { OpenTab(null, null, true); tab.Special = "boards"; have = tab; }
			ShowReader(have);
			AutoSend(true);
		}

		// Gets the newest boards, off the UI thread, then redraws any Leaderboards tab.
		void LoadBoards()
		{
			if (boardBusy) return;
			boardBusy = true;
			foreach (Tab open in tabs) if (open.Special == "boards") ShowReader(open);
			string lbName = Kept("lbname"), lbKey = Kept("lbkey");
			Behind(delegate
			{
				string got = null, rank = null;
				try { using (WebClient web = new WebClient()) { web.Encoding = Encoding.UTF8; web.CachePolicy = new RequestCachePolicy(RequestCacheLevel.NoCacheNoStore); got = web.DownloadString(BoardData); } } catch { }
				if (got != null) LearnRound(got);
				// Their own place on each board: only with a name, and only their own (the worker knows them by their key).
				if (got != null && lbName.Length > 0 && Regex.IsMatch(lbKey, "^[a-f0-9]{32}$"))
				{
					string[] r = ToWorker("rank", "{\"key\":" + Quote(lbKey) + "}");
					if (r != null && r[0] == "ok") rank = r[1];
				}
				Post(delegate
				{
					boardBusy = false;
					if (rank != null) Keep("lb-rank", rank);
					boardFailed = got == null || got.Length > 200000 || !got.Begins("# Capri Browser leaderboards");
					if (!boardFailed) { Keep("lb-board", got); Keep("lb-got", DateTime.Now.ToString("ddd d MMM, HH:mm", CultureInfo.InvariantCulture)); }
					foreach (Tab open in tabs) if (open.Special == "boards") ShowReader(open);
				});
			});
		}

		string BoardsPage()
		{
			Look look = mod.look;
			string[] c = look.Colors;
			// Saved page styles from before the Leaderboards tab: fetch the new ones quietly.
			if (PagesCss.Length > 100 && PagesCss.Replace("\r", "").Split(new[] { "\n%%\n" }, StringSplitOptions.None).Length < 4) GetLook();
			string me = NameKey(Kept("lbname")), week = "", updated = "", lastWeek = "";
			var rows = new Dictionary<string, List<string[]>>();
			var champs = new Dictionary<string, string[]>();
			for (int i = 0; i < Boards.GetLength(0); i++) rows[Boards[i, 0]] = new List<string[]>();
			foreach (string line in Kept("lb-board").Replace("\r", "").Split('\n'))
			{
				string[] p = line.Split('\t');
				if (p.Length == 2 && p[0] == "week" && Regex.IsMatch(p[1], @"^\d{4}w\d{1,2}$")) week = p[1];
				else if (p.Length == 2 && p[0] == "lastweek" && Regex.IsMatch(p[1], @"^\d{4}w\d{1,2}$")) lastWeek = p[1];
				else if (p.Length == 2 && p[0] == "updated" && Regex.IsMatch(p[1], @"^\d{4}-\d\d-\d\dT\d\d:\d\dZ$")) updated = p[1];
				else if (p.Length == 4 && (p[0] == "row" || p[0] == "last") && rows.ContainsKey(p[1]) && BadName(p[2]) == null && Regex.IsMatch(p[3], @"^\d{1,8}(\.\d)?$"))
				{
					if (p[0] == "last") champs[p[1]] = new[] { p[2], p[3] };
					else if (rows[p[1]].Count < 10) rows[p[1]].Add(new[] { p[2], p[3] });
				}
			}
			var places = new Dictionary<string, string[]>();
			int players = 0;
			if (me.Length > 0)
				foreach (string part in Kept("lb-rank").Split(';'))
				{
					Match pm = Regex.Match(part, @"^(\w{1,12})=(\d{1,7})(?::(\d{1,8}(?:\.\d)?))?$");
					if (!pm.Success) continue;
					if (pm.Groups[1].Value == "total") int.TryParse(pm.Groups[2].Value, out players);
					else if (rows.ContainsKey(pm.Groups[1].Value) && pm.Groups[3].Success) places[pm.Groups[1].Value] = new[] { pm.Groups[2].Value, pm.Groups[3].Value };
				}
			DateTime when;
			string changed = DateTime.TryParseExact(updated, "yyyy-MM-dd'T'HH:mm'Z'", CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal, out when) ? when.ToString("ddd d MMM, HH:mm", CultureInfo.InvariantCulture) : "";
			int left = ((int)DayOfWeek.Monday - (int)DateTime.UtcNow.DayOfWeek + 7) % 7;
			if (left == 0) left = 7;
			StringBuilder html = Start(look, Styled(2, ".g{max-width:900px;margin:0 auto}.g .b{display:inline-block;margin:4px;padding:12px;border:1px solid %C6%;color:%C2%}", c, null, null) + Styled(4, BoardsBasic, c, null, null) + ".g .lst{max-height:310px;overflow-y:auto;scrollbar-width:thin;padding-right:4px}");
			html.Replace("<head>", "<head><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none';style-src 'unsafe-inline';form-action 'none';base-uri 'none'\">", 0, 60);
			html.Append("<div class=\"g\"><div class=\"top\"><h1>LEADERBOARDS <span>&gt;</span></h1><div class=\"wk\">")
				.Append("STARTS AGAIN <b>MONDAY 00:00 UTC</b>, IN ").Append(left).Append(left == 1 ? " DAY" : " DAYS").Append("</div></div>")
				.Append("<div class=\"wk\">").Append(changed.Length > 0 ? "Last change " + changed : "").Append(changed.Length > 0 && Kept("lb-got").Length > 0 ? " &middot; " : "").Append(Kept("lb-got").Length > 0 ? "checked " + Esc(Kept("lb-got")) : "").Append("</div>");
			if (boardBusy && Kept("lb-board").Length == 0) html.Append("<div class=\"warn\">Getting the boards...</div>");
			else if (boardFailed) html.Append("<div class=\"warn\">").Append(Kept("lb-board").Length > 0 ? "Couldn't reach the leaderboards just now, so these are from the last check. Press Refresh to try again." : "Couldn't reach the leaderboards just now. Press Refresh to try again.").Append("</div>");

			// Where they are on each board, worked out while drawing the boards.
			var boards = new StringBuilder("<div class=\"bds\">");
			var placed = new List<string>();
			for (int i = 0; i < Boards.GetLength(0); i++)
			{
				List<string[]> list = rows[Boards[i, 0]];
				boards.Append("<div class=\"bd\"><h2>").Append(Boards[i, 1]).Append("<span>TOP 100</span></h2>");
				if (list.Count == 0) boards.Append("<div class=\"none\">Nobody yet. Be the first!</div>");
				else boards.Append("<div class=\"lst\">");
				bool onTop = false;
				for (int r = 0; r < list.Count; r++)
				{
					bool mine = me.Length > 0 && (NameKey(list[r][0]) == me || (places.ContainsKey(Boards[i, 0]) && places[Boards[i, 0]][0] == (r + 1).ToString()));
					if (mine) { placed.Add("#" + (r + 1) + " " + Boards[i, 1].ToLowerInvariant()); onTop = true; }
					boards.Append("<div class=\"rw").Append(r < 3 ? " r" + (r + 1) : "").Append(mine ? " me" : "").Append("\"><span class=\"rk\">").Append(r + 1).Append("</span><span class=\"nm\">").Append(Esc(list[r][0]))
						.Append("</span><span class=\"vl\">").Append(list[r][1]).Append(Boards[i, 2]).Append("</span></div>");
				}
				if (list.Count > 0) boards.Append("</div>");
				string[] at;
				if (!onTop && places.TryGetValue(Boards[i, 0], out at))
				{
					placed.Add("#" + at[0] + " " + Boards[i, 1].ToLowerInvariant());
					boards.Append("<div class=\"none\">&middot; &middot; &middot;</div><div class=\"rw me\"><span class=\"rk\">").Append(at[0]).Append("</span><span class=\"nm\">").Append(Esc(Kept("lbname")))
						.Append("</span><span class=\"vl\">").Append(at[1]).Append(Boards[i, 2]).Append("</span></div>");
				}
				boards.Append("</div>");
			}
			boards.Append("</div>");

			string buttons = "<a class=\"bt\" href=\"" + Own + "play?g=lbrefresh\">" + (boardBusy ? "Refreshing..." : "Refresh") + "</a><a class=\"bt\" href=\"" + Own + "play?g=lballtime\">All-time stats</a>";
			if (me.Length > 0)
				html.Append("<div class=\"you\"><div><div class=\"s\">YOU'RE ON THE BOARDS AS</div><div class=\"n\">").Append(Esc(Kept("lbname"))).Append("</div></div><div class=\"s\">")
					.Append(placed.Count > 0 ? string.Join(" &middot; ", placed.ToArray()) + (players > 0 ? " &middot; out of " + players + " player" + (players == 1 ? "" : "s") : "") : "Not on the boards yet. Send your stats to put your numbers up.").Append("</div><div class=\"cr\"><a class=\"bt go\" href=\"").Append(Own).Append("play?g=lbsend\">Send my stats</a>").Append(buttons).Append("</div></div>");
			else
				html.Append("<div class=\"you\"><div class=\"s\">Add a leaderboard name on the Games page to compete. Only your leaderboard name and your numbers show here.</div><div class=\"cr\"><a class=\"bt go\" href=\"").Append(Own).Append("play?g=lbgames\">Go to Games</a>").Append(buttons).Append("</div></div>");
			html.Append("<h1>THIS WEEK'S TOP 100s <span>&gt;</span></h1>").Append(boards);
			if (champs.Count > 0 && false)
			{
				html.Append("<h1>LAST WEEK'S CHAMPIONS").Append(lastWeek.Length > 0 ? " (WEEK " + lastWeek.Substring(5) + ")" : "").Append(" <span>&gt;</span></h1><div class=\"chs\">");
				for (int i = 0; i < Boards.GetLength(0); i++)
				{
					string[] w;
					if (champs.TryGetValue(Boards[i, 0], out w)) html.Append("<div class=\"ch\"><b>").Append(Boards[i, 1]).Append("</b>&#9733; ").Append(Esc(w[0])).Append(" <span>").Append(w[1]).Append(Boards[i, 2]).Append("</span></div>");
				}
				html.Append("</div>");
			}
			return html.Append("</div></body></html>").ToString();
		}

		void Board(string which, string all)
		{
			if (which == "lbopen") { ShowBoards(); return; }
			if (which == "lbrefresh") { LoadBoards(); return; }
			if (which == "lbgames") { ShowGames(); return; }
			if (which == "lballtime") { ShowAllTime(); return; }
			if (which == "lbfeat") { OpenFeatured(all); return; }
			if (which == "lboff")
			{
				string k = Regex.Match(all, "[&]k=([a-z]+)$").Groups[1].Value;
				if (Array.IndexOf(BoardKeys, k) < 0) return;
				bool off = Kept("lboff-" + k) != "1";
				Keep("lboff-" + k, off ? "1" : "");
				mod.Tell(off ? "Okay, your " + BoardNames[Array.IndexOf(BoardKeys, k)] + " stays off the boards from your next send, choom." : "Your " + BoardNames[Array.IndexOf(BoardKeys, k)] + " goes on the boards again, choom.");
				RefreshGames();
				return;
			}
			if (which == "lbsend")
			{
				if (Kept("lbname").Length == 0) { mod.Tell("Pick a leaderboard name first, choom."); return; }
				if (DateTime.UtcNow - autoSent < TimeSpan.FromMinutes(2)) { mod.Tell("Your stats are already up to date on the boards, choom."); LoadBoards(); return; }
				autoSent = DateTime.UtcNow;
				Behind(delegate { string said = SendWeek(); Post(delegate { mod.Tell(said); LoadBoards(); }); });
				return;
			}
			string name = "";
			try { name = Uri.UnescapeDataString(Regex.Match(all, "[&]n=([^&]*)").Groups[1].Value.Replace('+', ' ')); } catch { }
			Behind(delegate
			{
				string said = SaveBoardName(name);
				Post(delegate { foreach (Tab open in tabs) if (open.Special == "games" || open.Special == "boards") ShowReader(open); mod.Tell(said); });
			});
		}

		static string Took(int seconds) { return seconds / 3600 + "h " + seconds / 60 % 60 + "m"; }

		string GamesPage()
		{
			Look look = mod.look;
			string[] c = look.Colors;
			StringBuilder html = Start(look, Styled(2, ".g{max-width:900px;margin:0 auto}.g .b{display:inline-block;margin:4px;padding:12px;border:1px solid %C6%;color:%C2%}", c, null, null));
			html.Append("<div class=\"g\">").Append(FeaturedBox()).Append("<h1>GAMES <span>&gt;</span></h1><div class=\"row\">");
			List<string[]> list = Catalogue();
			foreach (string[] g in list)
			{
				bool have = Kept("game-" + g[0]).Length > 0;
				string go = !have ? "start&id=" + g[0] : g[3] == "page" && g[0] != "typing" ? "addon&id=" + g[0] : g[0];
				html.Append("<a class=\"b\" href=\"").Append(Own).Append("play?g=").Append(go).Append("\"><b>").Append(Esc(g[1])).Append("</b><div class=\"s\">").Append(Esc(g[2])).Append("</div></a>");
			}
			if (list.Count == 0) html.Append("<a class=\"b\" href=\"").Append(Own).Append("play?g=more\"><b>Getting the games...</b><div class=\"s\">One sec, choom. Or press here to get them now.</div></a>");
			html.Append("</div><h1>CO-OP WIKI RACE <span>&gt;</span></h1><div class=\"row\"><div class=\"b\" style=\"flex-basis:100%\"><div class=\"s\">Race a friend to the same Wikipedia page. One of you makes a code and sends it, you both press Start, and you compare result cards in Discord.</div>")
				.Append("<div class=\"s\" style=\"margin-top:6px\">Level ").Append(LevelName(RaceLevel)).Append(": the goal is ").Append(LevelClicks(RaceLevel)).Append(". Easy is 2 clicks and Hard 3, each with a route that was checked on Wikipedia. Challenging starts on a random page, so it can be any distance. The level is for solo races too.</div>");
			if (lobby != null) html.Append("<div class=\"n\" style=\"margin:12px 0 4px;letter-spacing:3px\">").Append(lobby).Append(" <span style=\"font-size:.5em;letter-spacing:2px\">").Append(LevelName(CodeLevel(lobby)).ToUpperInvariant()).Append("</span></div>");
			html.Append("<div class=\"cr\"><a class=\"bt\" href=\"").Append(Own).Append("play?g=coop\">New code</a><input id=\"rc\" placeholder=\"CAPRI-XXXX\" maxlength=\"10\"><a class=\"bt\" href=\"#\" onclick=\"location.href='").Append(Own).Append("play?g=join&c='+encodeURIComponent(document.getElementById('rc').value);return false\">Join</a>")
				.Append(lobby != null ? "<a class=\"bt go\" href=\"" + Own + "play?g=go\">Start 3, 2, 1</a>" : "").Append(lobby != null || race != null ? "<a class=\"bt\" href=\"" + Own + "play?g=cancel\">Cancel race</a>" : "").Append("<a class=\"bt go\" href=\"" + Own + "play?g=level\">Level: " + LevelName(RaceLevel) + "</a>").Append("<a class=\"bt" + (Flag("timed", false) ? " go" : "") + "\" href=\"" + Own + "play?g=timed\">3-minute limit: " + (Flag("timed", false) ? "ON" : "OFF") + "</a>").Append("</div></div>");
			html.Append("</div>").Append(BoardBox());
			html.Append("</div><h1>THIS WEEK <span>&gt;</span></h1><div class=\"row\">");
			string[,] stats = WeekStats();
			for (int i = 0; i < stats.GetLength(0); i++) html.Append("<div class=\"b\"><div class=\"n\" id=\"wk").Append(i).Append("\">").Append(stats[i, 0]).Append("</div><div class=\"s\">").Append(stats[i, 1]).Append("</div></div>");
			html.Append("</div><div class=\"cr\"><a class=\"bt\" href=\"").Append(Own).Append("play?g=lballtime\">All-time stats</a></div>");
			html.Append("<h1>ACHIEVEMENTS <span>&gt;</span></h1><div class=\"row\">");
			for (int i = 0; i < Badges.GetLength(0); i++)
			{
				int have = Stat(Badges[i, 0]), need = int.Parse(Badges[i, 1]);
				html.Append("<div class=\"b ").Append(have >= need ? "on" : "off").Append("\"><b>").Append(have >= need ? "&#9733; " : "&#9734; ").Append(Badges[i, 2]).Append("</b><div class=\"s\">").Append(Badges[i, 3])
					.Append(have >= need || need == 1 ? "" : " (" + Math.Min(have, need) + "/" + need + ")").Append("</div></div>");
			}
			html.Append("</div>");
			return html.Append("</div></body></html>").ToString();
		}

		string News()
		{
			string[] parts = Kept("whats-new").Replace("\r", "").Trim().Split(new[] { "\n\n" }, 2, StringSplitOptions.None);
			if (parts[0].Length == 0) return "";
			string[] lines = parts[0].Split('\n');
			var html = new StringBuilder("<h3 class='sub'>WHAT'S NEW: " + Esc(lines[0].ToUpperInvariant()) + "</h3>");
			for (int n = 1; n < lines.Length; n++)
			{
				string l = lines[n].Trim().TrimStart('\u2022').Trim();
				int cut = l.IndexOf(": ", Exact);
				html.Append("<p class='nl'>").Append(cut > 0 && cut < 85 ? "<b>" + Esc(l.Substring(0, cut)) + "</b>" + Esc(l.Substring(cut + 2)) : Esc(l)).Append("</p>");
			}
			return html.Append(parts.Length < 2 ? "" : "<details><summary class='hint' style='cursor:pointer'>Older versions</summary><div class='pre'>" + Esc(Clip(parts[1], 9000)) + "</div></details>").ToString();
		}

		// ---- the settings page: one clean web page in a tab of its own (the old panel is only for PCs without Edge's engine) ----

		int settingsY;

		internal void ShowJobs()
		{
			foreach (Tab open in tabs) if (open.Special == "jobs") { Select(open); ShowReader(open); return; }
			jobNote = null;
			OpenTab(null, null, true);
			tab.Special = "jobs";
			ShowReader(tab);
		}

		string jobNote;
		// The job Capri learn just rewrote, shown in its open form till it's saved.
		int draftAt = -1;
		Job draft;
		string TestNote(Look look, string trigger)
		{
			List<string[]> log;
			lock (mod.jobTests) if (!mod.jobTests.TryGetValue(trigger, out log)) return "";
			var html = new StringBuilder("<p><b>LAST TEST</b></p><ul style='list-style:none;padding:0;margin:0 0 10px'>");
			foreach (string[] r in log)
				html.Append("<li style='padding:3px 0'><b style='color:").Append(look.Colors[r[1] == "worked" ? 4 : r[1] == "failed" ? 5 : 3]).Append("'>").Append(r[1] == "worked" ? "\u2713" : r[1] == "failed" ? "\u2715" : "\u2013").Append(" ").Append(r[1].ToUpperInvariant()).Append("</b> ").Append(Esc(r[0])).Append(r[2].Length > 0 ? "<br><i>" + Esc(r[2]) + "</i>" : "").Append("</li>");
			return html.Append("</ul>").ToString();
		}

		string MissedNote(string trigger)
		{
			string missed;
			lock (mod.jobMissed) if (!mod.jobMissed.TryGetValue(trigger, out missed)) return "";
			return "<p class='warn'>Last time, Capri didn't know how to do " + Esc(missed) + ". Try wording it like the chips below.</p>";
		}

		internal static readonly string[] JobChips = { "open youtube.com", "open any website", "play", "pause", "full screen", "volume 40", "speed 1.5", "next video", "skip 2 minutes", "click Shuffle", "scroll down", "search lofi beats", "type hello in the search box", "press enter", "find me a lofi playlist", "new tab", "summarise", "check the comments", "read it out", "screenshot to notes", "remind me in 20 minutes to stretch", "wait 5", "wait 10 to 20 seconds", "listen for \"skip\" = next video", "listen for \"pause\" = pause job", "repeat 10 times", "repeat forever", "wait for it to load", "ask Ready?", "say Let's go, choom" };

		// Custom jobs: a header, how to word one (folded away once you've got some), each of theirs as a card, and a new one.
		string JobsPage()
		{
			Look look = mod.look;
			StringBuilder html = Start(look, SettingsCss());
			html.Replace("<head>", "<head><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none';script-src 'unsafe-inline';style-src 'unsafe-inline';form-action 'none';base-uri 'none'\">");
			List<Job> jobs = mod.Jobs();
			html.Append("<div class='st jx'><div class='main'><header class='jh'><h1 data-t='CUSTOM JOBS'>CUSTOM JOBS</h1><p>")
				.Append(Esc(JobGuides.ContainsKey(look.Lang) ? JobGuides[look.Lang] : "Make your own commands. Say the words in quotes and Capri does the steps."))
				.Append("</p><div class='jn'><b>").Append(jobs.Count).Append("</b> of 30 jobs").Append(jobs.Count < 30 ? "<button class='bt m' onclick='N()'>+ New job</button>" : "")
				.Append("<button class='bt' title=\"She works on the page itself and leaves your mouse, keyboard and other tabs to you. Full screen steps are skipped.\" onclick=\"location.href='").Append(Own).Append("jobs?a=quiet'\">Don't use my mouse: ").Append(Flag("jobquiet", false) ? "ON" : "OFF").Append("</button></div></header>");
			html.Append("<details class='card guide'").Append(jobs.Count == 0 ? " open" : "").Append("><summary><h2>HOW TO MAKE ONE <span>&gt;</span></h2></summary><ol>")
				.Append(Line("jobshow", "<li>Write what you'll say in quotes, then one step a line: <code>play</code>, <code>full screen</code>, <code>volume 40</code>.</li></ol>")).Append("</details>");
			if (!string.IsNullOrEmpty(jobNote)) html.Append("<div class='card'><p class='warn'>").Append(Esc(jobNote)).Append("</p></div>");
			html.Append("<div class='jg'>");
			for (int i = 0; i <= jobs.Count && i < 30; i++)
			{
				Job j = i < jobs.Count ? jobs[i] : new Job();
				bool fresh = i == jobs.Count, drafted = i == draftAt && draft != null;
				Job shown = drafted ? draft : j;
				html.Append("<div class='card jb").Append(fresh ? " nw" : drafted ? " ed" : "").Append("' id='j").Append(i).Append("' style='--d:").Append(Math.Min(i, 10) * 70).Append("ms'>");
				if (fresh) html.Append("<h2>NEW JOB <span>+</span></h2>");
				else
				{
					html.Append("<div class='jv'><div class='jt'>");
					foreach (string name in j.Trigger.Split('/', '|')) if (name.Trim().Length > 0) html.Append("<span class='nm'>\u201c").Append(Esc(name.Trim())).Append("\u201d</span>");
					html.Append("</div>");
					Uri link;
					if (Uri.TryCreate(j.Link, UriKind.Absolute, out link)) html.Append("<div class='jl'>\u2197 ").Append(Esc(link.Host + link.PathAndQuery.TrimEnd('/'))).Append("</div>");
					html.Append("<ol class='js'>");
					int k = 0;
					foreach (string step in j.Steps.Split('\n')) if (step.Trim().Length > 0) html.Append("<li style='--i:").Append(k++).Append("'>").Append(Esc(step)).Append("</li>");
					html.Append("</ol>").Append(TestNote(look, j.Trigger)).Append(MissedNote(j.Trigger)).Append("<div class='row'><button class='bt m go' onclick=\"J(").Append(i).Append(",'run')\">\u25B6 Run it</button><button class='bt' onclick=\"J(").Append(i).Append(",'test')\">Test</button><button class='bt' onclick='E(").Append(i)
						.Append(")'>Edit</button><button class='bt' onclick=\"J(").Append(i).Append(",'del')\">Delete</button></div></div>");
				}
				html.Append("<div class='jf'>").Append(drafted ? "<p class='ok'>\u2726 Capri learned your job and rewrote it so she can do it. Check it over, then Save.</p>" : "").Append("<label>When I say</label><input class='t q' maxlength='100' placeholder='\"movie night / film time\"' value='").Append(Esc(fresh && !drafted ? "" : "\"" + shown.Trigger + "\"")).Append("'>")
					.Append("<label>Open this link first (optional)</label><input class='l' maxlength='600' placeholder='https://www.youtube.com/playlist?list=...' value='").Append(Esc(shown.Link)).Append("'>")
					.Append("<label>Then do these steps, one a line, in your own words</label><textarea class='s' placeholder='open youtube.com&#10;put on something chill&#10;make it full screen and a bit quieter'>").Append(Esc(shown.Steps)).Append("</textarea><div class='pal'><i>Ideas to click, or write anything and she works out what you mean:</i>");
				foreach (string chip in JobChips) html.Append("<b onclick='C(this)'>").Append(Esc(chip)).Append("</b>");
				html.Append("</div><div class='row'><button class='bt m' onclick=\"J(").Append(i).Append(",'save')\">Save</button><button class='bt rw' onclick=\"J(").Append(i).Append(",'fix')\">\u2726 Capri learn</button>").Append(fresh ? "" : "<button class='bt' onclick='E(" + i + ")'>Cancel</button>").Append("</div></div></div>");
			}
			html.Append("</div></div></div><script>function J(i,a){var c=document.getElementById('j'+i),u='").Append(Own).Append("jobs?a='+a+'&i='+i;")
				.Append("if(a=='del'&&!confirm('Delete this job?'))return;if(a=='save'||a=='fix'){u+='&t='+encodeURIComponent(c.querySelector('.t').value)+'&l='+encodeURIComponent(c.querySelector('.l').value)+'&s='+encodeURIComponent(c.querySelector('.s').value);c.querySelector(a=='fix'?'.rw':'.jf .bt.m').classList.add(a=='fix'?'busy':'sv');if(a=='fix'){c.querySelector('.rw').textContent='Learning...';c.classList.add('run');}}")
				.Append("if(a=='run'||a=='test'){c.classList.add('run');setTimeout(function(){c.classList.remove('run')},4000);}location.href=u;}")
				.Append("function E(i){var c=document.getElementById('j'+i);c.classList.toggle('ed');if(c.classList.contains('ed'))c.querySelector('.t').focus();}")
				.Append("function N(){var c=document.querySelector('.nw');c.scrollIntoView({behavior:'smooth',block:'center'});c.classList.remove('fl');void c.offsetWidth;c.classList.add('fl');setTimeout(function(){c.querySelector('.t').focus({preventScroll:true})},450);}")
				.Append(draftAt >= 0 ? "document.getElementById('j" + draftAt + "').scrollIntoView({block:'center'});" : "")
				.Append("function C(b){var t=b.parentNode.parentNode.querySelector('textarea');t.value=(t.value.replace(/\\s+$/,'')+'\\n'+b.textContent).replace(/^\\n/,'');b.classList.remove('add');void b.offsetWidth;b.classList.add('add');}</script></body></html>");
			return html.ToString();
		}

		bool WebSettings()
		{
			foreach (Tab open in tabs) if (open.Special == "settings") { Select(open); return true; }
			settingsY = 0;
			settingsSite = null;
			settingsFind = "";
			OpenTab(null, null, true);
			tab.Special = "settings";
			ShowReader(tab);
			return true;
		}

		static string Esc(string text) { return WebUtility.HtmlEncode(text ?? ""); }

		// ---- Settings: hover a setting for a little box saying what it does ----
		// What a setting's hover box says, from the "tip" lines in data/lists.txt (none until it's downloaded).
		static string TipFor(string name, string about)
		{
			string tip;
			Dictionary<string, string> tips = Tips;
			if (tips.TryGetValue(name, out tip)) return tip;
			foreach (KeyValuePair<string, string> one in tips) { int n; if (one.Key.Length > 1 && one.Key[0] == 't' && int.TryParse(one.Key.Substring(1), out n) && n < 200 && T(n) == name) return one.Value; }
			for (int i = 0; i < ExtraList.GetLength(0); i++) if (ExtraList[i, 1] == name && tips.TryGetValue(ExtraList[i, 0], out tip)) return tip;
			return null;
		}

		static string TipBox(Look look)
		{
			return "<div id='tb' class='tb'><b></b><span></span></div><script>(function(){var tb=document.getElementById('tb'),t=0,iv=0,cur=null,mx=0,my=0;"
				+ "function hide(){clearTimeout(t);clearInterval(iv);tb.className='tb';cur=null;}"
				+ "function show(r){clearInterval(iv);iv=setInterval(function(){var e=document.elementFromPoint(mx,my),w=e&&e.closest?e.closest('.r[data-tip]'):null;if(w!==cur||(!on(w.querySelector('b'))&&!on(w.querySelector('i'))))hide();},80);tb.children[0].textContent=r.querySelector('b').textContent;tb.children[1].textContent=r.getAttribute('data-tip');tb.className='tb on';"
				+ "var w=tb.offsetWidth,h=tb.offsetHeight,L=Math.max(8,Math.min(mx+14,innerWidth-w-12)),T=my+20;if(T+h>innerHeight-8)T=my-h-14;"
				+ "tb.style.left=L+'px';tb.style.top=T+'px';}"
				+ "function on(el){if(!el)return false;var g=document.createRange();g.selectNodeContents(el);var q=g.getClientRects();for(var k=0;k<q.length;k++){var b=q[k];if(mx>=b.left-3&&mx<=b.right+3&&my>=b.top-2&&my<=b.bottom+2)return true;}return false;}"
				+ "document.addEventListener('mousemove',function(e){mx=e.clientX;my=e.clientY;if(e.screenX===sx&&e.screenY===sy)return;sx=e.screenX;sy=e.screenY;if(Date.now()<quiet)return;var r=e.target.closest?e.target.closest('.r[data-tip]'):null;if(r&&!on(r.querySelector('b'))&&!on(r.querySelector('i')))r=null;"
				+ "if(r===cur)return;hide();if(!r)return;cur=r;t=setTimeout(function(){show(r);},380);});"
				+ "var sx=-1,sy=-1,quiet=0;function stop(){hide();quiet=Date.now()+350;}document.addEventListener('scroll',stop,{capture:true,passive:true});document.addEventListener('wheel',stop,{capture:true,passive:true});document.addEventListener('mousedown',hide);document.documentElement.addEventListener('mouseleave',hide);})();</script>";
		}

		static string Row(string name, string about, string control)
		{
			string tip = TipFor(name, about);
			return "<div class='r'" + (tip == null ? "" : " data-tip=\"" + Esc(tip) + "\"") + "><div><b>" + Esc(name) + "</b>" + (string.IsNullOrEmpty(about) ? "" : "<i>" + Esc(about) + "</i>") + "</div><div class='c'>" + control + "</div></div>";
		}

		static string Switch(string key, bool on) { return "<span class='oo' data-k='" + key + "'><b class='" + (on ? "" : "a") + "' onclick='P(this,0)'>OFF</b><b class='" + (on ? "a" : "") + "' onclick='P(this,1)'>ON</b></span>"; }

		static string Btn(string key, string text, bool main) { return "<button class='" + (main ? "bt m" : "bt") + "' onclick=\"S('" + key + "',1)\">" + Esc(text) + "</button>"; }

		internal static readonly string[] AnimeHosts = { "crunchyroll.com", "youtube.com", "netflix.com", "primevideo.com", "custom" }, AnimeNames = { "Crunchyroll", "YouTube", "Netflix", "Prime Video", "Custom link..." };
		internal static readonly string[] VideoHosts = { "youtube.com", "tiktok.com", "twitch.tv", "netflix.com", "primevideo.com", "custom" }, VideoNames = { "YouTube", "TikTok", "Twitch", "Netflix", "Prime Video", "Custom link..." };

		string LinkRow(string key, string title)
		{
			if (Kept(key + "site") != "custom") return "";
			return Row(title, "Paste the site's link. For the best results, search for something on the site and paste that link with %s where the words go.",
				"<input type='text' spellcheck='false' style='width:260px' placeholder='https://site.com/search?q=%s' value='" + Esc(Kept(key + "link")) + "' onchange=\"S('" + key + "link',this.value)\">");
		}

		static string Pick(string key, IList<string> values, IList<string> names, string now, bool fonts)
		{
			var html = new StringBuilder("<select onchange=\"S('" + key + "',this.value)\">");
			for (int i = 0; i < values.Count; i++)
				html.Append("<option value='").Append(Esc(values[i])).Append("'").Append(values[i] == now ? " selected" : "").Append(fonts ? " style=\"font-family:'" + Esc(values[i]) + "'\"" : "").Append('>').Append(Esc(names[i])).Append("</option>");
			return html.Append("</select>").ToString();
		}

		string SettingsPage()
		{
			Look look = mod.look;
			string[] c = look.Colors;
			StringBuilder html = Start(look, SettingsCss());
			html.Replace("<head>", "<head><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none';script-src 'unsafe-inline';style-src 'unsafe-inline';img-src data: https://www.google.com https://*.gstatic.com;form-action 'none';base-uri 'none'\">");
			if (settingsSite != null) return SitePage(look, html);
			string[] ids, titles, icons;
			SettingsSections(out ids, out titles, out icons);
			html.Append(SettingsExtraCss(look)).Append("<div class='st'>").Append(SettingsNav(ids, titles, icons, -1)).Append("<div class='main'>");
			Func<string, string> open = id => { int i = Array.IndexOf(ids, id); return "<div class='card' id='" + ids[i] + "' style='animation-delay:" + (settingsY == 0 ? i * 40 : 0) + "ms'><h2>" + Esc(titles[i].ToUpperInvariant()) + " <span>&gt;</span></h2>"; };
			// Capri's on/off features, each in the part it belongs to.
			Func<string, string> extras = group =>
			{
				var rows = new StringBuilder();
				for (int i = 0; i < ExtraList.GetLength(0); i++)
					if (ExtraList[i, 3] == group) rows.Append(Row(ExtraList[i, 1], About(ExtraList[i, 0]), Switch("x-" + ExtraList[i, 0], Flag(ExtraList[i, 0], ExtraList[i, 2] == "1"))));
				return rows.ToString();
			};

			html.Append(open("look")).Append("<div class='th'>");
			foreach (string theme in Look.ThemeNames)
			{
				string[] k = new Look { Theme = theme }.Colors;
				string name = theme == "dark" ? T(9) : theme == "light" ? T(10) : theme == "warm" ? T(11) : Look.ExtraNames.ContainsKey(theme) ? Look.ExtraNames[theme] : char.ToUpperInvariant(theme[0]) + theme.Substring(1);
				html.Append("<a href='#' class='").Append(theme == look.Theme ? "on" : "").Append("' style='background:").Append(k[0]).Append(";color:").Append(k[2]).Append("' onclick=\"S('theme','").Append(theme).Append("');return false\">").Append(Esc(name))
					.Append("<i><u style='background:").Append(k[5]).Append("'></u><u style='background:").Append(k[4]).Append("'></u><u style='background:").Append(k[1]).Append("'></u></i></a>");
			}
			html.Append("</div>");
			var faces = new List<string>();
			using (var installed = new InstalledFontCollection()) foreach (FontFamily family in installed.Families) faces.Add(family.Name);
			html.Append(Row(T(12), null, Pick("font", faces, faces, look.Font, true)));
			html.Append(Row(T(13), null, "<input type='range' min='70' max='200' step='10' value='" + look.Size + "' oninput=\"this.nextSibling.textContent=this.value+'%'\" onchange=\"S('size',this.value)\"><span class='v'>" + look.Size + "%</span>"));
			html.Append(Row(T(33), null, Switch("sites", look.Sites))).Append(extras("look"));
			html.Append(Row("Wallpaper", wallText.Text, Btn("wallpaper", T(19), false) + Btn("nowall", T(20), false)));
			html.Append(Row(T(21), null, Switch("names", look.Names)))
				.Append(Row("Sidebar", About("sidebar"), Btn("sidesetup", "Set up", false))).Append("<h3 class='sub'>ANIMATIONS</h3>").Append(extras("motion")).Append("</div>");
			List<string> engineIds = new List<string>(), engineNames = new List<string>();
			for (int i = 0; i < Engines.GetLength(0); i++) { engineIds.Add(Engines[i, 0]); engineNames.Add(Engines[i, 1]); }
			html.Append(open("browser")).Append(Row(T(34), null, Pick("search", engineIds, engineNames, look.Search, false)));
			html.Append(Row(T(43), saveText.Text, Btn("folder", T(44), false)));
			List<string> langIds = new List<string>(), langNames = new List<string>();
			for (int i = 0; i < Languages.GetLength(0); i++) { langIds.Add(Languages[i, 0]); langNames.Add(Languages[i, 1]); }
			html.Append(langIds.Count > 1 ? Row(T(22), null, Pick("lang", langIds, langNames, look.Lang, false)) : Row("English", About("english"), Btn("getlangs", "Download languages", true))).Append("</div>");
			html.Append(open("tabs")).Append(extras("start")).Append(Row(T(46), null, Switch("restore", look.Restore))).Append(extras("tabs")).Append("</div>");
			int volume;
			if (!int.TryParse(Kept("soundvol"), out volume)) volume = 60;
			html.Append(open("mods")).Append(Row("Browser sounds", About("browsersounds"), Switch("x-sounds", Flag("sounds", false))))
				.Append(Row("Typing sounds", About("typingsounds"), Switch("x-typesounds", Flag("typesounds", false))))
				.Append(Row("Sound volume", null, "<input type='range' min='5' max='100' step='5' value='" + volume + "' oninput=\"this.nextSibling.textContent=this.value+'%'\" onchange=\"S('soundvol',this.value)\"><span class='v'>" + volume + "%</span>"))
				.Append("</div>");
			html.Append(open("capri")).Append(extras("capri"))
				.Append(Row("Put Capri's brain first", About("putcaprisbrainfirst"), Switch("x-brainfirst", Flag("brainfirst", true))))
				.Append("<h3 class='sub'>REACTIONS</h3>").Append(extras("react"))
