					HolocallThere ? Switch("x-holo", Flag("holo", false)) : "<span class='v'>Needs Holocall</span>"))
				.Append(HolocallThere ? Row("Hologram position", null, Pick("holospot", HoloSpots, new[] { "Top left", "Top middle", "Top right", "Middle left", "Middle right", "Bottom left", "Bottom middle", "Bottom right" }, Array.IndexOf(HoloSpots, Kept("holospot")) >= 0 ? Kept("holospot") : "br", false)) : "")
				.Append("</div>");
			html.Append(open("notify")).Append(Row("Capri notifications", About("caprinotifications"), Switch("x-notify", Flag("notify", true)))).Append(extras("notify")).Append("</div>");
			html.Append(open("research")).Append(Row("How hard she looks", About("howhardshelooks"), Pick("research", new[] { "deep", "quick", "off" }, new[] { "Deep", "Quick", "Off" }, ResearchMode, false)))
				.Append(Row("How much she writes", About("howmuchshewrites"), Pick("researchlen", new[] { "short", "mid", "long" }, new[] { "Short", "Mid", "Long" }, ResearchLength, false)))
				.Append("<p class='hint'>Big brains will be better: a bigger AI model in Capri Mainframe writes better research, most of all on Long.</p>")
				.Append(extras("research")).Append("<p class='hint'>Say “research …”, “what's the best …”, “best website for …”, “fact check …”, “compare my tabs”, “what have I got open?”, “work out my last note” (or “… my open notes”, or right-click a note for Work on this), "
				+ "“watch this page” or “fill in this form with …”, or highlight words and right-click for Let Capri research this. She works in the background, then asks if you want it brought up, put in your notes, or both, and if she should keep researching. Say “keep researching” any time to go deeper.</p></div>");
			html.Append(open("video")).Append(Row(edgeBroken ? "Not available" : "Ready", videoText.Text, edgeBroken ? Btn("video", "Try Edge's engine again", true) : ""))
				.Append(Row("Anime site", About("animesite"), Pick("animesite", AnimeHosts, AnimeNames, Kept("animesite").Length > 0 ? Kept("animesite") : AnimeHosts[0], false)))
				.Append(LinkRow("anime", "Custom anime site"))
				.Append(Row("Video site", About("videosite"), Pick("videosite", VideoHosts, VideoNames, Kept("videosite").Length > 0 ? Kept("videosite") : VideoHosts[0], false)))
				.Append(LinkRow("video", "Custom video site"))
				.Append(extras("video")).Append("</div>");
			html.Append(open("games")).Append(extras("games")).Append("</div>");
			bool personal = Kept("discordmode") == "personal";
			html.Append(open("discord")).Append(Row("Discord button", About("discordbutton"), Pick("discord", new[] { "capri", "personal" }, new[] { "Capri Discord server", "Your Discord" }, personal ? "personal" : "capri", false))).Append(extras("discord")).Append("</div>");
			List<string> levels = new List<string>(), levelNames = new List<string>();
			for (int i = 0; i < 4; i++) { levels.Add(i.ToString()); levelNames.Add(T(37 + i)); }
			html.Append(open("privacy")).Append(Row(T(36), "Strict may break some sites.", Pick("track", levels, levelNames, look.Track.ToString(), false)));
			html.Append(Row(T(41), About("t41"), Switch("ads", look.Ads))).Append(extras("privacy"));
			html.Append(Row(T(42), About("t42"), Btn("wipe", T(42), false)));
			html.Append("<h3 class='sub'>SITE SETTINGS</h3>").Append(Row("All sites", About("allsites"), "<button class='bt' onclick=\"S('site','*')\">Open</button>"));
			SortedDictionary<string, int> changed = PermSites();
			foreach (KeyValuePair<string, int> one in changed)
				html.Append("<a class='site' href='#' onclick=\"S('site','").Append(Esc(one.Key)).Append("');return false\"><i class='ic'></i>").Append(Esc(one.Key)).Append("<span>")
					.Append(one.Value == 1 ? "1 permission changed" : one.Value + " permissions changed").Append("</span><i class='ic ch'></i></a>");
			if (changed.Count == 0) html.Append("<p class='hint'>Sites you change show up here. Click the lock next to the address on any site to see its settings.</p>");
			html.Append("</div>");
			html.Append(open("data"));
			html.Append(CleanRows());
			html.Append("<h3 class='sub'>BACKUP</h3>").Append(Row("Backup", "Saves your notes, bookmarks, Speed Dial, jobs and settings to a file. Never passwords, history, tabs or sign-ins.", Btn("backup", "Back up", false) + Btn("unbackup", "Restore", false)));
			html.Append("</div>");
			html.Append(open("keys")).Append("<div class='pre'>").Append(Esc(KeysText)).Append("</div></div>");
			html.Append(open("can")).Append("<div class='pre'>").Append(Esc(CanText)).Append("</div></div>");
			string last = Kept("updated");
			html.Append(open("updates")).Append(Row("Capri Browser " + Version, "New versions of the browser come from Mods in Capri Mainframe. Your notes, bookmarks and settings stay.", Btn("news", "Open What's new", false)))
				.Append(Row("Games and add-ons", (last.Length == 0 ? "Not downloaded yet. " : AddonsBehind() ? "Newer ones are ready. " : "Up to date, last downloaded " + last + ". ") + "Gets every game, language, theme and ad blocker list for this version, and checks each file before using it.", Btn("update", "Update all", true))).Append(News()).Append("</div>");
			string jump = settingsJump ?? "";
			settingsJump = null;
			html.Append("<p id='fn' class='hint no'>No setting like that, choom. Try another word.</p></div></div><script>var fs=document.getElementById('fs'),O='").Append(Own).Append("';function S(k,v){location.href=O+'set?k='+k+'&v='+encodeURIComponent(v)+'&y='+Math.round(scrollY)+'&q='+encodeURIComponent(fs.value);}"
				+ "function P(b,v){var p=b.parentNode;p.children[0].className=v?'':'a';p.children[1].className=v?'a':'';S(p.getAttribute('data-k'),v);}function Go(e,id){e.preventDefault();document.getElementById(id).scrollIntoView({behavior:'smooth'});}"
				+ "var ns=document.querySelectorAll('.nav a');function Lit(){var best=0;document.querySelectorAll('.card').forEach(function(c,i){if(!c.classList.contains('no')&&c.getBoundingClientRect().top<140)best=i;});ns.forEach(function(a,i){a.classList.toggle('on',i==best);});}"
				// Every word has to be in the setting's name, what it says about it, its tip or its part; spaces and dashes don't matter.
				+ "function flat(t){return (t||'').toLowerCase().replace(/[\\s\\x21-\\x2f\\x3a-\\x40\\u2010-\\u201f]+/g,'');}function no(e,hide){e.classList.toggle('no',hide);return hide;}"
				+ "function Find(){document.body.classList.add('fx');var w=fs.value.split(/\\s+/).map(flat).filter(function(x){return x}).map(function(x){return x.length>3?x.replace(/s$/,''):x}),some=0;function has(t){return w.every(function(x){return t.indexOf(x)>=0})}"
				+ "document.querySelectorAll('.card').forEach(function(c,i){var title=flat(c.querySelector('h2').textContent),sub='',head=null,n=0;[].forEach.call(c.children,function(k){var t=k.classList;if(k.tagName=='H2')return;if(t.contains('sub')){head=k;sub=flat(k.textContent);no(k,w.length>0);return;}"
				+ "var mine=t.contains('r')?k.firstChild.textContent+(k.getAttribute('data-tip')||'')+[].map.call(k.querySelectorAll('button'),function(b){return b.textContent}).join(''):t.contains('th')?'themes colours colors dark light':t.contains('site')?k.textContent:'';"
				+ "if(!no(k,!has(title+sub+flat(mine)))){n++;if(head)no(head,false);}});no(c,!n);no(ns[i],!n);some+=n;});document.querySelectorAll('.gn').forEach(function(g){no(g,w.length>0)});no(document.getElementById('fn'),some>0);}"
				+ "fs.addEventListener('input',function(){scrollTo(0,0);Find();Lit();});fs.addEventListener('keydown',function(e){if(e.key=='Escape'&&fs.value){fs.value='';Find();Lit();}});if(fs.value)Find();"
				+ "addEventListener('scroll',Lit,{passive:true});scrollTo(0,").Append(settingsY).Append(");var J='").Append(jump).Append("';if(J=='look')scrollTo(0,0);else if(J){var e=document.getElementById(J);if(e)e.scrollIntoView();}Lit();</script>");
			return html.Append("</body></html>").ToString();
		}

		// A setting changed on the settings page: it goes through the same switches as before, so it all behaves the same.
		void SetFromPage(Tab t, string url)
		{
			Match k = Regex.Match(url, @"[?&]k=([\w-]+)"), v = Regex.Match(url, @"[?&]v=([^&]*)"), y = Regex.Match(url, @"[?&]y=(\d+)");
			if (!k.Success) return;
			string key = k.Groups[1].Value, value = v.Success ? Uri.UnescapeDataString(v.Groups[1].Value) : "";
			bool on = value == "1";
			int n;
			int.TryParse(value, out n);
			if (y.Success) int.TryParse(y.Groups[1].Value, out settingsY);
			Match find = Regex.Match(url, @"[?&]q=([^&]*)");
			if (find.Success) settingsFind = Clip(Uri.UnescapeDataString(find.Groups[1].Value), 60);
			if (SetSiteFromPage(key, value)) return;
			switch (key)
			{
				case "theme": if (Array.IndexOf(Look.ThemeNames, value) >= 0) { mod.look.Theme = value; Changed(); } return;
				case "font": mod.look.Font = value; Changed(); return;
				case "research": if (Regex.IsMatch(value ?? "", "^(?:deep|quick|off)$")) Keep("research", value); break;
				case "researchlen": if (Regex.IsMatch(value ?? "", "^(?:short|mid|long)$")) Keep("researchlen", value); break;
				case "animesite": if (Array.IndexOf(AnimeHosts, value) >= 0) Keep("animesite", value); break;
				case "videosite": if (Array.IndexOf(VideoHosts, value) >= 0) Keep("videosite", value); break;
				case "animelink": case "videolink":
					{
						Uri lu;
						string link = (value ?? "").Trim();
						if (link.Length == 0 || (link.Length < 400 && Uri.TryCreate(link.Replace("%s", "x"), UriKind.Absolute, out lu) && (lu.Scheme == "https" || lu.Scheme == "http"))) Keep(key, link);
						break;
					}
				case "size": mod.look.Size = Math.Max(70, Math.Min(200, n / 10 * 10)); Changed(); return;
				case "sites": mod.look.Sites = on; Changed(); return;
				case "names": mod.look.Names = on; Changed(); return;
				case "search": mod.look.Search = SearchEngine = Engines[Math.Max(0, EngineRow(value)), 0]; mod.Save(); break;
				case "track": mod.look.Track = Math.Max(0, Math.Min(3, n)); Guard(); break;
				case "ads": mod.look.Ads = on; Guard(); return;
				case "restore": mod.look.Restore = on; mod.Save(); return;
				case "lang": mod.look.Lang = Lang = Languages[LangRow(value), 0]; Forget(); mod.Save(); Relabel(); Recolor(); return;
				case "discord": Keep("discordmode", value == "personal" ? "personal" : "capri"); break;
				case "holospot": if (Array.IndexOf(HoloSpots, value) >= 0) { Keep("holospot", value); holoAt = value; if (Flag("holo", false)) Holo("Here's where I'll show up, choom.", false); } return;
				case "wallpaper": ImportWallpaper(); break;
				case "nowall": mod.RemoveWallpaper(); ShowWallState(null); RefreshHomes(); break;
				case "wipe": ClearSiteData(); break;
				case "clean": Later(StartCleaning); return;
				case "backup": Later(BackUp); return;
				case "unbackup": Later(RestoreFrom); return;
				case "update": UpdateAll(); return;
				case "news": Later(ShowNews); return;
				case "getlangs": Fetch("languages.txt", got => { UseLanguages(got); if (Languages.GetLength(0) < 2) { mod.Tell("That language file didn't look right."); return; } Host.Store.Set("langpack", got); foreach (Tab open in tabs) if (open.Special == "settings") ShowReader(open); mod.Tell("Languages downloaded. Pick one in Settings."); }); return;
				case "folder": PickSaveFolder(); break;
				case "video": TurnOnVideo(); break;
				default:
					if (key.Begins("clean-"))
					{
						HashSet<string> picked = CleanPicked();
						if (on) picked.Add(key.Substring(6)); else picked.Remove(key.Substring(6));
						CleanPick(picked);
						return;
					}
					if (!key.Begins("x-")) return;
					if (key == "x-hello") { Later(delegate { SetHello(on); }); return; }
					if (key == "x-darkweb") SetDarkWeb(on); else if (Host != null) Host.Store.Set("opt-" + key.Substring(2), on ? "1" : "0");
					if (key == "x-brainfirst") { if (on) brainWasFirst = true; BrainFirst(); }
					return;
			}
			if (key == "wallpaper" || key == "nowall" || key == "folder" || key == "video" || key == "discord" || key == "search" || key == "track" || key == "animesite" || key == "videosite") foreach (Tab open in tabs) if (open.Special == "settings") ShowReader(open);
		}

		void ShowHistory()
		{
			foreach (Tab open in tabs) if (open.Special == "history") { ShowReader(open); Select(open); return; }
			OpenTab(null, null, true);
			tab.Special = "history";
			ShowReader(tab);
		}

		// Filters as they type; every word has to match. Matches are lit by marking the plain text (never as page code).
		const string HistScript = @"(function(){var q=document.getElementById('hq'),n=document.getElementById('hn'),none=document.getElementById('h0'),L=[].slice.call(document.querySelectorAll('.hist a.v[data-k]')),sel=-1,shown=L;
L.forEach(function(a){a.__t=a.querySelector('i').textContent;a.__h=a.querySelector('span').textContent});
function lit(e,t,w){var on=[],lo=t.toLowerCase();w.forEach(function(x){var i=lo.indexOf(x);while(x&&i>=0){for(var k=i;k<i+x.length;k++)on[k]=1;i=lo.indexOf(x,i+x.length)}});e.textContent='';var run='',m=0;for(var k=0;k<=t.length;k++){var now=k<t.length?!!on[k]:!m;if(k==t.length||now!=!!m){if(run){var p=m?document.createElement('mark'):document.createTextNode('');p.textContent=run;e.appendChild(p)}run='';m=now?1:0}if(k<t.length)run+=t[k]}}
function pick(i){if(sel>=0&&shown[sel])shown[sel].classList.remove('sel');sel=i;if(sel>=0&&shown[sel]){shown[sel].classList.add('sel');shown[sel].scrollIntoView({block:'nearest',behavior:'smooth'})}}
function go(){L=L.filter(function(a){return a.hasAttribute('data-k')});var w=q.value.toLowerCase().trim().split(/\s+/).filter(function(x){return x});pick(-1);shown=[];L.forEach(function(a){var ok=w.every(function(x){return a.getAttribute('data-k').indexOf(x)>=0});a.style.display=ok?'':'none';if(ok){shown.push(a);lit(a.querySelector('i'),a.__t,w);lit(a.querySelector('span'),a.__h,w)}});n.textContent=w.length?shown.length+' of '+L.length:L.length+' pages';none.style.display=shown.length?'none':'block'}
q.addEventListener('input',go);
q.addEventListener('keydown',function(e){if(e.key=='ArrowDown'){e.preventDefault();pick(Math.min(shown.length-1,sel+1))}else if(e.key=='ArrowUp'){e.preventDefault();pick(Math.max(-1,sel-1))}else if(e.key=='Enter'){var a=shown[sel>=0?sel:0];if(a&&q.value.trim())location.href=a.href}else if(e.key=='Escape'&&q.value){e.preventDefault();q.value='';go()}});
document.addEventListener('keydown',function(e){if(e.target!==q&&(e.key=='/'||(e.ctrlKey&&e.key=='f'))){e.preventDefault();q.focus();q.select()}});
go();q.focus()})();";

		const string HistMenu = @"(function(){var m=document.createElement('div');m.className='hm';m.innerHTML='<a>Delete from history</a>';document.body.appendChild(m);var on=null;
function shut(){m.classList.remove('on');on=null}
document.addEventListener('contextmenu',function(e){var a=e.target.closest&&e.target.closest('.hist a.v[data-k]');if(!a){shut();return}e.preventDefault();on=a;m.style.left=Math.min(e.clientX,innerWidth-200)+'px';m.style.top=Math.min(e.clientY,innerHeight-50)+'px';m.classList.add('on')});
document.addEventListener('click',function(e){if(!m.contains(e.target))shut()});addEventListener('scroll',shut,true);addEventListener('blur',shut);
m.firstChild.addEventListener('click',function(){var a=on;shut();if(!a)return;location.href=Own+'forgetpage?u='+encodeURIComponent(a.getAttribute('href'));a.style.transition='opacity .18s,transform .18s';a.style.opacity='0';a.style.transform='translateX(14px)';setTimeout(function(){a.removeAttribute('data-k');a.style.display='none';var q=document.getElementById('hq');if(q)q.dispatchEvent(new Event('input'))},190)});
[].forEach.call(document.querySelectorAll('a.ask'),function(a){a.addEventListener('click',function(e){if(!confirm(a.getAttribute('data-ask')))e.preventDefault()})})})();";

		string HistoryPage()
		{
			Look look = mod.look;
			string[] c = look.Colors;
			StringBuilder html = Start(look, Styled(3, ".hist{max-width:880px;margin:0 auto}.hist a.v{display:block;padding:8px;color:%C2%}.hs input{width:100%;padding:12px}.h0,.hm{display:none}.hm.on{display:block;position:fixed;background:%C1%}.hm a{display:block;padding:8px}", c, null, null));
			html.Append("<div class=\"hist\"><h1>HISTORY <span>&gt;</span></h1><a class=\"v\" style=\"border-color:" + c[5] + ";color:" + c[5] + ";margin-bottom:16px\" href=\"" + Own + "play?g=pick\">CAPRI'S PICK <span>Something new, based on what you've been reading</span></a>");
			List<string[]> seen = mod.History();
			if (seen.Count == 0) html.Append("<p>Nothing here yet. Private tabs never show up here.</p>");
			else html.Append("<div class=\"hs\"><input id=\"hq\" type=\"search\" autocomplete=\"off\" spellcheck=\"false\" placeholder=\"Search your history: a site, a word from the title, part of the address\"><b id=\"hn\"></b></div><div class=\"hd\"><span>DELETE</span><a class=\"ask\" data-ask=\"Delete the last 7 days of history?\" href=\"" + Own + "forgethistory?d=7\">Last 7 days</a><a class=\"ask\" data-ask=\"Delete the last 30 days of history?\" href=\"" + Own + "forgethistory?d=30\">Last 30 days</a><a class=\"ask\" data-ask=\"Delete all your history?\" href=\"" + Own + "clearhistory\">Everything</a><em>Right-click a page to delete just that one.</em></div><p id=\"h0\" class=\"h0\">Nothing in your history matches that.</p>");
			foreach (string[] one in seen)
			{
				Uri uri;
				string host = Uri.TryCreate(one[0], UriKind.Absolute, out uri) ? uri.Host : one[0], name = one[1].Length > 0 ? one[1] : host;
				string find = (name + " " + host + " " + one[0]).ToLowerInvariant();
				html.Append("<a class=\"v\" data-k=\"").Append(WebUtility.HtmlEncode(find)).Append("\" href=\"").Append(WebUtility.HtmlEncode(one[0])).Append("\"><i>").Append(WebUtility.HtmlEncode(name))
					.Append("</i><span>").Append(WebUtility.HtmlEncode(host)).Append("</span>");
				long at;
				if (long.TryParse(one[2], out at)) html.Append("<small>").Append(WebUtility.HtmlEncode(When(at))).Append("</small>");
				html.Append("</a>");
			}
			if (seen.Count > 0) html.Append("<script>var Own='").Append(Own).Append("';").Append(HistScript).Append(HistMenu).Append("</script>");
			return html.Append("</div></body></html>").ToString();
		}

		// Suggestions under the bar from where they've been, matched on the address with or without "https://www."
		void Suggestions()
		{
			var known = new AutoCompleteStringCollection();
			var added = new HashSet<string>();
			foreach (string[] one in mod.History())
			{
				string url = one[0];
				string bare = Regex.Replace(url, @"^https?://", "");
				string noWww = Regex.Replace(bare, @"^www\.", "");
				foreach (string form in new[] { url, bare, noWww }) if (added.Add(form)) known.Add(form);
			}
			address.AutoCompleteCustomSource = known;
		}
		Shimmer summary;
		readonly WinTimer giveUp = new WinTimer { Interval = 90000 };

		// She reads the page in front and says what it's about. Her results page she sums up from what she read.
		internal void Summarise() { Summarise(null); }

		// With a question, she answers it from the page instead.
		internal void Summarise(string question)
		{
			if (summary == null || summary.Working) return;
			Tab t = tab;
			if (t.Private) { mod.Tell(Masked(t) ? "No cheating, choom. Guess it first." : "That's a private tab, so I won't send it anywhere, choom."); return; }
			if (t.OnReader && t.Page == null) { mod.Tell(question == null ? "Open a page first and I'll sum it up for you, choom." : "Open a page first, then ask me about it, choom."); return; }
			summary.Working = true;
			giveUp.Stop();
			giveUp.Start();
			bool scan = !t.OnReader && t.Address != null && t.Viewer.Script(CapriInternalBrowser.Reading(mod.look.Colors)) != null;
			Action done = delegate { Post(delegate { giveUp.Stop(); summary.Working = false; if (scan) t.Viewer.Script("window.capriReadDone&&capriReadDone()"); }); };
			if (t.OnReader) { mod.Summarise("Her search results for: " + t.Page.Query, null, t.Page.Text(6000), done, question); return; }
			string title = t.Title, at = t.Address;
			t.Viewer.Text(text => { mod.Summarise(title, at, text, done, question); });
		}

		void StartAsking()
		{
			Tab t = tab;
			if (t == null) return;
			if (t.Private) { mod.Tell(Masked(t) ? "No cheating, choom. Guess it first." : "That's a private tab, so I won't send it anywhere, choom."); return; }
			if (t.OnReader && t.Page == null) { mod.Tell("Open a page first, then ask me about it, choom."); return; }
			adding = false;
			asking = true;
			address.Text = "";
			Cue();
			address.Focus();
		}

		// ---- what Capri's capri_browser tool uses ----

		internal bool Loading { get { return tab != null && tab.Busy; } }

		internal string Here()
		{
			Tab t = Work;
			if (t == null) return "no tab";
			if (t.Private) return Masked(t) ? "a hidden Guess the Site page (no hints)" : "nothing you can see";
			return "tab " + (tabs.IndexOf(t) + 1) + " of " + tabs.Count + ", \"" + Clip(t.Title ?? "", 90) + "\""
				+ (t.OnReader || t.Address == null ? " (Capri Browser's own page)" : " at " + Clip(t.Address, 150)) + (t.Busy ? ", still loading" : "") + (t.Playing ? ", playing sound" : "");
		}

		string TabList()
		{
			var list = new StringBuilder("Open tabs:");
			for (int i = 0; i < tabs.Count; i++)
			{
				Tab t = tabs[i];
				if (t.Private) continue;
				list.Append("\n").Append(i + 1).Append(". ").Append(t == tab ? "[in front] " : "").Append(Clip(t.Title ?? "", 80))
					.Append(t.OnReader || t.Address == null ? "" : " - " + Clip(t.Address, 120));
			}
			return list.ToString();
		}

		// Brings their open Discord tab to the front: "ok", or null when there isn't one.
		internal string ToDiscord()
		{
			foreach (Tab d in tabs) if (!d.Private && d.Address != null && d.Address.Contains("discord.com")) { Select(d); return "ok"; }
			return null;
		}

		internal Task<string> Cdp(string method, string json, out string why)
		{
			Task<string> test = Script("1", out why);
			if (why != null) return null;
			Task<string> run = tab.Viewer.Cdp(method, json);
			if (run == null) why = NoEngine;
			return run;
		}

		internal Task<string> Gesture(string script, out string why)
		{
			Task<string> test = Script("1", out why);
			if (why != null) return null;
			Task<string> run = tab.Viewer.Gesture(script);
			if (run == null) why = NoEngine;
			return run;
		}

		internal Task<string> Script(string script, out string why)
		{
			why = null;
			Tab t = Work;
			if (t == null) why = "There's no tab open.";
			else if (t.Private) why = Masked(t) ? "They're playing Guess the Site, so the page is hidden till they guess. No hints: tell them no cheating." : "That's a private tab, so that one's theirs alone.";
			else if (t.OnReader || t.Address == null) why = "The tab in front is Capri Browser's own page, not a website. Use go <site> first.";
			if (why != null) return null;
			Task<string> run = t.Viewer.Script(script);
			if (run == null) why = NoEngine;
			return run;
		}

		// A tab they named by voice: the one in front, a number, or a site or words in its title. Her hidden Discord is never one.
		internal string CloseSaid(string what, string n)
		{
			Tab t = null;
			if (n.Length > 0) t = Numbered(n);
			else if (what.Length == 0) t = tab;
			else
			{
				string w = Regex.Replace(what.ToLowerInvariant(), @"[^a-z0-9]", "");
				foreach (Tab one in tabs)
				{
					if (one.Hidden) continue;
					Uri u;
					string host = Uri.TryCreate(one.Address ?? "", UriKind.Absolute, out u) ? u.Host.ToLowerInvariant().Replace("www.", "") : "";
					string title = Regex.Replace((one.Title ?? "").ToLowerInvariant(), @"[^a-z0-9]", "");
					if (w.Length > 1 && (host.Replace(".", "").StartsWith(w, Exact) || host.Split('.')[0] == w || title.Contains(w))) { t = one; if (one == tab) break; }
				}
			}
			if (t == null || t.Hidden) return what.Length > 0 ? "I can't see a " + what + " tab, choom." : "There's no tab like that, choom.";
			Close(t);
			return "Closed it, choom.";
		}

		Tab Numbered(string n)
		{
			int at;
			if (n.Length == 0 || n == "this") return tab;
			return int.TryParse(n, out at) && at >= 1 && at <= tabs.Count ? tabs[at - 1] : null;
		}

		internal string Do(string verb, string rest)
		{
			Tab t = Work;
			Form form = FindForm();
			switch (verb)
			{
				case "tabs": return TabList();
				case "go":
					if (rest.Length == 0) return "Say where to go.";
					if (t != null && t != tab) { Go(t, Where(rest)); return "Going to " + rest + "."; }
					address.Text = rest;
					Visit();
					return "Going to " + rest + ".";
				case "new": if (CapriInternalBrowser.quiet) OpenTab(null, null, true); else NewTab(); return "Opened a new tab.";
				case "switch":
					t = Numbered(rest);
					if (t == null) return "There's no tab " + rest + ". " + TabList();
					Select(t);
					return "Switched to it.";
				case "close":
					if (rest == "browser" || rest == "all" || rest == "window") { if (form != null) form.Close(); return "Closed Capri Browser."; }
					t = Numbered(rest);
					if (t == null) return "There's no tab " + rest + ". " + TabList();
					Close(t);
					return "Closed that tab.";
				case "back": if (t != null) { if (t.Viewer.CanBack && !t.OnReader) t.Viewer.Back(); else if (!t.OnReader) ShowReader(t); } return "Went back.";
				case "forward": if (t != null) t.Viewer.Forward(); return "Went forward.";
				case "reload": Reload(); return "Reloaded it.";
				case "mute": case "unmute":
					if (t == null || !t.Viewer.Modern) return "That needs Edge's engine.";
					if (t.Viewer.Muted != (verb == "mute")) Mute(t);
					return verb == "mute" ? "Muted the tab." : "Sound's back on.";
				case "zoom":
					if (t == null) return "There's no tab open.";
					t.Viewer.Zoom(rest.StartsWith("in") ? 1 : rest.StartsWith("out") ? -1 : 0);
					return "Zoomed " + (rest.Length == 0 ? "reset" : rest) + ".";
				case "note": if (rest.Length == 0) return "Say what to put in the note."; AddNote(rest); return "Saved it in Noted.";
				case "research": if (rest.Length == 0) return "Say what to research."; mod.Study("research", rest, rest); return "Researching it in the background now. When it's done you'll tell them and ask if they want it brought up or put in Noted, so just say you're on it.";
				case "snapnote": case "notesshot": if (t == null) return "There's no tab open."; ShotToNotes(t); return "Took a screenshot of the page and put it in Noted.";
				case "screenshot": if (t == null) return "There's no tab open."; if (Regex.IsMatch(rest, "^(?:full|visible|area)$")) { TakeShot(t, rest, null, null); return rest == "area" ? "Tell them to drag over the part they want." : "Took the screenshot; it's saved in their Pictures and copied."; } Screenshot(t); return "Took a screenshot of the page; it's saved in their Pictures, in Capri Browser.";
				case "translate": if (t == null) return "There's no tab open."; Translate(t); return "Translating the page.";
				case "fullscreen": SetFullScreen(!full); return full ? "Full screen." : "Out of full screen.";
				case "show":
					if (form != null && !quiet) { if (form.WindowState == FormWindowState.Minimized) form.WindowState = FormWindowState.Normal; form.Activate(); }
					return "Capri Browser is up front.";
				case "hide": if (form != null) form.WindowState = FormWindowState.Minimized; return "Tucked Capri Browser away.";
			}
			return null;
		}

		// ---- the Mainframe's red haze behind the tabs and the bar, and Capri's own mouse pointer ----

		static readonly float[] Fade = { 0f, .234375f, .4375f, .609375f, .75f, .859375f, .9375f, .984375f, 1f };
		static readonly float[] FadeAt = { 0f, .125f, .25f, .375f, .5f, .625f, .75f, .875f, 1f };

		internal static Color Mix(Color a, Color b, float amount)
		{
			return Color.FromArgb((int)(a.R + (b.R - a.R) * amount), (int)(a.G + (b.G - a.G) * amount), (int)(a.B + (b.B - a.B) * amount));
		}

		void Haze(Control c, Graphics g)
		{
			int y = PointToClient(c.PointToScreen(Point.Empty)).Y;
			Look look = mod.look;
			using (var glow = new LinearGradientBrush(new RectangleF(0, -y - 1, 16, 211),
				Mix(look.Shade(0), look.Shade(5), .2f), look.Shade(0), 90f))
			{
				glow.Blend = new System.Drawing.Drawing2D.Blend { Factors = Fade, Positions = FadeAt };
				g.FillRectangle(glow, 0, 0, c.Width, c.Height);
			}
		}

		static Cursor pointer;
		internal static Cursor Pointer
		{
			get
			{
				if (pointer == null)
					try { pointer = typeof(ICapriHost).Assembly.GetType("CapriDesktop.Look").GetProperty("Pointer", BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic).GetValue(null, null) as Cursor; }
					catch { }
				return pointer ?? Cursors.Default;
			}
		}

		void UsePointer(Control c)
		{
			if (!(c is TextBoxBase) && !(c is ComboBox) && !(c is WebBrowser) && c.GetType().Name != "WebView2" && !"grip".Equals(c.Tag)) c.Cursor = Pointer;
			foreach (Control child in c.Controls) UsePointer(child);
			c.ControlAdded -= Added;
			c.ControlAdded += Added;
		}

		void Added(object sender, ControlEventArgs e) { UsePointer(e.Control); }

		// Dragging the empty part of the tab strip moves the window, double-clicking it maximises, like Opera's.
		[DllImport("user32.dll")] private static extern bool ReleaseCapture();
		[DllImport("user32.dll", EntryPoint = "SendMessage")] private static extern IntPtr DragWindow(IntPtr window, int message, IntPtr wParam, IntPtr lParam);
		readonly Button[] caption = new Button[3];

		void Grab(Control c)
		{
			c.MouseDown += (sender, e) =>
			{
				Form form = FindForm();
				if (form == null || e.Button != MouseButtons.Left) return;
				if (e.Clicks == 2) { Maximise(); return; }
				ReleaseCapture();
				DragWindow(form.Handle, 0xA1, (IntPtr)2, IntPtr.Zero);
			};
		}

		void Maximise()
		{
			Form form = FindForm();
			if (form != null) form.WindowState = form.WindowState == FormWindowState.Maximized ? FormWindowState.Normal : FormWindowState.Maximized;
		}

		internal void Framed(bool maximised) { if (caption[1] != null) caption[1].Text = maximised ? "\uE923" : "\uE922"; }

		// Capri's logo at the far left, and minimise, maximise and close at the right, all in the tab strip.
		void BuildCaption()
		{
			var logo = new PictureBox { Dock = DockStyle.Left, Width = 38, SizeMode = PictureBoxSizeMode.CenterImage };
			logo.HandleCreated += delegate
			{
				Form form = FindForm();
				if (form != null && form.Icon != null) try { logo.Image = new Bitmap(form.Icon.ToBitmap(), 20, 20); } catch { }
			};
			logo.Click += delegate { if (!JustShut) PageMenu().Show(logo, new Point(0, logo.Height)); };
			new ToolTip().SetToolTip(logo, "Capri Browser");
			string[] icons = { "\uE921", "\uE922", "\uE8BB" }, tips = { "Minimise", "Maximise", "Close" };
			for (int i = 0; i < 3; i++)
			{
				int which = i;
				var b = new Button { Text = icons[i], Width = 46, Dock = DockStyle.Right, FlatStyle = FlatStyle.Flat, TabStop = false, Font = Icons(8f) };
				b.FlatAppearance.BorderSize = 0;
				new ToolTip().SetToolTip(b, tips[i]);
				b.Click += delegate
				{
					Form form = FindForm();
					if (form == null) return;
					if (which == 0) form.WindowState = FormWindowState.Minimized;
					else if (which == 1) Maximise();
					else form.Close();
				};
				caption[i] = b;
			}
			strip.Controls.Add(caption[0]);
			strip.Controls.Add(caption[1]);
			strip.Controls.Add(caption[2]);
			strip.Controls.Add(logo);
			Grab(strip);
			Grab(chips);
		}

		void TintCaption(Look look)
		{
			foreach (Button b in caption)
			{
				if (b == null) continue;
				b.BackColor = Color.Transparent;
				b.ForeColor = look.Shade(3);
				b.FlatAppearance.MouseOverBackColor = b == caption[2] ? Color.FromArgb(232, 17, 35) : Mix(look.Shade(0), look.Shade(5), .35f);
				b.FlatAppearance.MouseDownBackColor = b == caption[2] ? Color.FromArgb(160, 12, 24) : look.Shade(5);
			}
		}

		// A tab already on that site gets used (and brought to the front); otherwise a new one opens.
		internal bool HasSite(string host)
		{
			Uri u;
			foreach (Tab t in tabs) if (!t.Private && !t.OnReader && t.Address != null && Uri.TryCreate(t.Address, UriKind.Absolute, out u) && (u.Host == host || u.Host.EndsWith("." + host))) return true;
			return false;
		}

		// ---- For "find it cheaper": where the mouse is on the page, and a comparison tab that opens behind the one they're on ----
		internal string PointerOnPage()
		{
			if (tab == null || tab.OnReader || Form.ActiveForm != FindForm()) return null;
			Control page = tab.Viewer.Control;
			Point p = page.PointToClient(Cursor.Position);
			return page.ClientRectangle.Contains(p) ? p.X + "," + p.Y : null;
		}

		internal object OpenQuiet(string url) { OpenTab(null, url, false); return tabs.Count > 0 ? tabs[tabs.Count - 1] : null; }

		internal Task<string> ReadQuiet(object which) { Tab t = which as Tab; return t != null && tabs.Contains(t) ? t.Viewer.Script(Viewer.ReadScript) : null; }

		internal bool Selected(object which) { return tab == which; }

		internal void BringQuiet(object which, string find)
		{
			Tab t = which as Tab;
			if (t == null || !tabs.Contains(t)) return;
			Select(t);
			Do("show", "");
			if (!string.IsNullOrEmpty(find)) t.Viewer.Script("window.find(" + Quote(find.Length > 40 ? find.Substring(0, 40) : find) + ")");
		}

		internal void DropQuiet(object which) { Tab t = which as Tab; if (t != null && tabs.Contains(t) && t != tab) Close(t); }

		internal void UseSite(string host, string url)
		{
			// They've gone to another tab: she carries on in hers.
			if (CapriInternalBrowser.workAway && WorkTab != null && tabs.Contains(WorkTab)) { WorkTab.Viewer.Go(url); return; }
			Uri u;
			foreach (Tab t in tabs)
				if (!t.Private && !t.OnReader && t.Address != null && Uri.TryCreate(t.Address, UriKind.Absolute, out u) && (u.Host == host || u.Host.EndsWith("." + host)))
				{ Select(t); t.Viewer.Go(url); Do("show", ""); return; }
			OpenTab(null, url, true);
			Do("show", "");
		}

		internal Point OnScreen(int x, int y) { return Work.Viewer.Control.PointToScreen(new Point(x, y)); }

		internal string Showing { get { Tab t = Work; return t == null || t.Private || t.OnReader ? null : t.Address; } }

		// ---- the left sidebar: Capri's website, Discord (hers, or their own), GitHub, and Capri notes ----

		readonly Panel side = new Panel(), notes = new Panel();
		readonly RichTextBox noteText = new RichTextBox();
		Panel notePaper;
		Label[] noteBits = new Label[0];
		readonly List<Button> sideButtons = new List<Button>();
		readonly Label notesTitle = new Label { Text = "BROWSER NOTES  >", Tag = "heading", Left = 12, Top = 12, AutoSize = true, Padding = new Padding(10, 0, 0, 0) };

		string Kept(string key) { return mod.capri == null ? "" : mod.capri.Store.Get(key, "") ?? ""; }
		void Keep(string key, string value)
		{
			if ((key == "css-home" || key == "css-pages") && !SafeCss(value)) return;
			if (mod.capri != null && key != "adblock") mod.capri.Store.Set(key, value);
			if (key == "lists") UseLists(value);
			else if (key == "commands") UseCommands(value);
			else if (key == "adblock") { try { if (AdblockFile != null) File.WriteAllText(AdblockFile, value); } catch { } UseAdblock(value); }
			else if (key == "css-home") HomeCss = value;
			else if (key == "css-pages") PagesCss = value;
		}

		void RedBar(Label label) { label.Paint += (sender, e) => { using (SolidBrush bar = new SolidBrush(mod.look.Shade(5))) e.Graphics.FillRectangle(bar, 0, 3, 3, label.Height - 6); }; }

		readonly Dictionary<Button, Bitmap> logos = new Dictionary<Button, Bitmap>();

		// The sidebar's background: one soft red glow from the top fading to her dark, the same behind every button.
		void SideBack(Control c, Graphics g)
		{
			int y = side.PointToClient(c.PointToScreen(Point.Empty)).Y;
			Look look = mod.look;
			using (var back = new LinearGradientBrush(new RectangleF(0, -y - 1, 16, Math.Max(60, side.Height) + 2), Mix(look.Shade(0), look.Shade(5), .14f), look.Shade(0), 90f))
				g.FillRectangle(back, 0, 0, c.Width, c.Height);
		}

		Bitmap Reddened(Bitmap logo)
		{
			Color red = mod.look.Shade(5);
			float r = Math.Min(1.4f, red.R / 255f * 1.3f), gr = red.G / 255f * 1.3f, bl = red.B / 255f * 1.3f;
			var tinted = new Bitmap(logo.Width, logo.Height);
			using (Graphics g = Graphics.FromImage(tinted))
			using (var paint = new ImageAttributes())
			{
				paint.SetColorMatrix(new ColorMatrix(new[] { new[] { .3f * r, .3f * gr, .3f * bl, 0, 0 }, new[] { .59f * r, .59f * gr, .59f * bl, 0, 0 }, new[] { .11f * r, .11f * gr, .11f * bl, 0, 0 }, new[] { 0f, 0, 0, 1, 0 }, new[] { 0f, 0, 0, 0, 1 } }));
				g.DrawImage(logo, new Rectangle(0, 0, logo.Width, logo.Height), 0, 0, logo.Width, logo.Height, GraphicsUnit.Pixel, paint);
			}
			return tinted;
		}

		Button SideButton(string icon, string tip, string picture)
		{
			var b = new Button { Text = icon, Dock = DockStyle.Top, Height = 44, FlatStyle = FlatStyle.Flat, TabStop = false, Font = Icons(13f) };
			b.FlatAppearance.BorderSize = 0;
			new ToolTip().SetToolTip(b, tip);
			sideButtons.Add(b);
			// The site's own logo, fetched once; her icon font stays if it can't be.
			if (picture != null) Behind(delegate
			{
				try
				{
					byte[] data;
					using (var web = new WebClient())
					{
						web.Headers[HttpRequestHeader.UserAgent] = "Mozilla/5.0";
						try { data = web.DownloadData(picture); }
						catch (Exception) { data = web.DownloadData("https://www.google.com/s2/favicons?sz=64&domain=" + new Uri(picture).Host); }
					}
					Bitmap logo;
					using (var m = new MemoryStream(data))
						try { using (Icon i = new Icon(m, 20, 20)) logo = new Bitmap(i.ToBitmap(), 20, 20); }
						catch (Exception) { m.Position = 0; using (Image im = Image.FromStream(m)) logo = new Bitmap(im, 20, 20); }
					for (int i = 0; i < 50 && !b.IsHandleCreated && !b.IsDisposed; i++) Thread.Sleep(100);
					if (b.IsHandleCreated) b.BeginInvoke((Action)delegate { logos[b] = logo; b.Text = ""; b.Image = Reddened(logo); });
				}
				catch { }
			});
			return b;
		}

		// ---- Smoother moves: panels slide, tabs grow and shrink, the red line glides between tabs, menus fade in ----

		// Runs step from 0 to 1 over ms, fast at first and gentle at the end, then done. Stops if owner goes away. ms below 0: a closing move, which
		// starts gently and finishes fast; otherwise it opens fast and settles.
		static void Ease(Control owner, int ms, Action<float> step, Action done)
		{
			bool exit = ms < 0;
			ms = Math.Max(1, Math.Abs(ms));
			var clock = new WinTimer { Interval = 15 };
			DateTime start = DateTime.Now;
			clock.Tick += delegate
			{
				if (owner.IsDisposed) { clock.Stop(); clock.Dispose(); return; }
				float k = Math.Min(1f, (float)(DateTime.Now - start).TotalMilliseconds / ms);
				float e = exit ? k * k : 1f - (1f - k) * (1f - k) * (1f - k);
				try { step(e); } catch (Exception) { k = 1f; }
				if (k < 1f) return;
				clock.Stop();
				clock.Dispose();
				if (done != null && !owner.IsDisposed) done();
			};
			try { step(0f); } catch { }
			clock.Start();
		}

		static void FadeIn(ToolStripDropDown menu)
		{
			menu.Opening += delegate { try { menu.Opacity = .15; } catch { } };
			menu.Opened += delegate { Ease(menu, 150, e => { menu.Opacity = .15 + .85 * e; }, delegate { menu.Opacity = 1; }); };
		}

		readonly Panel marks = new Panel();
		// Counts each panel's slides, so a newer one wins over one still running.
		readonly Dictionary<Panel, int> slideCount = new Dictionary<Panel, int>();
		int Slides(Panel p) { int n; return slideCount.TryGetValue(p, out n) ? n : 0; }
		int NextSlide(Panel p) { slideCount[p] = Slides(p) + 1; return slideCount[p]; }

		// Noted and Bookmarks live over the page, in the page's own area. Opening slides one in from the sidebar's edge (only its position moves, so
		// nothing re-lays out while it does); closing slides it back. Pinned, it sits beside the page instead, and stays when they click the page.
		bool PinnedSide(Panel p) { return Kept(p == notes ? "pin-noted" : p == pwPanel ? "pin-passwords" : p == sideSetup ? "pin-sidesetup" : "pin-marks") == "1"; }

		void PlaceSide(Panel p)
		{
			if (p.Dock == DockStyle.Left) return;
			p.Top = 0;
			p.Height = holder.ClientSize.Height;
		}

		void ToggleSide(Panel p, int width)
		{
			if (full) return;
			if (p.Visible) { SlideIn(p, width); return; }
			foreach (Panel other in new[] { notes, marks, pwPanel, sideSetup }) if (other != p && other.Visible) SlideIn(other, other.Width);
			int my = NextSlide(p);
			p.Dock = DockStyle.None;
			p.Width = width;
			PlaceSide(p);
			p.Left = -width;
			p.Visible = true;
			p.BringToFront();
			Blip("panel");
			Ease(p, 240, e => { if (my == Slides(p)) p.Left = (int)(-width * (1 - e)); }, delegate
			{
				if (my != Slides(p)) return;
				p.Left = 0;
				if (PinnedSide(p)) { p.Dock = DockStyle.Left; p.SendToBack(); }
			});
		}

		void SlideIn(Panel p, int width)
		{
			if (!p.Visible) return;
			int my = NextSlide(p);
			if (p.Dock == DockStyle.Left) { p.Dock = DockStyle.None; PlaceSide(p); p.Left = 0; p.BringToFront(); }
			int from = p.Left;
			Ease(p, -190, e => { if (my == Slides(p)) p.Left = from + (int)((-p.Width - from) * e); }, delegate
			{
				if (my != Slides(p)) return;
				p.Visible = false;
				p.Left = 0;
			});
		}

		// Shows a side panel (when Capri adds a note), sliding it out if it was in.
		void ShowSide(Panel p, int width) { if (!p.Visible) ToggleSide(p, width); }

		// Clicking the page closes a panel that isn't pinned, like Opera's.
		void PageClicked()
		{
			foreach (Panel p in new[] { notes, marks, pwPanel, sideSetup }) if (p.Visible && p.Dock != DockStyle.Left && !PinnedSide(p) && Form.ActiveForm == FindForm()) SlideIn(p, p.Width);
		}

		Panel SideHead(Panel p, string glyph, string name, out Label title)
		{
			var head = new Panel { Dock = DockStyle.Top, Height = 52 };
			var icon = new Label { Text = glyph, Dock = DockStyle.Left, Width = glyph == null ? 16 : 46, TextAlign = ContentAlignment.MiddleCenter, Font = Icons(14f), Tag = "red" };
			title = new Label { Text = name, Dock = DockStyle.Fill, TextAlign = ContentAlignment.MiddleLeft, Font = new Font(UiBold, 14f), UseMnemonic = false, AutoEllipsis = true };
			Button shut = Flat("\uE711", "Close (Esc)", DockStyle.Right, 40);
			Button pin = Flat("\uE718", "Pin beside the page", DockStyle.Right, 36);
			string key = p == notes ? "pin-noted" : p == pwPanel ? "pin-passwords" : p == sideSetup ? "pin-sidesetup" : "pin-marks";
			Action showPin = delegate { bool on = Kept(key) == "1"; pin.Text = on ? "\uE841" : "\uE718"; pin.Tag = on ? "red" : null; pin.ForeColor = on ? mod.look.Shade(5) : mod.look.Shade(3); };
			pin.Click += delegate
			{
				bool on = Kept(key) != "1";
				Keep(key, on ? "1" : "0");
				showPin();
				if (on) { p.Dock = DockStyle.Left; p.SendToBack(); }
				else { p.Dock = DockStyle.None; PlaceSide(p); p.Left = 0; p.BringToFront(); }
			};
			shut.Click += delegate { SlideIn(p, p.Width); };
			head.Controls.Add(title);
			head.Controls.Add(pin);
			head.Controls.Add(shut);
			head.Controls.Add(icon);
			p.VisibleChanged += delegate { showPin(); };
			// The right edge drags to make it wider; a thin line and a soft shadow mark it.
			var grip = new Panel { Dock = DockStyle.Right, Width = 6, Cursor = Cursors.SizeWE };
			bool dragging = false;
			int from = 0, was = 0;
			grip.Paint += (sender, e) =>
			{
				Look look = mod.look;
				using (var shade = new LinearGradientBrush(new Rectangle(0, 0, grip.Width, Math.Max(1, grip.Height)), look.Shade(1), Mix(look.Shade(1), Color.Black, .45f), 0f))
					e.Graphics.FillRectangle(shade, 0, 0, grip.Width, grip.Height);
				using (var line = new Pen(dragging ? look.Shade(5) : look.Shade(6))) e.Graphics.DrawLine(line, grip.Width - 1, 0, grip.Width - 1, grip.Height);
			};
			grip.MouseDown += (sender, e) => { if (e.Button != MouseButtons.Left) return; dragging = true; from = Cursor.Position.X; was = p.Width; grip.Capture = true; grip.Invalidate(); };
			grip.MouseMove += delegate { if (dragging) p.Width = Math.Max(260, Math.Min(Math.Min(720, holder.Width - 200), was + Cursor.Position.X - from)); };
			grip.MouseUp += delegate { if (!dragging) return; dragging = false; grip.Capture = false; grip.Invalidate(); Keep(p == notes ? "noteswidth" : p == pwPanel ? "passwordswidth" : p == sideSetup ? "sidesetupwidth" : "markswidth", p.Width.ToString()); };
			p.Controls.Add(grip);
			p.KeyDown += (sender, e) => { if (e.KeyCode == Keys.Escape) SlideIn(p, p.Width); };
			return head;
		}

		// A search box in a rounded ring, red when it has focus, like Opera's. The ring panel holds the box.
		Panel Ring(TextBox box, string cue)
		{
			var row = new Panel { Dock = DockStyle.Top, Height = 48, Padding = new Padding(14, 4, 14, 8) };
			var ring = new Panel { Dock = DockStyle.Fill, Padding = new Padding(34, 8, 14, 4) };
			Buffered(ring);
			Buffered(row);
			box.Dock = DockStyle.Fill;
			box.BorderStyle = BorderStyle.None;
			box.Font = new Font(Ui, 10.5f);
			SetCue(box, cue);
			ring.Controls.Add(box);
			row.Controls.Add(ring);
			ring.Paint += (sender, e) =>
			{
				Look look = mod.look;
				Graphics g = e.Graphics;
				g.SmoothingMode = SmoothingMode.AntiAlias;
				g.Clear(row.BackColor);
				var r = new Rectangle(1, 1, ring.Width - 3, ring.Height - 3);
				using (var p = new GraphicsPath())
				{
					int d = Math.Min(r.Height, 18);
					p.AddArc(r.X, r.Y, d, d, 180, 90); p.AddArc(r.Right - d, r.Y, d, d, 270, 90); p.AddArc(r.Right - d, r.Bottom - d, d, d, 0, 90); p.AddArc(r.X, r.Bottom - d, d, d, 90, 90); p.CloseFigure();
					using (var fillIn = new SolidBrush(look.Shade(0))) g.FillPath(fillIn, p);
					using (var line = new Pen(box.Focused ? look.Shade(5) : Mix(look.Shade(6), look.Shade(5), .35f), box.Focused ? 2 : 1)) g.DrawPath(line, p);
				}
				TextRenderer.DrawText(g, "\uE721", Icons(10f), new Rectangle(8, 0, 24, ring.Height), look.Shade(3), TextFormatFlags.VerticalCenter | TextFormatFlags.HorizontalCenter);
			};
			box.GotFocus += delegate { ring.Invalidate(); };
			box.LostFocus += delegate { ring.Invalidate(); };
			box.BackColorChanged += delegate { ring.Invalidate(); };
			return row;
		}

		void DarkScroll(Control c)
		{
			Action theme = delegate { try { SetWindowTheme(c.Handle, mod.look.Shade(1).GetBrightness() < .5f ? "DarkMode_Explorer" : "Explorer", null); } catch { } };
			if (c.IsHandleCreated) theme(); else c.HandleCreated += delegate { theme(); };
		}

		// The red line under the tab in front, which glides to the next tab when they switch.
		readonly Panel slider = new Panel { Height = 2, Visible = false };
		int slides;

		void Slide(bool smooth)
		{
			Tab t = tab;
			if (t == null || t.Chip == null || t.Chip.IsDisposed || !strip.IsHandleCreated || !t.Chip.IsHandleCreated) { slider.Visible = false; return; }
			if (slider.Parent != strip) strip.Controls.Add(slider);
			slider.BackColor = mod.look.Shade(5);
			Point p = strip.PointToClient(t.Chip.PointToScreen(Point.Empty));
			int toX = p.X + 8, toW = Math.Max(8, t.Chip.Width - 16), y = p.Y + t.Chip.Height - 2;
			slider.Top = y;
			slider.BringToFront();
			int my = ++slides;
			if (!smooth || !slider.Visible) { slider.Left = toX; slider.Width = toW; slider.Visible = true; return; }
			int fromX = slider.Left, fromW = slider.Width;
			Ease(slider, 190, e => { if (my != slides) return; slider.Left = fromX + (int)((toX - fromX) * e); slider.Width = fromW + (int)((toW - fromW) * e); }, null);
		}

		void GrowChip(Tab t)
		{
			Panel chip = t.Chip;
			int goal = chip.Width;
			if (goal <= 12) return;
			chip.Width = 12;
			Ease(chip, 180, e =>
			{
				if (t.Chip != chip) return;
				chip.Width = 12 + (int)((goal - 12) * e);
				t.Close.Left = chip.Width - 27;
				t.Name.Width = Math.Max(0, chip.Width - 42);
				if (tab == t) Slide(false);
			}, delegate { SizeChips(); });
		}

		void ShrinkChip(Panel gone, bool settle)
		{
			gone = Ghost(gone);
			if (settle) { EaseChips(gone); return; }
			int from = gone.Width;
			Ease(gone, 200, e => { gone.Width = Math.Max(0, (int)(from * (1 - e))); }, delegate { chips.Controls.Remove(gone); gone.Dispose(); Slide(false); });
		}

		// A closed tab's stand-in: a picture of it in its place, fading as it gets narrower. The real tab goes at once.
		Panel Ghost(Panel chip)
		{
			Bitmap snap = null;
			try { snap = new Bitmap(Math.Max(1, chip.Width), Math.Max(1, chip.Height)); chip.DrawToBitmap(snap, new Rectangle(0, 0, snap.Width, snap.Height)); }
			catch (Exception) { if (snap != null) snap.Dispose(); snap = null; }
			var ghost = new Panel { Width = chip.Width, Height = chip.Height, Margin = chip.Margin, BackColor = chips.BackColor, Enabled = false };
			Buffered(ghost);
			int full = Math.Max(1, chip.Width);
			ghost.Paint += (sender, e) =>
			{
				if (snap == null) return;
				float k = Math.Max(0f, Math.Min(1f, ghost.Width / (float)full));
				using (var see = new ImageAttributes())
				{
					see.SetColorMatrix(new ColorMatrix { Matrix33 = k * k });
					e.Graphics.DrawImage(snap, new Rectangle(0, 0, snap.Width, snap.Height), 0, 0, snap.Width, snap.Height, GraphicsUnit.Pixel, see);
				}
			};
			ghost.Disposed += delegate { if (snap != null) snap.Dispose(); };
			chips.SuspendLayout();
			int at = chips.Controls.GetChildIndex(chip, false);
			chips.Controls.Add(ghost);
			if (at >= 0) chips.Controls.SetChildIndex(ghost, at);
			chips.Controls.Remove(chip);
			chips.ResumeLayout();
			chip.Dispose();
			return ghost;
		}

		[DllImport("uxtheme.dll", CharSet = CharSet.Unicode)] private static extern int SetWindowTheme(IntPtr window, string app, string list);

		// Drawn in one go and redrawn whole when resized, so nothing smears.
		static void Buffered(Control c)
		{
			typeof(Control).GetProperty("DoubleBuffered", BindingFlags.NonPublic | BindingFlags.Instance).SetValue(c, true, null);
			typeof(Control).GetProperty("ResizeRedraw", BindingFlags.NonPublic | BindingFlags.Instance).SetValue(c, true, null);
		}

		[DllImport("user32.dll", EntryPoint = "SendMessage")] private static extern IntPtr Poke(IntPtr window, int message, IntPtr wParam, IntPtr lParam);

		Button Flat(string glyph, string tip, DockStyle dock, int width)
		{
			var b = new Button { Text = glyph, Dock = dock, Width = width, FlatStyle = FlatStyle.Flat, TabStop = false, Cursor = Cursors.Hand, Font = Icons(10.5f) };
			b.FlatAppearance.BorderSize = 0;
			if (tip != null) new ToolTip().SetToolTip(b, tip);
			sideButtons.Add(b);
			return b;
		}

		// ---- Noted: notes as a chat with yourself, a feed of cards with a box at the bottom, in Noted chats they make ----

		Panel feed;
		Action noteTint = delegate { };
		int NotesWide() { int wide; return int.TryParse(Kept("noteswidth"), out wide) ? Math.Max(240, Math.Min(700, wide)) : 340; }

		static string When(long ticks)
		{
			if (ticks <= 0) return "";
			var at = new DateTime(ticks);
			if (at.Date == DateTime.Today) return at.ToString("HH:mm");
			if (at.Date == DateTime.Today.AddDays(-1)) return "Yesterday " + at.ToString("HH:mm");
			return at.ToString(at.Year == DateTime.Today.Year ? "d MMM HH:mm" : "d MMM yyyy");
		}

		static string Day(long ticks)
		{
			if (ticks <= 0) return "EARLIER";
			var at = new DateTime(ticks).Date;
			if (at == DateTime.Today) return "TODAY";
			if (at == DateTime.Today.AddDays(-1)) return "YESTERDAY";
			return at.ToString(at.Year == DateTime.Today.Year ? "ddd d MMM" : "d MMM yyyy").ToUpperInvariant();
		}

		// One line of the feed: a day divider or a note card. Where it's drawn eases toward where it belongs.
		sealed class NoteRow
		{
			public object Id;
			public string Header;
			public int Top, Height, Wide;
			public float Shown, Appear, Hover;
			public bool Open, Long;
			public float Seen;                  // while opening or folding: how tall it's drawn (0 the rest of the time)
			public Bitmap Picture, Was;         // Was: the open card, kept while it folds
			public string Url;
			public Rectangle Link, More;
		}

		[StructLayout(LayoutKind.Sequential)] private struct TwipRect { public int Left, Top, Right, Bottom; }
		[StructLayout(LayoutKind.Sequential)] private struct TextSpan { public int Min, Max; }
		[StructLayout(LayoutKind.Sequential)] private struct PrintRange { public IntPtr Hdc, HdcTarget; public TwipRect Rc, RcPage; public TextSpan Chrg; }
		[DllImport("user32.dll", EntryPoint = "SendMessage")] private static extern IntPtr SendRange(IntPtr window, int message, IntPtr wParam, ref PrintRange range);

		// A note with pictures in it, drawn by Windows' rich text box into a picture of the card's width (in memory).
		readonly RichTextBox notePainter = new RichTextBox { BorderStyle = BorderStyle.None, ScrollBars = RichTextBoxScrollBars.None };
		Bitmap PaintRich(string rtf, int wide, Color ink, Color back, int most)
		{
			notePainter.BackColor = back;
			try { notePainter.Rtf = rtf; } catch (Exception) { return null; }
			notePainter.SelectAll();
			notePainter.SelectionColor = ink;
			IntPtr box = notePainter.Handle;
			Func<IntPtr, int, PrintRange> range = (dc, high) =>
			{
				var r = new PrintRange { Hdc = dc, HdcTarget = dc };
				r.Rc = new TwipRect { Right = wide * 15, Bottom = high * 15 };
				r.RcPage = r.Rc;
				r.Chrg = new TextSpan { Min = 0, Max = -1 };
				return r;
			};
			int tall;
			using (var probe = new Bitmap(1, 1))
			using (Graphics g = Graphics.FromImage(probe))
			{
				IntPtr dc = g.GetHdc();
				try { PrintRange r = range(dc, most); SendRange(box, 0x439, IntPtr.Zero, ref r); tall = Math.Max(16, Math.Min(most, r.Rc.Bottom / 15 + 4)); }
				finally { Poke(box, 0x439, IntPtr.Zero, IntPtr.Zero); g.ReleaseHdc(dc); }
			}
			var pic = new Bitmap(Math.Max(1, wide), tall);
			using (Graphics g = Graphics.FromImage(pic))
			{
				g.Clear(back);
				IntPtr dc = g.GetHdc();
				try { PrintRange r = range(dc, tall); SendRange(box, 0x439, (IntPtr)1, ref r); }
				finally { Poke(box, 0x439, IntPtr.Zero, IntPtr.Zero); g.ReleaseHdc(dc); }
			}
			return pic;
		}

		// ---- Backup: only what's on this list, as plain text. Never passwords, history, tabs, sign-ins, site permissions or leaderboard keys ----
		static readonly Regex BackedUp = new Regex("^(?:theme|font|size|sites|names|language|search|ads|restore|track|allowed|trackok|dial|dial-names|bookmarks|bookfolders|notes|notelist|notebooks|notebookof|noteedited|noteswidth|jobs|research|researchlen|animesite|animelink|videosite|videolink|soundvol|holospot|cleanparts|(?:side|pin|opt)-[a-z0-9-]{1,30})$");
		// Reading or sending messages is always switched on by hand, never by a file.
		static readonly Regex ByHand = new Regex("^opt-(?:read|autoread|discord|quietmsg|hello)");
		const string BackupHead = "Capri Browser backup 1";

		string BackupText()
		{
			var file = new StringBuilder(BackupHead + "\n");
			foreach (string key in mod.capri.Store.Keys)
				if (BackedUp.IsMatch(key) && !ByHand.IsMatch(key))
					file.Append(key).Append('\t').Append((mod.capri.Store.Get(key, "") ?? "").Replace("\\", "\\\\").Replace("\r", "\\r").Replace("\n", "\\n").Replace("\t", "\\t")).Append('\n');
			return file.ToString();
		}

		// What a backup file holds, or null when it isn't one or something in it isn't safe.
		internal static Dictionary<string, string> ReadBackup(string text)
		{
			string[] lines = (text ?? "").Replace("\r", "").Split('\n');
			if (lines[0] != BackupHead) return null;
			var got = new Dictionary<string, string>();
			foreach (string line in lines)
			{
				int cut = line.IndexOf('\t');
				string key = cut < 1 ? "" : line.Substring(0, cut);
				if (!BackedUp.IsMatch(key) || ByHand.IsMatch(key)) continue;
				string value = Regex.Replace(line.Substring(cut + 1), @"\\(.)", m => { char c = m.Groups[1].Value[0]; return c == 'n' ? "\n" : c == 'r' ? "\r" : c == 't' ? "\t" : c.ToString(); });
				// Links can only be web pages, and notes can't hold embedded objects.
				if (Regex.IsMatch(key, "^(?:dial|bookmarks|jobs|animelink|videolink)") && Regex.IsMatch(value, @"(?:^|[\t\n])\s*(?:javascript|vbscript|data|file):", Plain)) return null;
				if (key == "notelist" && Regex.IsMatch(value, @"\\obj(?:ect|data|emb|link|class|ocx|update)", Plain)) return null;
				got[key] = value;
			}
			return got.Count == 0 ? null : got;
		}

		void BackUp()
		{
			try
			{
				using (var pick = new SaveFileDialog { Title = "Back up Capri Browser", Filter = "Capri Browser backup|*.capribackup", FileName = "Capri Browser " + DateTime.Now.ToString("yyyy-MM-dd") + ".capribackup" })
				{
					if (pick.ShowDialog(FindForm()) != DialogResult.OK) return;
					File.WriteAllText(pick.FileName, BackupText(), new UTF8Encoding(false));
					mod.Tell("Backed up, choom. Your notes are readable in that file, so keep it somewhere safe.");
				}
			}
			catch (Exception error) { mod.Tell("I couldn't save the backup: " + error.Message); }
		}

		void RestoreFrom()
		{
			try
			{
				using (var pick = new OpenFileDialog { Title = "Restore Capri Browser", Filter = "Capri Browser backup|*.capribackup" })
				{
					if (pick.ShowDialog(FindForm()) != DialogResult.OK) return;
					Dictionary<string, string> got = new FileInfo(pick.FileName).Length > 50000000 ? null : ReadBackup(File.ReadAllText(pick.FileName, Encoding.UTF8));
					if (got == null) { mod.Tell("That isn't a Capri Browser backup I can trust, choom, so I left everything as it was."); return; }
					string spare = Path.Combine(mod.Folder, "before-restore.capribackup");
					if (MessageBox.Show(FindForm(), "This replaces your notes, bookmarks, Speed Dial, jobs and settings with the backup's, then restarts Capri Browser. What you have now is saved first as:\n" + spare + "\n\nGo ahead?", "Capri Browser", MessageBoxButtons.YesNo, MessageBoxIcon.Question) != DialogResult.Yes) return;
					File.WriteAllText(spare, BackupText(), new UTF8Encoding(false));
					Restart(delegate { mod.UseBackup(got); });
				}
			}
			catch (Exception error) { mod.Tell("I couldn't restore it: " + error.Message); }
		}

		static Point[] CutEdge(int x, int y, int w, int h, int cut) { return new[] { new Point(x + cut, y), new Point(x + w - 1, y), new Point(x + w - 1, y + h - 1 - cut), new Point(x + w - 1 - cut, y + h - 1), new Point(x, y + h - 1), new Point(x, y + cut) }; }

		void BuildNoted()
		{
			notes.Padding = new Padding(0);
			var all = new List<string>(Kept("notelist").Split('\u001e'));
			if (all.Count == 1 && all[0].Length == 0) all[0] = Kept("notes");
			// Notes are kept as rich text, so pictures and links stay in them; the plain words are kept alongside for search.
			var plain = new List<string>();
			using (var reader = new RichTextBox()) foreach (string note in all) { if (note.StartsWith("{\\rtf")) { try { reader.Rtf = note; plain.Add(reader.Text); } catch (Exception) { plain.Add(""); } } else plain.Add(note); }
			var books = new List<string>(Kept("notebookof").Split('\u001e'));
			var edited = new List<long>();
			foreach (string when in Kept("noteedited").Split('\u001e')) { long ticks; edited.Add(long.TryParse(when, out ticks) ? ticks : 0); }
			while (books.Count < all.Count) books.Add("");
			while (edited.Count < all.Count) edited.Add(0);
			if (books.Count > all.Count) books.RemoveRange(all.Count, books.Count - all.Count);
			if (edited.Count > all.Count) edited.RemoveRange(all.Count, edited.Count - all.Count);
			// Blank notes (the old notes panel always kept one) aren't cards.
			for (int i = all.Count - 1; i >= 0; i--) if (plain[i].Trim().Length == 0 && !all[i].Contains("\\pict")) { all.RemoveAt(i); plain.RemoveAt(i); books.RemoveAt(i); edited.RemoveAt(i); }
			// Each note's own token, so a card still finds its note after others are added or deleted.
			var ids = new List<object>();
			foreach (string note in all) ids.Add(new object());

			Action store = delegate
			{
				Keep("notelist", string.Join("\u001e", all.ToArray()));
				Keep("notebookof", string.Join("\u001e", books.ToArray()));
				var times = new List<string>();
				foreach (long t in edited) times.Add(t.ToString());
				Keep("noteedited", string.Join("\u001e", times.ToArray()));
				if (all.Count == 0) Keep("notes", "");
			};

			string inBook = "", finding = "";
			object editing = null;

			Buffered(notes);
			Label named;
			Panel head = SideHead(notes, "", "Noted", out named);

			// ---- Chats: pills along the top (with how many notes), "All" and "+" at the end ----
			var pills = new Panel { Dock = DockStyle.Top, Height = 40, Cursor = Cursors.Hand };
			Buffered(pills);
			const string Everything = "All", Main = "Noted";
			var pillNames = new List<string>();
			var pillAt = new List<Rectangle>();
			int pillHover = -1, pillShift = 0;
			float markX = -1, markW = 0;
			Font pillFont = new Font(UiBold, 9.5f), countFont = new Font(Ui, 8.5f);
			Func<string, string> chatName = book => { return book == null ? "All chats" : book.Length == 0 ? "Noted" : book; };
			Func<string, int> countIn = pill =>
			{
				if (pill == Everything) return all.Count;
				string book = pill == Main ? "" : pill;
				int n = 0;
				foreach (string b1 in books) if (string.Equals(b1, book, Loose)) n++;
				return n;
			};
			Func<int> pillNow = delegate { string now = inBook == null ? Everything : inBook.Length == 0 ? Main : inBook; return pillNames.IndexOf(now); };
			Action layPills = delegate
			{
				pillNames.Clear();
				pillAt.Clear();
				pillNames.Add(Main);
				pillNames.AddRange(Notebooks());
				pillNames.Add(Everything);
				pillNames.Add("+");
				int x = 14 - pillShift;
				foreach (string p in pillNames)
				{
					int w = p == "+" ? 30 : TextRenderer.MeasureText(p, pillFont).Width + TextRenderer.MeasureText(countIn(p).ToString(), countFont).Width + 22;
					pillAt.Add(new Rectangle(x, 6, w, 26));
					x += w + 6;
				}
				int most = Math.Max(0, x + pillShift - pills.Width + 8);
				if (pillShift > most) { pillShift = most; for (int i = 0; i < pillAt.Count; i++) pillAt[i] = new Rectangle(pillAt[i].X + (pillShift - most), 6, pillAt[i].Width, 26); }
			};
			Action glidePill = delegate
			{
				layPills();
				int i = pillNow();
				if (i < 0) return;
				Rectangle to = pillAt[i];
				if (markX < 0 || !pills.Visible) { markX = to.X; markW = to.Width; pills.Invalidate(); return; }
				float fromX = markX, fromW = markW;
				Ease(pills, 200, e => { markX = fromX + (to.X - fromX) * e; markW = fromW + (to.Width - fromW) * e; pills.Invalidate(); }, null);
			};
			pills.Paint += (sender, e) =>
			{
				Look look = mod.look;
				Graphics g = e.Graphics;
				g.SmoothingMode = SmoothingMode.AntiAlias;
				g.Clear(look.Shade(1));
				if (pillAt.Count != pillNames.Count) layPills();
				int now = pillNow();
				if (now >= 0 && markX >= 0)
					using (var lit = new SolidBrush(Mix(look.Shade(1), look.Shade(5), .22f))) using (Pen edge = new Pen(look.Shade(5)))
					{
						Point[] shape = CutEdge((int)markX, 6, (int)markW, 26, 6);
						g.FillPolygon(lit, shape);
						g.DrawPolygon(edge, shape);
					}
				for (int i = 0; i < pillNames.Count; i++)
				{
					Rectangle r = pillAt[i];
					string p = pillNames[i];
					if (i != now)
					{
						Point[] shape = CutEdge(r.X, r.Y, r.Width, r.Height, 6);
						using (var back = new SolidBrush(i == pillHover ? Mix(look.Shade(0), look.Shade(5), .1f) : look.Shade(0))) g.FillPolygon(back, shape);
						using (var edge = new Pen(i == pillHover ? Mix(look.Shade(6), look.Shade(5), .5f) : look.Shade(6))) g.DrawPolygon(edge, shape);
					}
					Color ink = i == now ? look.Shade(2) : i == pillHover ? look.Shade(2) : look.Shade(3);
					if (p == "+") { TextRenderer.DrawText(g, "", Icons(8.5f), r, ink, TextFormatFlags.HorizontalCenter | TextFormatFlags.VerticalCenter); continue; }
					string count = countIn(p).ToString();
					int cw = TextRenderer.MeasureText(count, countFont).Width;
					TextRenderer.DrawText(g, p, pillFont, new Rectangle(r.X + 9, r.Y, r.Width - cw - 12, r.Height), ink, TextFormatFlags.VerticalCenter | TextFormatFlags.NoPrefix | TextFormatFlags.EndEllipsis);
					TextRenderer.DrawText(g, count, countFont, new Rectangle(r.Right - cw - 7, r.Y + 1, cw, r.Height), i == now ? look.Shade(5) : look.Shade(3), TextFormatFlags.VerticalCenter | TextFormatFlags.NoPrefix);
				}
			};
			Func<Point, int> pillUnder = p => { for (int i = 0; i < pillAt.Count; i++) if (pillAt[i].Contains(p)) return i; return -1; };
			pills.MouseMove += (sender, e) => { int i = pillUnder(e.Location); if (i != pillHover) { pillHover = i; pills.Invalidate(); } };
			pills.MouseLeave += delegate { pillHover = -1; pills.Invalidate(); };
			pills.MouseWheel += (sender, e) => { pillShift = Math.Max(0, pillShift - e.Delta / 3); layPills(); markX = -1; glidePill(); };
			pills.Resize += delegate { layPills(); markX = -1; glidePill(); };
			new ToolTip().SetToolTip(pills, "Your Noted chats. Right-click one to rename or delete it.");

			// ---- The feed: oldest at the top, newest at the bottom by the box, like a chat ----
			feed = new Panel { TabStop = false };
			feed.Dock = DockStyle.Fill;
			Buffered(feed);
			var rows = new List<NoteRow>();
			float scroll = 0, aim = 0, barShow = 0;
			int total = 0;
			NoteRow hovered = null;
			int hoverButton = -1;
			bool dragBar = false;
			int dragFrom = 0;
			float dragWas = 0;
			DateTime scrolledAt = DateTime.MinValue;
			object undoId = null;
			int undoAt = -1;
			string[] undoNote = null;
			long undoWhen = 0;
			DateTime undoUntil = DateTime.MinValue;
			Rectangle undoRect = Rectangle.Empty;
			Font body = new Font(Ui, 10.5f), bold = new Font(UiBold, 10.5f), small = new Font(Ui, 8.5f), divider = new Font(UiBold, 8f);
			Font glyphs = Icons(9f);
			const TextFormatFlags Wrap = TextFormatFlags.WordBreak | TextFormatFlags.NoPrefix | TextFormatFlags.TextBoxControl;
			const int Side = 12, Pad = 14, Folded = 230;
			var clock = new WinTimer { Interval = 15 };

			Func<int> cardWide = delegate { return Math.Max(120, feed.ClientSize.Width - Side - 18); };
			Func<int> maxScroll = delegate { return Math.Max(0, total - feed.ClientSize.Height); };
			Action kick = delegate { if (!clock.Enabled && !feed.IsDisposed) clock.Start(); };
			Func<string, bool> isLink = text => { string[] l = text.Replace("\r", "").Trim().Split('\n'); return l.Length <= 2 && Regex.IsMatch(l[l.Length - 1].Trim(), @"^https?://\S+$"); };

			// How tall a card is at this width, and its picture (drawn once, again only when the width or look changes).
			Func<NoteRow, int, Bitmap> drawCard = null;
			Func<NoteRow, int, int> measure = (row, w) =>
			{
				int i = ids.IndexOf(row.Id);
				if (i < 0) return 0;
				string text = plain[i].Replace("\r", "").Trim();
				Match url = Regex.Match(text, @"https?://[^\s<>""]+");
				row.Url = url.Success ? url.Value.TrimEnd('.', ',', ')', ';') : null;
				int inner = w - Pad * 2, h;
				if (all[i].Contains("\\pict"))
				{
					if (row.Picture == null || row.Wide != w) { if (row.Picture != null) row.Picture.Dispose(); row.Picture = drawCard(row, w); row.Wide = w; }
					return row.Picture == null ? 60 : row.Picture.Height;
				}
				if (!all[i].Contains("\\pict") && isLink(text))
				{
					string[] l = text.Split('\n');
					h = l.Length == 2 ? TextRenderer.MeasureText(l[0].Trim(), bold, new Size(inner, 0), Wrap).Height : 0;
					return Pad + h + 24 + 26;
				}
				h = TextRenderer.MeasureText(text, body, new Size(inner, 0), Wrap).Height;
				row.Long = h > Folded + 40;
				if (row.Long) h = (row.Open ? h : Folded) + 26;
				return Pad + h + 30;
			};
			drawCard = (row, w) =>
			{
				int i = ids.IndexOf(row.Id);
				if (i < 0) return null;
				Look look = mod.look;
				Color back = Mix(look.Shade(1), look.Shade(5), .05f), ink = look.Shade(2), faded = look.Shade(3);
				string text = plain[i].Replace("\r", "").Trim();
				int inner = w - Pad * 2;
				Bitmap rich = null;
				int h;
				if (all[i].Contains("\\pict"))
				{
					rich = PaintRich(all[i], inner, ink, back, 900);
					h = Pad + (rich == null ? 20 : rich.Height) + 30;
				}
				else h = row.Height > 0 && row.Wide == w ? row.Height : measure(row, w);
				var pic = new Bitmap(w, Math.Max(40, h));
				using (Graphics g = Graphics.FromImage(pic))
				{
					g.Clear(look.Shade(0));
					g.SmoothingMode = SmoothingMode.AntiAlias;
					Point[] shape = CutEdge(0, 0, w, pic.Height, 10);
					using (var fillIn = new SolidBrush(back)) g.FillPolygon(fillIn, shape);
					g.SmoothingMode = SmoothingMode.None;
					using (var edge = new Pen(look.Shade(6))) g.DrawPolygon(edge, shape);
					int y = Pad;
					row.Link = row.More = Rectangle.Empty;
					if (rich != null) { g.DrawImageUnscaled(rich, Pad, y); y += rich.Height; rich.Dispose(); }
					else if (isLink(text))
					{
						string[] l = text.Split('\n');
						Uri u;
						string address = l[l.Length - 1].Trim(), host = Uri.TryCreate(address, UriKind.Absolute, out u) ? u.Host : address;
						if (l.Length == 2) { Size t = TextRenderer.MeasureText(l[0].Trim(), bold, new Size(inner, 0), Wrap); TextRenderer.DrawText(g, l[0].Trim(), bold, new Rectangle(Pad, y, inner, t.Height), ink, Wrap); y += t.Height; }
						TextRenderer.DrawText(g, "↗  " + host, body, new Rectangle(Pad, y + 4, inner, 20), look.Shade(4), TextFormatFlags.NoPrefix | TextFormatFlags.EndEllipsis);
						row.Link = new Rectangle(0, 0, w, pic.Height);
						row.Url = address;
					}
					else
					{
						int full = TextRenderer.MeasureText(text, body, new Size(inner, 0), Wrap).Height, show = row.Long && !row.Open ? Folded : full;
						TextRenderer.DrawText(g, text, body, new Rectangle(Pad, y, inner, show), ink, Wrap | TextFormatFlags.EndEllipsis);
						if (row.Long && !row.Open)
							using (var fade = new LinearGradientBrush(new Rectangle(1, y + show - 40, w - 2, 41), Color.FromArgb(0, back), back, 90f))
								g.FillRectangle(fade, 1, y + show - 39, w - 2, 40);
						y += show;
						if (row.Long)
						{
							int nx = w / 2 - 24;
							g.SmoothingMode = SmoothingMode.AntiAlias;
							using (var notch = new SolidBrush(Mix(back, look.Shade(5), .22f))) g.FillPolygon(notch, new[] { new Point(nx, y + 6), new Point(nx + 48, y + 6), new Point(nx + 42, y + 20), new Point(nx + 6, y + 20) });
							using (var chevron = new Pen(look.Shade(5), 1.6f))
							{
								int cy = y + 13, d = row.Open ? -3 : 3;
								g.DrawLines(chevron, new[] { new Point(nx + 18, cy - d), new Point(nx + 24, cy + d), new Point(nx + 30, cy - d) });
							}
							g.SmoothingMode = SmoothingMode.None;
							row.More = new Rectangle(Pad, y, w - Pad * 2, 26);
							y += 26;
						}
					}
					// The bottom line: which chat (in All), the first link in it, and when.
					int x = Pad, line = pic.Height - 24;
					if (inBook == null && books[i].Length > 0)
					{
						Size t = TextRenderer.MeasureText(books[i], small);
						using (var tag = new SolidBrush(Mix(back, look.Shade(5), .18f))) g.FillRectangle(tag, x, line + 2, t.Width + 8, 16);
						TextRenderer.DrawText(g, books[i], small, new Point(x + 4, line + 3), look.Shade(2), TextFormatFlags.NoPrefix);
						x += t.Width + 14;
					}
					if (row.Url != null && row.Link.IsEmpty)
					{
						Uri u;
						string host = "↗ " + (Uri.TryCreate(row.Url, UriKind.Absolute, out u) ? u.Host : "link");
						Size t = TextRenderer.MeasureText(host, small);
						int room = Math.Max(30, Math.Min(t.Width, w - x - 90));
						TextRenderer.DrawText(g, host, small, new Rectangle(x, line + 3, room, 16), look.Shade(4), TextFormatFlags.NoPrefix | TextFormatFlags.EndEllipsis);
						row.Link = new Rectangle(x - 3, line, room + 6, 22);
					}
					TextRenderer.DrawText(g, edited[i] > 0 ? new DateTime(edited[i]).ToString("HH:mm") : "", small, new Rectangle(Pad, line + 3, w - Pad * 2, 16), faded, TextFormatFlags.Right | TextFormatFlags.NoPrefix);
					if (editing == row.Id) { using (Pen lit = new Pen(look.Shade(4), 2)) g.DrawPolygon(lit, CutEdge(1, 1, w - 2, pic.Height - 2, 9)); }
				}
				return pic;
			};
			Action<NoteRow> forget = row => { if (row.Picture != null) { row.Picture.Dispose(); row.Picture = null; } if (row.Was != null) { row.Was.Dispose(); row.Was = null; } row.Seen = 0; row.Wide = 0; };

			// Where everything goes. Rows ease from where they're drawn now to here.
			Action lay = delegate
			{
				int w = cardWide(), y = 12;
				foreach (NoteRow row in rows)
				{
					if (row.Header != null) row.Height = 30;
					else if (row.Wide != w || row.Height == 0) { forget(row); row.Height = measure(row, w); row.Wide = w; }
					row.Top = y;
					if (row.Shown < -9000) row.Shown = y;
					y += row.Height + (row.Header != null ? 2 : 10);
				}
				total = y + 6;
				aim = Math.Max(0, Math.Min(maxScroll(), aim));
				kick();
			};

			Func<int, bool> fits = i =>
			{
				return (inBook == null || string.Equals(books[i], inBook, Loose)) && (finding.Length == 0 || plain[i].IndexOf(finding, Loose) >= 0);
			};
			Func<object, float, NoteRow> newRow = (id, at) => { return new NoteRow { Id = id, Shown = at, Appear = 0 }; };
			Action toEnd = delegate { lay(); aim = maxScroll(); kick(); };
			// Rebuilds the list (a chat or search change). The cards fade in where they are, at the newest end.
			Action fill = delegate
			{
				foreach (NoteRow row in rows) forget(row);
				rows.Clear();
				hovered = null;
				var take = new List<int>();
				for (int i = 0; i < all.Count && take.Count < 150; i++) if (fits(i)) take.Add(i);
				take.Reverse();
				string day = null;
				foreach (int i in take)
				{
					string d = Day(edited[i]);
					if (d != day) { day = d; rows.Add(new NoteRow { Header = d, Shown = -9999, Appear = 0 }); }
					rows.Add(newRow(ids[i], -9999));
				}
				lay();
				scroll = aim = maxScroll();
				layPills();
				pills.Invalidate();
			};

			// ---- Painting ----
			var see = new ImageAttributes();
			feed.Paint += (sender, e) =>
			{
				Look look = mod.look;
				Graphics g = e.Graphics;
				g.Clear(look.Shade(0));
				int top = (int)Math.Round(scroll), high = feed.ClientSize.Height, w = cardWide();
				if (rows.Count == 0)
				{
					TextRenderer.DrawText(g, "", Icons(30f), new Rectangle(0, high / 2 - 90, feed.ClientSize.Width, 60), Mix(look.Shade(0), look.Shade(5), .45f), TextFormatFlags.HorizontalCenter);
					string say = finding.Length > 0 ? "No notes with “" + finding + "”" : "Nothing here yet";
					string under = finding.Length > 0 ? (inBook == null ? "Try other words." : "Try other words, or look in All.") : "Write a note below, paste or drop a picture,\nor ask Capri to add something.";
					TextRenderer.DrawText(g, say, bold, new Rectangle(20, high / 2 - 20, feed.ClientSize.Width - 40, 24), look.Shade(2), TextFormatFlags.HorizontalCenter | TextFormatFlags.NoPrefix);
					TextRenderer.DrawText(g, under, body, new Rectangle(20, high / 2 + 8, feed.ClientSize.Width - 40, 60), look.Shade(3), TextFormatFlags.HorizontalCenter | TextFormatFlags.WordBreak | TextFormatFlags.NoPrefix);
				}
				foreach (NoteRow row in rows)
				{
					int y = (int)Math.Round(row.Shown) - top + (int)((1 - row.Appear) * 14);
					int ch = row.Seen > 0 ? (int)row.Seen : row.Height;
					if (y > high || y + Math.Max(ch, row.Height) < 0) continue;
					if (row.Header != null)
					{
						Size t = TextRenderer.MeasureText(row.Header, divider);
						Color ink = Color.FromArgb((int)(255 * row.Appear), look.Shade(3));
						TextRenderer.DrawText(g, row.Header, divider, new Point(Side + 2, y + 10), Mix(look.Shade(0), look.Shade(3), row.Appear), TextFormatFlags.NoPrefix);
						using (var line = new Pen(Mix(look.Shade(0), look.Shade(6), row.Appear))) g.DrawLine(line, Side + t.Width + 8, y + 17, Side + w, y + 17);
						continue;
					}
					if (row.Picture == null || row.Wide != w) { if (row.Picture != null) row.Picture.Dispose(); row.Picture = drawCard(row, w); row.Wide = w; }
					if (row.Picture == null) continue;
					Bitmap face = row.Was ?? row.Picture;
					if (row.Seen > 0 && face.Height > 60 && face.Width == w)
					{
						// Opening or folding: the top as far as it's grown, then the card's own bottom line under it.
						int foot = Math.Min(30, ch / 2);
						g.SetClip(new Rectangle(Side, y, w, Math.Max(0, ch - foot)));
						g.DrawImageUnscaled(face, Side, y);
						g.ResetClip();
						g.DrawImage(face, new Rectangle(Side, y + ch - foot, w, foot), new Rectangle(0, face.Height - foot, w, foot), GraphicsUnit.Pixel);
					}
					else if (row.Appear >= .99f) g.DrawImageUnscaled(row.Picture, Side, y);
					else
					{
						var m = new ColorMatrix { Matrix33 = row.Appear };
						see.SetColorMatrix(m);
						g.DrawImage(row.Picture, new Rectangle(Side, y, row.Picture.Width, row.Picture.Height), 0, 0, row.Picture.Width, row.Picture.Height, GraphicsUnit.Pixel, see);
					}
					if (row.Hover > .02f)
					{
						int a = (int)(255 * row.Hover);
						using (var bar = new SolidBrush(Color.FromArgb(a, look.Shade(5)))) g.FillRectangle(bar, Side, y + 10, 3, ch - 20);
						using (var edge = new Pen(Color.FromArgb(a, Mix(look.Shade(6), look.Shade(5), .6f)))) g.DrawPolygon(edge, CutEdge(Side, y, w, ch, 10));
						string[] icons = { "", "", "" };
						Color back = Mix(look.Shade(1), look.Shade(5), .05f);
						for (int k = 0; k < 3; k++)
						{
							var r = new Rectangle(Side + w - 10 - (3 - k) * 28, y + 6, 26, 24);
							using (var pad = new SolidBrush(Color.FromArgb(a, row == hovered && hoverButton == k ? Mix(back, look.Shade(5), .3f) : Mix(back, look.Shade(0), .4f)))) g.FillRectangle(pad, r);
							TextRenderer.DrawText(g, icons[k], glyphs, r, Mix(back, k == 2 && row == hovered && hoverButton == k ? look.Shade(5) : look.Shade(2), row.Hover), TextFormatFlags.HorizontalCenter | TextFormatFlags.VerticalCenter);
						}
					}
				}
				// The scrollbar: thin, wider under the mouse, fades when not in use.
				if (total > high && barShow > .02f)
				{
					int thumb = Math.Max(30, high * high / total), at = (int)((high - thumb) * (scroll / Math.Max(1, maxScroll())));
					bool near = dragBar || feed.PointToClient(Cursor.Position).X > feed.ClientSize.Width - 14;
					int bw = near ? 6 : 3;
					using (var b1 = new SolidBrush(Color.FromArgb((int)(barShow * (near ? 230 : 150)), near ? look.Shade(5) : look.Shade(3)))) g.FillRectangle(b1, feed.ClientSize.Width - bw - 3, at + 2, bw, thumb - 4);
				}
				undoRect = Rectangle.Empty;
				if (DateTime.Now < undoUntil)
				{
					string said = "Note deleted";
					Size t = TextRenderer.MeasureText(said, body), u = TextRenderer.MeasureText("UNDO", bold);
					int bw = t.Width + u.Width + 44, bx = (feed.ClientSize.Width - bw) / 2, by = high - 50;
					g.SmoothingMode = SmoothingMode.AntiAlias;
					using (var b1 = new SolidBrush(look.Shade(1))) g.FillPolygon(b1, CutEdge(bx, by, bw, 36, 8));
					using (var edge = new Pen(look.Shade(5))) g.DrawPolygon(edge, CutEdge(bx, by, bw, 36, 8));
					g.SmoothingMode = SmoothingMode.None;
					TextRenderer.DrawText(g, said, body, new Point(bx + 14, by + 9), look.Shade(2), TextFormatFlags.NoPrefix);
					undoRect = new Rectangle(bx + t.Width + 22, by + 4, u.Width + 14, 28);
					TextRenderer.DrawText(g, "UNDO", bold, new Point(undoRect.X + 7, by + 9), look.Shade(4), TextFormatFlags.NoPrefix);
				}
			};

			// One clock for every movement; it stops when everything's settled.
			clock.Tick += delegate
			{
				if (feed.IsDisposed) { clock.Stop(); clock.Dispose(); return; }
				bool moving = false;
				aim = Math.Max(0, Math.Min(maxScroll(), aim));
				if (Math.Abs(aim - scroll) > .5f) { scroll += (aim - scroll) * .24f; moving = true; } else scroll = aim;
				foreach (NoteRow row in rows)
				{
					if (Math.Abs(row.Top - row.Shown) > .5f) { row.Shown += (row.Top - row.Shown) * .22f; moving = true; } else row.Shown = row.Top;
					if (row.Appear < 1) { row.Appear = Math.Min(1, row.Appear + .08f); moving = true; }
					if (row.Seen > 0)
					{
						if (Math.Abs(row.Height - row.Seen) > .5f) { row.Seen += (row.Height - row.Seen) * .22f; moving = true; }
						else { row.Seen = 0; if (row.Was != null) { row.Was.Dispose(); row.Was = null; } }
					}
					float want = row == hovered ? 1 : 0;
					if (Math.Abs(want - row.Hover) > .02f) { row.Hover += (want - row.Hover) * .3f; moving = true; } else row.Hover = want;
				}
				bool inUse = dragBar || (DateTime.Now - scrolledAt).TotalMilliseconds < 900 || feed.ClientRectangle.Contains(feed.PointToClient(Cursor.Position));
				float bar = inUse ? 1 : 0;
				if (Math.Abs(bar - barShow) > .02f) { barShow += (bar - barShow) * .2f; moving = true; } else barShow = bar;
				if (DateTime.Now < undoUntil.AddMilliseconds(100)) moving = true;
				feed.Invalidate();
				if (!moving) clock.Stop();
			};

			Func<Point, NoteRow> rowAt = p =>
			{
				int y = p.Y + (int)scroll;
				foreach (NoteRow row in rows) if (row.Header == null && y >= row.Top && y < row.Top + row.Height && p.X >= Side && p.X < Side + cardWide()) return row;
				return null;
			};
			Func<NoteRow, Point, int> buttonAt = (row, p) =>
			{
				int w = cardWide(), y = row.Top - (int)scroll;
				for (int k = 0; k < 3; k++) if (new Rectangle(Side + w - 10 - (3 - k) * 28, y + 6, 26, 24).Contains(p)) return k;
				return -1;
			};
			Func<NoteRow, Point, Point> inCard = (row, p) => new Point(p.X - Side, p.Y + (int)scroll - row.Top);

			// ---- What a card can do ----
			Action<object> edit = null;
			Action<object> drop = id =>
			{
				int i = ids.IndexOf(id);
				if (i < 0) return;
				if (editing == id) { editing = null; noteText.Clear(); }
				undoId = id; undoAt = i; undoNote = new[] { all[i], plain[i], books[i] }; undoWhen = edited[i];
				undoUntil = DateTime.Now.AddSeconds(6);
				all.RemoveAt(i); plain.RemoveAt(i); books.RemoveAt(i); edited.RemoveAt(i); ids.RemoveAt(i);
				store();
				int r = rows.FindIndex(x => x.Id == id);
				if (r >= 0)
				{
					forget(rows[r]);
					rows.RemoveAt(r);
					bool lonely = r > 0 && rows[r - 1].Header != null && (r == rows.Count || rows[r].Header != null);
					if (lonely) rows.RemoveAt(r - 1);
				}
				hovered = null;
				lay();
				layPills();
				pills.Invalidate();
				var gone = new WinTimer { Interval = 6100 };
				gone.Tick += delegate { gone.Stop(); gone.Dispose(); kick(); };
				gone.Start();
			};
			Action undo = delegate
			{
				if (undoNote == null) return;
				int at = Math.Min(Math.Max(0, undoAt), all.Count);
				all.Insert(at, undoNote[0]); plain.Insert(at, undoNote[1]); books.Insert(at, undoNote[2]); edited.Insert(at, undoWhen); ids.Insert(at, undoId);
				undoNote = null;
				undoUntil = DateTime.MinValue;
				store();
				float keep = aim;
				fill();
				aim = scroll = Math.Min(keep, maxScroll());
				kick();
			};
			Action<object> copy = id =>
			{
				int j = ids.IndexOf(id);
				if (j < 0) return;
				try { DataObject d = new DataObject(); if (all[j].StartsWith("{\\rtf")) d.SetData(DataFormats.Rtf, all[j]); d.SetData(DataFormats.UnicodeText, plain[j]); Clipboard.SetDataObject(d, true); } catch { }
				mod.Tell("Copied, choom.");
			};
			Action<object> menuFor = id =>
			{
				int i = ids.IndexOf(id);
				if (i < 0) return;
				ContextMenuStrip m = NewMenu();
				Match link = Regex.Match(plain[i], @"(?:https?|file)://\S+");
				Item(m.Items, "Edit", "", true, delegate { edit(id); });
				Item(m.Items, "Copy", "", true, delegate { copy(id); });
				Item(m.Items, "Work on this", "", true, delegate { int j = ids.IndexOf(id); if (j >= 0) mod.Study("solve", "at:" + edited[j], "work on this note"); });
				string first = Regex.Replace(plain[i].Replace("\r", "").Trim().Split('\n')[0], @"(?:https?|file)://\S+", "").Trim();
				if (first.Length > 2) Item(m.Items, "Research this", "", true, delegate { mod.Study("research", Clip(first, 150), first); });
				if (plain[i].Trim().Length > 0) Item(m.Items, "Read it to me", "", true, delegate { int j = ids.IndexOf(id); if (j >= 0) mod.Tell(Clip(Regex.Replace(plain[j], @"(?:https?|file)://\S+", "a link"), 700)); });
				if (link.Success) Item(m.Items, "Open link", "", true, delegate { OpenTab(null, link.Value, true); });
				var move = new ToolStripMenuItem("Move to") { ForeColor = mod.look.Shade(2) };
				var places = new List<string> { "" };
				places.AddRange(Notebooks());
				foreach (string place in places)
				{
					if (string.Equals(place, books[i], Loose)) continue;
					string into = place;
					var one = new ToolStripMenuItem(chatName(into)) { ForeColor = mod.look.Shade(2) };
					one.Click += delegate { int j = ids.IndexOf(id); if (j < 0) return; books[j] = into; store(); Later(delegate { fill(); }); };
					move.DropDownItems.Add(one);
				}
				if (move.DropDownItems.Count > 0) { move.DropDown.BackColor = mod.look.Shade(1); m.Items.Add(move); }
				Item(m.Items, "Delete", "", true, delegate { drop(id); });
				m.Show(Cursor.Position);
			};

			feed.MouseWheel += (sender, e) => { aim = Math.Max(0, Math.Min(maxScroll(), aim - e.Delta * .9f)); scrolledAt = DateTime.Now; kick(); };
			feed.MouseMove += (sender, e) =>
			{
				if (dragBar) { int high = feed.ClientSize.Height, thumb = Math.Max(30, high * high / Math.Max(1, total)); aim = scroll = Math.Max(0, Math.Min(maxScroll(), dragWas + (e.Y - dragFrom) * maxScroll() / (float)Math.Max(1, high - thumb))); feed.Invalidate(); return; }
				NoteRow row = rowAt(e.Location);
				int button = row == null ? -1 : buttonAt(row, e.Location);
				Point local = row == null ? Point.Empty : inCard(row, e.Location);
				bool hand = undoRect.Contains(e.Location) || button >= 0 || (row != null && (row.Link.Contains(local) || row.More.Contains(local)));
				feed.Cursor = hand ? Cursors.Hand : Cursors.Default;
				if (row != hovered || button != hoverButton) { hovered = row; hoverButton = button; kick(); }
				kick();
			};
			feed.MouseLeave += delegate { hovered = null; hoverButton = -1; kick(); };
			feed.MouseDown += (sender, e) =>
			{
				if (e.Button == MouseButtons.Left && total > feed.ClientSize.Height && e.X > feed.ClientSize.Width - 14) { dragBar = true; dragFrom = e.Y; dragWas = scroll; feed.Capture = true; kick(); }
			};
			feed.MouseUp += (sender, e) =>
			{
				if (dragBar) { dragBar = false; feed.Capture = false; scrolledAt = DateTime.Now; kick(); return; }
				if (e.Button == MouseButtons.Left && undoRect.Contains(e.Location)) { undo(); return; }
				NoteRow row = rowAt(e.Location);
				if (row == null) return;
				if (e.Button == MouseButtons.Right) { menuFor(row.Id); return; }
				if (e.Button != MouseButtons.Left) return;
				int button = buttonAt(row, e.Location);
				if (button == 0) { edit(row.Id); return; }
				if (button == 1) { copy(row.Id); return; }
				if (button == 2) { drop(row.Id); return; }
				Point local = inCard(row, e.Location);
				if (row.More.Contains(local))
				{
					// The open card is kept while it folds; the new one is drawn as it grows. The cards under it move with it.
					int was = row.Height;
					Bitmap open = row.Open ? row.Picture : null;
					if (open != null) row.Picture = null;
					forget(row);
					row.Open = !row.Open;
					row.Height = 0;
					lay();
					row.Was = open;
					row.Seen = was;
					kick();
					return;
				}
				if (row.Link.Contains(local) && row.Url != null) OpenTab(null, row.Url, true);
			};
			feed.DoubleClick += delegate { NoteRow row = rowAt(feed.PointToClient(Cursor.Position)); if (row != null && row.Link.IsEmpty) edit(row.Id); };
			feed.Resize += delegate { bool atEnd = aim >= maxScroll() - 2; lay(); if (atEnd) scroll = aim = maxScroll(); feed.Invalidate(); };

			// ---- The box at the bottom: write, paste or drop a picture, attach a file, add the page's link, then Enter ----
			var composer = new Panel { Dock = DockStyle.Bottom, Height = 62, Padding = new Padding(12, 8, 12, 12) };
			var paper = new Panel { Dock = DockStyle.Fill, Padding = new Padding(12, 9, 4, 5) };
			Buffered(composer);
			Buffered(paper);
			var editingNote = new Label { Dock = DockStyle.Bottom, Height = 24, Text = "EDITING A NOTE  ·  Enter saves  ·  Esc cancels", TextAlign = ContentAlignment.MiddleLeft, Padding = new Padding(14, 0, 0, 0), Font = new Font(UiBold, 8.5f), Visible = false };
			Button send = Flat("", "Send to Noted (Enter)", DockStyle.Right, 34);
			Button attach = Flat("", "Add a picture or a file", DockStyle.Right, 32);
			Button pageLink = Flat("", "Add this page's link", DockStyle.Right, 32);
			noteText.Dock = DockStyle.Fill;
			noteText.BorderStyle = BorderStyle.None;
			noteText.ScrollBars = RichTextBoxScrollBars.Vertical;
			noteText.DetectUrls = true;
			noteText.EnableAutoDragDrop = true;
			noteText.AcceptsTab = false;
			noteText.Font = new Font(Ui, 10.5f);
			var cue = new Label { Text = "Leave a note for yourself...", Left = 1, Top = 1, AutoSize = true, Cursor = Cursors.IBeam, Font = new Font(Ui, 10.5f) };
			cue.Click += delegate { noteText.Focus(); };
			Action hint = delegate { bool show = noteText.TextLength == 0 && !noteText.Focused; if (cue.Visible != show) { cue.Visible = show; noteText.Invalidate(); } };
			noteText.TextChanged += delegate { hint(); };
			int grow = 0;
			noteText.ContentsResized += (sender, e) =>
			{
				int to = Math.Max(62, Math.Min(190, e.NewRectangle.Height + 36)), from = composer.Height, my = ++grow;
				if (to == from) return;
				Ease(composer, 140, k => { if (my == grow) composer.Height = from + (int)((to - from) * k); }, null);
			};
			paper.Controls.Add(noteText);
			paper.Controls.Add(pageLink);
			paper.Controls.Add(attach);
			paper.Controls.Add(send);
			paper.Controls.Add(cue);
			cue.Location = new Point(13, 10);
			cue.BringToFront();
			composer.Controls.Add(paper);
			paper.Paint += (sender, e) =>
			{
				Look look = mod.look;
				Graphics g = e.Graphics;
				g.Clear(composer.BackColor);
				Point[] shape = CutEdge(0, 0, paper.Width, paper.Height, 9);
				g.SmoothingMode = SmoothingMode.AntiAlias;
				using (var fillIn = new SolidBrush(look.Shade(0))) g.FillPolygon(fillIn, shape);
				bool on = noteText.Focused;
				using (var edge = new Pen(editing != null ? look.Shade(4) : on ? look.Shade(5) : Mix(look.Shade(6), look.Shade(5), .3f), on || editing != null ? 1.6f : 1f)) g.DrawPolygon(edge, shape);
			};
			noteText.GotFocus += delegate { hint(); paper.Invalidate(); };
			noteText.LostFocus += delegate { hint(); paper.Invalidate(); };
			composer.Paint += (sender, e) => { using (Pen line = new Pen(mod.look.Shade(6))) e.Graphics.DrawLine(line, 0, 0, composer.Width, 0); };
			notePaper = composer;

			edit = id =>
			{
				int i = ids.IndexOf(id);
				if (i < 0) return;
				object was = editing;
				editing = id;
				if (all[i].StartsWith("{\\rtf")) { try { noteText.Rtf = all[i]; } catch (Exception) { noteText.Text = plain[i]; } } else noteText.Text = all[i];
				noteText.SelectAll();
				noteText.SelectionColor = mod.look.Shade(2);
				editingNote.Visible = true;
				noteText.Focus();
				noteText.SelectionStart = noteText.TextLength;
				foreach (NoteRow row in rows) if (row.Id == id || row.Id == was) forget(row);
				paper.Invalidate();
				kick();
			};
			Action stopEditing = delegate
			{
				object was = editing;
				editing = null;
				editingNote.Visible = false;
				foreach (NoteRow row in rows) if (row.Id == was) forget(row);
				paper.Invalidate();
				kick();
			};

			// Picture into the box: scaled down to fit, through the clipboard (what RichTextBox takes), then their clipboard put back.
			Action<Image> putPicture = picture =>
			{
				if (picture == null) return;
				try { picture.Save(Path.Combine(Path.GetTempPath(), "capri-noted-last.png"), ImageFormat.Png); Keep("notedlast", DateTime.Now.Ticks.ToString()); } catch { }
				int widest = Math.Max(140, Math.Min(320, noteText.ClientSize.Width - 30));
				float scale = Math.Min(1f, Math.Min(widest / (float)picture.Width, widest * .75f / picture.Height));
				IDataObject held = null;
				using (var shrunk = new Bitmap(Math.Max(1, (int)(picture.Width * scale)), Math.Max(1, (int)(picture.Height * scale))))
				{
					using (Graphics g = Graphics.FromImage(shrunk)) { g.InterpolationMode = InterpolationMode.HighQualityBicubic; g.DrawImage(picture, 0, 0, shrunk.Width, shrunk.Height); }
					try { held = Clipboard.GetDataObject(); Clipboard.SetImage(shrunk); noteText.Paste(); noteText.ScrollToCaret(); noteText.Refresh(); } catch { }
				}
				try { if (held != null) Clipboard.SetDataObject(held, true); } catch { }
			};

			Action post = delegate
			{
				bool pic = noteText.Rtf.Contains("\\pict");
				if (noteText.Text.Trim().Length == 0 && !pic) return;
				string rtf = noteText.Rtf, words = noteText.Text.Trim();
				int was = editing == null ? -1 : ids.IndexOf(editing);
				if (was >= 0)
				{
					all[was] = rtf; plain[was] = words; edited[was] = DateTime.Now.Ticks;
					object id0 = editing;
					stopEditing();
					noteText.Clear();
					store();
					foreach (NoteRow row in rows) if (row.Id == id0) { forget(row); row.Height = 0; }
					lay();
					feed.Refresh();
					return;
				}
				stopEditing();
				Bump("notes", 1);
				string into = pickBook != null ? BookFor(pickBook) : inBook ?? "";
				pickBook = null;
				bool switched = inBook != null && !string.Equals(inBook, into, Loose);
				if (switched) { inBook = into; ShowBook(); }
				object id = new object();
				all.Insert(0, rtf); plain.Insert(0, words); books.Insert(0, into); edited.Insert(0, DateTime.Now.Ticks); ids.Insert(0, id);
				noteText.Clear();
				store();
				if (switched || finding.Length > 0) { fill(); return; }
				// The new card rises in at the bottom, under a Today divider if there isn't one yet.
				lay();
				float from = total;
				if (rows.Count == 0 || rows.FindLastIndex(x => x.Header != null) < 0 || rows[rows.FindLastIndex(x => x.Header != null)].Header != "TODAY")
					rows.Add(new NoteRow { Header = "TODAY", Shown = from, Appear = 0 });
				NoteRow fresh = newRow(id, from + 30);
				fresh.Appear = .5f;
				rows.Add(fresh);
				toEnd();
				feed.Refresh();
				noteText.Refresh();
				layPills();
				pills.Invalidate();
			};
			send.Click += delegate { post(); noteText.Focus(); };
			noteText.KeyDown += (sender, e) =>
			{
				if (e.KeyCode == Keys.Enter && !e.Shift && !e.Control) { e.SuppressKeyPress = true; post(); }
				else if (e.KeyCode == Keys.Escape && editing != null) { e.SuppressKeyPress = true; stopEditing(); noteText.Clear(); }
				else if (e.KeyCode == Keys.Escape) { e.SuppressKeyPress = true; SlideIn(notes, notes.Width); }
				else if (((e.Control && e.KeyCode == Keys.V) || (e.Shift && e.KeyCode == Keys.Insert)) && Clipboard.ContainsImage()) { e.SuppressKeyPress = true; using (Image pasted = Clipboard.GetImage()) putPicture(pasted); }
				else if (((e.Control && e.KeyCode == Keys.V) || (e.Shift && e.KeyCode == Keys.Insert)) && !Clipboard.ContainsImage() && Clipboard.ContainsText()) { e.SuppressKeyPress = true; noteText.SelectionColor = mod.look.Shade(2); noteText.SelectedText = Clipboard.GetText(); noteText.ScrollToCaret(); noteText.Refresh(); }
			};
			noteText.LinkClicked += (sender, e) => { OpenLink(e.LinkText); };
			attach.Click += delegate
			{
				using (var pick = new OpenFileDialog { Title = "Add to Noted", Filter = "Pictures and files|*.*|Pictures|*.png;*.jpg;*.jpeg;*.gif;*.bmp" })
				{
					if (pick.ShowDialog(FindForm()) != DialogResult.OK) return;
					string f = pick.FileName;
					if (Regex.IsMatch(Path.GetExtension(f), @"^\.(?:png|jpe?g|gif|bmp)$", RegexOptions.IgnoreCase))
					{
						try { using (Image im = Image.FromFile(f)) putPicture(im); } catch (Exception) { mod.Tell("I couldn't open that picture, choom."); }
					}
					else
					{
						long size = 0;
						try { size = new FileInfo(f).Length; } catch { }
						noteText.SelectedText = Path.GetFileName(f) + "  (" + (size >= 1048576 ? (size / 1048576.0).ToString("0.0") + " MB" : Math.Max(1, size / 1024) + " KB") + ")\n" + new Uri(f).AbsoluteUri + "\n";
					}
					noteText.Focus();
				}
			};

			// Capri's own notes, and the page's link, go straight in as cards; whatever they were writing stays in the box.
			Action<Action> keepDraft = work =>
			{
				string draft = noteText.TextLength > 0 || noteText.Rtf.Contains("\\pict") ? noteText.Rtf : null;
				object wasEditing = editing;
				editing = null;
				noteText.Clear();
				work();
				post();
				if (draft != null) { try { noteText.Rtf = draft; } catch { } }
				editing = wasEditing;
				editingNote.Visible = editing != null;
			};
			textNote = text => { ShowSide(notes, NotesWide()); keepDraft(delegate { noteText.SelectedText = text; }); };
			noteInto = (text, book) => { pickBook = book ?? ""; textNote(text); };
			snapNote = (title, picture) =>
			{
				ShowSide(notes, NotesWide());
				keepDraft(delegate { noteText.SelectedText = title + "\n"; putPicture(picture); });
			};
			pageLink.Click += delegate
			{
				Tab t = tab;
				if (t == null || t.OnReader || t.Address == null || t.Private) { mod.Tell("Open a site first, choom."); return; }
				textNote(t.Title + "\n" + t.Address);
			};

			// ---- Chats: picking, making, renaming, deleting ----
			ShowBook = delegate
			{
				if (inBook != null && inBook.Length > 0 && !new List<string>(Notebooks()).Contains(inBook)) inBook = "";
				NoteBookShown = inBook;
				named.Text = inBook == null || inBook.Length == 0 ? (inBook == null ? "Noted  ·  All" : "Noted") : "Noted  ·  " + inBook;
				glidePill();
			};
			Action makeChat = delegate
			{
				string name = AskName("New Noted chat", "What's this chat for? Like Shopping, School or Game ideas.", "");
				if (name == null) return;
				var mine = new List<string>(Notebooks());
				string found = mine.Find(b1 => string.Equals(b1, name, Loose));
				if (found == null) { mine.Add(name); Keep("notebooks", string.Join("\u001e", mine.ToArray())); found = name; }
				inBook = found;
			};
			Action<string> chatMenu = now =>
			{
				ContextMenuStrip m = NewMenu();
				Item(m.Items, "Rename \"" + now + "\"", "", true, delegate
				{
					string name = AskName("Rename Noted chat", "A new name for \"" + now + "\".", now);
					if (name == null || name == now) return;
					var mine = new List<string>(Notebooks());
					int i = mine.IndexOf(now);
					if (i >= 0) mine[i] = name;
					Keep("notebooks", string.Join("\u001e", mine.ToArray()));
					for (int j = 0; j < books.Count; j++) if (books[j] == now) books[j] = name;
					if (inBook == now) inBook = name;
					store(); ShowBook(); fill();
				});
				Item(m.Items, "Delete \"" + now + "\" (its notes move to Noted)", "", true, delegate
				{
					var mine = new List<string>(Notebooks());
					mine.Remove(now);
					Keep("notebooks", string.Join("\u001e", mine.ToArray()));
					for (int j = 0; j < books.Count; j++) if (books[j] == now) books[j] = "";
					if (inBook == now) inBook = "";
					store(); ShowBook(); fill();
				});
				m.Show(Cursor.Position);
			};
			pills.MouseUp += (sender, e) =>
			{
				int i = pillUnder(e.Location);
				if (i < 0) return;
				string p = pillNames[i];
				if (e.Button == MouseButtons.Right) { if (p != Main && p != Everything && p != "+") chatMenu(p); return; }
				if (e.Button != MouseButtons.Left) return;
				if (p == "+") makeChat();
				else inBook = p == Everything ? null : p == Main ? "" : p;
				ShowBook();
				fill();
			};

			// Search waits until they stop typing for a moment.
			var search = new TextBox();
			Panel searchRow = Ring(search, "Search Noted");
			var typing = new WinTimer { Interval = 160 };
			typing.Tick += delegate { typing.Stop(); string now = search.Text.Trim(); if (now == finding) return; finding = now; fill(); };
			search.TextChanged += delegate { typing.Stop(); typing.Start(); };
			search.KeyDown += (sender, e) => { if (e.KeyCode == Keys.Escape && search.TextLength > 0) { e.SuppressKeyPress = true; search.Clear(); } };

			Color tinted = Color.Empty;
			noteTint = delegate
			{
				Look look = mod.look;
				bool changed = tinted != look.Shade(1);
				tinted = look.Shade(1);
				notes.BackColor = head.BackColor = pills.BackColor = searchRow.BackColor = look.Shade(1);
				foreach (Control part in head.Controls) if ("red".Equals(part.Tag)) part.ForeColor = look.Shade(5); else part.ForeColor = look.Shade(3);
				named.ForeColor = look.Shade(2);
				search.BackColor = look.Shade(0);
				search.ForeColor = look.Shade(2);
				feed.BackColor = look.Shade(0);
				composer.BackColor = look.Shade(1);
				paper.BackColor = noteText.BackColor = look.Shade(0);
				noteText.ForeColor = look.Shade(2);
				cue.ForeColor = look.Shade(3);
				cue.BackColor = look.Shade(0);
				editingNote.ForeColor = look.Shade(4);
				editingNote.BackColor = look.Shade(1);
				foreach (Button b in new[] { send, attach, pageLink }) { b.BackColor = look.Shade(0); b.ForeColor = look.Shade(3); b.FlatAppearance.MouseOverBackColor = Mix(look.Shade(0), look.Shade(5), .2f); }
				send.ForeColor = look.Shade(5);
				if (changed) foreach (NoteRow row in rows) forget(row);
				pills.Invalidate();
				paper.Invalidate();
				feed.Invalidate();
			};
			notes.VisibleChanged += delegate { if (notes.Visible) { noteTint(); lay(); scroll = aim = maxScroll(); glidePill(); kick(); } };
			ShowBook();
			noteTint();
			fill();
			notes.Controls.Add(feed);
			notes.Controls.Add(editingNote);
			notes.Controls.Add(composer);
			notes.Controls.Add(searchRow);
			notes.Controls.Add(pills);
			notes.Controls.Add(head);
			feed.BringToFront();
			notes.Width = NotesWide();
			DarkScroll(noteText);
		}

		void OpenLink(string link)
		{
			if (link.StartsWith("file:", Loose))
			{
				try { Process.Start("explorer.exe", "/select,\"" + new Uri(link).LocalPath + "\""); } catch { }
				return;
			}
			OpenTab(null, link, true);
		}

		// ---- Bookmarks: their own, in folders, behind the sidebar's star (Ctrl+Shift+B), with a star in the address box ----

		sealed class Mark { public string Folder, Title, Url; }
		// Popup cards: an empty dropdown, the holder for its card, and the card's border, adding and tidy-up when it shuts.
		static ToolStripDropDown NewDrop(Color back) { return new ToolStripDropDown { Padding = Padding.Empty, Margin = Padding.Empty, DropShadowEnabled = true, BackColor = back }; }
		static ToolStripControlHost Holder(Control card) { return new ToolStripControlHost(card) { Padding = Padding.Empty, Margin = Padding.Empty, AutoSize = false, Size = card.Size }; }
		void Hold(ToolStripDropDown drop, Control card, ToolStripControlHost holder, Color edge)
		{
			card.Paint += (sender, e) => { using (Pen line = new Pen(edge)) e.Graphics.DrawRectangle(line, 0, 0, card.Width - 1, card.Height - 1); };
			drop.Items.Add(holder);
			drop.Closed += delegate { menuShut = DateTime.Now; Later(delegate { drop.Dispose(); }); };
		}
		void KeepFolders(List<string> folders) { Keep("bookfolders", string.Join("\u001e", folders.ToArray())); }
		List<string> BookFolders() { return new List<string>(Kept("bookfolders").Split(new[] { '\u001e' }, StringSplitOptions.RemoveEmptyEntries)); }
		readonly TreeView markTree = new TreeView();
		readonly Label star = new Label { Text = "\uE734", Dock = DockStyle.Right, Width = 30, TextAlign = ContentAlignment.MiddleCenter, Font = Icons(11f), Cursor = Cursors.Hand };
		readonly ToolTip starTip = new ToolTip();
		Action marksChanged = delegate { };
		string starAt;
		const int MarksWide = 320;

		static string Flat1(string text) { return Regex.Replace(text ?? "", @"[\t\r\n\u001e]+", " ").Trim(); }

		List<Mark> Marks()
		{
			var got = new List<Mark>();
			foreach (string line in Kept("bookmarks").Split('\n'))
			{
				string[] p = line.Split('\t');
				if (p.Length == 3 && p[2].Length > 0) got.Add(new Mark { Folder = p[0], Title = p[1], Url = p[2] });
			}
			return got;
		}

		void SaveMarks(List<Mark> list)
		{
			var s = new StringBuilder();
			foreach (Mark m in list) s.Append(Flat1(m.Folder)).Append('\t').Append(Flat1(m.Title)).Append('\t').Append(Flat1(m.Url)).Append('\n');
			Keep("bookmarks", s.ToString());
			marksChanged();
			ShowStar();
		}

		List<string> MarkFolders(List<Mark> list)
		{
			List<string> got = BookFolders();
			foreach (Mark m in list) if (m.Folder.Length > 0 && !got.Contains(m.Folder)) got.Add(m.Folder);
			return got;
		}

		static int Same(List<Mark> list, Mark m)
		{
			for (int i = 0; i < list.Count; i++) if (list[i].Url == m.Url && list[i].Folder == m.Folder && list[i].Title == m.Title) return i;
			return -1;
		}

		// Bookmarks the page in front (or takes it off). Null when done, or what to tell them.
		internal string MarkThis(bool toggle)
		{
			Tab t = tab;
			if (t == null || t.OnReader || t.Address == null) return "Open a site first, choom.";
			List<Mark> list = Marks();
			int had = list.FindIndex(m => m.Url == t.Address);
			if (had >= 0)
			{
				if (!toggle) return "That one's already in your bookmarks, choom.";
				list.RemoveAll(m => m.Url == t.Address);
			}
			else list.Add(new Mark { Folder = "", Title = t.Title, Url = t.Address });
			SaveMarks(list);
			if (had < 0) Ease(star, 260, e => { star.Font = new Font("Segoe MDL2 Assets", 11f + 4f * (float)Math.Sin(e * Math.PI)); }, delegate { star.Font = Icons(11f); });
			return null;
		}

		internal void ShowMarks() { ToggleSide(marks, marks.Width); }

		void ShowStar()
		{
			Tab t = tab;
			bool page = t != null && !t.OnReader && t.Address != null;
			starAt = page ? t.Address : null;
			bool on = page && Marks().Exists(m => m.Url == t.Address);
			star.Visible = page;
			star.Text = on ? "\uE735" : "\uE734";
			star.ForeColor = on ? mod.look.Shade(5) : mod.look.Shade(3);
			starTip.SetToolTip(star, on ? "Remove bookmark (Ctrl+Shift+D)" : "Bookmark this page (Ctrl+Shift+D)");
		}

		void BuildMarks()
		{
			marks.Dock = DockStyle.Left;
			int savedWide;
			marks.Width = int.TryParse(Kept("markswidth"), out savedWide) ? Math.Max(260, Math.Min(720, savedWide)) : MarksWide;
			marks.Visible = false;
			marks.Padding = new Padding(0, 0, 0, 8);
			Buffered(marks);
			Label title;
			Panel head = SideHead(marks, "\uE734", "Bookmarks", out title);
			var find = new TextBox();
			Panel findRow = Ring(find, "Search bookmarks");
			Panel ring = (Panel)findRow.Controls[0];
			var shut = new Button();

			var tools = new FlowLayoutPanel { Dock = DockStyle.Top, Height = 34, Padding = new Padding(10, 0, 10, 4), WrapContents = false };
			Func<string, string, Button> tool = (words, tip) =>
			{
				var b = new Button { Text = words, AutoSize = true, Height = 28, FlatStyle = FlatStyle.Flat, TabStop = false, Cursor = Cursors.Hand, Font = new Font(Ui, 9.5f), Margin = new Padding(0, 0, 6, 0) };
				b.FlatAppearance.BorderSize = 1;
				new ToolTip().SetToolTip(b, tip);
				tools.Controls.Add(b);
				return b;
			};
			Button addPage = tool("+ This page", "Bookmark the page in front (Ctrl+Shift+D)");
			Button newFolder = tool("New folder", "Make a folder for bookmarks");
			Button import = tool("Import", "Bring bookmarks over from Chrome, Edge, Opera, Opera GX, Brave or Vivaldi");
			var status = new Label { Dock = DockStyle.Bottom, Height = 24, Padding = new Padding(16, 0, 8, 0), TextAlign = ContentAlignment.MiddleLeft, Font = new Font(Ui, 9f) };

			markTree.Dock = DockStyle.Fill;
			markTree.BorderStyle = BorderStyle.None;
			markTree.ShowLines = false;
			markTree.ShowRootLines = true;
			markTree.ShowPlusMinus = true;
			markTree.FullRowSelect = true;
			markTree.HotTracking = true;
			markTree.ShowNodeToolTips = true;
			markTree.ItemHeight = 30;
			markTree.DrawMode = TreeViewDrawMode.OwnerDrawAll;
			markTree.ShowPlusMinus = false;
			markTree.ShowRootLines = false;
			TreeNode hovered = null;
			Buffered(markTree);
			DarkScroll(markTree);
			markTree.MouseMove += (sender, e) => { TreeNode n = markTree.GetNodeAt(e.Location); if (n != hovered) { hovered = n; markTree.Invalidate(); } };
			markTree.MouseLeave += delegate { hovered = null; markTree.Invalidate(); };
			markTree.AfterExpand += delegate { markTree.Invalidate(); };
			markTree.AfterCollapse += delegate { markTree.Invalidate(); };
			markTree.DrawNode += (sender, e) =>
			{
				if (e.Bounds.Height <= 0) return;
				Look look = mod.look;
				Graphics g = e.Graphics;
				var row = new Rectangle(0, e.Bounds.Y, markTree.ClientSize.Width, e.Bounds.Height);
				bool on = e.Node == markTree.SelectedNode && markTree.Focused, over = e.Node == hovered;
				using (var back = new SolidBrush(on ? Mix(look.Shade(1), look.Shade(5), .22f) : over ? Mix(look.Shade(1), look.Shade(5), .1f) : look.Shade(1))) g.FillRectangle(back, row);
				if (on) using (SolidBrush bar = new SolidBrush(look.Shade(5))) g.FillRectangle(bar, 0, row.Y + 5, 3, row.Height - 10);
				int x = 8 + e.Node.Level * 20;
				bool folder = e.Node.Tag is string;
				using (Font icons = Icons(8f))
					if (folder) TextRenderer.DrawText(g, e.Node.IsExpanded ? "\uE70D" : "\uE76C", icons, new Rectangle(x, row.Y, 16, row.Height), look.Shade(3), TextFormatFlags.VerticalCenter | TextFormatFlags.HorizontalCenter);
				x += 18;
				if (markTree.ImageList != null && e.Node.ImageIndex >= 0 && e.Node.ImageIndex < markTree.ImageList.Images.Count) g.DrawImage(markTree.ImageList.Images[e.Node.ImageIndex], x, row.Y + (row.Height - 18) / 2);
				x += 24;
				TextRenderer.DrawText(g, e.Node.Text, folder ? new Font(UiBold, 10f) : markTree.Font, new Rectangle(x, row.Y, row.Width - x - 6, row.Height), e.Node.Tag == null ? look.Shade(3) : look.Shade(2), TextFormatFlags.VerticalCenter | TextFormatFlags.EndEllipsis | TextFormatFlags.NoPrefix);
			};
			markTree.Indent = 20;
			markTree.Font = new Font(Ui, 10.5f);
			markTree.AllowDrop = true;
			var glyphs = new ImageList { ImageSize = new Size(18, 18), ColorDepth = ColorDepth.Depth32Bit };
			markTree.ImageList = glyphs;
			var treeBox = new Panel { Dock = DockStyle.Fill, Padding = new Padding(10, 2, 4, 0) };
			treeBox.Controls.Add(markTree);

			Action tintMarks = delegate
			{
				Look look = mod.look;
				marks.BackColor = head.BackColor = findRow.BackColor = tools.BackColor = treeBox.BackColor = look.Shade(1);
				title.ForeColor = look.Shade(2);
				TintHead(head, title, look);
				status.ForeColor = look.Shade(3);
				status.BackColor = look.Shade(1);
				find.BackColor = look.Shade(0);
				find.ForeColor = look.Shade(2);
				markTree.BackColor = look.Shade(1);
				markTree.ForeColor = look.Shade(2);
				markTree.LineColor = look.Shade(3);
				foreach (Control c in tools.Controls) { Button b = c as Button; if (b == null) continue; b.BackColor = look.Shade(0); b.ForeColor = look.Shade(2); b.FlatAppearance.BorderColor = look.Shade(6); b.FlatAppearance.MouseOverBackColor = Mix(look.Shade(0), look.Shade(5), .25f); }
				glyphs.Images.Clear();
				foreach (string[] g in new[] { new[] { "\uE8B7", "3" }, new[] { "\uE774", "5" }, new[] { "\uE734", "5" } })
				{
					var b = new Bitmap(18, 18);
					using (Graphics gr = Graphics.FromImage(b))
					{
						gr.TextRenderingHint = TextRenderingHint.AntiAliasGridFit;
						using (Font f = Icons(10.5f))
						using (var ink = new SolidBrush(look.Shade(int.Parse(g[1]))))
						using (var mid = new StringFormat { Alignment = StringAlignment.Center, LineAlignment = StringAlignment.Center })
							gr.DrawString(g[0], f, ink, new RectangleF(0, 0, 18, 18), mid);
					}
					glyphs.Images.Add(b);
				}
				bool dark = look.Shade(1).GetBrightness() < .5f;
				if (markTree.IsHandleCreated) SetWindowTheme(markTree.Handle, dark ? "DarkMode_Explorer" : "Explorer", null);
				ring.Invalidate();
			};
			markTree.HandleCreated += delegate { bool dark = mod.look.Shade(1).GetBrightness() < .5f; SetWindowTheme(markTree.Handle, dark ? "DarkMode_Explorer" : "Explorer", null); };

			Func<Mark, TreeNode> leaf = m => { return new TreeNode(m.Title.Length > 0 ? m.Title : m.Url, 1, 1) { Tag = m, ToolTipText = m.Url }; };
			Action fillTree = delegate
			{
				string q = find.Text.Trim();
				List<Mark> list = Marks();
				var open = new HashSet<string>();
				foreach (TreeNode n in markTree.Nodes) if (n.IsExpanded && n.Tag is string) open.Add((string)n.Tag);
				bool first = markTree.Nodes.Count == 0;
				markTree.BeginUpdate();
				markTree.Nodes.Clear();
				if (q.Length > 0)
				{
					foreach (Mark m in list) if (m.Title.IndexOf(q, Loose) >= 0 || m.Url.IndexOf(q, Loose) >= 0) markTree.Nodes.Add(leaf(m));
					if (markTree.Nodes.Count == 0) markTree.Nodes.Add(new TreeNode("No bookmarks match.", 2, 2));
				}
				else
				{
					var main = new TreeNode("Bookmarks", 2, 2) { Tag = "" };
					markTree.Nodes.Add(main);
					var folders = new Dictionary<string, TreeNode>();
					foreach (string f in MarkFolders(list)) { TreeNode n = new TreeNode(f, 0, 0) { Tag = f }; folders[f] = n; markTree.Nodes.Add(n); }
					foreach (Mark m in list)
					{
						TreeNode into;
						(m.Folder.Length > 0 && folders.TryGetValue(m.Folder, out into) ? into : main).Nodes.Add(leaf(m));
					}
					if (first || open.Contains("")) main.Expand();
					foreach (TreeNode n in folders.Values) if (open.Contains((string)n.Tag)) n.Expand();
					if (list.Count == 0) main.Nodes.Add(new TreeNode("Click the star in the address box to bookmark a page.", 2, 2));
				}
				markTree.EndUpdate();
				status.Text = list.Count + (list.Count == 1 ? " bookmark" : " bookmarks");
			};
			marksChanged = delegate { if (!markTree.IsDisposed) fillTree(); };
			find.TextChanged += delegate { fillTree(); };

			markTree.NodeMouseClick += (sender, e) =>
			{
				markTree.SelectedNode = e.Node;
				Mark m = e.Node.Tag as Mark;
				string folder = e.Node.Tag as string;
				if (e.Button == MouseButtons.Left && m != null)
				{
					Tab t = tab;
					if (t != null && t.OnReader && t.Page == null && t.Special == null) Go(t, m.Url); else OpenTab(null, m.Url, true);
				}
				else if (e.Button == MouseButtons.Middle && m != null) OpenTab(null, m.Url, false);
				else if (e.Button == MouseButtons.Left && folder != null) { if (e.Node.IsExpanded) e.Node.Collapse(); else e.Node.Expand(); }
				else if (e.Button == MouseButtons.Right && (m != null || folder != null)) Later(delegate { MarkMenu(m, folder); });
			};
			markTree.ItemDrag += (sender, e) => { TreeNode n = e.Item as TreeNode; if (n != null && n.Tag is Mark) markTree.DoDragDrop(n, DragDropEffects.Move); };
			markTree.DragOver += (sender, e) =>
			{
				TreeNode over = markTree.GetNodeAt(markTree.PointToClient(new Point(e.X, e.Y)));
				bool link = e.Data.GetDataPresent(DataFormats.UnicodeText) && Regex.IsMatch((e.Data.GetData(DataFormats.UnicodeText) as string ?? "").Trim(), @"^https?://\S+$");
				e.Effect = (e.Data.GetDataPresent(typeof(TreeNode)) && over != null) || link ? (link ? DragDropEffects.Copy : DragDropEffects.Move) : DragDropEffects.None;
			};
			markTree.DragDrop += (sender, e) =>
			{
				TreeNode over = markTree.GetNodeAt(markTree.PointToClient(new Point(e.X, e.Y)));
				string folder = over == null ? "" : over.Tag is Mark ? ((Mark)over.Tag).Folder : over.Tag as string ?? "";
				List<Mark> list = Marks();
				TreeNode n = e.Data.GetData(typeof(TreeNode)) as TreeNode;
				if (n != null && n.Tag is Mark)
				{
					int i = Same(list, (Mark)n.Tag);
					if (i < 0) return;
					Mark m = list[i];
					list.RemoveAt(i);
					m.Folder = folder;
					int before = over != null && over.Tag is Mark ? Same(list, (Mark)over.Tag) : -1;
					if (before >= 0) list.Insert(before, m); else list.Add(m);
				}
				else
				{
					string url = (e.Data.GetData(DataFormats.UnicodeText) as string ?? "").Trim();
					if (!Regex.IsMatch(url, @"^https?://\S+$")) return;
					Uri u;
					list.Add(new Mark { Folder = folder, Title = Uri.TryCreate(url, UriKind.Absolute, out u) ? u.Host : url, Url = url });
				}
				SaveMarks(list);
			};

			addPage.Click += delegate { string said = MarkThis(false); status.Text = said ?? "Bookmarked it."; };
			newFolder.Click += delegate
			{
				string name = AskName("New folder", "What's the folder called?", "");
				if (name == null) return;
				List<string> folders = BookFolders();
				if (!folders.Contains(name)) folders.Add(name);
				KeepFolders(folders);
				fillTree();
			};
			import.Click += delegate
			{
				ContextMenuStrip m = NewMenu();
				var seen = new HashSet<string>();
				foreach (string[] other in OtherBrowsers())
				{
					if (!File.Exists(other[1]) || !seen.Add(other[0])) continue;
					string from = other[0], file = other[1];
					Item(m.Items, "From " + from, "", true, delegate { status.Text = ImportMarks(from, file); });
				}
				if (m.Items.Count == 0) Item(m.Items, "No other browsers' bookmarks found on this PC", "", false, delegate { });
				m.Show(import, new Point(0, import.Height));
			};

			tintMarks();
			fillTree();
			marks.VisibleChanged += delegate { if (marks.Visible) { tintMarks(); fillTree(); } };
			marks.Controls.Add(treeBox);
			marks.Controls.Add(status);
			marks.Controls.Add(tools);
			marks.Controls.Add(findRow);
			marks.Controls.Add(head);
			treeBox.BringToFront();

			// The star in the address box: hollow, or filled red when the page is bookmarked.
			star.Click += delegate { MarkThis(true); };
			box.Controls.Add(star);
			var watchStar = new WinTimer { Interval = 500 };
			watchStar.Tick += delegate { Tab t = tab; string at = t == null || t.OnReader ? null : t.Address; if (at != starAt) ShowStar(); };
			watchStar.Start();
			Disposed += delegate { watchStar.Dispose(); };
		}

		void MarkMenu(Mark m, string folder)
		{
			ContextMenuStrip menu = NewMenu();
			List<Mark> list = Marks();
			if (m != null)
			{
				Item(menu.Items, "Open in new tab", "", true, delegate { OpenTab(null, m.Url, true); });
				Item(menu.Items, "Copy link", "", true, delegate { try { Clipboard.SetText(m.Url); } catch { } });
				Item(menu.Items, "Rename", "", true, delegate
				{
					string name = AskName("Rename bookmark", "A new name for this bookmark.", Clip(m.Title, 40));
					if (name == null) return;
					List<Mark> now = Marks();
					int i = Same(now, m);
					if (i < 0) return;
					now[i].Title = name;
					SaveMarks(now);
				});
				var move = new ToolStripMenuItem("Move to") { ForeColor = mod.look.Shade(2) };
				var places = new List<string> { "" };
				places.AddRange(MarkFolders(list));
				foreach (string place in places)
				{
					if (place == m.Folder) continue;
					string into = place;
					var one = new ToolStripMenuItem(into.Length == 0 ? "Bookmarks" : into) { ForeColor = mod.look.Shade(2) };
					one.Click += delegate { List<Mark> now = Marks(); int i = Same(now, m); if (i < 0) return; now[i].Folder = into; Later(delegate { SaveMarks(now); }); };
					move.DropDownItems.Add(one);
				}
				if (move.DropDownItems.Count > 0) { move.DropDown.BackColor = mod.look.Shade(1); menu.Items.Add(move); }
				Item(menu.Items, "Delete", "", true, delegate { List<Mark> now = Marks(); int i = Same(now, m); if (i < 0) return; now.RemoveAt(i); SaveMarks(now); });
			}
			else if (folder.Length > 0)
			{
				Item(menu.Items, "Open all in tabs", "", true, delegate { int n = 0; foreach (Mark one in Marks()) if (one.Folder == folder && n++ < 10) OpenTab(null, one.Url, n == 1); });
				Item(menu.Items, "Rename folder", "", true, delegate
				{
					string name = AskName("Rename folder", "A new name for \"" + folder + "\".", Clip(folder, 40));
					if (name == null || name == folder) return;
					List<string> folders = BookFolders();
					int f = folders.IndexOf(folder);
					if (f >= 0) folders[f] = name; else folders.Add(name);
					KeepFolders(folders);
					List<Mark> now = Marks();
					foreach (Mark one in now) if (one.Folder == folder) one.Folder = name;
					SaveMarks(now);
				});
				Item(menu.Items, "Delete folder (its bookmarks move to Bookmarks)", "", true, delegate
				{
					List<string> folders = BookFolders();
					folders.Remove(folder);
					KeepFolders(folders);
					List<Mark> now = Marks();
					foreach (Mark one in now) if (one.Folder == folder) one.Folder = "";
					SaveMarks(now);
				});
			}
			else Item(menu.Items, "Open all in tabs", "", true, delegate { int n = 0; foreach (Mark one in Marks()) if (one.Folder.Length == 0 && n++ < 10) OpenTab(null, one.Url, n == 1); });
			menu.Show(Cursor.Position);
		}

		// Where other browsers on this PC keep their bookmarks (their own Bookmarks file, read only when they press Import).
		static string[][] OtherBrowsers()
		{
			string local = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData), roam = Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData);
			return new[]
			{
				new[] { "Opera GX", Path.Combine(roam, @"Opera Software\Opera GX Stable\Default\Bookmarks") },
				new[] { "Opera GX", Path.Combine(roam, @"Opera Software\Opera GX Stable\Bookmarks") },
				new[] { "Opera", Path.Combine(roam, @"Opera Software\Opera Stable\Default\Bookmarks") },
				new[] { "Opera", Path.Combine(roam, @"Opera Software\Opera Stable\Bookmarks") },
				new[] { "Chrome", Path.Combine(local, @"Google\Chrome\User Data\Default\Bookmarks") },
				new[] { "Edge", Path.Combine(local, @"Microsoft\Edge\User Data\Default\Bookmarks") },
				new[] { "Brave", Path.Combine(local, @"BraveSoftware\Brave-Browser\User Data\Default\Bookmarks") },
				new[] { "Vivaldi", Path.Combine(local, @"Vivaldi\User Data\Default\Bookmarks") }
			};
		}

		string ImportMarks(string from, string file)
		{
			try
			{
				string text;
				using (var f = new FileStream(file, FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete))
				using (var r = new StreamReader(f, Encoding.UTF8)) text = r.ReadToEnd();
				int at = 0;
				Dictionary<string, object> whole = ReadJson(text, ref at) as Dictionary<string, object>;
				object roots;
				if (whole == null || !whole.TryGetValue("roots", out roots) || !(roots is Dictionary<string, object>)) return "Couldn't read " + from + "'s bookmarks.";
				var found = new List<Mark>();
				foreach (string root in new[] { "bookmark_bar", "other", "synced" })
				{
					object node;
					if (((Dictionary<string, object>)roots).TryGetValue(root, out node)) WalkMarks(node, null, from, found);
				}
				List<Mark> list = Marks();
				int added = 0;
				foreach (Mark m in found)
				{
					if (list.Exists(had => had.Url == m.Url && had.Folder == m.Folder)) continue;
					list.Add(m);
					added++;
				}
				SaveMarks(list);
				return added == 0 ? "Nothing new to bring over from " + from + "." : "Brought over " + added + (added == 1 ? " bookmark" : " bookmarks") + " from " + from + ".";
			}
			catch (Exception error) { return "Couldn't read " + from + "'s bookmarks: " + error.Message; }
		}

		static void WalkMarks(object node, string folder, string from, List<Mark> into)
		{
			Dictionary<string, object> o = node as Dictionary<string, object>;
			if (o == null || into.Count > 5000) return;
			object type, name, url, kids;
			o.TryGetValue("type", out type);
			o.TryGetValue("name", out name);
			string called = Flat1(name as string ?? "");
			if ("url".Equals(type) && o.TryGetValue("url", out url) && url is string && Regex.IsMatch((string)url, "^https?://", RegexOptions.IgnoreCase))
				into.Add(new Mark { Folder = folder ?? "", Title = called, Url = Flat1((string)url) });
			else if (o.TryGetValue("children", out kids) && kids is List<object>)
			{
				string here = (called.Length > 0 ? called : "Bookmarks") + " (" + from + ")";
				foreach (object k in (List<object>)kids) WalkMarks(k, here, from, into);
			}
		}

		// A small JSON reader for other browsers' Bookmarks files: objects, arrays and strings (numbers and the rest come back as null).
		static object ReadJson(string s, ref int i)
		{
			while (i < s.Length && char.IsWhiteSpace(s[i])) i++;
			if (i >= s.Length) return null;
			char c = s[i];
			if (c == '{')
			{
				var o = new Dictionary<string, object>();
				i++;
				while (true)
				{
					while (i < s.Length && (char.IsWhiteSpace(s[i]) || s[i] == ',')) i++;
					if (i >= s.Length) return o;
					if (s[i] == '}') { i++; return o; }
					string key = ReadJson(s, ref i) as string;
					while (i < s.Length && (char.IsWhiteSpace(s[i]) || s[i] == ':')) i++;
					object v = ReadJson(s, ref i);
					if (key != null) o[key] = v;
				}
			}
			if (c == '[')
			{
				var a = new List<object>();
				i++;
				while (true)
				{
					while (i < s.Length && (char.IsWhiteSpace(s[i]) || s[i] == ',')) i++;
					if (i >= s.Length) return a;
					if (s[i] == ']') { i++; return a; }
					a.Add(ReadJson(s, ref i));
				}
			}
			if (c == '"')
			{
				var b = new StringBuilder();
				i++;
				while (i < s.Length && s[i] != '"')
				{
					if (s[i] == '\\' && i + 1 < s.Length)
					{
						char e = s[++i];
						if (e == 'u' && i + 4 < s.Length) { int code; if (int.TryParse(s.Substring(i + 1, 4), NumberStyles.HexNumber, null, out code)) b.Append((char)code); i += 4; }
						else b.Append(e == 'n' ? '\n' : e == 't' ? '\t' : e == 'r' ? '\r' : e == 'b' ? '\b' : e == 'f' ? '\f' : e);
					}
					else b.Append(s[i]);
					i++;
				}
				i++;
				return b.ToString();
			}
			int start = i;
			while (i < s.Length && ",}]".IndexOf(s[i]) < 0 && !char.IsWhiteSpace(s[i])) i++;
			if (i == start) i++;
			return null;
		}

		// ---- Extensions: Chrome-style extensions they add themselves, from a folder, or a .zip or .crx they downloaded ----

		static string ExtensionsHome { get { return Host == null ? null : Path.Combine(Host.Folder, "extensions"); } }

		object ExtensionProfile()
		{
			foreach (Tab t in tabs)
			{
				if (t.Private) continue;
				object core = t.Viewer.Core;
				if (core == null) continue;
				try { return Get(core, "Profile"); } catch { }
			}
			return null;
		}

		// What Edge's engine has installed: each extension object, or null when extensions can't run here.
		void ListExtensions(Action<List<object>> got)
		{
			object profile = ExtensionProfile();
			if (profile == null) { got(null); return; }
			try
			{
				Task run = (Task)Call(profile, "GetBrowserExtensionsAsync");
				run.ContinueWith(done =>
				{
					var list = new List<object>();
					try { foreach (object e in (IEnumerable)done.GetType().GetProperty("Result").GetValue(done, null)) list.Add(e); }
					catch (Exception) { list = null; }
					Post(delegate { got(list); });
				});
			}
			catch (Exception) { got(null); }
		}

		// Waits for one of Edge's tasks, then says how it went on her window's thread (null when it worked).
		void After(object task, Action<string> done)
		{
			Task run = task as Task;
			if (run == null) { done("that didn't start"); return; }
			run.ContinueWith(finished => { string why = finished.IsFaulted ? finished.Exception.GetBaseException().Message : null; Post(delegate { done(why); }); });
		}

		// Copies or unpacks it into the mod's extensions folder (so it stays put), then hands that folder to Edge's engine.
		void AddExtension(string source, Action<string> done)
		{
			string home = ExtensionsHome;
			object profile = ExtensionProfile();
			if (home == null || profile == null) { done("Open a website tab first, then try again."); return; }
			string folder, made = null;
			try
			{
				string name = Regex.Replace(Path.GetFileNameWithoutExtension(source.TrimEnd('\\', '/')), @"[^\w.-]+", "-");
				folder = Path.Combine(home, name);
				for (int n = 2; Directory.Exists(folder); n++) folder = Path.Combine(home, name + "-" + n);
				Directory.CreateDirectory(folder);
				made = folder;
				if (Directory.Exists(source)) CopyFolder(source, folder, 0);
				else
				{
					byte[] bytes = File.ReadAllBytes(source);
					if (bytes.Length > 4 && bytes[0] == 'C' && bytes[1] == 'r' && bytes[2] == '2' && bytes[3] == '4')
					{
						uint version = BitConverter.ToUInt32(bytes, 4);
						int skip = version == 3 ? 12 + (int)BitConverter.ToUInt32(bytes, 8) : 16 + (int)BitConverter.ToUInt32(bytes, 8) + (int)BitConverter.ToUInt32(bytes, 12);
						byte[] zip = new byte[bytes.Length - skip];
						Buffer.BlockCopy(bytes, skip, zip, 0, zip.Length);
						bytes = zip;
					}
					string failed = UnzipAll(bytes, folder);
					if (failed != null) { done("Couldn't unpack it: " + failed); return; }
				}
				// Zips from GitHub often have the extension one folder down.
				if (!File.Exists(Path.Combine(folder, "manifest.json")))
					foreach (string inner in Directory.GetDirectories(folder))
						if (File.Exists(Path.Combine(inner, "manifest.json"))) { folder = inner; break; }
				if (!File.Exists(Path.Combine(folder, "manifest.json"))) { done("That isn't an extension: there's no manifest.json in it."); return; }
				string file = Path.Combine(folder, "manifest.json"), text = File.ReadAllText(file), left = Lighter(ref text);
				if (left != null) { File.WriteAllText(file, text); mod.Tell("I left out the part of that extension Capri Browser can't do (" + left + "); the rest should work, choom."); }
				string notHere = BrowserOnly(text);
				if (notHere != null)
				{
					try { Directory.Delete(made, true); } catch { }
					done("it changes the browser itself (" + notHere + "), and Capri Browser only takes extensions that change pages.");
					return;
				}
			}
			catch (Exception error) { done(Inner(error).Message); return; }
			try
			{
				string kept = folder;
				string unpacked = made;
				object task = Call(profile, "AddBrowserExtensionAsync", folder);
				Task run = (Task)task;
				run.ContinueWith(finished =>
				{
					string why = finished.IsFaulted ? finished.Exception.GetBaseException().Message : null;
					Post(delegate
					{
						string id = null;
						if (why == null) try { id = (string)Get(finished.GetType().GetProperty("Result").GetValue(finished, null), "Id"); } catch { }
						if (id != null) Keep("extfolders", Kept("extfolders") + id + "\t" + kept + "\n");
						else if (why != null && unpacked != null) try { Directory.Delete(unpacked, true); } catch { }
						done(why);
					});
				});
			}
			catch (Exception error) { done("Edge's engine here can't add extensions yet (" + Inner(error).Message + "). Restart Capri and try again."); }
		}

		static bool StoreSite(string url)
		{
			Uri u;
			return url != null && Uri.TryCreate(url, UriKind.Absolute, out u) && u.Scheme == "https" && u.Host == "chromewebstore.google.com";
		}

		void StoreAdd(Tab t, string from, string what)
		{
			if (!StoreSite(from) || t.Private) return;
			string[] p = (what ?? "").Split(new[] { '|' }, 2);
			string id = p[0], name = Regex.Replace(p.Length > 1 ? p[1] : "", @"[^\w .-]+", "").Trim();
			if (!Regex.IsMatch(id, "^[a-p]{32}$")) return;
			if (name.Length == 0) name = "extension";
			string url = "https://clients2.google.com/service/update2/crx?response=redirect&prodversion=131.0.0.0&acceptformat=crx2,crx3&x=id%3D" + id + "%26uc";
			Action<string> button = words => { if (!t.Viewer.Control.IsDisposed) t.Viewer.Script("(function(){var b=document.getElementById('capri-ext-add');if(b){b.textContent=" + Quote(words) + ";b.disabled=true}})()"); };
			Behind(delegate
			{
				byte[] got = DownloadBytes(url, null);
				string file = null;
				if (got != null && got.Length > 16 && got[0] == 'C' && got[1] == 'r' && got[2] == '2' && got[3] == '4')
					try { file = Path.Combine(Path.GetTempPath(), Regex.Replace(name, @"\s+", "-") + ".crx"); File.WriteAllBytes(file, got); } catch (Exception) { file = null; }
				Post(delegate
				{
					if (file == null) { button("Couldn't download it"); mod.Tell("I couldn't get that extension from the store, choom."); return; }
					AddExtension(file, failed =>
					{
						try { File.Delete(file); } catch { }
						if (failed != null && failed.Begins("it changes the browser itself")) { button("Not supported in Capri Browser"); mod.Tell("I can't add that one, choom: " + failed); return; }
						if (failed != null) { button("Couldn't add it"); mod.Tell("That extension didn't go in, choom: " + failed); return; }
						Bump("extensions", 1);
						button("Added to Capri Browser ✓");
						mod.Tell(Line("extadded", "Extension's in, choom. Reload a page to see it work.", "Got it installed, choom. Give the page a reload."));
					});
				});
			});
		}

		// What, if anything, makes an extension one for the browser rather than for pages. Null when it only changes pages. Permissions it only asks
		// for later (optional) don't count. Parts only for the browser itself that an extension can do without: left out of her copy of it.
		const string ExtraKeys = "devtools_page|omnibox|side_panel", ExtraPerms = "tabGroups|sidePanel|bookmarks|history|topSites|sessions|browsingData|downloads(?:\\.\\w+)?|pageCapture|search|fontSettings|offscreen|system\\.\\w+|readingList";
		internal static string Lighter(ref string manifest)
		{
			var left = new List<string>();
			string m = Regex.Replace(manifest, "\"(" + ExtraKeys + ")\"\\s*:\\s*(?:\"[^\"]*\"|\\{[^{}]*\\})\\s*,?", k => { left.Add(k.Groups[1].Value.Replace('_', ' ')); return ""; });
			m = Regex.Replace(m, "(\"(?:optional_)?permissions\"\\s*:\\s*\\[)([^\\]]*)\\]", p =>
			{
				return p.Groups[1].Value + Regex.Replace(p.Groups[2].Value, "\"(" + ExtraPerms + ")\"\\s*,?", one => { if (!p.Value.StartsWith("\"optional")) left.Add(one.Groups[1].Value); return ""; }) + "]";
			});
			if (left.Count == 0) return null;
			manifest = Regex.Replace(m, ",(\\s*[}\\]])", "$1");
			return string.Join(", ", left.ToArray());
		}

		static readonly string[,] BrowserParts =
		{
			{ "chrome_url_overrides", "it replaces the new tab, history or bookmarks page" },
			{ "chrome_settings_overrides", "it changes the home page or search engine" },
			{ "theme", "it's a browser theme" },
			{ "tabCapture", "it records tab audio or video" },
			{ "desktopCapture", "it records the screen" },
			{ "proxy", "it changes the connection (proxy or VPN)" },
			{ "privacy", "it changes browser privacy settings" },
			{ "contentSettings", "it changes browser site settings" },
			{ "management", "it manages other extensions" },
			{ "nativeMessaging", "it needs an app installed on your PC" },
			{ "debugger", "it uses the debugger" },
			{ "pageCapture", "it saves whole pages" },
			{ "ttsEngine", "it adds a voice engine" },
			{ "vpnProvider", "it's a VPN" },
			{ "enterprise", "it's for managed work PCs" },
		};

		internal static string BrowserOnly(string manifest)
		{
			string text = manifest ?? "";
			Match perms = Regex.Match(text, "\"permissions\"\\s*:\\s*\\[([^\\]]*)\\]");
			string have = perms.Success ? perms.Groups[1].Value : "";
			for (int i = 0; i < BrowserParts.GetLength(0); i++)
			{
				string part = BrowserParts[i, 0];
				bool key = Regex.IsMatch(text, "\"" + part + "\"\\s*:");
				bool perm = Regex.IsMatch(have, "\"" + part + "(?:\\.[\\w.]+)?\"");
				if (key && i < 3) return BrowserParts[i, 1];
				if (perm) return BrowserParts[i, 1];
			}
			return null;
		}

		static void CopyFolder(string from, string to, int depth)
		{
			if (depth > 12) return;
			Directory.CreateDirectory(to);
			foreach (string f in Directory.GetFiles(from)) File.Copy(f, Path.Combine(to, Path.GetFileName(f)), true);
			foreach (string d in Directory.GetDirectories(from)) if (!Path.GetFileName(d).StartsWith(".")) CopyFolder(d, Path.Combine(to, Path.GetFileName(d)), depth + 1);
		}

		// The extension's own folder, as kept when it was added.
		string ExtensionFolder(string id)
		{
			foreach (string line in Kept("extfolders").Split('\n')) { string[] p = line.Split('\t'); if (p.Length == 2 && p[0] == id) return p[1]; }
			return null;
		}

		// A page of the extension from its manifest: its toolbar popup, or its options page.
		string ExtensionPage(string id, bool options)
		{
			string folder = ExtensionFolder(id);
			if (folder == null) return null;
			try
			{
				string manifest = File.ReadAllText(Path.Combine(folder, "manifest.json"));
				Match m = options
					? Regex.Match(manifest, "\"options_ui\"\\s*:\\s*\\{[^}]*?\"page\"\\s*:\\s*\"([^\"]+)\"|\"options_page\"\\s*:\\s*\"([^\"]+)\"")
					: Regex.Match(manifest, "\"default_popup\"\\s*:\\s*\"([^\"]+)\"");
				if (!m.Success) return null;
				string page = (m.Groups[1].Success ? m.Groups[1].Value : m.Groups[2].Value).TrimStart('/');
				return "chrome-extension://" + id + "/" + page;
			}
			catch (Exception) { return null; }
		}

		Button Puzzle()
		{
			Button b = Tool("\uEA86", 36, "Extensions", DockStyle.Right);
			puzzleButton = b;
			b.Font = Icons(11f);
			b.Click += delegate { if (!JustShut) ExtensionsPanel(b); };
			return b;
		}

		// Under the puzzle button: their extensions, each with on/off, its popup, options and remove, then ways to add one.
		void ExtensionsPanel(Control under)
		{
			Look look = mod.look;
			Color back = look.Shade(1), ink = look.Shade(2), faint = look.Shade(3), red = look.Shade(5), edge = look.Shade(6);
			ToolStripDropDown drop = NewDrop(back);
			FadeIn(drop);
			var card = new Panel { Width = 360, Height = 120, BackColor = back };
			Hold(drop, card, Holder(card), edge);
			Action build = null;
			Action<string> say = line => { if (line != null) mod.Tell(line); };
			Func<string, int, Button> small = (words, left) =>
			{
				var b = new Button { Text = words, Left = left, Height = 28, AutoSize = true, FlatStyle = FlatStyle.Flat, BackColor = look.Shade(0), ForeColor = ink, Font = new Font(Ui, 9.5f), Cursor = Cursors.Hand, TabStop = false };
				b.FlatAppearance.BorderColor = edge;
				b.FlatAppearance.MouseOverBackColor = Mix(look.Shade(0), red, .25f);
				card.Controls.Add(b);
				return b;
			};
			Action<string> pick = kind =>
			{
				var chosen = new List<string>();
				drop.AutoClose = false;
				if (kind == "folder")
					using (var f = new FolderBrowserDialog { Description = "Pick an extension's folder (the one with manifest.json in it), or a folder holding several." })
					{
						if (f.ShowDialog(FindForm()) == DialogResult.OK)
						{
							// A folder of extension folders: each one goes in.
							if (!File.Exists(Path.Combine(f.SelectedPath, "manifest.json")))
								try { foreach (string inner in Directory.GetDirectories(f.SelectedPath)) if (File.Exists(Path.Combine(inner, "manifest.json"))) chosen.Add(inner); } catch { }
							if (chosen.Count < 2) { chosen.Clear(); chosen.Add(f.SelectedPath); }
						}
					}
				else
					using (var f = new OpenFileDialog { Title = "Pick extensions (you can pick several)", Filter = "Extensions|*.zip;*.crx|All files|*.*", Multiselect = true }) { if (f.ShowDialog(FindForm()) == DialogResult.OK) chosen.AddRange(f.FileNames); }
				drop.AutoClose = true;
				if (chosen.Count == 0) return;
				// One after another, so Edge's engine isn't asked for two at once.
				int added = 0;
				var fails = new List<string>();
				Action<int> next = null;
				next = i =>
				{
					if (i >= chosen.Count)
					{
						if (added > 0) Bump("extensions", added);
						if (fails.Count == 0) say(added == 1 ? Line("extadded", "Extension's in, choom. Reload a page to see it work.", "Got it installed, choom. Give the page a reload.") : added + " extensions are in, choom. Reload a page to see them work.");
						else if (added == 0) say(fails.Count == 1 ? "That extension didn't go in, choom: " + fails[0] : "None of those went in, choom. " + fails[0]);
						else say(added + " went in, but " + fails.Count + " didn't, choom: " + fails[0]);
						if (!drop.IsDisposed && drop.Visible) build();
						return;
					}
					string one = chosen[i];
					AddExtension(one, failed =>
					{
						if (failed == null) added++; else fails.Add(Path.GetFileName(one.TrimEnd('\\', '/')) + ": " + failed);
						next(i + 1);
					});
				};
				next(0);
			};
			build = delegate
			{
				ListExtensions(list =>
				{
					if (card.IsDisposed) return;
					card.SuspendLayout();
					card.Controls.Clear();
					int y = 16;
					card.Controls.Add(new Label { Text = "Extensions", Left = 20, Top = y, Width = 320, Height = 28, ForeColor = ink, BackColor = back, Font = new Font(UiBold, 13f) });
					y += 36;
					if (list == null)
					{
						var why = new Label { Text = "Extensions need a website tab open (and Capri restarted once after this update). Open a site, then try again.", Left = 20, Top = y, Width = 320, Height = 54, ForeColor = faint, BackColor = back, Font = new Font(Ui, 9.5f) };
						card.Controls.Add(why);
						y += 58;
					}
					else if (list.Count == 0) { card.Controls.Add(new Label { Text = "No extensions yet.", Left = 20, Top = y, Width = 320, Height = 24, ForeColor = faint, BackColor = back, Font = new Font(Ui, 10f) }); y += 30; }
					else foreach (object ext in list)
					{
						object one = ext;
						string id = "", name = "Extension";
						bool on = true;
						try { id = (string)Get(one, "Id"); name = (string)Get(one, "Name"); on = (bool)Get(one, "IsEnabled"); } catch { }
						var icon = new Label { Text = "\uEA86", Left = 18, Top = y + 4, Width = 24, Height = 24, ForeColor = on ? red : faint, BackColor = back, Font = Icons(12f) };
						var called = new Label { Text = name, Left = 46, Top = y + 6, Width = 170, Height = 22, ForeColor = on ? ink : faint, BackColor = back, Font = new Font(UiBold, 10f), AutoEllipsis = true, UseMnemonic = false };
						Button toggle = small(on ? "On" : "Off", 222);
						toggle.AutoSize = false;
						toggle.Width = 52;
						toggle.Top = y + 2;
						toggle.ForeColor = on ? red : faint;
						Button more = small("\uE712", 280);
						more.AutoSize = false;
						more.Width = 36;
						more.Top = y + 2;
						more.Font = Icons(10f);
						card.Controls.Add(icon);
						card.Controls.Add(called);
						string extId = id;
						toggle.Click += delegate { After(Call(one, "EnableAsync", !on), failed => { if (failed != null) say("Couldn't switch it, choom: " + failed); else build(); }); };
						more.Click += delegate
						{
							ContextMenuStrip m = NewMenu();
							string popup = ExtensionPage(extId, false), options = ExtensionPage(extId, true);
							Item(m.Items, "Open its popup page", "", popup != null && on, delegate { drop.Close(); OpenTab(null, popup, true); });
							Item(m.Items, "Options", "", options != null && on, delegate { drop.Close(); OpenTab(null, options, true); });
							Item(m.Items, "Remove", "", true, delegate
							{
								After(Call(one, "RemoveAsync"), failed =>
								{
									if (failed != null) { say("Couldn't remove it, choom: " + failed); return; }
									string folder = ExtensionFolder(extId);
									try { if (folder != null && ExtensionsHome != null && folder.StartsWith(ExtensionsHome, Loose)) Directory.Delete(folder, true); } catch { }
									build();
								});
							});
							m.Show(more, new Point(0, more.Height));
						};
						y += 38;
					}
					y += 6;
					Button addFolder = small("+ Add a folder", 20);
					addFolder.Top = y;
					Button addFile = small("+ Add a .zip or .crx", 140);
					addFile.Top = y;
					addFolder.Click += delegate { pick("folder"); };
					addFile.Click += delegate { pick("file"); };
					y += 36;
					Button store = small("Get extensions from the Chrome Web Store", 20);
					store.Top = y;
					store.Click += delegate { drop.Close(); OpenTab(null, "https://chromewebstore.google.com/", true); };
					y += 40;
					var note = new Label { Text = "Open the Chrome Web Store in Capri Browser and press Add to Capri Browser on an extension, or add a folder, .zip or .crx. Only extensions that change pages work (ad blockers, dark mode, YouTube or Roblox tweaks). Browser-only extras (developer tools, side panels, bookmarks) are left out; new tab pages, themes and tab recorders aren't supported. Toolbar popups open as a tab. Extensions can read and change the sites you visit, so only add ones you trust.", Left = 20, Top = y, Width = 320, ForeColor = faint, BackColor = back, Font = new Font(Ui, 9f) };
					note.Height = TextRenderer.MeasureText(note.Text, note.Font, new Size(320, 0), TextFormatFlags.WordBreak).Height + 4;
					card.Controls.Add(note);
					y += note.Height + 14;
					// Lots of extensions: the panel stops at the screen's edge and scrolls.
					int room = Math.Max(240, Screen.FromControl(under).WorkingArea.Bottom - under.PointToScreen(Point.Empty).Y - under.Height - 24);
					card.AutoScroll = y > room;
					card.Height = Math.Min(y, room);
					holder.Size = card.Size;
					drop.Size = card.Size;
					card.ResumeLayout();
					card.Invalidate();
				});
			};
			build();
			Point at = under.PointToScreen(new Point(under.Width, under.Height + 4));
			drop.Show(new Point(Math.Max(0, at.X - card.Width), at.Y));
		}

		// ---- Screenshots: what's on screen, the whole page, a part they drag over, or a part Capri finds by name ----

		Button Camera()
		{
			Button b = Tool("\uE722", 36, "Screenshot (Ctrl+Shift+X picks an area)", DockStyle.Right);
			b.Font = Icons(11f);
			b.Click += delegate
			{
				if (JustShut) return;
				Tab t = tab;
				bool ok = t != null && !t.OnReader && t.Address != null && t.Viewer.Modern;
				ContextMenuStrip m = NewMenu();
				Item(m.Items, "Pick an area", "Ctrl+Shift+X", ok, delegate { TakeShot(t, "area", null, null); });
				Item(m.Items, "What's on screen", "", ok, delegate { TakeShot(t, "visible", null, null); });
				Item(m.Items, "The whole page", "", ok, delegate { TakeShot(t, "full", null, null); });
				Item(m.Items, "The whole page, into Noted", "", ok, delegate { ShotToNotes(t); });
				m.Show(b, new Point(b.Width, b.Height), ToolStripDropDownDirection.BelowLeft);
			};
			return b;
		}

		static string Num(double n) { return n.ToString("0.##", CultureInfo.InvariantCulture); }

		// What's on screen in the tab, as Edge saves it to a picture file.
		void Still(Tab t, Action<Bitmap> got)
		{
			string file = Path.Combine(Path.GetTempPath(), "capri-shot-" + Guid.NewGuid().ToString("N") + ".png");
			t.Viewer.Shot(file, failed =>
			{
				Bitmap b = null;
				if (failed == null) try { using (Image i = Image.FromFile(file)) b = new Bitmap(i); } catch { }
				try { File.Delete(file); } catch { }
				Post(delegate { got(b); });
			});
		}

		const string PagePlace = "JSON.stringify([innerWidth,innerHeight,scrollX,scrollY])";

		// A part of the page by its place on the page (CSS pixels from the top left of the whole page).
		void ShotOf(Tab t, double x, double y, double w, double h, Action<Bitmap> got)
		{
			Task<string> ask = t.Viewer.Script(PagePlace);
			if (ask == null) { got(null); return; }
			ask.ContinueWith(done =>
			{
				string[] p = new string[0];
				try { p = Unjson(done.Result).Trim('[', ']').Split(','); } catch { }
				Post(delegate
				{
					double iw, ih, sx, sy;
					CultureInfo inv = CultureInfo.InvariantCulture;
					if (p.Length != 4 || !double.TryParse(p[0], NumberStyles.Float, inv, out iw) || !double.TryParse(p[1], NumberStyles.Float, inv, out ih) || !double.TryParse(p[2], NumberStyles.Float, inv, out sx) || !double.TryParse(p[3], NumberStyles.Float, inv, out sy) || iw < 1 || ih < 1) { got(null); return; }
					x = Math.Max(sx, Math.Min(x, sx + iw - 1));
					w = Math.Max(1, Math.Min(w, sx + iw - x));
					y = Math.Max(0, y);
					h = Math.Max(1, Math.Min(h, 12000));
					Bitmap whole = null;
					double filled = y, k = 0;
					Action<double> band = null;
					Action finish = delegate
					{
						t.Viewer.Script("scrollTo({left:" + Num(sx) + ",top:" + Num(sy) + ",behavior:'instant'})");
						got(whole);
					};
					band = top =>
					{
						Task<string> moved = t.Viewer.Script("scrollTo({left:" + Num(sx) + ",top:" + Num(top) + ",behavior:'instant'});scrollY");
						if (moved == null) { finish(); return; }
						moved.ContinueWith(m =>
						{
							double at = top;
							try { double.TryParse(Unjson(m.Result), NumberStyles.Float, inv, out at); } catch { }
							Post(delegate
							{
								var settle = new WinTimer { Interval = 220 };
								settle.Tick += delegate
								{
									settle.Stop();
									settle.Dispose();
									Still(t, b =>
									{
										if (b == null) { if (whole != null) whole.Dispose(); whole = null; finish(); return; }
										if (whole == null) { k = b.Width / iw; whole = new Bitmap(Math.Max(1, (int)(w * k)), Math.Max(1, (int)(h * k))); }
										double from = Math.Max(filled, at), to = Math.Min(y + h, at + ih);
										if (to > from)
											using (Graphics g = Graphics.FromImage(whole))
												g.DrawImage(b, new RectangleF(0, (float)((from - y) * k), (float)(w * k), (float)((to - from) * k)), new RectangleF((float)((x - sx) * k), (float)((from - at) * k), (float)(w * k), (float)((to - from) * k)), GraphicsUnit.Pixel);
										b.Dispose();
										bool stuck = to <= filled;
										filled = Math.Max(filled, to);
										if (filled >= y + h - 1 || stuck) finish(); else band(filled);
									});
								};
								settle.Start();
							});
						});
					};
					// Already all on screen: one picture, no scrolling.
					if (y >= sy && y + h <= sy + ih)
						Still(t, b =>
						{
							if (b == null) { got(null); return; }
							k = b.Width / iw;
							Rectangle cut = Rectangle.Intersect(new Rectangle((int)((x - sx) * k), (int)((y - sy) * k), Math.Max(1, (int)(w * k)), Math.Max(1, (int)(h * k))), new Rectangle(0, 0, b.Width, b.Height));
							Bitmap part = cut.Width > 0 && cut.Height > 0 ? b.Clone(cut, b.PixelFormat) : null;
							b.Dispose();
							got(part);
						});
					else band(y);
				});
			});
		}

		const string PageSize = "(function(){var d=document.documentElement,b=document.body||d;return [0,0,Math.max(d.scrollWidth,b.scrollWidth,innerWidth),Math.max(d.scrollHeight,b.scrollHeight,innerHeight)].join(',')})()";

		// Finds a part of the page: the video, the main picture, the top, or the smallest block with those words in it.
		const string FindPart = "(function(q){function r(e){var b=e.getBoundingClientRect(),s=getComputedStyle(e);return b.width>30&&b.height>30&&s.visibility!='hidden'&&s.display!='none'?b:null}" +
			"function out(b){return [b.left+scrollX,b.top+scrollY,b.width,b.height].map(Math.round).join(',')}" +
			"function biggest(sel){var best=null,a=0;document.querySelectorAll(sel).forEach(function(e){var b=r(e);if(b&&b.width*b.height>a){a=b.width*b.height;best=b}});return best}" +
			"if(q=='top')return [scrollX,0,innerWidth,innerHeight].join(',');" +
			"var b=null;if(q=='video')b=biggest('video')||biggest('iframe[src*=\"youtube\"],iframe[src*=\"player\"],iframe[src*=\"embed\"]');" +
			"else if(q=='picture')b=biggest('img,picture,canvas');" +
			"else{var len=1e9;document.querySelectorAll('h1,h2,h3,h4,h5,h6,section,article,figure,table,form,aside,header,footer,main,nav,ul,ol,dl,div,p,blockquote,pre,li').forEach(function(e){var t=(e.innerText||'').toLowerCase();if(t.indexOf(q)<0)return;" +
			"var x=/^H[1-6]$/.test(e.tagName)?(e.closest('section,article,figure,table,form,aside,li')||e.parentElement||e):e;var c=r(x);if(!c||c.width*c.height<12000)return;var l=(x.innerText||'').length;if(l<len){len=l;b=c}})}" +
			"return b?out(b):''})";

		// how: "visible", "full", "area" (they drag over it) or "find" (what names the part). said gets what Capri should say, or null.
		internal void TakeShot(Tab t, string how, string what, Action<string> said)
		{
			if (t == null || t.OnReader || t.Address == null || !t.Viewer.Modern) { if (said != null) said("Open a website first, choom, then I'll snap it."); return; }
			Bump("shots", 1);
			if (how == "visible" || how == "area")
			{
				Still(t, b =>
				{
					if (b == null || how == "visible") { ShotDone(t, b, said); return; }
					PickArea(t, b, said);
				});
				return;
			}
			Task<string> run = t.Viewer.Script(how == "full" ? PageSize : FindPart + "(" + Quote((what ?? "").ToLowerInvariant()) + ")");
			if (run == null) { ShotDone(t, null, said); return; }
			run.ContinueWith(done =>
			{
				string place = "";
				try { place = Unjson(done.Result); } catch { }
				Post(delegate
				{
					Match m = Regex.Match(place, @"^(-?[\d.]+),(-?[\d.]+),([\d.]+),([\d.]+)$");
					if (!m.Success) { if (said != null) said("I couldn't find " + (what ?? "that") + " on this page, choom. Want the whole page, or a bit you pick?"); return; }
					Func<int, double> n = g => double.Parse(m.Groups[g].Value, CultureInfo.InvariantCulture);
					ShotOf(t, n(1), n(2), n(3), n(4), b => { ShotDone(t, b, said); });
				});
			});
		}

		// A dimmed still of the page over it; they drag over the part they want (Esc or a click cancels).
		void PickArea(Tab t, Bitmap whole, Action<string> said)
		{
			Control view = t.Viewer.Control;
			Rectangle screen = view.RectangleToScreen(view.ClientRectangle);
			var cover = new Form { FormBorderStyle = FormBorderStyle.None, StartPosition = FormStartPosition.Manual, Bounds = screen, ShowInTaskbar = false, TopMost = true, KeyPreview = true, Cursor = Cursors.Cross, BackColor = Color.Black };
			Buffered(cover);
			float sx = whole.Width / (float)Math.Max(1, screen.Width), sy = whole.Height / (float)Math.Max(1, screen.Height);
			var dim = new Bitmap(screen.Width, screen.Height);
			using (Graphics g = Graphics.FromImage(dim))
			{
				g.DrawImage(whole, new Rectangle(0, 0, dim.Width, dim.Height));
				using (var shade = new SolidBrush(Color.FromArgb(140, 0, 0, 0))) g.FillRectangle(shade, 0, 0, dim.Width, dim.Height);
			}
			Point from = Point.Empty;
			Rectangle pick = Rectangle.Empty;
			bool down = false, used = false;
			Look look = mod.look;
			var hintFont = new Font(UiBold, 11f);
			cover.Paint += (sender, e) =>
			{
				Graphics g = e.Graphics;
				g.DrawImage(dim, 0, 0);
				if (pick.Width > 0 && pick.Height > 0)
				{
					g.DrawImage(whole, pick, new RectangleF(pick.X * sx, pick.Y * sy, pick.Width * sx, pick.Height * sy), GraphicsUnit.Pixel);
					using (var line = new Pen(look.Shade(5), 2)) g.DrawRectangle(line, pick);
					TextRenderer.DrawText(g, (int)(pick.Width * sx) + " × " + (int)(pick.Height * sy), hintFont, new Point(pick.X, Math.Max(0, pick.Y - 24)), Color.White);
				}
				string hint = "Drag over the part you want.  Esc to cancel.";
				Size size = TextRenderer.MeasureText(hint, hintFont);
				var tag = new Rectangle((cover.Width - size.Width) / 2 - 14, 14, size.Width + 28, size.Height + 12);
				using (var pill = new SolidBrush(Color.FromArgb(220, look.Shade(1)))) g.FillRectangle(pill, tag);
				using (var line = new Pen(look.Shade(5))) g.DrawRectangle(line, tag);
				TextRenderer.DrawText(g, hint, hintFont, tag, look.Shade(2), TextFormatFlags.HorizontalCenter | TextFormatFlags.VerticalCenter);
			};
			cover.MouseDown += (sender, e) => { if (e.Button != MouseButtons.Left) { cover.Close(); return; } down = true; from = e.Location; pick = Rectangle.Empty; };
			cover.MouseMove += (sender, e) =>
			{
				if (!down) return;
				pick = Rectangle.FromLTRB(Math.Min(from.X, e.X), Math.Min(from.Y, e.Y), Math.Max(from.X, e.X), Math.Max(from.Y, e.Y));
				pick.Intersect(cover.ClientRectangle);
				cover.Invalidate();
			};
			cover.MouseUp += delegate
			{
				if (!down) return;
				down = false;
				if (pick.Width < 8 || pick.Height < 8) { cover.Close(); return; }
				Rectangle cut = Rectangle.Intersect(new Rectangle((int)(pick.X * sx), (int)(pick.Y * sy), (int)(pick.Width * sx), (int)(pick.Height * sy)), new Rectangle(0, 0, whole.Width, whole.Height));
				used = true;
				Bitmap part = cut.Width > 0 && cut.Height > 0 ? whole.Clone(cut, whole.PixelFormat) : null;
				cover.Close();
				ShotDone(t, part, said);
			};
			cover.KeyDown += (sender, e) => { if (e.KeyCode == Keys.Escape) cover.Close(); };
			cover.Deactivate += delegate { if (!down) cover.Close(); };
			cover.FormClosed += delegate
			{
				dim.Dispose();
				whole.Dispose();
				hintFont.Dispose();
				if (!used && said != null) said("Okay, no screenshot, choom.");
				Later(delegate { cover.Dispose(); });
			};
			cover.Show(FindForm());
			cover.Activate();
		}

		// Saved in Pictures\Capri Browser, copied to the clipboard, and shown in a little card in the corner.
		void ShotDone(Tab t, Bitmap shot, Action<string> said)
		{
			if (shot == null) { if (said != null) said("That screenshot didn't work, choom."); else mod.Tell("I couldn't take that screenshot, choom."); return; }
			Uri at;
			string host = t.Address != null && Uri.TryCreate(t.Address, UriKind.Absolute, out at) ? Regex.Replace(at.Host, @"[^\w.-]", "_") : "page", file = null;
			try
			{
				string folder = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyPictures), "Capri Browser");
				Directory.CreateDirectory(folder);
				file = Path.Combine(folder, host + " " + DateTime.Now.ToString("yyyy-MM-dd HH.mm.ss", CultureInfo.InvariantCulture) + ".png");
				shot.Save(file, ImageFormat.Png);
				LastShot = file;
			}
			catch (Exception) { file = null; }
			try { Clipboard.SetImage(shot); } catch { }
			ShotCard(t, shot, file);
			if (said != null) said(Line("shotdone", "Got it, choom. Saved in your Pictures and copied, so you can paste it anywhere.", "Snapped it, choom. It's copied and saved.", "Done, choom. Screenshot's on your clipboard and in Pictures."));
		}

		Panel shotCard;

		// ---- Message reader: her Discord, and the live box ----
		// They downloaded add-ons before, and this Capri Browser pins newer ones.
		internal bool AddonsBehind() { return Kept("updated").Length > 0 && Kept("addons-pin") != AddonsCommit; }

		internal Tab ChatTab(string site)
		{
			return site == "Discord" && Flag("readdiscord", false) ? HiddenDiscord(true) : null;
		}

		// Capri's own Discord: made the first time it's needed while the reader is on, kept loaded out of sight and muted.
		Tab hiddenDc;
		internal Tab HiddenDiscord(bool make)
		{
			if (hiddenDc != null || !make || IsDisposed) return hiddenDc;
			var t = new Tab { Hidden = true, Title = "Discord" };
			t.Viewer = MakeViewer(t);
			// Edge only starts in a shown window, so it is shown, but parked past the edge, behind everything.
			Control page = t.Viewer.Control;
			page.Dock = DockStyle.None;
			page.Bounds = new Rectangle(-30000, -30000, 1100, 760);
			page.Visible = true;
			page.SendToBack();
			hiddenDc = t;
			Go(t, "https://discord.com/channels/@me");
			int tries = 0;
			var hush = new WinTimer { Interval = 500 };
			hush.Tick += delegate { tries++; try { if (t.Viewer.Core != null) { t.Viewer.Muted = true; tries = 99; } } catch { } if (tries >= 60) { hush.Stop(); hush.Dispose(); } };
			hush.Start();
			return t;
		}

		// The reader turned off: her Discord goes.
		internal void DropHiddenDiscord()
		{
			Tab t = hiddenDc;
			hiddenDc = null;
			if (t == null) return;
			holder.Controls.Remove(t.Viewer.Control);
			t.Viewer.Control.Dispose();
		}
		// Their Discord tab, whatever the reader settings.
		internal Tab SiteTab(string site)
		{
			if (site == "Discord" && hiddenDc != null) return hiddenDc;
			foreach (Tab t in tabs) if (!t.Private && !t.OnReader && t.Address != null && site == "Discord" && Regex.IsMatch(t.Address, @"^https://(?:ptb\.|canary\.)?discord\.com/")) return t;
			return null;
		}
		bool Watched(Tab t) { return t == ChatTab("Discord"); }
		internal bool Has(Tab t) { return t != null && ((t == hiddenDc && !t.Viewer.Control.IsDisposed) || researchViews.Contains(t) || (tabs.Contains(t) && !t.Private)); }

		// Her research views: like her Discord, shown but parked out of sight, muted, and gone when she's done.
		readonly List<Tab> researchViews = new List<Tab>();
		internal Tab ResearchView(int n, string url)
		{
			while (researchViews.Count <= n && !IsDisposed)
			{
				var t = new Tab { Hidden = true, Title = "Research" };
				t.Viewer = MakeViewer(t);
				Control page = t.Viewer.Control;
				page.Dock = DockStyle.None;
				page.Bounds = new Rectangle(-30000, -30000, 1200, 860);
				page.Visible = true;
				page.SendToBack();
				researchViews.Add(t);
			}
			if (n >= researchViews.Count) return null;
			Tab one = researchViews[n];
			try { if (one.Viewer.Core != null) one.Viewer.Muted = true; } catch { }
			one.Busy = true;
			Go(one, url);
			return one;
		}
		internal void DropResearchViews()
		{
			foreach (Tab t in researchViews) { holder.Controls.Remove(t.Viewer.Control); t.Viewer.Control.Dispose(); }
			researchViews.Clear();
		}
		internal void CloseQuiet(Tab t) { if (t != null && tabs.Contains(t)) Close(t); }
		internal bool InFront(Tab t) { Form f = FindForm(); return t == tab && f != null && f.Visible && f.WindowState != FormWindowState.Minimized; }
		internal void Show(Tab t)
		{
			if (t != null && t == hiddenDc) { OpenTab(null, t.Address != null && t.Address.Begins("https://discord.com/") ? t.Address : "https://discord.com/channels/@me", true); return; }
			if (Has(t)) Select(t);
		}
		internal bool Looking(Tab t) { Form f = FindForm(); return t == tab && f != null && f.Visible && f.WindowState != FormWindowState.Minimized && Form.ActiveForm == f; }

		Panel chatCard;
		Label chatWho, chatHead, chatBody, chatState;
		PictureBox chatShot;
		ChatAt chatFor;
		DateTime chatShownAt, chatTypedAt = DateTime.UtcNow;
		bool chatMoves;
		string chatFull = "";
		int chatShown;
		WinTimer chatType;
		Color HoloCyan { get { return mod.look.Shade(4); } }
		Color HoloDim { get { return mod.look.Shade(3); } }
		Color HoloRed { get { return mod.look.Shade(5); } }
		Color HoloInk { get { return mod.look.Shade(1); } }
		void TintChatCard()
		{
			if (chatCard == null || chatCard.IsDisposed) return;
			foreach (Control part in chatCard.Controls) { part.BackColor = HoloInk; part.ForeColor = HoloDim; }
			chatCard.BackColor = HoloInk;
			chatHead.ForeColor = HoloRed;
			chatBody.ForeColor = HoloCyan;
			chatCard.Invalidate(true);
		}
		const int ChatWide = 340;

		static Point[] HoloEdge(int w, int h) { return new[] { new Point(12, 0), new Point(w - 1, 0), new Point(w - 1, h - 13), new Point(w - 13, h - 1), new Point(0, h - 1), new Point(0, 12) }; }

		// Her box under her hologram: who it's about, then "CAPRI: ..." typed out in cyan with a blinking block, a picture of a typed reply when
		// there is one, and where things are at.
		internal void ChatCard(ChatAt chat, string text, string state)
		{
			chatFor = chat;
			chatShownAt = DateTime.UtcNow;
			if (chatCard == null || chatCard.IsDisposed)
			{
				var c = new Panel { Width = ChatWide, Height = 90, BackColor = HoloInk, Cursor = Cursors.Hand };
				c.Paint += (sender, e) =>
				{
					e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
					using (var line = new Pen(HoloCyan, 1.6f)) e.Graphics.DrawPolygon(line, HoloEdge(c.Width, c.Height));
					using (var bar = new SolidBrush(HoloRed)) e.Graphics.FillRectangle(bar, 12, 30, 3, c.Height - 44);
				};
				c.Resize += delegate { using (GraphicsPath shape = new GraphicsPath()) { Point[] p = HoloEdge(c.Width + 1, c.Height + 1); shape.AddPolygon(p); c.Region = new Region(shape); } c.Invalidate(); };
				Font mono = new Font("Consolas", 10.5f), small = new Font("Consolas", 8.5f);
				chatWho = new Label { Left = 22, Top = 9, Width = ChatWide - 60, Height = 16, ForeColor = HoloDim, BackColor = HoloInk, Font = small, AutoEllipsis = true, UseMnemonic = false };
				chatHead = new Label { Text = "CAPRI:", Left = 24, Top = 30, AutoSize = true, Padding = Padding.Empty, Margin = Padding.Empty, ForeColor = HoloRed, BackColor = HoloInk, Font = new Font("Consolas", 10.5f, FontStyle.Bold), UseMnemonic = false };
				chatBody = new Label { Left = 24, Top = 30, Width = ChatWide - 44, ForeColor = HoloCyan, BackColor = HoloInk, Font = mono, UseMnemonic = false };
				chatShot = new PictureBox { Left = 24, Width = ChatWide - 44, Height = 0, SizeMode = PictureBoxSizeMode.Zoom, BackColor = HoloInk, Visible = false };
				chatState = new Label { Left = 24, Width = ChatWide - 44, ForeColor = HoloDim, BackColor = HoloInk, Font = small, UseMnemonic = false };
				var x = new Label { Text = "\uE711", Left = ChatWide - 32, Top = 7, Width = 20, Height = 20, ForeColor = HoloDim, BackColor = HoloInk, Font = Icons(8f), Cursor = Cursors.Hand };
				foreach (Control part in new Control[] { c, chatWho, chatHead, chatBody, chatState, chatShot }) part.Click += delegate { if (chatFor != null) Show(chatFor.Tab); CloseChatCard(); };
				x.Click += delegate { CloseChatCard(); };
				c.Controls.AddRange(new Control[] { x, chatHead, chatWho, chatBody, chatShot, chatState });
				chatCard = c;
				Controls.Add(c);
				c.BringToFront();
				var typing = new WinTimer { Interval = 22 };
				chatType = typing;
				typing.Tick += delegate
				{
					if (c.IsDisposed || chatCard != c) { typing.Dispose(); return; }
					if (chatShown < chatFull.Length) { chatShown = Math.Min(chatFull.Length, chatShown + 2); chatTypedAt = DateTime.UtcNow; }
					else typing.Interval = 480;
					bool blink = chatShown < chatFull.Length || DateTime.Now.Millisecond < 500;
					chatBody.Text = "       " + chatFull.Substring(0, chatShown) + (blink ? "\u2588" : " ");
					if (chatShown >= chatFull.Length && (DateTime.UtcNow - chatTypedAt).TotalSeconds > 7 && !c.ClientRectangle.Contains(c.PointToClient(Cursor.Position))) CloseChatCard();
				};
				typing.Start();
				if (!chatMoves) { chatMoves = true; Resize += delegate { if (chatCard != null && !chatCard.IsDisposed) PlaceChatCard(false); }; }
				PlaceChatCard(true);
			}
			chatWho.Text = (chat.Site + "  \u00b7  " + chat.Who).ToUpperInvariant();
			chatTypedAt = DateTime.UtcNow;
			if (text != null && text != chatFull) { chatFull = text; chatShown = 0; chatType.Interval = 22; }
			if (state != null) chatState.Text = state;
			LayOutChatCard();
		}

		internal void ChatShot(Image shot)
		{
			if (chatShot == null || chatShot.IsDisposed) { if (shot != null) shot.Dispose(); return; }
			Image old = chatShot.Image;
			chatShot.Image = shot;
			chatShot.Visible = shot != null;
			int wide = shot == null ? ChatWide : 440;
			if (chatCard.Width != wide) { chatCard.Width = wide; foreach (Control part in new Control[] { chatWho, chatBody, chatState, chatShot }) part.Width = wide - (part == chatWho ? 60 : 44); foreach (Control part in chatCard.Controls) if (part.Text == "") part.Left = wide - 32; }
			chatShot.Height = shot == null ? 0 : Math.Min(200, Math.Max(28, (int)(shot.Height * Math.Min(1.7f, chatShot.Width / (float)Math.Max(1, shot.Width)))));
			if (old != null) old.Dispose();
			LayOutChatCard();
		}

		void LayOutChatCard()
		{
			if (chatCard == null || chatCard.IsDisposed) return;
			int body = TextRenderer.MeasureText("       " + chatFull + "\u2588", chatBody.Font, new Size(chatBody.Width, 1000), TextFormatFlags.WordBreak).Height + 2;
			chatBody.Height = Math.Min(160, body);
			chatShot.Top = chatBody.Bottom + 6;
			chatState.Visible = chatState.Text.Length > 0;
			chatState.Top = (chatShot.Visible ? chatShot.Bottom : chatBody.Bottom) + 6;
			chatState.Height = chatState.Visible ? Math.Min(48, TextRenderer.MeasureText(chatState.Text, chatState.Font, new Size(chatState.Width, 1000), TextFormatFlags.WordBreak).Height + 2) : 0;
			chatCard.Height = (chatState.Visible ? chatState.Bottom : chatShot.Visible ? chatShot.Bottom : chatBody.Bottom) + 14;
			chatCard.Invalidate();
			chatCard.BringToFront();
			PlaceChatCard(false);
		}

		// Under her hologram (wherever Settings puts it), or just above it when it's at the bottom.
		void PlaceChatCard(bool slide)
		{
			Panel c = chatCard;
			if (c == null || c.IsDisposed) return;
			Point holo = PointToClient(HoloSpot()), page = PointToClient(holder.PointToScreen(Point.Empty));
			int hw = holoWide > 0 ? holoWide : 260, hh = holoHigh > 0 ? holoHigh : 200;
			string at = holoAt ?? Kept("holospot");
			int left = page.X + (side.Visible && side.Parent == holder ? side.Width : 0) + 10, right = page.X + holder.Width - c.Width - 10;
			int x = Math.Max(left, Math.Min(right, holo.X + (hw - c.Width) / 2));
			int y = at.Begins("b") ? holo.Y - c.Height - 10 : holo.Y + hh + 10;
			y = Math.Max(page.Y + 10, Math.Min(page.Y + holder.Height - c.Height - 10, y));
			c.Left = x;
			if (!slide) { c.Top = y; return; }
			c.Top = y + 16;
			Ease(c, 220, e => { c.Top = y + 16 - (int)(16 * e); }, null);
		}

		void CloseChatCard()
		{
			Panel c = chatCard;
			chatCard = null;
			if (c == null || c.IsDisposed) return;
			if (chatShot != null && chatShot.Image != null) { Image old = chatShot.Image; chatShot.Image = null; old.Dispose(); }
			int from = c.Top;
			Ease(c, -160, e => { c.Top = from + (int)(16 * e); }, delegate { Controls.Remove(c); c.Dispose(); });
		}

		// Now and then (about one block in three, at most once every 2 minutes) she reacts out loud.
		DateTime lastBlockLine = DateTime.MinValue;
		void BlockedLine(string what)
		{
			if (!Notice("shieldtalk") || (DateTime.Now - lastBlockLine).TotalMinutes < 2 || dice.Next(3) != 0) return;
			lastBlockLine = DateTime.Now;
			string line = what == "redirect"
				? Line("blockredirect", "Nope. That site tried to yank you off to an ad, choom. Not on my watch.", "Sneaky redirect, blocked. You're welcome, choom.", "Ugh, this site keeps trying to drag you somewhere shady. I've got you.", "That link was a trap, choom. Shut it down.")
				: what == "popup"
				? Line("blockpopup", "Pop-up ad tried to sneak in. Blocked it, choom.", "Another pop-up? Not today, choom.", "Caught a pop-up trying to open behind your back. Gone.", "This site really wants you to see an ad. I said no.")
				: Line("blocklayer", "There was an invisible ad sitting over your video, choom. Peeled it off.", "Found a see-through ad layer eating your clicks. Removed it.", "Invisible click trap, gone. Try it now, choom.");
			mod.Tell(line);
		}

		void ShotCard(Tab t, Bitmap shot, string file)
		{
			if (shotCard != null && !shotCard.IsDisposed) { Controls.Remove(shotCard); shotCard.Dispose(); }
			Look look = mod.look;
			var c = new Panel { Width = 280, Height = 236, BackColor = look.Shade(1) };
			shotCard = c;
			c.Paint += (sender, e) => { using (Pen line = new Pen(look.Shade(5))) e.Graphics.DrawRectangle(line, 0, 0, c.Width - 1, c.Height - 1); };
			var head = new Label { Text = "Screenshot saved and copied", Left = 14, Top = 10, Width = 220, Height = 22, ForeColor = look.Shade(2), BackColor = look.Shade(1), Font = new Font(UiBold, 10f) };
			var x = new Label { Text = "\uE711", Left = 248, Top = 10, Width = 22, Height = 22, ForeColor = look.Shade(3), BackColor = look.Shade(1), Font = Icons(9f), Cursor = Cursors.Hand };
			float k = Math.Min(252f / shot.Width, 130f / shot.Height);
			var pic = new PictureBox { Left = 14, Top = 40, Width = 252, Height = 130, SizeMode = PictureBoxSizeMode.Zoom, BackColor = look.Shade(0), Cursor = Cursors.Hand };
			var thumb = new Bitmap(shot, Math.Max(1, (int)(shot.Width * Math.Min(1f, k * 2))), Math.Max(1, (int)(shot.Height * Math.Min(1f, k * 2))));
			pic.Image = thumb;
			c.Controls.Add(head);
			c.Controls.Add(x);
			c.Controls.Add(pic);
			int left = 14;
			Func<string, Action, Button> button = (words, run) =>
			{
				var b = new Button { Text = words, Left = left, Top = 182, Height = 40, Width = 80, FlatStyle = FlatStyle.Flat, BackColor = look.Shade(0), ForeColor = look.Shade(2), Font = new Font(Ui, 9.5f), Cursor = Cursors.Hand, TabStop = false };
				b.FlatAppearance.BorderColor = look.Shade(6);
				b.FlatAppearance.MouseOverBackColor = Mix(look.Shade(0), look.Shade(5), .25f);
				b.Click += delegate { Later(run); };
				c.Controls.Add(b);
				left += 86;
				return b;
			};
			Action close = null;
			Action open = delegate { if (file != null) try { Process.Start(file); } catch { } };
			pic.Click += delegate { open(); };
			button("Open", open);
			button("To Noted", delegate
			{
				if (snapNote == null) return;
				float s = Math.Min(1f, 900f / Math.Max(1, shot.Width));
				using (var small = new Bitmap(shot, Math.Max(1, (int)(shot.Width * s)), Math.Max(1, (int)(shot.Height * s)))) snapNote(t.Title + "  " + t.Address, small);
				close();
			});
			button("Folder", delegate { if (file != null) try { Process.Start("explorer.exe", "/select,\"" + file + "\""); } catch { } });
			Controls.Add(c);
			c.BringToFront();
			int restY = Height - c.Height - 18, startY = Height + 4;
			c.Left = Width - c.Width - 18;
			c.Top = startY;
			Ease(c, 240, e => { c.Top = startY + (int)((restY - startY) * e); }, null);
			bool going = false;
			close = delegate
			{
				if (going || c.IsDisposed) return;
				going = true;
				int from = c.Top;
				Ease(c, -180, e => { c.Top = from + (int)((Height + 4 - from) * e); }, delegate { Controls.Remove(c); c.Dispose(); thumb.Dispose(); shot.Dispose(); });
			};
			x.Click += delegate { close(); };
			var away = new WinTimer { Interval = 9000 };
			away.Tick += delegate { away.Stop(); away.Dispose(); if (!c.IsDisposed && !c.ClientRectangle.Contains(c.PointToClient(Cursor.Position))) close(); };
			away.Start();
			Resize += delegate { if (!c.IsDisposed && !going) { c.Left = Width - c.Width - 18; c.Top = Height - c.Height - 18; } };
		}

		// For her: "screenshot this" once she knows which part.
		internal string ShootFront(string how, string what, Action<string> said) { TakeShot(tab, how, what, said); return null; }
		internal void ShowNoted() { ShowSide(notes, NotesWide()); noteText.Focus(); }

		void Discord() { OpenTab(null, Kept("discordmode") == "personal" ? "https://discord.com/channels/@me" : "https://discord.gg/capridesktop", true); }

		void BuildSide()
		{
			side.Dock = DockStyle.Left;
			side.Width = 46;
			side.Padding = new Padding(0, 6, 0, 0);
			side.Paint += (sender, e) =>
			{
				SideBack(side, e.Graphics);
				using (var line = new Pen(Mix(mod.look.Shade(0), mod.look.Shade(5), .45f))) e.Graphics.DrawLine(line, side.Width - 1, 0, side.Width - 1, side.Height);
			};
			int sideStart = sideButtons.Count;
			SideButton("\uE80F", "Capri website", "https://capriai.app/favicon.ico").Click += delegate { OpenTab(null, "https://capriai.app/", true); };
			Button discord = SideButton("\uE8BD", "Discord (right-click to switch)", "https://www.google.com/s2/favicons?sz=64&domain=discord.com");
			discord.Click += delegate { Discord(); };
			discord.MouseUp += (sender, e) =>
			{
				if (e.Button != MouseButtons.Right) return;
				bool personal = Kept("discordmode") == "personal";
				ContextMenuStrip pick = NewMenu();
				ToolStripMenuItem capri = new ToolStripMenuItem("Capri Discord") { Checked = !personal }, mine = new ToolStripMenuItem("Personal Discord") { Checked = personal };
				capri.Click += delegate { Keep("discordmode", "capri"); };
				mine.Click += delegate { Keep("discordmode", "personal"); };
				pick.Items.Add(capri);
				pick.Items.Add(mine);
				pick.Show(discord, e.Location);
			};
			SideButton("\uE943", "Capri on GitHub", "https://github.githubassets.com/favicons/favicon-dark.png").Click += delegate { OpenTab(null, "https://github.com/lachydotmcg/capri-desktop", true); };
			SideButton("\uE734", "Bookmarks (Ctrl+Shift+B)", null).Click += delegate { ToggleSide(marks, marks.Width); };
			SideButton("\uE724", "Noted", null).Click += delegate { ToggleSide(notes, NotesWide()); if (notes.Visible) noteText.Focus(); };
			SideButton("\uEA99", "Capri Cleaner", null).Click += delegate { ShowCleaner(); };
			SideButton("\uE81C", T(49), null).Click += delegate { ShowHistory(); };
			SideButton("\uE7FC", "Games", null).Click += delegate { ShowGames(); };
			SideButton("\uE8FD", "Custom jobs", null).Click += delegate { ShowJobs(); };
			SideExtras(sideStart);
			Button welcome = SideButton(((char)0xE946).ToString(), "Welcome and useful information", null);
			welcome.Dock = DockStyle.Bottom;
			welcome.Click += delegate { ShowWelcome(); };
			gameBtn = SideButton("\uE945", "Game mode: Capri Browser goes super low so your game gets the PC (click again to turn it off)", null);
			gameBtn.Dock = DockStyle.Bottom;
			gameBtn.Click += delegate { autoGame = false; mod.Tell(GameMode(!gameMode)); };
			for (int i = sideButtons.Count - 1; i >= 0; i--)
			{
				Button b = sideButtons[i];
				side.Controls.Add(b);
				Watch(b);
				b.FlatAppearance.MouseOverBackColor = b.FlatAppearance.MouseDownBackColor = Color.Transparent;
				b.Paint += (sender, e) =>
				{
					// Drawn whole here: the sidebar's background behind it, a soft red glow on hover, then the icon in red.
					Look look = mod.look;
					Graphics g = e.Graphics;
					SideBack(b, g);
					g.SmoothingMode = SmoothingMode.AntiAlias;
					if (hot.Contains(b))
						using (GraphicsPath glow = Clipped(new RectangleF(6, 5, b.Width - 13, b.Height - 10), false))
						using (var wash = new SolidBrush(Color.FromArgb(60, look.Shade(5)))) g.FillPath(wash, glow);
					if (b.Image != null) g.DrawImage(b.Image, (b.Width - b.Image.Width) / 2, (b.Height - b.Image.Height) / 2, b.Image.Width, b.Image.Height);
					else TextRenderer.DrawText(g, b.Text, b.Font, b.ClientRectangle, hot.Contains(b) ? Mix(look.Shade(5), Color.White, .35f) : look.Shade(5), TextFormatFlags.HorizontalCenter | TextFormatFlags.VerticalCenter | TextFormatFlags.NoPrefix);
				};
			}

			// Notes they keep for themselves: a list of notes on top, the one being written below, saved as they type.
			int wide;
			notes.Dock = DockStyle.Left;
			notes.Width = int.TryParse(Kept("noteswidth"), out wide) ? Math.Max(240, Math.Min(700, wide)) : 340;
			notes.Visible = false;
			notes.Padding = new Padding(12, 40, 12, 8);
			notesTitle.Font = new Font(UiBold, 10f);
			RedBar(notesTitle);
			labels.Add(notesTitle);
			var edge = new Panel { Dock = DockStyle.Left, Width = 6, Visible = false, Cursor = Cursors.SizeWE, Tag = "grip" };
			new ToolTip().SetToolTip(edge, "Drag to resize the notes. Double-click to switch between narrow and wide.");
			bool dragging = false, over = false;
			int from = 0, was = 0;
			edge.Paint += (sender, e) =>
			{
				Look look = mod.look;
				bool lit = over || dragging;
				e.Graphics.Clear(look.Shade(0));
				using (var line = new Pen(lit ? look.Shade(5) : look.Shade(6))) e.Graphics.DrawLine(line, 0, 0, 0, edge.Height);
				using (var handle = new SolidBrush(lit ? look.Shade(5) : look.Shade(6))) e.Graphics.FillRectangle(handle, 1, edge.Height / 2 - 18, 3, 36);
			};
			edge.MouseEnter += delegate { over = true; edge.Invalidate(); };
			edge.MouseLeave += delegate { over = false; edge.Invalidate(); };
			edge.MouseDown += (sender, e) => { if (e.Button != MouseButtons.Left) return; dragging = true; from = Cursor.Position.X; was = notes.Width; edge.Capture = true; };
			edge.MouseMove += delegate { if (dragging) notes.Width = Math.Max(200, Math.Min(Math.Min(700, Width - side.Width - 320), was + Cursor.Position.X - from)); };
			edge.MouseUp += delegate { if (!dragging) return; dragging = false; edge.Capture = false; edge.Invalidate(); Keep("noteswidth", notes.Width.ToString()); };
			edge.DoubleClick += delegate { notes.Width = notes.Width < 450 ? Math.Max(200, Math.Min(560, Width - side.Width - 320)) : 300; Keep("noteswidth", notes.Width.ToString()); };
			notes.VisibleChanged += delegate { edge.Visible = notes.Visible; };

			BuildNoted();
			BuildMarks();
			BuildPasswords();
			BuildSideSetup();
			notes.Dock = marks.Dock = pwPanel.Dock = sideSetup.Dock = DockStyle.None;
			notes.Visible = marks.Visible = pwPanel.Visible = sideSetup.Visible = false;
			holder.Controls.Add(pwPanel);
			holder.Controls.Add(sideSetup);
			ApplySide();
			StartBrainFirst();
			Bested = (k, v) => { Post(delegate { Invite(k, v); }); };
			holder.Controls.Add(notes);
			holder.Controls.Add(marks);
			holder.Resize += delegate { PlaceSide(notes); PlaceSide(marks); PlaceSide(pwPanel); PlaceSide(sideSetup); };
			// A new tab's page goes under an open panel, and beside a pinned one.
			holder.ControlAdded += (sender, e) =>
			{
				if (e.Control == notes || e.Control == marks || e.Control == pwPanel || e.Control == sideSetup) return;
				e.Control.GotFocus += delegate { PageClicked(); };
				foreach (Panel p in new[] { notes, marks, pwPanel, sideSetup }) if (p.Visible) { if (p.Dock == DockStyle.Left) p.SendToBack(); else p.BringToFront(); }
			};
			foreach (Control c in holder.Controls) if (c != notes && c != marks) { Control page = c; page.GotFocus += delegate { PageClicked(); }; }
			Controls.Add(side);
		}

		// Settings: what the sidebar's Discord button opens, Capri's server or their own Discord.
		void SetDarkWeb(bool on)
		{
			if (Host != null) Host.Store.Set("opt-darkweb", on ? "1" : "0");
			foreach (Tab t in tabs) t.Viewer.Dark(on);
		}

		string CanText { get { return Help(0); } }
		string KeysText { get { return Help(1); } }

		string Help(int part)
		{
			string lang = Lang, mine = lang == "en" ? "" : Kept("help-" + lang);
			if (mine.Length == 0 && lang != "en") GetHelp(lang);
			string[] h = (mine.Length > 0 ? mine : Kept("help")).Replace("\r", "").Split(new[] { "\n%%\n" }, StringSplitOptions.None);
			if (h.Length > part && h[part].Trim().Length > 0) return h[part].Trim();
			GetLook();
			return "Getting this from Browser addons... If it doesn't show, press Update all below.";
		}

		// Settings' styling, from Browser addons. Plain style rules only: anything that could load or run something is removed.
		string SettingsCss()
		{
			string css = Kept("css-settings");
			// settings.css from before the tips moved there: fetch the new one quietly.
			if (css.Length >= 100 && css.IndexOf(".jx ", Exact) < 0) GetLook();
			string[] c = mod.look.Colors;
			css = Colored(css, c);
			if (css.Length < 100) { GetLook(); return "body{background:#0a0a10;color:#ececf1;font-family:'Segoe UI',sans-serif;padding:20px}.nav a{display:inline-block;margin:0 12px 8px 0;color:#5ef0f6}.card{margin:18px 0;padding:14px;border:1px solid #5c1824}.pre{white-space:pre-wrap;color:#92828c}"; }
			return SafeCss(css) ? css : "body{background:#0a0a10;color:#ececf1;font-family:'Segoe UI',sans-serif;padding:20px}";
		}

		// Games from Browser addons: their own scripts and styles, pictures, and only the three APIs our games use.
		const string GameCsp = "<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none';script-src 'unsafe-inline';style-src 'unsafe-inline';img-src https: data:;media-src https: data:;connect-src https://graphql.anilist.co https://en.wikipedia.org https://www.gamerpower.com;form-action 'none';base-uri 'none'\">";
		bool lookAsked;

		// Style rules only: no escapes, tags, at-rules other than @keyframes and @media, urls or anything else that can load or run something.
		static bool SafeCss(string css) { return !Regex.IsMatch(css, @"[\\<>]|@(?!keyframes\b|media\b)|url|expression|image|src|behavio|binding|javascript", RegexOptions.IgnoreCase); }

		// Downloads settings.css and help.txt once, quietly, then redraws Settings. The help in your language, once, off the UI thread; Settings
		// redraws when it's here.
		readonly List<string> helpAsked = new List<string>();
		void GetHelp(string lang)
		{
			string file = "help/" + lang + ".txt";
			if (helpAsked.Contains(lang) || !IsPinned(file)) return;
			helpAsked.Add(lang);
			Behind(delegate
			{
				string got = null;
				try { using (WebClient web = new WebClient()) { web.Encoding = Encoding.UTF8; got = Pinned(web, file); } } catch { }
				if (got != null) Post(delegate { Keep("help-" + lang, got); RefreshSettingsTabs(); });
			});
		}

		// The ad blocker and tracker lists, in the background. Until they're here, the short built-in lists are used.
		bool adblockAsked;
		void GetAdblock()
		{
			if (adblockAsked) return;
			adblockAsked = true;
			Behind(delegate
			{
				string got = null;
				try { using (WebClient web = new WebClient()) got = Pinned(web, "data/adblock.txt"); } catch (Exception) { }
				if (got != null) Post(delegate { Keep("adblock", got); Keep("adblock-pin", AddonsCommit); });
			});
		}

		void GetLook()
		{
			if (lookAsked) return;
			lookAsked = true;
			Behind(delegate
			{
				string css = null, help = null, welcome = null, news = null, lists = null, home = null, pages = null, clock = null, guess = null;
				try { using (WebClient web = new WebClient()) { web.Encoding = Encoding.UTF8; css = Pinned(web, "settings.css"); help = Pinned(web, "help.txt"); welcome = Pinned(web, "pages/welcome.html"); news = Pinned(web, "whats-new.txt"); lists = Pinned(web, "data/lists.txt"); home = Pinned(web, "pages/home.css"); pages = Pinned(web, "pages/pages.css"); clock = Pinned(web, "pages/race-clock.js"); guess = Pinned(web, "pages/guess.js"); } }
				catch (Exception) { lookAsked = false; return; }
				Post(delegate { Keep("css-settings", css); Keep("help", help); Keep("page-welcome", welcome); Keep("whats-new", news); Keep("lists", lists); Keep("css-home", home); Keep("css-pages", pages); Keep("js-clock", clock); Keep("js-guess", guess); Keep("look-pin", AddonsCommit); foreach (Tab open in tabs) if (open.Special == "settings" || open.Special == "welcome") ShowReader(open); });
			});
		}

		// Settings open as a page of their own.
		internal bool SettingsShown { get { return false; } set { if (value) WebSettings(); } }

