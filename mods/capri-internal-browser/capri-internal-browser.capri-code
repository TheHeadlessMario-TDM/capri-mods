		internal void ClearSiteData()
		{
			const string question = "This signs you out of websites and clears their cookies, saved site data and cache. Your history, Speed Dial and saved passwords stay. Go ahead?";
			bool yes = MessageBox.Show(FindForm(), question, "Capri Browser", MessageBoxButtons.YesNo, MessageBoxIcon.Question) == DialogResult.Yes;
			if (!yes) return;
			Tab with = null;
			foreach (Tab t in tabs) if (t.Viewer.Modern && !t.Private) { with = t; break; }
			Action<string> done = failed => { Post(delegate { mod.Tell(failed == null ? "Done, choom. Cookies and site data are cleared." : "I couldn't clear it, choom: " + failed); }); };
			if (with == null || !with.Viewer.Clear(done)) mod.Tell("Edge's engine isn't running yet, so there's nothing to clear right now, choom.");
		}

		void Cue()
		{
			if (!address.IsHandleCreated) return;
			SendMessage(address.Handle, 0x1501, (IntPtr)1, adding ? T(4) : asking ? T(62) : T(3));
		}

		protected override bool ProcessCmdKey(ref Message msg, Keys keyData)
		{
			return Shortcut(keyData) || base.ProcessCmdKey(ref msg, keyData);
		}

		// Capri Browser's own keys. Edge's own (Ctrl+F, Ctrl+P, zoom) are left to the page.
		internal bool Shortcut(Keys keyData)
		{
			if (Masked(tab) && (keyData == Keys.F12 || ((keyData & Keys.Control) != 0 && "UIJCFPASG".IndexOf((char)(keyData & Keys.KeyCode)) >= 0))) return true;
			if (keyData == (Keys.Control | Keys.T)) { NewTab(); return true; }
			if (keyData == (Keys.Control | Keys.W) || keyData == (Keys.Control | Keys.F4)) { Tab closing = tab; Later(delegate { Close(closing); }); return true; }
			if (keyData == (Keys.Control | Keys.Shift | Keys.PageDown) && tab != null) { MoveTab(tab, tabs.IndexOf(tab) + 1); Remember(); return true; }
			if (keyData == (Keys.Control | Keys.Shift | Keys.PageUp) && tab != null) { MoveTab(tab, tabs.IndexOf(tab) - 1); Remember(); return true; }
			if (keyData == (Keys.Control | Keys.Tab) || keyData == (Keys.Control | Keys.PageDown)) { Step(1); return true; }
			if (keyData == (Keys.Control | Keys.Shift | Keys.Tab) || keyData == (Keys.Control | Keys.PageUp)) { Step(-1); return true; }
			if (keyData == (Keys.Control | Keys.L) || keyData == Keys.F6) { address.Focus(); address.SelectAll(); return true; }
			if (keyData == Keys.F5 || keyData == (Keys.Control | Keys.R)) { Reload(); return true; }
			if (keyData == (Keys.Control | Keys.Shift | Keys.S)) { Summarise(); return true; }
			if (keyData == (Keys.Control | Keys.Shift | Keys.B)) { ShowMarks(); return true; }
			if (keyData == (Keys.Control | Keys.Shift | Keys.D)) { MarkThis(true); return true; }
			if (keyData == (Keys.Control | Keys.Shift | Keys.X)) { TakeShot(tab, "area", null, null); return true; }
			if (keyData == (Keys.Control | Keys.Shift | Keys.T)) { ReopenClosed(); return true; }
			if (keyData == (Keys.Control | Keys.Shift | Keys.N)) { NewPrivate(); return true; }
			if (keyData == (Keys.Control | Keys.M)) { Mute(tab); return true; }
			if (keyData == (Keys.Control | Keys.Shift | Keys.A)) { StartAsking(); return true; }
			if (keyData == (Keys.Control | Keys.H)) { ShowHistory(); return true; }
			if (keyData == (Keys.Control | Keys.J)) { tab.Viewer.Downloads(); return true; }
			if (keyData == Keys.F11) { byKey = !full; SetFullScreen(!full); return true; }
			if (keyData == Keys.Escape && mod.Driving) { mod.Halt(); return true; }
			if (keyData == Keys.Escape && full && byKey) { SetFullScreen(false); return true; }
			if (keyData == (Keys.Control | Keys.D)) { if (!tab.OnReader && tab.Address != null) AddToDial(tab.Address); return true; }
			if (keyData == (Keys.Alt | Keys.Left)) { if (tab.Viewer.CanBack) tab.Viewer.Back(); return true; }
			if (keyData == (Keys.Alt | Keys.Right)) { tab.Viewer.Forward(); return true; }
			return false;
		}

		// Every bit of text that changes with the language, so picking one redoes them all.
		readonly List<Action> words = new List<Action>();
		Button resultsButton;
		readonly Label saveText = new Label();
		readonly Control shield = new Panel { Dock = DockStyle.Right, Width = 50, Cursor = Cursors.Hand };
		readonly ToolTip shieldTip = new ToolTip();
		bool asking;
		internal string LastShot;
		internal static bool ShowShots = true;

		void Relabel()
		{
			foreach (Action say in words) say();
			ShowVideoState(null);
			ShowWallState(null);
			Cue();
			foreach (Tab t in tabs) if (t.OnReader && t.Address == null) ShowReader(t);
		}

		static int fetching;
		static bool edgeBroken;
		static string edgeWhy;

		void ShowVideoState(string message)
		{
			bool modern = tab != null && tab.Viewer.Modern;
			if (message != null) videoText.Text = message;
			else if (modern) videoText.Text = "Edge's engine: videos, sign-ins, downloads and saved passwords work like they do in Edge.";
			else if (edgeBroken) videoText.Text = "Edge's engine didn't start (" + edgeWhy + "), so most sites and videos won't work. Installing Microsoft's \"WebView2 Runtime\" usually fixes it.";
			else videoText.Text = "Getting Edge's engine ready...";
		}

		// The first time, Edge's engine is set up by itself: Microsoft's WebView2 SDK, 9.8 MB from NuGet, checked by its SHA-256.
		void GetEdge()
		{
			if (edgeBroken || VideoInstalled(mod.Folder) || Interlocked.Exchange(ref fetching, 1) == 1) return;
			string folder = mod.Folder;
			ShowVideoState("Getting Edge's engine ready (a one-time 9.8 MB download from Microsoft)...");
			var worker = new Thread(delegate()
			{
				string failed = InstallVideo(folder, percent => { Post(delegate { videoText.Text = "Getting Edge's engine ready... " + percent + "%"; }); });
				Interlocked.Exchange(ref fetching, 0);
				Post(delegate
				{
					if (failed != null) { edgeBroken = true; edgeWhy = "the download failed: " + failed; ShowVideoState(null); return; }
					Rebuild();
				});
			});
			worker.IsBackground = true;
			worker.Start();
		}

		void TurnOnVideo()
		{
			edgeBroken = false;
			edgeWhy = null;
			videoError = null;
			if (VideoInstalled(mod.Folder)) Rebuild(); else GetEdge();
		}

		// ---- Capri's hologram when she talks (Settings > Capri features) ----
		// It borrows the call screen from Issei's Holocall mod, which they install from the Capri app's mod browser: her face, its animation and the
		// reading of her voice all come from their copy of Holocall, so it only works while Holocall is installed and on.
		object holoLook, holoTap;
		MethodInfo holoDraw, holoMouth, holoLine;
		int holoWide, holoHigh;
		HoloScreen holoScreen;
		WinTimer holoBeat;
		readonly Stopwatch holoClock = Stopwatch.StartNew();
		double holoShown = -1, holoLeaving = -1, holoUntil, holoLevel, holoLast, holoStarted, holoIdle;
		bool holoVoice, holoWarned;
		string holoText;
		double HoloNow { get { return holoClock.Elapsed.TotalSeconds; } }

		// One of Holocall's own parts, from Holocall itself as Capri loaded it; null when it isn't installed and on.
		static readonly Dictionary<string, Type> holocallParts = new Dictionary<string, Type>();
		internal static Type HolocallPart(string name)
		{
			lock (holocallParts) { Type known; if (holocallParts.TryGetValue(name, out known)) return known; }
			foreach (Assembly a in AppDomain.CurrentDomain.GetAssemblies())
			{
				if (a == typeof(CapriInternalBrowser).Assembly || a.GlobalAssemblyCache) continue;
				Type[] all;
				try { all = a.GetTypes(); }
				catch (ReflectionTypeLoadException partly) { all = partly.Types; }
				catch (Exception) { continue; }
				bool holocall = false;
				Type found = null;
				foreach (Type t in all) { if (t == null) continue; if (t.Name == "Holocall") holocall = true; if (t.Name == name) found = t; }
				if (holocall && found != null) { lock (holocallParts) holocallParts[name] = found; return found; }
			}
			return null;
		}

		internal static bool HolocallThere { get { return HolocallPart("Look") != null; } }

		internal void Holo(string line, bool talking)
		{
			if (line == null)
			{
				// Her voice finished: the call screen goes once she's been quiet a moment.
				if (holoVoice) { holoVoice = false; holoUntil = HoloNow + .35; }
				return;
			}
			if (!HoloReady())
			{
				if (!holoWarned && HolocallPart("Look") == null) { holoWarned = true; mod.Tell("I can't find Holocall running, choom. Turn it on in Capri's mods and my hologram will show up."); }
				return;
			}
			double now = HoloNow;
			holoText = line;
			holoVoice = talking;
			holoUntil = talking ? now + 120 : now + Math.Max(2.5, Math.Min(8, line.Length * .07));
			if (holoShown < 0 || holoLeaving >= 0) { holoShown = now; holoLeaving = -1; holoStarted = now; }
			holoBeat.Start();
		}

		bool HoloReady()
		{
			if (holoLook != null) return true;
			Form owner = FindForm();
			Type look = HolocallPart("Look");
			if (owner == null || look == null) return false;
			try
			{
				Bitmap face = mod.HoloFace();
				ConstructorInfo make = look.GetConstructor(AnyMember, null, new[] { typeof(Bitmap), typeof(float) }, null);
				holoDraw = look.GetMethod("Draw", AnyMember);
				if (face == null || make == null || holoDraw == null) { mod.Note("hologram: " + (face == null ? "no face art" : "Holocall changed, its call screen can't be borrowed")); holoWarned = true; return false; }
				float k = Math.Max(.5f, Math.Min(1.2f, Screen.FromControl(this).Bounds.Height / 1080f * .62f));
				holoLook = make.Invoke(new object[] { face, k });
				holoWide = (int)look.GetField("Width", AnyMember).GetValue(holoLook);
				holoHigh = (int)look.GetField("Height", AnyMember).GetValue(holoLook);
				Type tap = HolocallPart("Tap");
				MethodInfo find = tap == null || mod.HostObject == null ? null : tap.GetMethod("Find", BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic);
				if (find != null)
				{
					holoTap = find.Invoke(null, new object[] { mod.HostObject, null });
					holoMouth = tap.GetMethod("Talking", AnyMember);
					holoLine = tap.GetMethod("Line", AnyMember);
				}
				holoScreen = new HoloScreen(new Size(holoWide, holoHigh));
				holoScreen.Begin(owner);
				holoBeat = new WinTimer { Interval = 15 };
				holoBeat.Tick += delegate { try { HoloTick(); } catch (Exception) { holoBeat.Stop(); } };
				Disposed += delegate { holoBeat.Dispose(); holoScreen.Dispose(); IDisposable d = holoLook as IDisposable; if (d != null) d.Dispose(); };
				return true;
			}
			catch (Exception error) { holoLook = null; mod.Note("hologram: " + (error.InnerException ?? error).Message); return false; }
		}

		// Where the hologram sits on the page (Settings > Capri features): t, m or b for top, middle or bottom, then l, c or r.
		internal static readonly string[] HoloSpots = { "tl", "tc", "tr", "ml", "mr", "bl", "bc", "br" };
		string holoAt;
		Point HoloSpot()
		{
			string at = holoAt ?? (holoAt = Kept("holospot"));
			int left = (side.Visible && side.Parent == holder ? side.Width : 0) + 10, right = holder.Width - holoWide - 10, top = 10, bottom = holder.Height - holoHigh - 10;
			int x = at.EndsWith("l") ? left : at.EndsWith("c") ? (left + right) / 2 : right, y = at.StartsWith("t") ? top : at.StartsWith("m") ? (top + bottom) / 2 : bottom;
			return holder.PointToScreen(new Point(Math.Max(left, x), Math.Max(top, y)));
		}

		void HoloTick()
		{
			double now = HoloNow, dt = Math.Min(.1, now - holoLast);
			holoLast = now;
			double open = 0;
			bool talking = false;
			if (holoTap != null && holoMouth != null)
			{
				object[] asked = { 0.0 };
				talking = (bool)holoMouth.Invoke(holoTap, asked);
				open = (double)asked[0];
			}
			// Without Capri to read (tests), her mouth just moves while her voice plays.
			else if (holoVoice) { talking = true; open = .2 + .8 * Math.Abs(Math.Sin(now * 9.5) * Math.Sin(now * 3.1)); }
			if (talking) holoUntil = Math.Max(holoUntil, now + .35);
			double want = talking ? open : 0;
			holoLevel += (want - holoLevel) * Math.Min(1, dt * (want > holoLevel ? 30 : 12));
			if (holoShown >= 0 && holoLeaving < 0 && now > holoUntil) holoLeaving = now;
			if (holoShown < 0 || (holoLeaving >= 0 && now - holoLeaving > .28))
			{
				holoShown = holoLeaving = -1;
				holoScreen.Canvas.Clear(Color.Transparent);
				holoScreen.Flip(HoloSpot());
				holoBeat.Stop();
				return;
			}
			double arriving = Math.Max(0, 1 - (now - holoShown) / .32), leaving = holoLeaving < 0 ? 0 : Math.Min(1, (now - holoLeaving) / .28);
			// Her face always moves a little, but while she's quiet 30 frames a second is plenty.
			if (!(talking || arriving > 0 || leaving > 0 || holoLevel > .01) && now < holoIdle) return;
			holoIdle = now + .033;
			string status = leaving > 0 ? "CALL ENDED" : now - holoStarted < 1.2 ? "CONNECTING" : "CONNECTED";
			string said = holoTap == null || holoLine == null ? null : holoLine.Invoke(holoTap, null) as string;
			holoDraw.Invoke(holoLook, new object[] { holoScreen.Canvas, now, holoLevel, talking, said ?? holoText, Math.Max(arriving, leaving), leaving > 0, status, now - holoStarted });
			holoScreen.Flip(HoloSpot());
		}

		internal void Post(Action run)
		{
			if (IsDisposed) return;
			try { if (InvokeRequired) BeginInvoke(run); else run(); } catch (InvalidOperationException) { }
		}

		// After the click or key that asked for it has finished, so a control is never disposed inside its own event.
		void Later(Action run)
		{
			if (IsDisposed) return;
			try { BeginInvoke(run); } catch (InvalidOperationException) { }
		}

		// ---- pages ----

		// A crashed page is reloaded the first time, and asked about if it crashes again within a minute. When the whole engine
		// stops, Capri Browser restarts with its tabs (once a minute at most, so it can never loop).
		static DateTime engineAt;
		void PageCrashed(Tab t, int kind)
		{
			DateTime now = DateTime.UtcNow;
			if (kind == 0)
			{
				if (mod.Restarting || now < engineAt.AddSeconds(5)) return;
				bool soon = now < engineAt.AddMinutes(1);
				engineAt = now;
				mod.Note("page engine crashed");
				if (soon) { mod.Tell("The page engine crashed again, choom. Press Restart in the menu when you're ready."); return; }
				mod.Tell("The page engine crashed, so I'm restarting Capri Browser with your tabs, choom.");
				Remember();
				mod.Restart(FindForm(), tab == null || tab.Private ? null : tab.Address, null);
				return;
			}
			if (kind > 2 || (!tabs.Contains(t) && !t.Hidden)) return;
			bool again = now < t.CrashAt.AddMinutes(1);
			if (kind == 2 && again) return;
			t.CrashAt = now;
			if (kind == 2) { if (!t.Hidden) mod.Tell("\"" + Clip(t.Title, 50) + "\" isn't responding, choom. Give it a moment, or press F5 to reload it."); return; }
			mod.Note("a page crashed");
			if (again && (t.Hidden || MessageBox.Show(FindForm(), "\"" + Clip(t.Title, 60) + "\" keeps crashing. Reload it?", "Capri Browser", MessageBoxButtons.YesNo, MessageBoxIcon.Warning) != DialogResult.Yes)) return;
			if (t.OnReader) ShowReader(t); else t.Viewer.Reload();
			if (!again && !t.Hidden) mod.Tell("That page crashed, so I reloaded it, choom.");
		}

		// The video player when it's installed and on, otherwise the classic engine.
		Viewer MakeViewer(Tab t)
		{
			Viewer made = null;
			if (!edgeBroken && VideoInstalled(mod.Folder))
			{
				string why = LoadVideo(mod.Folder);
				if (why == null)
					try { made = new ModernViewer(Path.Combine(mod.Folder, "web-profile"), mod.look.Shade(0), t.Private); }
					catch (Exception error) { made = null; why = Inner(error).Message; }
				if (made == null) { edgeBroken = true; edgeWhy = why; }
			}
			if (made == null)
			{
				made = new ClassicViewer();
				t.Private = false;
				if (!edgeBroken) Later(GetEdge);
			}
			Viewer v = made;
			v.Moved = url =>
			{
				if (StoreSite(url)) v.Script(ModernViewer.StoreButton);
				if (url == null || url.StartsWith(Own, Exact)) return;
				t.OnReader = false;
				t.Address = url;
				Uri went;
				string risk = Flag("scam", true) && !t.Hidden && Uri.TryCreate(url, UriKind.Absolute, out went) && went.Host != warnedHost ? Scam(went) : null;
				if (risk != null) { warnedHost = new Uri(url).Host; if (Flag("glitch", true)) t.Viewer.Script(RedGlitch); mod.Tell("Careful, choom: this page looks sketchy, " + risk + ". Don't sign in or pay here unless you're sure."); }
				if (!t.Private && !t.Hidden) { Bump("pages", 1); if (DateTime.Now.Hour >= 1 && DateTime.Now.Hour < 5) Bump("night", 1, true); }
				if (race != null && race.Tab == t) Raced(url);
				if (Masked(t)) { t.Viewer.Script("document.documentElement.style.filter='blur(18px)'"); Guess(t); }
				if (t == tab && !adding && !address.Focused) address.Text = url;
				if (t == tab) ShowLock();
				Remember();
			};
			v.Titled = title =>
			{
				if (t.OnReader) return;
				RaceTitle(t, title);
				Retitle(t, title);
				if (!t.Private && !t.Hidden && t.Address != null) mod.Visited(t.Address, t.Title);
			};
			v.Busy = busy => { t.Busy = busy; if (t == tab) loading.Visible = busy && !full; };
			v.Blocks = count => { if (count > t.Blocked) adsNew += count - t.Blocked; t.Blocked = count; if (t == tab) ShowShield(); };
			v.Downloading = (operation, file, from) => { Downloading(operation, file, from); };
			v.PageMenu = delegate { if (Masked(t)) return true; if (!(t == tab && t.OnReader && t.Special == null && t.Address == null && (t.Page == null || t.Page.Results.Count == 0))) return false; Later(DialMenu); return true; };
			v.Typed = delegate { if (t == tab) Blip("key"); };
			v.Crashed = kind => { Later(delegate { PageCrashed(t, kind); }); };
			v.Escaped = delegate { if (mod.Driving) mod.Halt(); };
			v.Tracks = count => { if (count > t.Tracked) tracksNew += count - t.Tracked; t.Tracked = count; if (t == tab) ShowShield(); };
			v.Shield = what =>
			{
				Post(delegate
				{
					if (what == "layer" || what == "popup" || what == "redirect") { Bump("shielded", 1); if (t == tab) { ShowShield(); BlockedLine(what); } }
					else if (what == "scam" && t == tab && !t.Private) mod.ScamText();
					else if (what.Begins("skip|") && t == tab) Behind(delegate { mod.OfferSkip(what.Substring(5)); });
				});
			};
			v.Sound = (playing, muted) => { if (t.Playing == playing && t.Muted == muted) return; t.Playing = playing; t.Muted = muted; Retitle(t, t.Title); };
			v.Key = pressed => t == tab && Shortcut(pressed);
			v.FullScreen = on => { if (t == tab) { byKey = false; SetFullScreen(on); } };
			v.ExtWanted = (from, what) => { StoreAdd(t, from, what); };
			v.Loaded = delegate { if (StoreSite(t.Address)) v.Script(ModernViewer.StoreButton); v.Style(mod.look, t.OnReader); Race r = race; if (r != null && r.Tab == t) RaceClock(r, false); if (Masked(t)) Guess(t); };
			v.Ready = delegate { if (Masked(t)) Guess(t); };
			v.Researched = picked =>
			{
				Post(delegate
				{
					if (t.Private || string.IsNullOrWhiteSpace(picked)) return;
					mod.Study("pick", Clip(Regex.Replace(picked, @"\s+", " ").Trim(), 150), "Research this, highlighted on \"" + t.Title + "\": " + Clip(picked, 1200));
				});
			};
			v.MakeMenu = delegate { ContextMenuStrip m = NewMenu(); m.Tag = mod.look.Shade(4); return m; };
			v.CloseAsked = delegate { Post(delegate { CloseQuiet(t); }); };
			v.ExtensionsAsked = delegate
			{
				Post(delegate
				{
					mod.Tell("Capri Browser hasn't got Edge's own Extensions page, choom, so switches that live there (like Allow User Scripts) can't go on. Press \"Maybe later\" and it keeps working with what it can. Here are your extensions.");
					if (puzzleButton != null) ExtensionsPanel(puzzleButton);
				});
			};
			v.Wallpapered = source => { Post(delegate { if (!t.Private) WallpaperFrom(source, t.Address); }); };
			v.Asked = picked =>
			{
				Post(delegate
				{
					if (t.Private || string.IsNullOrWhiteSpace(picked)) return;
					mod.Summarise(t.Title, t.Address, "The part they highlighted on \"" + t.Title + "\": " + picked, delegate { }, "Explain the part they highlighted, simply and briefly.");
				});
			};
			v.LoginSeen = (from, user, pass) => { OfferSave(t, from, user, pass); };
			v.PasswordBox = from => { OfferFill(t, from); };
			v.Ended = (title, counts) => { if (!t.Private && counts) { Bump("videos", 1); } if (!t.Private && !t.Hidden && Notice("react")) mod.React(title); };
			v.Opening = url => { if (!t.Hidden) Later(delegate { OpenTab(null, url, true); }); };
			v.Mine = url => { if ((t.OnReader && t.Special != "addon" && t.Special != "welcome") || (t.Special == "welcome" && Regex.IsMatch(url, "^" + Regex.Escape(Own) + "go[?]w=(video|settings|home|games|download|quiet|bug|idea|donate|send&k=(bug|idea)&t=[^&#]{0,600}&m=[^&#]{0,12000})$")) || Regex.IsMatch(url, "^" + Regex.Escape(Own) + "play[?]g=(cancel|hint)$")
				|| (t == guessTab && Regex.IsMatch(url, "^" + Regex.Escape(Own) + "play[?]g=(guess|guessed&r=[01])$"))
				|| (t.Special == "addon" && Regex.IsMatch(url, "^" + Regex.Escape(Own) + "play[?]g=(quit|typed&w=[0-9]+&a=[0-9]+|survived&s=[0-9]+|daily&s=[0-9]{1,5}&d=[0-9]{1,6})$"))) Later(delegate { OwnLink(t, url); }); };
			v.Blocked = url =>
			{
				t.OnReader = true;
				t.Address = url;
				v.Html(Reader(null, mod.look, VideoNotice + "<br><br>The site you asked for: " + WebUtility.HtmlEncode(url)
					+ (edgeBroken && edgeWhy != null ? "<br>Why Edge's engine stopped: " + WebUtility.HtmlEncode(edgeWhy) : "")));
				Uri asked;
				Retitle(t, Uri.TryCreate(url, UriKind.Absolute, out asked) ? asked.Host : url);
				if (t == tab) { address.Text = url; ShowLock(); }
			};
			// Swapped after the failing engine's own event has returned, never from inside it.
			v.Failed = why =>
			{
				Post(delegate
				{
					if (edgeBroken) return;
					edgeBroken = true;
					edgeWhy = why;
					Rebuild();
				});
			};
			v.Privacy(mod.look);
			v.Control.Dock = DockStyle.Fill;
			v.Control.Visible = t == tab;
			holder.Controls.Add(v.Control);
			// In split screen, clicking into either half makes it the tab in front (address bar and all).
			v.Control.GotFocus += delegate { if (Split && tab != t && (t == splitA || t == splitB)) Select(t); };
			if (Split && (t == splitA || t == splitB)) Later(delegate { if (tab != null) ShowPages(tab); });
			return v;
		}

		// Every tab onto the engine the settings now pick, each keeping its page.
		void Rebuild()
		{
			foreach (Tab t in tabs)
			{
				string at = t.OnReader ? null : t.Address;
				holder.Controls.Remove(t.Viewer.Control);
				t.Viewer.Control.Dispose();
				t.Viewer = MakeViewer(t);
				if (at != null) Go(t, at); else ShowReader(t);
			}
			if (tab != null) Select(tab);
			ShowVideoState(null);
		}

		// Her own page in a tab: her results when it has some, otherwise the new tab page.
		void ShowReader(Tab t)
		{
			if (Masked(t)) GuessOver();
			t.OnReader = true;
			t.Address = null;
			if (t.Special == "settings")
			{
				t.Viewer.Html(SettingsPage());
				Retitle(t, T(7));
				if (t == tab) address.Text = "";
				return;
			}
			if (t.Special == "jobs")
			{
				t.Viewer.Html(JobsPage());
				Retitle(t, "Custom jobs");
				if (t == tab) address.Text = "";
				return;
			}
			if (t.Special == "welcome")
			{
				t.Viewer.Html(WelcomePage());
				Retitle(t, "Useful information");
				if (t == tab) address.Text = "";
				return;
			}
			if (t.Special == "addon")
			{
				t.Viewer.Html(GameCsp + t.Html);
				Retitle(t, t.Title);
				if (t == tab) address.Text = "";
				return;
			}
			if (t.Special == "boards")
			{
				t.Viewer.Html(BoardsPage());
				Retitle(t, "Leaderboards");
				if (t == tab) address.Text = "";
				return;
			}
			if (t.Special == "news")
			{
				t.Viewer.Html(NewsPage());
				Retitle(t, "What's new");
				if (t == tab) address.Text = "";
				return;
			}
			if (t.Special == "alltime")
			{
				t.Viewer.Html(AllTimePage());
				Retitle(t, "All-time stats");
				if (t == tab) address.Text = "";
				return;
			}
			if (t.Special == "games")
			{
				t.Viewer.Html(GamesPage());
				Retitle(t, "Games");
				if (t == tab) address.Text = "";
				return;
			}
			if (t.Special == "history")
			{
				t.Viewer.Html(HistoryPage());
				Retitle(t, T(49));
				if (t == tab) address.Text = "";
				return;
			}
			if (t.Page != null && t.Page.Results.Count > 0)
			{
				t.Viewer.Html(Reader(t.Page, mod.look, null));
				Retitle(t, t.Page.Query);
			}
			else
			{
				t.Viewer.Html(Home(mod.look, mod.Dial(), Recently(), mod.Wallpaper(), mod.TilePicture));
				Retitle(t, T(1));
			}
			if (t == tab) { address.Text = t.Page == null ? "" : t.Page.Query; ShowLock(); }
		}

		static List<string> Recently()
		{
			List<KeyValuePair<DateTime, Page>> all;
			lock (Recent) all = new List<KeyValuePair<DateTime, Page>>(Recent.Values);
			all.Sort((a, b) => b.Key.CompareTo(a.Key));
			var asked = new List<string>();
			foreach (KeyValuePair<DateTime, Page> one in all) if (asked.Count < 6) asked.Add(one.Value.Query);
			return asked;
		}

		void Go(Tab t, string url)
		{
			t.Special = null;
			t.OnReader = false;
			t.Address = url;
			Uri uri;
			Retitle(t, Uri.TryCreate(url, UriKind.Absolute, out uri) ? uri.Host : url);
			if (t == tab) { address.Text = url; ShowLock(); }
			t.Viewer.Go(url);
		}

		void Reload()
		{
			if (tab.OnReader) ShowReader(tab); else tab.Viewer.Reload();
		}

		// Speed Dial's own links: "+" asks for a site in the bar, "x" takes one off.
		void OwnLink(Tab t, string url)
		{
			// The Speed Dial's search box and her recent searches: exactly what they typed, on their search engine.
			if (url.StartsWith(Own + "search", Exact))
			{
				Match q = Regex.Match(url, @"[?&]q=([^&#]*)");
				string to = Where(q.Success ? Uri.UnescapeDataString(q.Groups[1].Value.Replace('+', ' ')) : "");
				if (to != null) Go(t, to);
				return;
			}
			if (url.StartsWith(Own + "engine", Exact)) { Match e = Regex.Match(url, @"[?&]e=(\w+)"); int row = e.Success ? EngineRow(e.Groups[1].Value) : -1; if (row >= 0) { mod.look.Search = SearchEngine = Engines[row, 0]; mod.Save(); } ShowReader(t); return; }
			if (url.StartsWith(Own + "set?", Exact)) { SetFromPage(t, url); return; }
			if (url.StartsWith(Own + "jobs?", Exact) && t.Special == "jobs")
			{
				Func<string, string> part = key => { Match one = Regex.Match(url, "[?&]" + key + "=([^&]*)"); return one.Success ? Uri.UnescapeDataString(one.Groups[1].Value) : ""; };
				int ji;
				int.TryParse(part("i"), out ji);
				string a = part("a");
				if (a == "save") { jobNote = mod.KeepJob(ji, part("t"), part("l"), part("s")); if (jobNote == null) draftAt = -1; }
				else if (a == "fix")
				{
					string link = part("l");
					mod.RewriteJob(part("t"), part("s"), (name, steps) =>
					{
						Later(delegate
						{
							if (name != null) { draftAt = ji; draft = new Job { Trigger = name, Link = link, Steps = steps }; jobNote = null; }
							if (t.Special == "jobs") ShowReader(t);
						});
					});
					return;
				}
				else if (a == "quiet") { if (Host != null) Host.Store.Set("opt-jobquiet", Flag("jobquiet", false) ? "0" : "1"); }
				else if (a == "del") { mod.DropJob(ji); jobNote = null; draftAt = -1; }
				else if (a == "run" || a == "test") { List<Job> jobs = mod.Jobs(); if (ji >= 0 && ji < jobs.Count) { Job run = jobs[ji]; mod.Tell((a == "test" ? "Testing " : "Running ") + run.Trigger + ", choom."); Behind(delegate { mod.RunJob(run, 0, a == "test" ? new List<string[]>() : null); }); } return; }
				ShowReader(t);
				return;
			}
			if (url.StartsWith(Own + "go?w=", Exact))
			{
				string w = url.Substring(Own.Length + 5);
				if (w == "video") TurnOnVideo();
				else if (w == "settings") SettingsShown = true;
				else if (w == "download") { dlNote = "Starting the download..."; ShowReader(t); UpdateAll(false, t); }
				else if (w == "bug" || w == "idea") OpenTab(null, FeedbackUrl(w == "bug"), true);
				else if (w == "donate") OpenTab(null, "https://ko-fi.com/tob7as", true);
				else if (w == "games") ShowGames();
				else if (w.Begins("send&"))
				{
					Func<string, string> part = key => { Match one = Regex.Match(w, "&" + key + "=([^&]*)"); try { return one.Success ? Uri.UnescapeDataString(one.Groups[1].Value.Replace('+', ' ')).Trim() : ""; } catch (Exception) { return ""; } };
					string title = part("t"), said = part("m");
					if (title.Length == 0 || said.Length == 0) { mod.Tell("Write a title and a few words first, choom."); return; }
					bool bug = part("k") == "bug";
					if (title.Length > 100) title = title.Substring(0, 100);
					if (said.Length > 2000) said = said.Substring(0, 2000);
					Behind(delegate
					{
						string[] got = ToWorker("feedback", "{\"kind\":\"" + (bug ? "bug" : "idea") + "\",\"title\":" + Quote(title) + ",\"text\":" + Quote(said) + ",\"version\":\"" + Version + "\",\"windows\":" + Quote(WindowsName()) + ",\"key\":" + Quote(BoardKey()) + "}");
						Post(delegate
						{
							if (got != null && got[0] == "ok") { t.Viewer.Script("(function(){var f=document.querySelector('form.fb');if(f)f.reset();return 1})()"); mod.Tell("Sent, choom. Thanks! It went straight to the Capri Browser team."); }
							else if (got != null && got[0] == "no") mod.Tell(got[1].Length > 0 ? got[1] : "That didn't send, choom. Try again in a bit.");
							else { OpenTab(null, FeedbackUrl(bug, title, said), true); mod.Tell((got == null ? "I couldn't reach the bug box" : "The bug box is full for today") + ", so here it is on GitHub instead. Press Submit there to send it."); }
						});
					});
				}
				else if (w == "quiet") { UpdateAll(true, null); mod.Tell("Downloading the rest in the background, choom. Browse away."); t.Special = null; ShowReader(t); }
				else { t.Special = null; ShowReader(t); }
				return;
			}
			if (url.StartsWith(Own + "play?g=", Exact)) { Game(url.Substring(Own.Length + 7)); return; }
			if (url.StartsWith(Own + "clearhistory", Exact)) { mod.ClearHistory(); ShowReader(t); return; }
			if (url.StartsWith(Own + "forgethistory?d=", Exact)) { int days; if (int.TryParse(url.Substring(Own.Length + 16), out days) && days > 0) mod.ForgetHistory(days, null); ShowReader(t); return; }
			if (url.StartsWith(Own + "forgetpage?u=", Exact)) { mod.ForgetHistory(0, Uri.UnescapeDataString(url.Substring(Own.Length + 13))); Suggestions(); return; }
			if (url.StartsWith(Own + "add", Exact))
			{
				if (t != tab) Select(t);
				adding = true;
				address.Text = "";
				Cue();
				address.Focus();
				return;
			}
			Match which = Regex.Match(url, @"^" + Regex.Escape(Own) + @"(remove|picture|unpicture)\?i=(\d+)$");
			if (!which.Success) return;
			List<string> dial = mod.Dial();
			int i = int.Parse(which.Groups[2].Value);
			if (i >= dial.Count) return;
			string site = dial[i];
			if (which.Groups[1].Value == "remove") { dial.RemoveAt(i); mod.SaveDial(dial); mod.RemoveTilePicture(site); mod.NameTile(site, null); }
			else if (which.Groups[1].Value == "unpicture") mod.RemoveTilePicture(site);
			else { TileMenu(i, site); return; }
			RefreshHomes();
		}

		void TileMenu(int i, string site)
		{
			ContextMenuStrip m = NewMenu();
			Item(m.Items, "Change image", "", true, delegate
			{
				using (var pick = new OpenFileDialog { Title = T(30), InitialDirectory = DownloadFolder(), Filter = "Pictures|*.jpg;*.jpeg;*.jpe;*.jfif;*.png;*.bmp;*.gif;*.tif;*.tiff|All files|*.*" })
				{
					if (pick.ShowDialog(FindForm()) != DialogResult.OK) return;
					string failed = mod.SetTilePicture(site, pick.FileName);
					if (failed != null) MessageBox.Show(FindForm(), failed, "Capri Browser");
					RefreshHomes();
				}
			});
			Item(m.Items, "Edit name", "", true, delegate
			{
				string name;
				lock (DialNames) if (!DialNames.TryGetValue(site, out name)) name = Tile(site);
				string typed = AskLine("Edit name", "NAME (EMPTY FOR THE SITE'S OWN NAME)", name);
				if (typed == null) return;
				mod.NameTile(site, typed == Tile(site) ? null : typed);
				RefreshHomes();
			});
			Item(m.Items, "Edit link", "", true, delegate
			{
				string typed = AskLine("Edit link", "LINK", site);
				List<string> dial = mod.Dial();
				string url = Where(typed);
				if (url == null || url == site || i >= dial.Count || dial[i] != site) return;
				if (dial.Contains(url)) { mod.Tell("That site is already on Speed Dial, choom."); return; }
				dial[i] = url;
				mod.SaveDial(dial);
				mod.MoveTile(site, url);
				RefreshHomes();
			});
			m.Closed += delegate { Later(delegate { m.Dispose(); }); };
			m.Show(Cursor.Position);
		}

		// One line to type, in her colours. Null if they cancel.
		string AskLine(string title, string what, string start)
		{
			Look look = mod.look;
			using (var f = new Form { Text = title, FormBorderStyle = FormBorderStyle.FixedDialog, MaximizeBox = false, MinimizeBox = false, ShowInTaskbar = false, StartPosition = FormStartPosition.CenterParent, ClientSize = new Size(380, 124), BackColor = look.Shade(1), ForeColor = look.Shade(2), Font = new Font(Ui, 10f) })
			{
				f.Controls.Add(new Label { Text = what, Left = 18, Top = 14, AutoSize = true, ForeColor = look.Shade(3), Font = new Font(UiBold, 8f) });
				var box = new TextBox { Left = 18, Top = 34, Width = 344, Text = start ?? "", BackColor = look.Shade(0), ForeColor = look.Shade(2), BorderStyle = BorderStyle.FixedSingle };
				f.Controls.Add(box);
				var save = new Button { Text = "Save", Left = 278, Top = 76, Width = 84, Height = 32, FlatStyle = FlatStyle.Flat, BackColor = look.Shade(0), ForeColor = look.Shade(2), DialogResult = DialogResult.OK };
				var cancel = new Button { Text = "Cancel", Left = 188, Top = 76, Width = 84, Height = 32, FlatStyle = FlatStyle.Flat, BackColor = look.Shade(0), ForeColor = look.Shade(2), DialogResult = DialogResult.Cancel };
				save.FlatAppearance.BorderColor = look.Shade(5);
				cancel.FlatAppearance.BorderColor = look.Shade(6);
				f.Controls.Add(save);
				f.Controls.Add(cancel);
				f.AcceptButton = save;
				f.CancelButton = cancel;
				f.Shown += delegate { box.SelectAll(); box.Focus(); };
				return f.ShowDialog(FindForm()) == DialogResult.OK ? box.Text : null;
			}
		}

		internal string Bookmark() { if (tab == null || tab.OnReader || tab.Address == null) return "Open a site first, choom."; AddToDial(tab.Address); return null; }

		void AddToDial(string typed)
		{
			string url = Where(typed);
			if (url == null) return;
			List<string> dial = mod.Dial();
			if (!dial.Contains(url) && dial.Count < 30) { dial.Add(url); mod.SaveDial(dial); }
			RefreshHomes();
		}

		void RefreshHomes()
		{
			foreach (Tab t in tabs) if (t.OnReader && t.Special == null && (t.Page == null || t.Page.Results.Count == 0) && t.Address == null) ShowReader(t);
		}

		// What they typed, as an address: a site as it is, anything else a Bing search.
		internal static string Where(string typed)
		{
			typed = (typed ?? "").Trim();
			if (typed.Length == 0) return null;
			if (Regex.IsMatch(typed, @"^https?://\S+$", Plain)) return typed;
			if (Regex.IsMatch(typed, @"^[\w-]+(\.[\w-]+)+(:\d+)?(/\S*)?$")) return "https://" + typed + (typed.IndexOf('/') < 0 ? "/" : "");
			return SearchUrl(typed);
		}

		void Visit()
		{
			if (Masked(tab)) { mod.Tell("No peeking, choom. Guess it first."); return; }
			string typed = address.Text.Trim();
			if (race != null && race.Tab == tab && !asking && !typed.Begins("?"))
			{
				address.Text = tab.Address ?? "";
				mod.Tell("No typing addresses in a wiki race, choom. Links only, or cancel the race.");
				return;
			}
			if (asking || (typed.Begins("?") && tab != null && !tab.OnReader && tab.Address != null))
			{
				asking = false;
				string question = typed.TrimStart('?').Trim();
				Select(tab);
				if (question.Length > 0) Summarise(question);
				return;
			}
			if (adding)
			{
				adding = false;
				if (typed.Length > 0 && !Regex.IsMatch(typed, @"\s")) AddToDial(typed);
				Select(tab);
				return;
			}
			string url = Where(typed);
			if (url != null) { Go(tab, url); tab.Viewer.Control.Focus(); }
		}

		void Changed()
		{
			mod.Save();
			Recolor();
			foreach (Tab t in tabs) if (t.OnReader && t.Address == null) ShowReader(t); else t.Viewer.Style(mod.look, t.OnReader);
		}

		void Recolor()
		{
			Look look = mod.look;
			BackColor = holder.BackColor = look.Shade(0);
			strip.BackColor = chips.BackColor = look.Shade(0);
			top.BackColor = look.Shade(0);
			field.BackColor = lens.BackColor = look.Shade(1);
			box.BackColor = shield.BackColor = look.Shade(1);
			box.Invalidate();
			loading.BackColor = look.Shade(5);
			address.BackColor = look.Shade(1);
			address.ForeColor = look.Shade(2);
			ShowLock();
			foreach (Button b in buttons)
			{
				b.BackColor = Color.Transparent;
				b.ForeColor = b == resultsButton ? look.Shade(5) : b == plus ? look.Shade(3) : look.Shade(4);
				b.FlatAppearance.MouseOverBackColor = look.Shade(6);
			}
			TintCaption(look);
			TintSide(look);
			strip.Invalidate(true);
			top.Invalidate(true);
			TintChatCard();
			// The tab in front is filled with her second accent, like a gaming browser's; the rest sit back.
			foreach (Tab t in tabs)
			{
				if (t.Chip == null) continue;
				bool front = t == tab;
				t.Chip.BackColor = front ? look.Shade(5) : look.Shade(0);
				t.Name.BackColor = t.Close.BackColor = Color.Transparent;
				t.Name.ForeColor = front ? Color.White : look.Shade(3);
				t.Close.ForeColor = front ? Color.White : look.Shade(3);
				t.Close.FlatAppearance.MouseOverBackColor = front ? ControlPaint.Dark(look.Shade(5), 0.1f) : look.Shade(6);
				t.Chip.Invalidate();
			}
			foreach (Tab t in tabs) t.Viewer.Background(look.Shade(0));
			top.Invalidate();
			if (summary != null) summary.Invalidate();
			BrowserWindow window = FindForm() as BrowserWindow;
			if (window != null) window.Tint();
		}
	}

	// ---- Capri Browser's own window ----

	internal sealed class BrowserWindow : Form
	{
		internal readonly Browser Browser;
		readonly CapriInternalBrowser mod;

		[DllImport("dwmapi.dll")] private static extern int DwmSetWindowAttribute(IntPtr window, int attribute, ref int value, int size);

		public BrowserWindow(CapriInternalBrowser owner, Page page, string address, Icon icon)
		{
			mod = owner;
			Text = "Capri Browser";
			if (icon != null) Icon = icon;
			FormBorderStyle = FormBorderStyle.None;
			DoubleBuffered = true;
			StartPosition = FormStartPosition.Manual;
			MinimumSize = new Size(640, 420);
			BackColor = mod.look.Shade(0);
			Rectangle work = Screen.PrimaryScreen.WorkingArea;
			var place = new Rectangle(work.Left + Math.Max(0, (work.Width - 1240) / 2), work.Top + Math.Max(0, (work.Height - 820) / 2), Math.Min(1240, work.Width), Math.Min(820, work.Height));
			bool maximised = false;
			string[] saved = (mod.WindowPlace() ?? "").Split(',');
			int x, y, w, h;
			if (saved.Length >= 4 && int.TryParse(saved[0], out x) && int.TryParse(saved[1], out y) && int.TryParse(saved[2], out w) && int.TryParse(saved[3], out h))
			{
				var was = new Rectangle(x, y, Math.Max(640, w), Math.Max(420, h));
				foreach (Screen screen in Screen.AllScreens) if (screen.WorkingArea.IntersectsWith(was)) { place = was; break; }
				maximised = saved.Length > 4 && saved[4] == "1";
			}
			Bounds = place;
			Fit(Screen.FromRectangle(place));
			if (maximised) WindowState = FormWindowState.Maximized;
			Browser = new Browser(owner, page, address) { Dock = DockStyle.Fill };
			Browser.TitleChanged = title => { mod.Front = Browser.Here(); mod.Visited(Browser.Showing); Text = string.IsNullOrWhiteSpace(title) ? "Capri Browser" : title + " - Capri Browser"; };
			Controls.Add(Browser);
			FormClosing += delegate
			{
				Browser.SetFullScreen(false);
				Rectangle r = WindowState == FormWindowState.Normal ? Bounds : RestoreBounds;
				mod.SaveWindow(r.X + "," + r.Y + "," + r.Width + "," + r.Height + "," + (WindowState == FormWindowState.Maximized ? "1" : "0"));
			};
		}

		protected override void OnHandleCreated(EventArgs e) { base.OnHandleCreated(e); Tint(); }

		// No Windows title bar: the tab strip is the top, like Opera's, so the window resizes from its own edges.
		protected override CreateParams CreateParams { get { CreateParams p = base.CreateParams; p.Style |= 0x20000 | 0x10000 | 0x80000; return p; } }

		protected override void WndProc(ref Message m)
		{
			base.WndProc(ref m);
			if (m.Msg != 0x84 || WindowState != FormWindowState.Normal || Browser == null || Browser.Full) return;
			long at = m.LParam.ToInt64();
			Point p = PointToClient(new Point((short)(at & 0xFFFF), (short)((at >> 16) & 0xFFFF)));
			bool l = p.X < 6, r = p.X >= Width - 6, t = p.Y < 6, b = p.Y >= Height - 6;
			int hit = t && l ? 13 : t && r ? 14 : b && l ? 16 : b && r ? 17 : l ? 10 : r ? 11 : t ? 12 : b ? 15 : 0;
			if (hit != 0) m.Result = (IntPtr)hit;
		}

		// Maximised, it fills the screen but leaves the taskbar showing.
		void Fit(Screen s)
		{
			Rectangle w = s.WorkingArea;
			MaximizedBounds = new Rectangle(w.X - s.Bounds.X, w.Y - s.Bounds.Y, w.Width, w.Height);
		}

		protected override void OnResize(EventArgs e)
		{
			if (Browser != null)
			{
				Padding = WindowState == FormWindowState.Normal && !Browser.Full ? new Padding(4) : Padding.Empty;
				Browser.Framed(WindowState == FormWindowState.Maximized);
			}
			if (IsHandleCreated && WindowState != FormWindowState.Maximized) Fit(Screen.FromHandle(Handle));
			base.OnResize(e);
			Invalidate();
		}

		protected override void OnMove(EventArgs e) { base.OnMove(e); if (IsHandleCreated && WindowState == FormWindowState.Normal) Fit(Screen.FromHandle(Handle)); }

		// A thin edge with the Mainframe's red corner brackets.
		protected override void OnPaint(PaintEventArgs e)
		{
			base.OnPaint(e);
			if (Padding.All <= 0) return;
			Graphics g = e.Graphics;
			int w = Width - 1, h = Height - 1;
			using (var line = new Pen(mod.look.Shade(6))) g.DrawRectangle(line, 0, 0, w, h);
			using (var red = new Pen(mod.look.Shade(5), 2))
			{
				g.DrawLines(red, new[] { new Point(1, 20), new Point(1, 1), new Point(20, 1) });
				g.DrawLines(red, new[] { new Point(w - 20, 1), new Point(w, 1), new Point(w, 20) });
				g.DrawLines(red, new[] { new Point(1, h - 20), new Point(1, h), new Point(20, h) });
				g.DrawLines(red, new[] { new Point(w - 20, h), new Point(w, h), new Point(w, h - 20) });
			}
		}

		// Windows 11's title bar in her colours: dark with her near-black, or light.
		internal void Tint()
		{
			if (!IsHandleCreated) return;
			try
			{
				int dark = mod.look.Dark ? 1 : 0;
				DwmSetWindowAttribute(Handle, 20, ref dark, 4);
				Color c = mod.look.Shade(0);
				int rgb = c.R | (c.G << 8) | (c.B << 16);
				DwmSetWindowAttribute(Handle, 35, ref rgb, 4);
				int round = 2;
				DwmSetWindowAttribute(Handle, 33, ref round, 4);
				BackColor = c;
				Invalidate();
			}
			catch { }
		}
	}

	internal sealed class MenuColors : ProfessionalColorTable
	{
		readonly Look look;
		public MenuColors(Look look) { this.look = look; UseSystemColors = false; }
		public override Color MenuItemSelected { get { return look.Shade(6); } }
		public override Color MenuItemSelectedGradientBegin { get { return look.Shade(6); } }
		public override Color MenuItemSelectedGradientEnd { get { return look.Shade(6); } }
		public override Color MenuItemBorder { get { return look.Shade(6); } }
		public override Color MenuBorder { get { return look.Shade(6); } }
		public override Color ToolStripDropDownBackground { get { return look.Shade(1); } }
		public override Color ImageMarginGradientBegin { get { return look.Shade(1); } }
		public override Color ImageMarginGradientMiddle { get { return look.Shade(1); } }
		public override Color ImageMarginGradientEnd { get { return look.Shade(1); } }
		public override Color SeparatorDark { get { return look.Shade(6); } }
		public override Color SeparatorLight { get { return look.Shade(1); } }
	}

	// ---- The Summarise button ----

	// Start-up: Capri's name glitching in over scanlines, a load bar, then SYSTEM ONLINE. A click skips it.
	internal sealed class BootScreen : Control
	{
		readonly WinTimer tick = new WinTimer { Interval = 16 };
		readonly DateTime from = DateTime.UtcNow;
		readonly Random dice = new Random();
		static readonly Color Ink = Color.FromArgb(9, 12, 18), Cyan = Color.FromArgb(94, 240, 246), Dim = Color.FromArgb(62, 150, 160), Red = Color.FromArgb(232, 66, 70);
		const double Total = 1850;

		public BootScreen()
		{
			SetStyle(ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer | ControlStyles.UserPaint | ControlStyles.ResizeRedraw, true);
			Dock = DockStyle.Fill;
			tick.Tick += delegate { if ((DateTime.UtcNow - from).TotalMilliseconds > Total) Dispose(); else Invalidate(); };
			tick.Start();
			Click += delegate { Dispose(); };
		}

		protected override void Dispose(bool disposing) { if (disposing) tick.Dispose(); base.Dispose(disposing); }

		static float Part(double ms, double a, double b) { double t = Math.Max(0, Math.Min(1, (ms - a) / (b - a))); return (float)(1 - Math.Pow(1 - t, 3)); }

		static Point[] Edge(float x, float y, float w, float h)
		{
			int c = (int)Math.Min(14, Math.Min(w, h) / 3);
			return new[] { new Point((int)x + c, (int)y), new Point((int)(x + w), (int)y), new Point((int)(x + w), (int)(y + h) - c), new Point((int)(x + w) - c, (int)(y + h)), new Point((int)x, (int)(y + h)), new Point((int)x, (int)y + c) };
		}

		protected override void OnPaint(PaintEventArgs e)
		{
			Graphics g = e.Graphics;
			double ms = (DateTime.UtcNow - from).TotalMilliseconds;
			g.Clear(Ink);
			g.SmoothingMode = SmoothingMode.AntiAlias;
			g.TextRenderingHint = TextRenderingHint.AntiAliasGridFit;
			const float W = 330, H = 140;
			float cx = Width / 2f, cy = Height / 2f;
			float open = Part(ms, 0, 300) * (1 - Part(ms, 1660, 1850));
			float tall = Part(ms, 260, 600) * (1 - Part(ms, 1480, 1660));
			bool flick = ms < 260 && dice.Next(3) == 0;
			float w = W * open, h = Math.Max(1, H * tall);
			if (w < 2) return;
			float x = cx - w / 2, y = cy - h / 2;
			int glow = flick ? 60 : 255;
			if (tall < 0.02f)
			{
				using (var line = new Pen(Color.FromArgb(glow, Cyan), 1.6f)) g.DrawLine(line, x, cy, x + w, cy);
				using (var soft = new Pen(Color.FromArgb(glow / 5, Cyan), 7f)) g.DrawLine(soft, x, cy, x + w, cy);
				return;
			}
			// Her panel: dark glass, faint scan lines inside, a cyan cut-corner edge and the red bar at the left.
			Point[] shape = Edge(x, y, w, h);
			using (var glass = new SolidBrush(Color.FromArgb(235, 12, 18, 26))) g.FillPolygon(glass, shape);
			using (var clip = new GraphicsPath())
			{
				clip.AddPolygon(shape);
				g.SetClip(clip);
				using (var scan = new Pen(Color.FromArgb(16, Cyan))) for (float sy = y + (float)(ms / 30 % 4); sy < y + h; sy += 4) g.DrawLine(scan, x, sy, x + w, sy);
				g.ResetClip();
			}
			using (var line = new Pen(Color.FromArgb(220, Cyan), 1.6f)) g.DrawPolygon(line, shape);
			using (var bar = new SolidBrush(Red)) g.FillRectangle(bar, x + 14, y + 22, 3, Math.Max(0, h - 44));
			if (tall < 0.85f) return;
			// CAPRI types in a letter at a time, each settling from cyan to her red; BROWSER fades in under it.
			using (var big = new Font("Bahnschrift SemiBold", 40f, FontStyle.Regular, GraphicsUnit.Pixel))
			using (var small = new Font("Consolas", 12f, FontStyle.Regular, GraphicsUnit.Pixel))
			{
				string name = "CAPRI";
				float full = 0; foreach (char k in name) full += g.MeasureString(k.ToString(), big, PointF.Empty, StringFormat.GenericTypographic).Width + 6;
				float tx = cx - (full + 16) / 2 + 6, ty = y + h / 2 - 34, left0 = tx;
				int shown = Math.Min(name.Length, (int)Math.Max(0, (ms - 620) / 70));
				for (int i = 0; i < shown; i++)
				{
					double age = ms - 620 - i * 70;
					float settle = (float)Math.Max(0, Math.Min(1, age / 160));
					Color c = Color.FromArgb((int)(Cyan.R + (Red.R - Cyan.R) * settle), (int)(Cyan.G + (Red.G - Cyan.G) * settle), (int)(Cyan.B + (Red.B - Cyan.B) * settle));
					string ch = name[i].ToString();
					using (var ink = new SolidBrush(c)) g.DrawString(ch, big, ink, tx, ty);
					tx += g.MeasureString(ch, big, PointF.Empty, StringFormat.GenericTypographic).Width + 6;
				}
				if (shown == name.Length && ms < 1420)
					using (var caret = new SolidBrush(Color.FromArgb(DateTime.Now.Millisecond < 500 ? 230 : 0, Cyan))) g.FillRectangle(caret, tx + 2, ty + 8, 14, 34);
				float sub = Part(ms, 1000, 1200) * (1 - Part(ms, 1440, 1520));
				if (sub > 0)
					using (var faint = new SolidBrush(Color.FromArgb((int)(220 * sub), Dim)))
						g.DrawString("B R O W S E R", small, faint, left0 + 2, ty + 52);
			}
		}
	}

	internal sealed class Shimmer : Control
	{
		readonly WinTimer tick = new WinTimer { Interval = 33 };
		readonly Func<Look> look;
		int frame;
		bool hover, working;
		string label = "SUMMARISE", busy = "READING";

		public Shimmer(Func<Look> look, Font font)
		{
			this.look = look;
			Font = font;
			SetStyle(ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer | ControlStyles.UserPaint | ControlStyles.ResizeRedraw, true);
			Cursor = Cursors.Hand;
			TabStop = false;
			tick.Tick += delegate
			{
				frame++;
				// Idle, it only redraws while the sheen passes or the mouse is on it, so it costs next to nothing.
				if (working || hover || frame % Period < Sweep + 2 || frame % 6 == 0) Invalidate();
			};
			Fit();
		}

		int Period { get { return working ? 40 : 160; } }
		int Sweep { get { return working ? 40 : 48; } }

		public bool Working
		{
			get { return working; }
			set { if (working == value) return; working = value; frame = 0; Fit(); Invalidate(); }
		}

		public void Words(string label, string busy) { this.label = label; this.busy = busy; Fit(); Invalidate(); }

		void Fit()
		{
			int wide = Math.Max(TextRenderer.MeasureText(label, Font).Width, TextRenderer.MeasureText(busy + "...", Font).Width);
			Width = wide + 44;
		}

		protected override void OnHandleCreated(EventArgs e) { base.OnHandleCreated(e); tick.Start(); }
		protected override void OnHandleDestroyed(EventArgs e) { tick.Stop(); base.OnHandleDestroyed(e); }
		protected override void OnMouseEnter(EventArgs e) { hover = true; Invalidate(); base.OnMouseEnter(e); }
		protected override void OnMouseLeave(EventArgs e) { hover = false; Invalidate(); base.OnMouseLeave(e); }
		protected override void Dispose(bool disposing) { if (disposing) tick.Dispose(); base.Dispose(disposing); }

		protected override void OnPaint(PaintEventArgs e)
		{
			Look l = look();
			Graphics g = e.Graphics;
			g.SmoothingMode = SmoothingMode.AntiAlias;
			g.Clear(l.Shade(1));
			var r = new Rectangle(3, 5, Width - 8, Height - 11);
			if (r.Width < 10 || r.Height < 6) return;
			Color accent = l.Shade(4);
			using (var fill = new SolidBrush(hover || working ? l.Shade(6) : l.Shade(0))) g.FillRectangle(fill, r);

			int p = frame % Period;
			if (p < Sweep)
			{
				float t = p / (float)Sweep;
				t = t * t * (3 - 2 * t);
				int band = Math.Max(28, r.Width / 3);
				int x = r.Left - band + (int)((r.Width + band) * t);
				var glow = new Rectangle(x, r.Top, band, r.Height);
				using (var sheen = new LinearGradientBrush(new Rectangle(x - 1, r.Top, band + 2, r.Height), Color.Transparent, Color.Transparent, 0f))
				{
					var blend = new ColorBlend(3);
					blend.Colors = new[] { Color.FromArgb(0, accent), Color.FromArgb(working ? 75 : 50, accent), Color.FromArgb(0, accent) };
					blend.Positions = new[] { 0f, 0.5f, 1f };
					sheen.InterpolationColors = blend;
					g.SetClip(r);
					g.FillRectangle(sheen, glow);
					g.ResetClip();
				}
			}

			// Border, brighter on hover and gently pulsing while she reads; her red and cyan corner brackets.
			double breath = (Math.Sin(frame / 9.0) + 1) / 2;
			int edge = working ? 120 + (int)(110 * breath) : hover ? 230 : 0;
			using (var line = new Pen(edge > 0 ? Color.FromArgb(edge, accent) : l.Shade(6))) g.DrawRectangle(line, r);
			using (var red = new Pen(l.Shade(5), 2f)) { g.DrawLine(red, r.Left, r.Top + 1, r.Left + 7, r.Top + 1); g.DrawLine(red, r.Left + 1, r.Top, r.Left + 1, r.Top + 7); }
			using (var cyan = new Pen(accent, 2f)) { g.DrawLine(cyan, r.Right - 7, r.Bottom - 1, r.Right, r.Bottom - 1); g.DrawLine(cyan, r.Right - 1, r.Bottom - 7, r.Right - 1, r.Bottom); }

			float cx = r.Left + 14, cy = r.Top + r.Height / 2f;
			float big = 4.2f + (float)((Math.Sin(frame / (working ? 4.0 : 14.0)) + 1) * (working ? 1.3 : 0.6));
			float small = big * 0.32f;
			PointF[] star = {
				new PointF(cx, cy - big), new PointF(cx + small, cy - small), new PointF(cx + big, cy), new PointF(cx + small, cy + small),
				new PointF(cx, cy + big), new PointF(cx - small, cy + small), new PointF(cx - big, cy), new PointF(cx - small, cy - small) };
			using (var spark = new SolidBrush(working ? accent : Color.FromArgb(150 + (int)(105 * breath), accent))) g.FillPolygon(spark, star);

			string text = working ? busy + new string('.', 1 + frame / 10 % 3) : label;
			var words = new Rectangle(r.Left + 24, r.Top, r.Width - 26, r.Height);
			TextRenderer.DrawText(g, text, Font, words, hover || working ? l.Shade(2) : accent, TextFormatFlags.VerticalCenter | TextFormatFlags.Left | TextFormatFlags.NoPadding | TextFormatFlags.EndEllipsis);
		}
	}

	// Capri thinking while she works in the browser: three sparks orbiting in her red and cyan, "CAPRI // THINKING", what she's on, and a bar
	// for how far through the job she is (a sweep when she can't tell). It never takes the focus and only redraws while it shows.
	internal sealed class Thinking : Control
	{
		readonly WinTimer tick = new WinTimer { Interval = 33 };
		readonly Func<Look> look;
		readonly Font head = new Font("Segoe UI Semibold", 7.5f), body = new Font("Segoe UI", 9f);
		int frame, step, steps;
		float shown;
		string doing = "";
		// Head: a heading of its own, with an X and a percentage. Still: finished, so nothing moves.
		internal string Head;
		internal bool Still;

		public Thinking(Func<Look> look)
		{
			this.look = look;
			SetStyle(ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer | ControlStyles.UserPaint | ControlStyles.ResizeRedraw, true);
			SetStyle(ControlStyles.Selectable, false);
			TabStop = false;
			Size = new Size(300, 58);
			tick.Tick += delegate { frame++; shown += (step - shown) * .15f; if (Still && Math.Abs(step - shown) < .5f) { shown = step; tick.Stop(); } Invalidate(); };
		}

		public void On(string doing, int step, int steps)
		{
			this.doing = doing;
			this.steps = steps;
			this.step = step;
			if (!Visible) { frame = 0; shown = Math.Max(0, step - 1); }
			Visible = true;
			tick.Start();
			Invalidate();
		}

		public void Off() { tick.Stop(); Visible = false; }

		protected override void Dispose(bool disposing) { if (disposing) { tick.Dispose(); head.Dispose(); body.Dispose(); } base.Dispose(disposing); }

		protected override void OnPaint(PaintEventArgs e)
		{
			Look l = look();
			Graphics g = e.Graphics;
			g.SmoothingMode = SmoothingMode.AntiAlias;
			Color accent = l.Shade(4), red = l.Shade(5);
			g.Clear(l.Shade(1));
			var r = new Rectangle(0, 0, Width - 1, Height - 1);
			double breath = (Math.Sin(frame / 9.0) + 1) / 2;
			using (var line = new Pen(Color.FromArgb(110 + (int)(120 * breath), accent))) g.DrawRectangle(line, r);
			using (var r2 = new Pen(red, 2f)) { g.DrawLine(r2, 1, 1, 10, 1); g.DrawLine(r2, 1, 1, 1, 10); }
			using (var c2 = new Pen(accent, 2f)) { g.DrawLine(c2, r.Right - 10, r.Bottom - 1, r.Right, r.Bottom - 1); g.DrawLine(c2, r.Right - 1, r.Bottom - 10, r.Right - 1, r.Bottom); }

			float cx = 28, cy = Height / 2f;
			for (int k = 0; k < 3; k++)
				for (int trail = 5; trail >= 0; trail--)
				{
					double a = (frame - trail * 1.6) / 7.0 + k * Math.PI * 2 / 3;
					float x = cx + (float)Math.Cos(a) * 13, y = cy + (float)Math.Sin(a) * 13, size = 4.6f - trail * .6f;
					using (var dot = new SolidBrush(Color.FromArgb(255 - trail * 40, k == 1 ? red : accent))) g.FillEllipse(dot, x - size / 2, y - size / 2, size, size);
				}
			float big = 4f + (float)breath * 1.6f, small = big * .32f;
			PointF[] star = {
				new PointF(cx, cy - big), new PointF(cx + small, cy - small), new PointF(cx + big, cy), new PointF(cx + small, cy + small),
				new PointF(cx, cy + big), new PointF(cx - small, cy + small), new PointF(cx - big, cy), new PointF(cx - small, cy - small) };
			using (var core = new SolidBrush(l.Shade(2))) g.FillPolygon(core, star);

			string title = (Head ?? "CAPRI // THINKING") + (Still ? "" : new string('.', 1 + frame / 10 % 3));
			TextRenderer.DrawText(g, title, head, new Rectangle(52, 8, Width - 60, 14), red, TextFormatFlags.Left | TextFormatFlags.NoPadding);
			if (Head != null) TextRenderer.DrawText(g, "\u2715", head, new Rectangle(Width - 24, 7, 16, 14), l.Shade(2), TextFormatFlags.NoPadding);
			if (steps > 0) TextRenderer.DrawText(g, Head != null ? step + "%" : step + "/" + steps, head, new Rectangle(52, 8, Width - (Head != null ? 84 : 62), 14), l.Shade(3), TextFormatFlags.Right | TextFormatFlags.NoPadding);
			TextRenderer.DrawText(g, doing, body, new Rectangle(52, 22, Width - 62, 18), l.Shade(2), TextFormatFlags.Left | TextFormatFlags.NoPadding | TextFormatFlags.EndEllipsis | TextFormatFlags.SingleLine);

			var bar = new Rectangle(52, Height - 12, Width - 62, 3);
			using (var track = new SolidBrush(l.Shade(6))) g.FillRectangle(track, bar);
			if (steps > 0) using (SolidBrush done = new SolidBrush(accent)) g.FillRectangle(done, bar.Left, bar.Top, (int)(bar.Width * Math.Min(1f, shown / steps)), bar.Height);
			else
			{
				int band = bar.Width / 3, x = bar.Left - band + (frame * 5) % (bar.Width + band);
				g.SetClip(bar);
				using (var sweep = new SolidBrush(accent)) g.FillRectangle(sweep, x, bar.Top, band, bar.Height);
				g.ResetClip();
			}
		}
	}

	// ---- The two engines behind Capri Browser ----

	internal abstract class Viewer
	{
		public Control Control;
		// Moved: it's at a new address. Mine: one of Capri Browser's own links (Speed Dial's add and remove), which never loads.
		public Action<string> Moved, Blocked, Failed, Titled, Opening, Mine;
		public Action<bool> Busy, FullScreen;
		public Action Loaded, Ready;
		// Asked: they picked "Ask Capri about this" on some highlighted words.
		public Action<string> Asked;
		// Researched: they picked "Let Capri research this".
		public Action<string> Researched;
		// Wallpapered: they picked "Make wallpaper" on a picture (its address).
		public Action<string> Wallpapered;
		public Func<ContextMenuStrip> MakeMenu;
		public Action<string, string> ExtWanted;   // the store page it came from, and "id|name"
		public Action<string, bool> Ended;      // the title, and whether it was over 6 minutes (only those count as finished)
		// LoginSeen: they signed in on the page (where, username, password), for the Passwords list. PasswordBox: the page has a password box.
		public Action<string, string, string> LoginSeen;
		public Action<string> PasswordBox;
		public virtual void Dark(bool on) { }
		public virtual void Blurred(bool on) { }
		public virtual void Downloads() { }
		public Action<bool, bool> Sound;
		// Blocks: how many ads it has blocked on this page so far.
		public Action<int> Blocks;
		// Shield: something the page shield did or saw, like "layer", "popup", "redirect", "fake", "scam" or "skip|ad|x,y".
		public Action<string> Shield;
		public Action<int> Tracks;
		public readonly List<string> TrackerHosts = new List<string>();
		public int Stopped;
		public virtual void Zoom(int step) { }
		public virtual void Print() { }
		public virtual bool Sleep() { return false; }
		public virtual void Saver(bool low) { }
		public virtual Task<string> Script(string script) { return null; }
		public virtual Task<string> Gesture(string script) { return null; }
		public virtual Task<string> Cdp(string method, string json) { return null; }
		public virtual object Core { get { return null; } }
		public virtual void Shot(string file, Action<string> done) { done("that needs Edge's engine"); }
		public virtual void Grab(Action<Bitmap> done) { done(null); }
		public virtual bool Muted { get { return false; } set { } }
		public virtual void Privacy(Look look) { }
		// False when there's nothing to clear with; otherwise done gets null or why it failed.
		public virtual bool Clear(Action<string> done) { return false; }
		public virtual void Permit(int kind, string host, string value) { }
		public virtual void SiteData(string host, Action<string> got) { got(null); }
		public virtual void WipeSite(string host, Action<string> done) { done("that needs Edge's engine"); }
		public virtual void ClearKinds(string kinds, Action<string> done) { done("that needs Edge's engine"); }
		// EngineId: the process id of Edge's engine behind this page, or 0.
		public virtual int EngineId { get { return 0; } }
		// Downloading: a download started (Edge's download, the file it goes to, and where from).
		public Action<object, string, string> Downloading;
		// Capri's own menu in place of Edge's: her items first, then Edge's, which run by their command ids when picked.
		protected bool OwnMenu(object asked, List<KeyValuePair<string, Action>> mine)
		{
			ContextMenuStrip m = MakeMenu();
			if (m == null) return false;
			object wait = Call(asked, "GetDeferral");
			bool over = false;
			Action<int> finish = id =>
			{
				if (over) return;
				over = true;
				try { if (id >= 0) Set(asked, "SelectedCommandId", id); Call(wait, "Complete"); } catch { }
			};
			Color accent = m.Tag is Color ? (Color)m.Tag : m.ForeColor;
			foreach (KeyValuePair<string, Action> one in mine)
			{
				Action run = one.Value;
				var item = new ToolStripMenuItem(one.Key) { ForeColor = accent };
				item.Click += delegate { finish(-1); run(); };
				m.Items.Add(item);
			}
			if (mine.Count > 0) m.Items.Add(new ToolStripSeparator());
			EdgeItems(m, m.Items, (IList)Get(asked, "MenuItems"), finish);
			while (m.Items.Count > 0 && m.Items[m.Items.Count - 1] is ToolStripSeparator) m.Items.RemoveAt(m.Items.Count - 1);
			// Closing without a pick: let a click's own handler go first.
			SynchronizationContext ui = SynchronizationContext.Current;
			m.Closed += delegate { if (ui == null) finish(-1); else ui.Post(delegate { ui.Post(delegate { finish(-1); }, null); }, null); };
			Set(asked, "Handled", true);
			m.Show(Cursor.Position);
			return true;
		}

		protected static void EdgeItems(ContextMenuStrip m, ToolStripItemCollection into, IList items, Action<int> finish)
		{
			foreach (object it in items)
			{
				int kind = Convert.ToInt32(Get(it, "Kind"));
				if (kind == 3) { if (into.Count > 0 && !(into[into.Count - 1] is ToolStripSeparator)) into.Add(new ToolStripSeparator()); continue; }
				string label = Get(it, "Label") as string ?? "";
				if ((kind == 1 || kind == 2) && (bool)Get(it, "IsChecked")) label = "✓ " + label;
				var one = new ToolStripMenuItem(label) { ShortcutKeyDisplayString = Get(it, "ShortcutKeyDescription") as string, Enabled = (bool)Get(it, "IsEnabled"), ForeColor = m.ForeColor };
				if (kind == 4)
				{
					ToolStripDropDownMenu sub = (ToolStripDropDownMenu)one.DropDown;
					sub.Renderer = m.Renderer; sub.BackColor = m.BackColor; sub.ForeColor = m.ForeColor; sub.Font = m.Font; sub.ShowImageMargin = false;
					EdgeItems(m, one.DropDownItems, (IList)Get(it, "Children"), finish);
				}
				else { int id = Convert.ToInt32(Get(it, "CommandId")); one.Click += delegate { finish(id); }; }
				into.Add(one);
			}
		}

		// PageMenu: a right-click on the page itself (not a link, picture or text box); true when Capri Browser showed its own menu.
		public Func<bool> PageMenu;
		// Crashed: 0 the whole page engine stopped, 1 this page did, 2 it isn't responding.
		public Action<int> Crashed;
		// Typed: a key was pressed on the page (only for typing sounds).
		public Action Typed;
		public Action Escaped;
		// A key pressed while the page has focus: true when Capri Browser used it.
		public Func<Keys, bool> Key;
		public virtual bool Modern { get { return false; } }
		public abstract void Html(string html);
		public abstract void Go(string url);
		public abstract void Reload();
		// ExtensionsAsked: something tried to open the browser's own Extensions page.
		public Action ExtensionsAsked, CloseAsked;
		protected bool Ours(string url)
		{
			if (url != null && ExtensionsAsked != null && Regex.IsMatch(url, @"^(?:edge|chrome)://extensions", RegexOptions.IgnoreCase)) { ExtensionsAsked(); return true; }
			if (url == null || !url.StartsWith(Own, Exact)) return false;
			if (Mine != null) Mine(url);
			return true;
		}
		public abstract bool CanBack { get; }
		public abstract void Back();
		public abstract void Forward();
		public abstract string Address { get; }
		public abstract void Style(Look look, bool reader);
		public virtual void Background(Color color) { }
		// The words on the page, the article's if it has one; null when it can't be read. May answer on another thread.
		public abstract void Text(Action<string> got);
		internal const string ReadScript = "(function(){var m=document.querySelector('article,main,[role=main]');var b=document.body||document.documentElement;return ((m&&m.innerText&&m.innerText.length>400)?m:b).innerText;})()";
	}

	// Without Edge's engine there's nothing to show pages with, so a note says how to get it.
	internal sealed class ClassicViewer : Viewer
	{
		readonly Label note = new Label { Dock = DockStyle.Fill, TextAlign = ContentAlignment.MiddleCenter, Text = "Capri Browser needs Microsoft Edge WebView2.\nGet it from go.microsoft.com/fwlink/p/?LinkId=2124703, then restart Capri." };
		string at;
		public ClassicViewer() { Control = note; }
		public override void Html(string html) { }
		public override void Go(string url) { if (!Ours(url)) at = url; }
		public override void Reload() { }
		public override bool CanBack { get { return false; } }
		public override void Back() { }
		public override void Forward() { }
		public override string Address { get { return at; } }
		public override void Style(Look look, bool reader) { note.BackColor = look.Shade(0); note.ForeColor = look.Shade(2); }
		public override void Text(Action<string> got) { got(null); }
	}

	internal sealed class ModernViewer : Viewer
	{
		readonly Control view;
		object core;
		Action waiting;
		Look styled;
		bool styledReader;

		public override bool Modern { get { return true; } }
		public override object Core { get { return core; } }

		public ModernViewer(string profile, Color background, bool inPrivate)
		{
			Type type = videoForms.GetType("Microsoft.Web.WebView2.WinForms.WebView2", true);
			view = (Control)Activator.CreateInstance(type);
			startProfile = profile;
			startPrivate = inPrivate;
			Set(view, "DefaultBackgroundColor", background);
			Control = view;
			Hook(view, "CoreWebView2InitializationCompleted", args =>
			{
				if (!(bool)Get(args, "IsSuccess"))
				{
					Exception why = Get(args, "InitializationException") as Exception;
					if (Failed != null) Failed(why == null ? "it said no" : why.Message);
					return;
				}
				core = Get(view, "CoreWebView2");
				Hook(core, "ProcessFailed", failed => { if (Crashed != null) Crashed(Convert.ToInt32(Get(failed, "ProcessFailedKind"))); });
				Hook(core, "WindowCloseRequested", done => { if (CloseAsked != null) CloseAsked(); });
				// Popups and "open in new tab" stay in Capri Browser.
				Hook(core, "NewWindowRequested", request =>
				{
					string uri = Get(request, "Uri") as string;
					if (uri != null && uri.Contains("://extensions") && Ours(uri)) { Set(request, "Handled", true); return; }
					bool clicked = true;
					try { clicked = (bool)Get(request, "IsUserInitiated"); } catch { }
					if (!clicked) { Set(request, "Handled", true); return; }
					Uri popTo;
					// Where the click was: the page itself tells us about clicks on it; no word from it means the click was inside a frame, like an embedded
					// video player from another site.
					bool inFrame = (DateTime.UtcNow - topClick).TotalMilliseconds > 1500;
					string frameSite = null;
					try { Uri from; object frame = Get(request, "OriginalSourceFrameInfo"); if (frame != null && Uri.TryCreate(Get(frame, "Source") as string ?? "", UriKind.Absolute, out from)) frameSite = SiteOf(from.Host); } catch { }
					if (Shielding && SitePerm(pageHost, "pop") != "allow" && Uri.TryCreate(uri ?? "", UriKind.Absolute, out popTo) && (IsAd(uri) || PopAd.IsMatch(uri)
						|| (JustClickedNothing && SiteOf(popTo.Host) != SiteOf(pageHost))
						|| (inFrame && SiteOf(popTo.Host) != SiteOf(pageHost) && SiteOf(popTo.Host) != frameSite)))
					{
						Set(request, "Handled", true);
						Stopped++;
						if (Shield != null) Shield("popup");
						ShieldNote("Capri blocked a pop-up");
						return;
					}
					if (Ours(uri)) { Set(request, "Handled", true); return; }
					// A real popup (one that asks for a size, like "Sign in with Google" on other sites) opens as Edge's own small window so it can talk back to
					// the page that opened it.
					bool popup = false;
					try { object features = Get(request, "WindowFeatures"); popup = (bool)Get(features, "HasSize") || (bool)Get(features, "HasPosition"); } catch { }
					if (popup && !string.IsNullOrEmpty(uri)) return;
					Set(request, "Handled", true);
					if (string.IsNullOrEmpty(uri)) return;
					if (Opening != null) Opening(uri); else Go(uri);
				});
				// A site asks for the camera, location and so on: its Site settings answer first, otherwise Edge asks.
				Hook(core, "PermissionRequested", asked =>
				{
					try
					{
						int kind = Convert.ToInt32(Get(asked, "PermissionKind"));
						string key = null;
						for (int i = 0; i < PermList.GetLength(0); i++) if (PermList[i, 3] == kind.ToString()) key = PermList[i, 0];
						Uri from;
						if (key == null || !Uri.TryCreate(Get(asked, "Uri") as string ?? "", UriKind.Absolute, out from)) return;
						string v = SitePerm(from.Host, key);
						if (v != "allow" && v != "block") return;
						PropertyInfo state = asked.GetType().GetProperty("State");
						state.SetValue(asked, Enum.ToObject(state.PropertyType, v == "allow" ? 1 : 2), null);
					}
					catch { }
				});
				Hook(core, "DOMContentLoaded", delegate { ShieldPage(); if (Ready != null) Ready(); });
				Hook(core, "DocumentTitleChanged", delegate { if (Titled != null) Titled(Get(core, "DocumentTitle") as string); });
				// Edge's engine keeps keys pressed on a page to itself, so Capri Browser's own shortcuts are passed back out.
				try
				{
					FieldInfo held = view.GetType().GetField("_coreWebView2Controller", BindingFlags.Instance | BindingFlags.NonPublic);
					object controller = held == null ? null : held.GetValue(view);
					if (controller != null) Hook(controller, "AcceleratorKeyPressed", key =>
					{
						int kind = Convert.ToInt32(Get(key, "KeyEventKind"));
						if ((kind != 0 && kind != 2) || (bool)Get(key, "Handled") || Key == null) return;
						Keys pressed = (Keys)(int)(uint)Get(key, "VirtualKey") | Control.ModifierKeys;
						if (Key(pressed)) Set(key, "Handled", true);
					});
				}
				catch { }
				Hook(core, "ContainsFullScreenElementChanged", delegate { if (FullScreen != null) FullScreen((bool)Get(core, "ContainsFullScreenElement")); });
				// Saved passwords and form filling, like Edge.
				try
				{
					object settings = Get(core, "Settings");
					// Off: Capri Browser offers to save sign-ins to its own Passwords list instead (LoginScript). Ones Edge saved before still fill in.
					Set(settings, "IsPasswordAutosaveEnabled", false);
					Set(settings, "IsGeneralAutofillEnabled", true);
				}
				catch { }
				// Sound on the tab, and the ad blocker.
				Hook(core, "IsDocumentPlayingAudioChanged", delegate { Heard(); });
				Hook(core, "IsMutedChanged", delegate { Heard(); });
				try { Call(core, "AddScriptToExecuteOnDocumentCreatedAsync", ShieldScript); } catch { }
				if (Flag("darkweb", false)) Dark(true);
				Hook(core, "DownloadStarting", starting =>
				{
					try
					{
						string file = Get(starting, "ResultFilePath") as string, from = Get(Get(starting, "DownloadOperation"), "Uri") as string;
						if (Downloading != null) Downloading(Get(starting, "DownloadOperation"), file, from);
						Uri at;
						string name = file == null ? "" : Path.GetFileName(file);
						// A file pretending to be something else: holiday.jpg.exe, invoice.pdf.scr.
						bool fake = Regex.IsMatch(name, @"\.(pdf|docx?|xlsx?|pptx?|txt|jpe?g|png|gif|webp|mp[34]|mov|avi|zip|rar)\.(exe|scr|bat|cmd|com|pif|vbs|js|jse|wsf|hta|lnk|msi|ps1)$", RegexOptions.IgnoreCase);
						if (Host == null || !Flag("downloads", true) || file == null || !(fake || Regex.IsMatch(name, @"\.(exe|msi|bat|cmd|scr|vbs|ps1|jar|com|pif|hta)$", RegexOptions.IgnoreCase)) || !Uri.TryCreate(from ?? "", UriKind.Absolute, out at)) return;
						if (!fake && Regex.IsMatch(at.Host, @"(^|\.)(microsoft\.com|github\.com|githubusercontent\.com|steampowered\.com|mozilla\.org|google\.com|discord\.com|discordapp\.net|nvidia\.com|amd\.com|python\.org|nodejs\.org|capriai\.app|minecraft\.net|epicgames\.com|roblox\.com|rbxcdn\.com)$", RegexOptions.IgnoreCase)) return;
						if (Flag("glitch", true)) Call(core, "ExecuteScriptAsync", RedGlitch);
						object wait = Call(starting, "GetDeferral");
						Control.BeginInvoke((MethodInvoker)delegate
						{
							bool go = false;
							try
							{
								go = MessageBox.Show(Control.FindForm(), (fake ? name + " pretends to be a " + Regex.Match(name, @"\.(\w+)\.\w+$").Groups[1].Value.ToUpperInvariant() + " file, but it's really a program. That's a classic trick."
									: name + " is a program from " + at.Host + ", a site I don't know.") + "\n\nOnly download it if you really trust where it came from. Download it anyway?",
									"Capri: sketchy download", MessageBoxButtons.YesNo, MessageBoxIcon.Warning, MessageBoxDefaultButton.Button2) == DialogResult.Yes;
							}
							catch { }
							try { if (!go) Set(starting, "Cancel", true); Call(wait, "Complete"); } catch { }
							Host.Say(go ? "Okay, it's downloading. Only run it if you trust it, choom." : "Good call, choom. I stopped that download.");
						});
					}
					catch { }
				});
				try { Call(core, "AddScriptToExecuteOnDocumentCreatedAsync", EndedScript); } catch { }
				try { Call(core, "AddScriptToExecuteOnDocumentCreatedAsync", LoginScript); } catch { }
				Hook(core, "WebMessageReceived", message =>
				{
					try
					{
						string said = Call(message, "TryGetWebMessageAsString") as string;
						if (said != null && said.Begins("capri-endedL|") && Ended != null) Ended(said.Substring(13), true);
						else if (said != null && said.Begins("capri-ended|") && Ended != null) Ended(said.Substring(12), false);
						else if (said != null && said.Begins("capri-ext|") && ExtWanted != null) ExtWanted(Get(message, "Source") as string ?? "", said.Substring(10));
						else if (said != null && said.Begins("capri-login|") && LoginSeen != null) { int cut = said.IndexOf('\n'); if (cut > 12) LoginSeen(Get(message, "Source") as string ?? "", said.Substring(12, cut - 12), said.Substring(cut + 1)); }
						else if (said == "capri-pwbox" && PasswordBox != null) PasswordBox(Get(message, "Source") as string ?? "");
						else if (said == "capri-click|plain") { plainClick = DateTime.UtcNow; topClick = DateTime.UtcNow; }
						else if (said == "capri-click|link") { plainClick = DateTime.MinValue; topClick = DateTime.UtcNow; }
						else if (said == "capri-key") { if (Typed != null) Typed(); }
						else if (said == "capri-esc") { if (Escaped != null) Escaped(); }
						else if (said != null && said.Begins("capri-shield|"))
						{
							string what = said.Substring(13);
							if (what == "layer" || what == "popup") Stopped++;
							if (Shield != null) Shield(what);
						}
					}
					catch { }
				});
				Hook(core, "ContextMenuRequested", asked =>
				{
					try
					{
						object target = Get(asked, "ContextMenuTarget");
						if (PageMenu != null && Convert.ToInt32(Get(target, "Kind")) == 0 && !(bool)Get(target, "HasLinkUri") && !(bool)Get(target, "IsEditable") && PageMenu()) { Set(asked, "Handled", true); return; }
						string source = Convert.ToInt32(Get(target, "Kind")) == 1 ? Get(target, "SourceUri") as string : null;
						string picked = (bool)Get(target, "HasSelection") ? Get(target, "SelectionText") as string : null;
						var mine = new List<KeyValuePair<string, Action>>();
						if (picked != null && Asked != null && Flag("askmenu", true)) mine.Add(new KeyValuePair<string, Action>("Ask Capri about this", delegate { Asked(picked); }));
						if (picked != null && Researched != null && Flag("researchmenu", true) && ResearchMode != "off") mine.Add(new KeyValuePair<string, Action>("Let Capri research this", delegate { Researched(picked); }));
						if (source != null && source.Begins("http") && Opening != null)
							mine.Add(new KeyValuePair<string, Action>("Find where this image comes from", delegate { Opening("https://lens.google.com/uploadbyurl?url=" + Uri.EscapeDataString(source)); }));
						if (source != null && source.Begins("https://") && Wallpapered != null)
							mine.Add(new KeyValuePair<string, Action>("Make wallpaper", delegate { Wallpapered(source); }));
						if (MakeMenu != null && Flag("capmenu", true) && OwnMenu(asked, mine)) return;
						IList items = (IList)Get(asked, "MenuItems");
						for (int i = mine.Count - 1; i >= 0; i--)
						{
							KeyValuePair<string, Action> one = mine[i];
							object item = Call(Get(core, "Environment"), "CreateContextMenuItem", one.Key, null, 0);
							Hook(item, "CustomItemSelected", delegate { one.Value(); });
							items.Insert(0, item);
						}
					}
					catch { }
				});
				try { if (PagePointer().Length > 0) { Call(core, "AddScriptToExecuteOnDocumentCreatedAsync", PagePointer()); Call(core, "ExecuteScriptAsync", PagePointer()); } } catch { }
				Hook(core, "WebResourceRequested", asked =>
				{
					try
					{
						if (guard == null) return;
						string wants = Get(Get(asked, "Request"), "Uri") as string;
