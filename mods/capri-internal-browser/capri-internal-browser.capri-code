		// ---- Browser sounds (Settings > Sounds): little blips for tabs, panels, menus, buttons and typing ----
		readonly DateTime born = DateTime.Now;
		DateTime lastBlip = DateTime.MinValue;
		static readonly Dictionary<string, float[]> blips = new Dictionary<string, float[]>();
		static readonly Random blipDice = new Random();
		static int blipsPlaying;
		const int BlipRate = 32000;

		// The sounds are made here, not loaded: deep, soft and short, in the spirit of a gaming browser's UI sounds.
		sealed class Filter
		{
			readonly double b0, b1, b2, a1, a2;
			double x1, x2, y1, y2;
			// kind: 'l' low-pass, 'h' high-pass, 'b' band-pass (RBJ's cookbook filters)
			internal Filter(char kind, double hz, double q)
			{
				double w = 2 * Math.PI * Math.Min(hz, BlipRate * .45) / BlipRate, cos = Math.Cos(w), alpha = Math.Sin(w) / (2 * q), a0 = 1 + alpha;
				if (kind == 'l') { b0 = (1 - cos) / 2; b1 = 1 - cos; b2 = b0; }
				else if (kind == 'h') { b0 = (1 + cos) / 2; b1 = -(1 + cos); b2 = b0; }
				else { b0 = alpha; b1 = 0; b2 = -alpha; }
				b0 /= a0; b1 /= a0; b2 /= a0; a1 = -2 * cos / a0; a2 = (1 - alpha) / a0;
			}
			internal double Run(double x) { double y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2; x2 = x1; x1 = x; y2 = y1; y1 = y; return y; }
		}

		static double Envelope(int i, int count, double attack)
		{
			double t = i / (double)count, rise = Math.Min(1, i / Math.Max(1, attack * BlipRate));
			return rise * Math.Pow(1 - t, 2.2);
		}

		// A tone gliding from one pitch to another; shape 0 is a sine, 1 a triangle, anything between a mix.
		static void Glide(float[] into, double start, double length, double from, double to, double shape, double loud)
		{
			int first = (int)(start * BlipRate), count = (int)(length * BlipRate);
			double phase = 0;
			for (int i = 0; i < count && first + i < into.Length; i++)
			{
				double t = i / (double)count;
				phase += 2 * Math.PI * from * Math.Pow(to / from, t) / BlipRate;
				double p = phase / (2 * Math.PI) % 1, tri = 1 - 4 * Math.Abs(p - .5);
				into[first + i] += (float)(loud * Envelope(i, count, .004) * (Math.Sin(phase) * (1 - shape) + tri * shape));
			}
		}

		static void Hiss(float[] into, double start, double length, Filter filter, double loud)
		{
			int first = (int)(start * BlipRate), count = (int)(length * BlipRate);
			for (int i = 0; i < count && first + i < into.Length; i++)
			{
				double white;
				lock (blipDice) white = blipDice.NextDouble() * 2 - 1;
				into[first + i] += (float)(loud * Envelope(i, count, .002) * filter.Run(white));
			}
		}

		static float[] Soften(float[] wave, double hz) { Filter f = new Filter('l', hz, .707); for (int i = 0; i < wave.Length; i++) wave[i] = (float)f.Run(wave[i]); return wave; }

		// pitch: 1 for the usual sound; a keypress gets a few percent either way so fast typing sounds natural.
		static float[] Blip(string kind, double pitch)
		{
			float[] w;
			switch (kind)
			{
				case "key":
					w = new float[(int)(BlipRate * .05)];
					Glide(w, 0, .035, 150 * pitch, 105 * pitch, .2, .42);
					Hiss(w, 0, .009, new Filter('b', 2500 * pitch, 1.3), .55);
					return Soften(w, 6000);
				case "open":            // a tab opens: an airy rise and a soft pop up into place
					w = new float[(int)(BlipRate * .32)];
					Air(w, 0, .13, 700, 3400, .16);
					Pluck(w, .035, 587, 1.5, .085, .5);
					Pluck(w, .035, 1174, 1.5, .05, .12);
					return Level(Room(Soften(w, 5200), .2), .5);
				case "close":           // a tab closes: the same air falling away, and a muffled drop
					w = new float[(int)(BlipRate * .3)];
					Air(w, 0, .12, 3000, 650, .14);
					Pluck(w, .02, 392, 1.35, .075, .5);
					Pluck(w, .02, 196, 1.2, .06, .25);
					return Level(Room(Soften(w, 3600), .18), .46);
				case "switch":          // moving between tabs: a light glassy tick
					w = new float[(int)(BlipRate * .16)];
					Pluck(w, 0, 1318, 1.15, .028, .32);
					Pluck(w, 0, 2637, 1.1, .016, .08);
					return Level(Room(Soften(w, 7000), .16), .26);
				case "click":           // a button: a small rounded tap
					w = new float[(int)(BlipRate * .16)];
					Pluck(w, 0, 880, 1.4, .03, .4);
					Pluck(w, 0, 220, 1.6, .035, .3);
					return Level(Room(Soften(w, 5000), .14), .32);
				case "hover":           // barely there
					w = new float[(int)(BlipRate * .05)];
					Pluck(w, 0, 2349, 1.05, .01, .2);
					return Level(Soften(w, 8000), .07);
				case "menu":            // a menu opens: a quick shimmer up
					w = new float[(int)(BlipRate * .24)];
					Air(w, 0, .07, 1400, 3600, .12);
					Pluck(w, .012, 988, 1.3, .05, .35);
					Pluck(w, .04, 1480, 1.2, .045, .2);
					return Level(Room(Soften(w, 6500), .2), .3);
				case "panel":           // a side panel slides in: a longer swish with two soft notes
					w = new float[(int)(BlipRate * .42)];
					Air(w, 0, .22, 500, 2600, .18);
					Pluck(w, .06, 659, 1.25, .1, .3);
					Pluck(w, .1, 988, 1.2, .12, .25);
					return Level(Room(Soften(w, 4800), .24), .42);
				case "focus":           // the address bar: two quiet notes
					w = new float[(int)(BlipRate * .3)];
					Pluck(w, 0, 784, 1.1, .08, .3);
					Pluck(w, .05, 1175, 1.1, .1, .25);
					return Level(Room(Soften(w, 5200), .22), .3);
				default:                // "done", a download finished: three rising notes that ring out
					w = new float[(int)(BlipRate * .75)];
					Pluck(w, 0, 523, 1.2, .22, .3);
					Pluck(w, .085, 659, 1.2, .24, .3);
					Pluck(w, .17, 784, 1.2, .32, .34);
					Pluck(w, .17, 1568, 1.1, .2, .06);
					return Level(Room(Soften(w, 4500), .28), .5);
			}
		}

		// A synth pluck: starts a little sharp (bend) and slides into its note in a few milliseconds, then dies away.
		static void Pluck(float[] into, double start, double hz, double bend, double decay, double loud)
		{
			int first = (int)(start * BlipRate);
			double phase = 0;
			for (int i = 0; first + i < into.Length; i++)
			{
				double t = i / (double)BlipRate;
				double amp = Math.Min(1, t / .0025) * Math.Exp(-t / decay);
				if (amp < .0005 && t > .005) break;
				double f = hz * (1 + (bend - 1) * Math.Exp(-t / .012));
				phase += 2 * Math.PI * f / BlipRate;
				into[first + i] += (float)(loud * amp * (Math.Sin(phase) + .12 * Math.Sin(2 * phase)));
			}
		}

		// Air: noise through a band that sweeps from one pitch to another, swelling in and out.
		static void Air(float[] into, double start, double length, double from, double to, double loud)
		{
			int first = (int)(start * BlipRate), count = (int)(length * BlipRate);
			double y1 = 0, y2 = 0, x1 = 0, x2 = 0;
			for (int i = 0; i < count && first + i < into.Length; i++)
			{
				double t = i / (double)count, hz = from * Math.Pow(to / from, t);
				double wv = 2 * Math.PI * hz / BlipRate, alpha = Math.Sin(wv) / 2.4, a0 = 1 + alpha;
				double white;
				lock (blipDice) white = blipDice.NextDouble() * 2 - 1;
				double y = (alpha * white - alpha * x2 + 2 * Math.Cos(wv) * y1 - (1 - alpha) * y2) / a0;
				x2 = x1; x1 = white; y2 = y1; y1 = y;
				double swell = Math.Sin(Math.PI * t);
				into[first + i] += (float)(loud * swell * swell * y * 3);
			}
		}

		// A small room: a few short echoes blended in, so sounds sit in a space instead of a dry beep.
		static float[] Room(float[] wave, double mix)
		{
			int[] gaps = { (int)(BlipRate * .0297), (int)(BlipRate * .0371), (int)(BlipRate * .0411), (int)(BlipRate * .0437) };
			float[] wet = new float[wave.Length];
			foreach (int gap in gaps)
			{
				float[] line = new float[gap];
				int at = 0;
				for (int i = 0; i < wave.Length; i++) { float o = line[at]; line[at] = wave[i] + o * .62f; wet[i] += o * .25f; at = (at + 1) % gap; }
			}
			var dark = new Filter('l', 3800, .707);
			for (int i = 0; i < wave.Length; i++) wave[i] += (float)(mix * dark.Run(wet[i]));
			return wave;
		}

		// Every sound brought to the same peak, then a fade over its last few milliseconds so nothing clicks at the end.
		static float[] Level(float[] wave, double peak)
		{
			float top = 0;
			foreach (float v in wave) top = Math.Max(top, Math.Abs(v));
			if (top <= 0) return wave;
			float k = (float)(peak / top);
			int tail = Math.Min(wave.Length, (int)(BlipRate * .012));
			for (int i = 0; i < wave.Length; i++) wave[i] *= k * Math.Min(1f, (wave.Length - i) / (float)tail);
			return wave;
		}

		DateTime lastHover = DateTime.MinValue;

		void Blip(string kind)
		{
			// Typing sounds have their own switch, so they work with or without the other sounds.
			bool key = kind == "key";
			if (!(key ? Flag("typesounds", false) : Flag("sounds", false)) || (DateTime.Now - born).TotalSeconds < 3) return;
			if (kind == "hover") { if ((DateTime.Now - lastHover).TotalMilliseconds < 90) return; lastHover = DateTime.Now; }
			else if (!key) { if ((DateTime.Now - lastBlip).TotalMilliseconds < 60) return; lastBlip = DateTime.Now; }
			int volume;
			if (!int.TryParse(Kept("soundvol"), out volume)) volume = 60;
			float[] wave;
			if (key) { double pitch; lock (blipDice) pitch = .94 + blipDice.NextDouble() * .12; wave = Blip(kind, pitch); }
			else lock (blips) if (!blips.TryGetValue(kind, out wave)) blips[kind] = wave = Blip(kind, 1.0);
			short[] pcm = new short[wave.Length];
			float scale = 32767f * Math.Max(0, Math.Min(100, volume)) / 100f;
			for (int i = 0; i < wave.Length; i++) pcm[i] = (short)Math.Max(-32767, Math.Min(32767, wave[i] * scale));
			PlayPcm(pcm);
		}

		[StructLayout(LayoutKind.Sequential)]
		struct WaveFormat { public short Tag, Channels; public int Rate, BytesPerSecond; public short Align, Bits, Extra; }
		[StructLayout(LayoutKind.Sequential)]
		struct WaveHeader { public IntPtr Data; public int Length, Recorded; public IntPtr User; public int Flags, Loops; public IntPtr Next, Reserved; }
		[DllImport("winmm.dll")] private static extern int waveOutOpen(out IntPtr device, int id, ref WaveFormat format, IntPtr callback, IntPtr instance, int flags);
		[DllImport("winmm.dll")] private static extern int waveOutPrepareHeader(IntPtr device, IntPtr header, int size);
		[DllImport("winmm.dll")] private static extern int waveOutWrite(IntPtr device, IntPtr header, int size);
		[DllImport("winmm.dll")] private static extern int waveOutUnprepareHeader(IntPtr device, IntPtr header, int size);
		[DllImport("winmm.dll")] private static extern int waveOutReset(IntPtr device);
		[DllImport("winmm.dll")] private static extern int waveOutClose(IntPtr device);

		// Each sound gets its own short-lived output, so they can overlap and never cut off Capri's own sounds.
		static void PlayPcm(short[] pcm)
		{
			if (Interlocked.Increment(ref blipsPlaying) > 6) { Interlocked.Decrement(ref blipsPlaying); return; }
			Behind(delegate
			{
				IntPtr device = IntPtr.Zero, data = IntPtr.Zero, header = IntPtr.Zero;
				int size = Marshal.SizeOf(typeof(WaveHeader));
				try
				{
					var format = new WaveFormat { Tag = 1, Channels = 1, Rate = BlipRate, BytesPerSecond = BlipRate * 2, Align = 2, Bits = 16 };
					if (waveOutOpen(out device, -1, ref format, IntPtr.Zero, IntPtr.Zero, 0) != 0) { device = IntPtr.Zero; return; }
					data = Marshal.AllocHGlobal(pcm.Length * 2);
					Marshal.Copy(pcm, 0, data, pcm.Length);
					header = Marshal.AllocHGlobal(size);
					Marshal.StructureToPtr(new WaveHeader { Data = data, Length = pcm.Length * 2 }, header, false);
					if (waveOutPrepareHeader(device, header, size) == 0 && waveOutWrite(device, header, size) == 0)
						Thread.Sleep(pcm.Length * 1000 / BlipRate + 120);
				}
				catch { }
				finally
				{
					try
					{
						if (device != IntPtr.Zero) { waveOutReset(device); if (header != IntPtr.Zero) waveOutUnprepareHeader(device, header, size); waveOutClose(device); }
						if (header != IntPtr.Zero) Marshal.FreeHGlobal(header);
						if (data != IntPtr.Zero) Marshal.FreeHGlobal(data);
					}
					catch { }
					Interlocked.Decrement(ref blipsPlaying);
				}
			});
		}

		// ---- Sidebar setup: which icons the sidebar shows, and web sites they can add, like a gaming browser's ----
		// Key, name, icon, group, shown by default, and the site it opens (for the added ones).
