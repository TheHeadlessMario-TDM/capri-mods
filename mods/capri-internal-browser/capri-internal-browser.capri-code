		internal const string StoreButton = @"(function(){if(location.hostname!=='chromewebstore.google.com')return '';function up(){var m=/^\/detail\/(?:[^\/]+\/)?([a-p]{32})/.exec(location.pathname),b=document.getElementById('capri-ext-add');if(!m){if(b)b.style.display='none';return}if(!b){b=document.createElement('button');b.id='capri-ext-add';b.style.cssText='position:fixed;right:24px;bottom:24px;z-index:2147483647;padding:12px 22px;border:0;border-radius:8px;background:#e0313b;color:#fff;font:600 15px Segoe UI,sans-serif;cursor:pointer;box-shadow:0 6px 20px rgba(0,0,0,.35)';b.onclick=function(){if(b.disabled)return;var h=document.querySelector('h1');b.textContent='Adding...';b.disabled=true;chrome.webview.postMessage('capri-ext|'+b.getAttribute('data-id')+'|'+((h&&h.textContent)||'').trim().slice(0,60))};document.documentElement.appendChild(b)}b.style.display='';if(b.getAttribute('data-id')!==m[1]){b.setAttribute('data-id',m[1]);b.textContent='Add to Capri Browser';b.disabled=false}}up();if(!window.__capriStore){window.__capriStore=1;setInterval(up,800)}return 'ok'})()";
		const string EndedScript = "(function(){function f(e){var v=e.target;if(!v||v.tagName!='VIDEO'||!(v.duration>45)||!isFinite(v.duration))return;if(e.type=='timeupdate'&&v.currentTime<v.duration*0.9)return;var k=v.currentSrc||'v';if(v.__capriDone===k)return;v.__capriDone=k;if(window.chrome&&chrome.webview)chrome.webview.postMessage((v.duration>360?'capri-endedL|':'capri-ended|')+document.title);}document.addEventListener('ended',f,true);document.addEventListener('timeupdate',f,true);})();";
		Task<string> darkId;

		public override bool Sleep() { if (core == null) return false; try { Call(core, "TrySuspendAsync"); return true; } catch (Exception) { return false; } }
		// Game mode: Edge keeps this page's memory as low as it can (its Low level), or back to Normal.
		public override void Saver(bool low)
		{
			if (core == null) return;
			try { PropertyInfo p = core.GetType().GetProperty("MemoryUsageTargetLevel"); if (p != null) p.SetValue(core, Enum.ToObject(p.PropertyType, low ? 1 : 0), null); }
			catch (Exception) { }
		}

		// Guess the Site: every page this tab opens starts blurred, before anything shows.
		const string BlurScript = "(function(){function b(){var h=document.documentElement;if(h)h.style.setProperty('filter','blur(18px)','important');return !!h;}if(!b())new MutationObserver(function(m,o){if(b())o.disconnect();}).observe(document,{childList:true});})()";
		Task<string> blurId;
		bool wantBlur;
		public override void Blurred(bool on)
		{
			wantBlur = on;
			if (core == null) return;
			try
			{
				if (on && blurId == null) { blurId = Call(core, "AddScriptToExecuteOnDocumentCreatedAsync", BlurScript) as Task<string>; Call(core, "ExecuteScriptAsync", BlurScript); }
				else if (!on && blurId != null)
				{
					Task<string> id = blurId;
					blurId = null;
					if (id.Status == TaskStatus.RanToCompletion) { Call(core, "RemoveScriptToExecuteOnDocumentCreated", id.Result); return; }
					var wait = new WinTimer { Interval = 300 };
					wait.Tick += delegate
					{
						if (!id.IsCompleted) return;
						wait.Dispose();
						try { if (core != null && id.Status == TaskStatus.RanToCompletion) Call(core, "RemoveScriptToExecuteOnDocumentCreated", id.Result); } catch { }
					};
					wait.Start();
				}
			}
			catch { }
		}

		public override void Dark(bool on)
		{
			if (core == null) return;
			try
			{
				if (on && darkId == null) { darkId = Call(core, "AddScriptToExecuteOnDocumentCreatedAsync", DarkScript) as Task<string>; Call(core, "ExecuteScriptAsync", DarkScript); }
				else if (!on && darkId != null)
				{
					if (darkId.Status == TaskStatus.RanToCompletion) Call(core, "RemoveScriptToExecuteOnDocumentCreated", darkId.Result);
					darkId = null;
					Call(core, "ExecuteScriptAsync", "(function(){var s=document.getElementById('capri-dark');if(s)s.remove();})()");
				}
			}
			catch { }
		}

		public override Task<string> Script(string script) { return core == null ? null : (Task<string>)Call(core, "ExecuteScriptAsync", script); }
		// Run as if the user had just clicked, so the page may pop a video out or go full screen.
		public override Task<string> Cdp(string method, string json) { return core == null ? null : (Task<string>)Call(core, "CallDevToolsProtocolMethodAsync", method, json); }
		public override Task<string> Gesture(string script) { return core == null ? null : (Task<string>)Call(core, "CallDevToolsProtocolMethodAsync", "Runtime.evaluate", "{\"expression\":\"" + script.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\",\"userGesture\":true,\"awaitPromise\":true,\"returnByValue\":true}"); }

		// Her red pointer, from Capri herself, as the mouse on web pages (boxes you type in keep the text cursor).
		static string pagePointer;
		static string PagePointer()
		{
			if (pagePointer != null) return pagePointer;
			pagePointer = "";
			try
			{
				MethodInfo art = typeof(ICapriHost).Assembly.GetType("CapriDesktop.Look").GetMethod("PointerArt", BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic);
				using (Bitmap b = (Bitmap)art.Invoke(null, new object[] { 32 }))
				using (var png = new MemoryStream())
				{
					b.Save(png, ImageFormat.Png);
					string css = "*{cursor:url(data:image/png;base64," + Convert.ToBase64String(png.ToArray()) + ") 2 2,auto!important}input,textarea,[contenteditable],[contenteditable] *{cursor:text!important}";
					pagePointer = "(function(){function a(){if(document.getElementById('capri-pointer'))return;var s=document.createElement('style');s.id='capri-pointer';s.textContent=" + Quote(css) + ";(document.head||document.documentElement).appendChild(s);}if(document.documentElement)a();document.addEventListener('DOMContentLoaded',a);})();";
				}
			}
			catch { }
			return pagePointer;
		}

		public override void Zoom(int step)
		{
			if (core == null) return;
			double now = (double)Get(view, "ZoomFactor");
			Set(view, "ZoomFactor", step == 0 ? 1.0 : Math.Max(0.25, Math.Min(5.0, step > 0 ? now * 1.1 : now / 1.1)));
		}

		public override void Print()
		{
			if (core == null) return;
			try { Call(core, "ShowPrintUI"); } catch (Exception) { try { Call(core, "ExecuteScriptAsync", "window.print()"); } catch { } }
		}

		public override bool Muted
		{
			get { return core != null && (bool)Get(core, "IsMuted"); }
			set { if (core != null) Set(core, "IsMuted", value); }
		}

		// The visible page as a picture, only in memory (never saved).
		public override void Grab(Action<Bitmap> done)
		{
			if (core == null) { done(null); return; }
			try
			{
				var saved = new MemoryStream();
				Task run = (Task)Call(core, "CapturePreviewAsync", 0, saved);
				run.ContinueWith(finished =>
				{
					Bitmap got = null;
					try { if (!finished.IsFaulted) { saved.Position = 0; using (Image raw = Image.FromStream(saved)) got = new Bitmap(raw); } } catch { }
					saved.Dispose();
					done(got);
				});
			}
			catch (Exception) { done(null); }
		}

		public override void Shot(string file, Action<string> done)
		{
			if (core == null) { done("the page isn't ready yet"); return; }
			try
			{
				Stream saved = File.Create(file);
				Task run = (Task)Call(core, "CapturePreviewAsync", 0, saved);
				run.ContinueWith(finished => { saved.Dispose(); done(finished.IsFaulted ? finished.Exception.GetBaseException().Message : null); });
			}
			catch (Exception error) { done(Inner(error).Message); }
		}

		// Cookies, site storage and the cache. Passwords, autofill and history stay.
		public override bool Clear(Action<string> done)
		{
			if (core == null) return false;
			try
			{
				object profile = Get(core, "Profile");
				MethodInfo wipe = null;
				foreach (MethodInfo method in profile.GetType().GetMethods()) if (method.Name == "ClearBrowsingDataAsync" && method.GetParameters().Length == 1) wipe = method;
				if (wipe == null) return false;
				Task run = (Task)wipe.Invoke(profile, new[] { Enum.Parse(wipe.GetParameters()[0].ParameterType, "AllSite, DiskCache") });
				run.ContinueWith(finished => { done(finished.IsFaulted ? finished.Exception.GetBaseException().Message : null); });
			}
			catch (Exception error) { done(Inner(error).Message); }
			return true;
		}

		// Site settings, pushed into Edge's own permission store so an earlier "Allow" doesn't stick around.
		public override void Permit(int kind, string host, string value)
		{
			if (core == null || kind < 0 || host == "*") return;
			try
			{
				object profile = Get(core, "Profile");
				int state = value == "allow" ? 1 : value == "block" ? 2 : 0;
				foreach (string origin in SiteOrigins(host, true)) Call(profile, "SetPermissionStateAsync", kind, origin, state);
			}
			catch { }
		}

		// How much a site keeps on this PC, and its cookies: "bytes|cookies" (-1 when unknown).
		public override void SiteData(string host, Action<string> got)
		{
			if (core == null) { got(null); return; }
			try
			{
				TaskScheduler ui = TaskScheduler.FromCurrentSynchronizationContext();
				var sizes = new List<Task<string>>();
				foreach (string origin in SiteOrigins(host, false)) sizes.Add(Cdp("Storage.getUsageAndQuota", "{\"origin\":\"" + origin + "\"}"));
				Task cookies = (Task)Call(Get(core, "CookieManager"), "GetCookiesAsync", "https://" + host);
				var all = new List<Task>();
				foreach (Task<string> one in sizes) all.Add(one);
				all.Add(cookies);
				Task.Factory.ContinueWhenAll(all.ToArray(), done =>
				{
					long used = -1;
					foreach (Task<string> one in sizes)
					{
						if (one.Status != TaskStatus.RanToCompletion) continue;
						Match m = Regex.Match(one.Result ?? "", "\"usage\":\\s*([0-9.eE+]+)");
						double d;
						if (m.Success && double.TryParse(m.Groups[1].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out d)) used = Math.Max(0, used) + (long)d;
					}
					int count = -1;
					if (cookies.Status == TaskStatus.RanToCompletion)
					{
						ICollection list = Get(cookies, "Result") as ICollection;
						if (list != null) count = list.Count;
					}
					got(used + "|" + count);
				}, CancellationToken.None, TaskContinuationOptions.None, ui);
			}
			catch (Exception) { got(null); }
		}

		// Deletes one site's cookies, storage and cache, and nothing else.
		public override void WipeSite(string host, Action<string> done)
		{
			if (core == null) { done("the page isn't ready yet"); return; }
			try
			{
				TaskScheduler ui = TaskScheduler.FromCurrentSynchronizationContext();
				var work = new List<Task>();
				foreach (string origin in SiteOrigins(host, true)) work.Add(Cdp("Storage.clearDataForOrigin", "{\"origin\":\"" + origin + "\",\"storageTypes\":\"all\"}"));
				object jar = Get(core, "CookieManager");
				foreach (string origin in SiteOrigins(host, false))
				{
					Task found = (Task)Call(jar, "GetCookiesAsync", origin);
					work.Add(found.ContinueWith(f =>
					{
						if (f.Status != TaskStatus.RanToCompletion) return;
						ICollection list = Get(f, "Result") as ICollection;
						if (list != null) foreach (object cookie in list) try { Call(jar, "DeleteCookie", cookie); } catch { }
					}, ui));
				}
				Task.Factory.ContinueWhenAll(work.ToArray(), finished =>
				{
					string failed = null;
					int bad = 0;
					foreach (Task w in finished) if (w.IsFaulted) { bad++; failed = w.Exception.GetBaseException().Message; }
					done(bad == finished.Length ? failed : null);
				}, CancellationToken.None, TaskContinuationOptions.None, ui);
			}
			catch (Exception error) { done(Inner(error).Message); }
		}

		public override int EngineId { get { try { return core == null ? 0 : Convert.ToInt32(Get(core, "BrowserProcessId")); } catch (Exception) { return 0; } } }

		// Clears kinds of Edge's browsing data by name, like "DiskCache, CacheStorage".
		public override void ClearKinds(string kinds, Action<string> done)
		{
			if (core == null) { done("the page isn't ready yet"); return; }
			try
			{
				object profile = Get(core, "Profile");
				MethodInfo wipe = null;
				foreach (MethodInfo method in profile.GetType().GetMethods()) if (method.Name == "ClearBrowsingDataAsync" && method.GetParameters().Length == 1) wipe = method;
				if (wipe == null) { done("this version of Edge's engine can't do that"); return; }
				Type kind = wipe.GetParameters()[0].ParameterType;
				long all = 0;
				foreach (string name in kinds.Split(','))
					try { all |= Convert.ToInt64(Enum.Parse(kind, name.Trim())); } catch { }
				if (all == 0) { done(null); return; }
				Task run = (Task)wipe.Invoke(profile, new[] { Enum.ToObject(kind, all) });
				run.ContinueWith(finished => { done(finished.IsFaulted ? finished.Exception.GetBaseException().Message : null); });
			}
			catch (Exception error) { done(Inner(error).Message); }
		}

		public override void Html(string html) { Run(delegate { Call(core, "NavigateToString", html); }); }
		public override void Go(string url) { Run(delegate { Call(core, "Navigate", url); }); }
		public override void Reload() { Run(delegate { Call(core, "Reload"); }); }
		public override void Downloads() { try { if (core != null) Call(core, "OpenDefaultDownloadDialog"); } catch { } }
		public override void Text(Action<string> got)
		{
			if (core == null) { got(null); return; }
			try
			{
				Task<string> run = (Task<string>)Call(core, "ExecuteScriptAsync", ReadScript);
				run.ContinueWith(done =>
				{
					string json = done.Status == TaskStatus.RanToCompletion ? done.Result : null;
					string text = null;
					// Edge hands it back as a JSON string: quotes and escapes.
					if (json != null && json.Length >= 2 && json[0] == '"')
						try { text = Regex.Unescape(json.Substring(1, json.Length - 2)); } catch (Exception) { text = json; }
					got(text);
				});
			}
			catch (Exception) { got(null); }
		}
		public override bool CanBack { get { return core != null && (bool)Get(view, "CanGoBack"); } }
		public override void Back() { if (CanBack) Call(view, "GoBack"); }
		public override void Forward() { if (core != null && (bool)Get(view, "CanGoForward")) Call(view, "GoForward"); }
		public override string Address { get { Uri at = core == null ? null : Get(view, "Source") as Uri; return at == null ? null : at.AbsoluteUri; } }
		public override void Background(Color color) { try { Set(view, "DefaultBackgroundColor", color); } catch { } }

		public override void Style(Look look, bool reader)
		{
			styled = look;
			styledReader = reader;
			if (core == null) return;
			try
			{
				Scheme(look);
				if (reader) Set(view, "ZoomFactor", 1.0);
			}
			catch { }
		}

		// Sites with their own dark mode, like YouTube, follow this.
		void Scheme(Look look)
		{
			object profile = Get(core, "Profile");
			PropertyInfo preferred = profile == null ? null : profile.GetType().GetProperty("PreferredColorScheme");
			if (preferred != null) preferred.SetValue(profile, Enum.ToObject(preferred.PropertyType, !look.Sites ? 0 : look.Dark ? 2 : 1), null);
		}
	}

	// ---- The video player download: Microsoft's WebView2 SDK from NuGet, checked against its SHA-256 ----

	const string VideoVersion = "1.0.4314.35";
	const string VideoHash = "90778DEB1B77E36292828B4B5833C9255C27533F40E0DDD55891AE718944EDC4";
	const string VideoPackage = "https://api.nuget.org/v3-flatcontainer/microsoft.web.webview2/" + VideoVersion + "/microsoft.web.webview2." + VideoVersion + ".nupkg";
	static Assembly videoCore, videoForms;
	static string videoError;

	public static bool VideoReady { get { return videoForms != null; } }

	static string Architecture
	{
		get
		{
			string arch = (Environment.GetEnvironmentVariable("PROCESSOR_ARCHITECTURE") ?? "").ToUpperInvariant();
			return arch == "ARM64" ? "win-arm64" : IntPtr.Size == 4 ? "win-x86" : "win-x64";
		}
	}

	static string VideoFolder(string folder) { return Path.Combine(folder, "video-player-" + VideoVersion); }

	public static bool VideoInstalled(string folder)
	{
		string home = VideoFolder(folder);
		return File.Exists(Path.Combine(home, "Microsoft.Web.WebView2.Core.dll")) && File.Exists(Path.Combine(home, "Microsoft.Web.WebView2.WinForms.dll")) && File.Exists(Path.Combine(home, Architecture, "WebView2Loader.dll"));
	}

	// Null once Edge's engine is loaded, or why it couldn't be.
	public static string LoadVideo(string folder)
	{
		if (videoForms != null) return null;
		if (videoError != null) return videoError;
		try
		{
			string home = VideoFolder(folder);
			videoCore = Assembly.LoadFrom(Path.Combine(home, "Microsoft.Web.WebView2.Core.dll"));
			videoForms = Assembly.LoadFrom(Path.Combine(home, "Microsoft.Web.WebView2.WinForms.dll"));
			Type environment = videoCore.GetType("Microsoft.Web.WebView2.Core.CoreWebView2Environment", true);
			// Only allowed once per Capri run.
			try { environment.GetMethod("SetLoaderDllFolderPath").Invoke(null, new object[] { Path.Combine(home, Architecture) }); }
			catch (Exception loader) { if (!(Inner(loader) is InvalidOperationException)) throw; }
			// Throws when the WebView2 Runtime isn't on this PC (it comes with Windows 11 and Edge).
			environment.GetMethod("GetAvailableBrowserVersionString", new[] { typeof(string) }).Invoke(null, new object[] { null });
			return null;
		}
		catch (Exception error)
		{
			videoForms = null;
			videoError = Inner(error).Message;
			return videoError;
		}
	}

	// Downloads the package, checks it's exactly the one this mod was made with, and keeps only the three files it needs.
	public static string InstallVideo(string folder, Action<int> progress)
	{
		try
		{
			byte[] package = DownloadBytes(VideoPackage, progress);
			if (package == null) return "the download didn't finish. Check your connection and try again.";
			using (SHA256 sha = SHA256.Create())
				if (BitConverter.ToString(sha.ComputeHash(package)).Replace("-", "") != VideoHash) return "the download didn't match Microsoft's package, so it wasn't used.";
			string home = VideoFolder(folder);
			Directory.CreateDirectory(Path.Combine(home, Architecture));
			string[,] files = { { "lib/net462/Microsoft.Web.WebView2.Core.dll", "Microsoft.Web.WebView2.Core.dll" }, { "lib/net462/Microsoft.Web.WebView2.WinForms.dll", "Microsoft.Web.WebView2.WinForms.dll" }, { "runtimes/" + Architecture + "/native/WebView2Loader.dll", Path.Combine(Architecture, "WebView2Loader.dll") } };
			for (int i = 0; i < files.GetLength(0); i++)
			{
				byte[] file = Unzip(package, files[i, 0]);
				if (file == null) return "the package was missing " + files[i, 0] + ".";
				string target = Path.Combine(home, files[i, 1]);
				File.WriteAllBytes(target + ".part", file);
				if (File.Exists(target)) File.Delete(target);
				File.Move(target + ".part", target);
			}
			videoError = null;
			return null;
		}
		catch (Exception error) { return Inner(error).Message; }
	}

	// One file out of a zip (a .nupkg is one), unpacked by Windows' own tar.exe.
	public static byte[] Unzip(byte[] zip, string name)
	{
		string folder = Path.Combine(Path.GetTempPath(), "capri-unzip-" + Guid.NewGuid().ToString("N"));
		try
		{
			if (Untar(zip, folder, name) != null) return null;
			string file = Path.Combine(folder, name.Replace('/', '\\'));
			return File.Exists(file) ? File.ReadAllBytes(file) : null;
		}
		catch (Exception) { return null; }
		finally { try { Directory.Delete(folder, true); } catch { } }
	}

	// Files out of a zip into folder (just only, when given) with Windows' own tar, which reads zips and won't write outside the folder.
	internal static string Untar(byte[] zip, string folder, string only)
	{
		string file = Path.Combine(Path.GetTempPath(), "capri-zip-" + Guid.NewGuid().ToString("N") + ".zip");
		try
		{
			string windows = Environment.GetFolderPath(Environment.SpecialFolder.Windows), tar = Path.Combine(windows, "Sysnative\\tar.exe");
			if (!File.Exists(tar)) tar = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.System), "tar.exe");
			if (!File.Exists(tar)) return "Windows' tar.exe isn't on this PC";
			File.WriteAllBytes(file, zip);
			Directory.CreateDirectory(folder);
			var start = new ProcessStartInfo(tar, "-xf \"" + file + "\" -C \"" + folder.TrimEnd('\\') + "\"" + (only == null ? "" : " \"" + only + "\"")) { UseShellExecute = false, CreateNoWindow = true };
			using (Process run = Process.Start(start))
			{
				if (!run.WaitForExit(120000)) { try { run.Kill(); } catch { } return "unpacking took too long"; }
				return run.ExitCode == 0 ? null : "it couldn't be unpacked";
			}
		}
		catch (Exception error) { return error.Message; }
		finally { try { File.Delete(file); } catch { } }
	}

	static byte[] DownloadBytes(string address, Action<int> progress)
	{
		HttpWebRequest request = (HttpWebRequest)WebRequest.Create(address);
		request.UserAgent = "CapriInternalBrowser/1.1";
		request.Timeout = 20000;
		request.ReadWriteTimeout = 20000;
		try
		{
			using (WebResponse response = request.GetResponse())
			using (Stream stream = response.GetResponseStream())
			using (var saved = new MemoryStream())
			{
				long total = response.ContentLength;
				byte[] chunk = new byte[81920];
				int read, last = -1;
				while ((read = stream.Read(chunk, 0, chunk.Length)) > 0)
				{
					saved.Write(chunk, 0, read);
					int percent = total > 0 ? (int)(saved.Length * 100 / total) : 0;
					if (percent != last && progress != null) { last = percent; progress(percent); }
				}
				return saved.ToArray();
			}
		}
		catch (WebException) { return null; }
		catch (IOException) { return null; }
	}

	// ---- Reflection helpers for Edge's engine ----

	static object Get(object target, string name) { return target.GetType().GetProperty(name).GetValue(target, null); }

	static void Set(object target, string name, object value) { target.GetType().GetProperty(name).SetValue(target, value, null); }

	static object Call(object target, string name, params object[] args)
	{
		foreach (MethodInfo method in target.GetType().GetMethods())
			if (method.Name == name && method.GetParameters().Length == args.Length)
			{
				ParameterInfo[] takes = method.GetParameters();
				for (int i = 0; i < args.Length; i++) if (takes[i].ParameterType.IsEnum && args[i] is int) args[i] = Enum.ToObject(takes[i].ParameterType, args[i]);
				return method.Invoke(target, args);
			}
		throw new MissingMethodException(target.GetType().Name, name);
	}

	// Subscribes to an event whose handler type only exists in Edge's library, like EventHandler<CoreWebView2NewWindowRequestedEventArgs>.
	static void Hook(object target, string name, Action<object> run)
	{
		EventInfo info = target.GetType().GetEvent(name);
		if (info == null) return;
		ParameterInfo[] takes = info.EventHandlerType.GetMethod("Invoke").GetParameters();
		ParameterExpression sender = Expression.Parameter(takes[0].ParameterType, "sender"), args = Expression.Parameter(takes[1].ParameterType, "args");
		Expression body = Expression.Invoke(Expression.Constant(run), Expression.Convert(args, typeof(object)));
		info.AddEventHandler(target, Expression.Lambda(info.EventHandlerType, body, sender, args).Compile());
	}

	static Exception Inner(Exception error) { while (error is TargetInvocationException && error.InnerException != null) error = error.InnerException; return error; }

	// ---- Her hidden browser ----

	public sealed class Result
	{
		public string Title, Address, Snippet, Site;
		public string Host { get { return Site ?? new Uri(Address).Host; } }
	}

	public sealed class Page
	{
		public string Query = "";
		public List<Result> Results = new List<Result>();
		// Host and the best sentences she read there.
		public List<KeyValuePair<string, string>> Read = new List<KeyValuePair<string, string>>();

		public string Text(int most)
		{
			var text = new StringBuilder("Web results for \"" + Query + "\", read in your own browser (nothing opened on their screen):");
			for (int i = 0; i < Results.Count && i < 5; i++)
				text.Append("\n" + (i + 1) + ". " + Results[i].Title + " (" + Results[i].Host + ")" + (Results[i].Snippet.Length > 0 ? ": " + Results[i].Snippet : ""));
			foreach (KeyValuePair<string, string> read in Read) text.Append("\nFrom " + read.Key + ": " + read.Value);
			return Clip(text.ToString(), most);
		}
	}

	static readonly Regex Hidden = new Regex(@"<(script|style|noscript|svg|head|nav|footer|header|form|aside|template|iframe|select)\b.*?</\1\s*>|<!--.*?-->", RegexOptions.Singleline | RegexOptions.IgnoreCase);
	// Video and social sites have no text to read without signing in, so she only lists them.
	internal static readonly Regex Unsuitable = new Regex(@"\b(?:porn\w*|p[o0]rn|nsfw|hentai|rule\s*34|r34|nudes?|nudity|naked|nackt|desnud[ao]s?|sex|sexe|sexo|sexy|sexual(?:ly)?|xxx|onlyfans|fansly|erotic\w*|fetish\w*|kink\w*|camgirls?|escorts?|hookers?|strip\s*clubs?|lewd|boobs?|tits|genitals?|gore|snuff|beheadings?|xvideos|xhamster|pornhub|redtube|chaturbate"
		+ @"|suicide\s+methods?|how\s+to\s+(?:kill\s+(?:myself|someone|a\s+person)|make\s+(?:a\s+)?(?:bomb|pipe\s*bomb|meth|explosives?|poison|napalm)|cook\s+meth|buy\s+(?:drugs|a\s+gun\s+illegally)))\b", RegexOptions.IgnoreCase);
	static readonly Regex Unreadable = new Regex(@"(^|\.)(youtube\.com|youtu\.be|tiktok\.com|instagram\.com|facebook\.com|x\.com|twitter\.com|pinterest\.[a-z.]+|linkedin\.com|twitch\.tv)$", RegexOptions.IgnoreCase);
	internal static string[] Filler = { "the", "and", "for", "what", "whats", "what's", "when", "where" };
	// What she looked up lately, so asking again (or saying yes to Capri Browser) is instant.
	static readonly Dictionary<string, KeyValuePair<DateTime, Page>> Recent = new Dictionary<string, KeyValuePair<DateTime, Page>>();
	// How long she gives the pages she reads: past this she answers from what's in.
	public static double ReadSeconds = 3.5;

	public static Page Search(string search) { return Search(search, null); }

	public static Page Search(string search, Action<string> reading)
	{
		var page = new Page { Query = Regex.Replace(search ?? "", @"\s+", " ").Trim().TrimEnd('?', '.', '!', ' ') };
		if (page.Query.Length == 0) return page;
		string key = page.Query.ToLowerInvariant();
		lock (Recent)
		{
			KeyValuePair<DateTime, Page> kept;
			if (Recent.TryGetValue(key, out kept) && (DateTime.UtcNow - kept.Key).TotalMinutes < 10 && kept.Value.Results.Count > 0) return kept.Value;
		}
		List<string> wanted = Wanted(page.Query);
		string q = Uri.EscapeDataString(page.Query);
		// All four searches go out at once; she keeps the first in this order that answers with relevant pages, so a blocked one costs nothing
		// extra.
		string[] addresses = { "https://search.brave.com/search?safesearch=strict&q=" + q, "https://www.bing.com/search?adlt=strict&setlang=" + Lang + "&q=" + q, "https://html.duckduckgo.com/html/?kp=1&q=" + q, "https://" + WikiHost + "/w/api.php?action=query&list=search&format=json&srlimit=3&srsearch=" + q };
		string[] pages = new string[4];
		ManualResetEvent[] done = { new ManualResetEvent(false), new ManualResetEvent(false), new ManualResetEvent(false), new ManualResetEvent(false) };
		for (int i = 0; i < 4; i++)
		{
			int which = i;
			var fetcher = new Thread(delegate() { try { pages[which] = Fetch(addresses[which]); } catch { } finally { done[which].Set(); } });
			fetcher.IsBackground = true;
			fetcher.Start();
		}
		DateTime until = DateTime.UtcNow.AddSeconds(7);
		for (int i = 0; i < 4 && page.Results.Count == 0; i++)
		{
			done[i].WaitOne(Left(until));
			string got;
			lock (pages) got = pages[i];
			page.Results = Relevant(i == 0 ? Brave(got) : i == 1 ? Bing(got) : i == 2 ? DuckDuckGo(got) : Encyclopedia(got), wanted);
		}
		// The top two pages she can read load side by side, and she stops waiting after ReadSeconds.
		var toRead = new List<Result>();
		foreach (Result result in page.Results) if (toRead.Count < 2 && !Unreadable.IsMatch(result.Host)) toRead.Add(result);
		if (toRead.Count > 0 && reading != null) reading(toRead[0].Host);
		string[] read = new string[toRead.Count];
		var readers = new List<Thread>();
		for (int i = 0; i < toRead.Count; i++)
		{
			int which = i;
			var reader = new Thread(delegate()
			{
				string passage;
				try { passage = Read(toRead[which].Address, page.Query); }
				catch (Exception) { passage = null; }
				lock (read) read[which] = passage;
			});
			reader.IsBackground = true;
			reader.Start();
			readers.Add(reader);
		}
		DateTime readUntil = DateTime.UtcNow.AddSeconds(ReadSeconds);
		foreach (Thread reader in readers) reader.Join(Left(readUntil));
		lock (read)
			for (int i = 0; i < read.Length; i++)
				if (!string.IsNullOrEmpty(read[i])) page.Read.Add(new KeyValuePair<string, string>(toRead[i].Host, read[i]));
		if (page.Results.Count > 0)
			lock (Recent)
			{
				if (Recent.Count > 30) Recent.Clear();
				Recent[key] = new KeyValuePair<DateTime, Page>(DateTime.UtcNow, page);
			}
		return page;
	}

	public static void Forget() { lock (Recent) Recent.Clear(); }

	static TimeSpan Left(DateTime until) { return TimeSpan.FromTicks(Math.Max(0, (until - DateTime.UtcNow).Ticks)); }

	// Bing's results page. Its links go through bing.com/ck/a, with the real address base64'd after u=a1.
	public static List<Result> Bing(string html)
	{
		var found = new List<Result>();
		foreach (string part in Regex.Split(html ?? "", @"(?=<li class=""b_algo"")"))
		{
			if (!part.Begins("<li class=\"b_algo\"")) continue;
			string body = Hidden.Replace(Regex.Replace(part, @"<link\b[^>]*>", ""), " ");
			Match link = Regex.Match(body, @"<h2\b[^>]*>\s*<a\b[^>]*\bhref=""([^""]+)""[^>]*>(.*?)</a>", RegexOptions.Singleline);
			if (!link.Success) continue;
			string address = WebUtility.HtmlDecode(link.Groups[1].Value);
			Match coded = Regex.Match(address, @"^https://www\.bing\.com/ck/a\?.*?[?&]u=a1([A-Za-z0-9_-]+)");
			// Bing's own forwarding link is kept as it is: opening it takes them to the site.
			Uri uri;
			if (!Uri.TryCreate(address, UriKind.Absolute, out uri) || (uri.Scheme != "http" && uri.Scheme != "https") || (!coded.Success && uri.Host.EndsWith("bing.com", Loose))) continue;
			Match snippet = Regex.Match(body, @"<p\b[^>]*>(.*?)</p>", RegexOptions.Singleline);
			found.Add(new Result { Title = Clip(Flat(link.Groups[2].Value), 120), Address = uri.AbsoluteUri, Snippet = snippet.Success ? Clip(Flat(snippet.Groups[1].Value), 300) : "" });
			if (found.Count == 8) break;
		}
		return found;
	}

	// For research: Brave, Wikipedia and Bing together, their relevant results merged, so one engine having a bad day (or matching a different
	// William) can't leave her with nothing.
	internal static List<Result> Gather(string search)
	{
		string query = Regex.Replace(search ?? "", @"\s+", " ").Trim().TrimEnd('?', '.', '!', ' '), q = Uri.EscapeDataString(query);
		List<string> wanted = Wanted(query);
		string[] addresses = { "https://search.brave.com/search?safesearch=strict&q=" + q, "https://" + WikiHost + "/w/api.php?action=query&list=search&format=json&srlimit=3&srsearch=" + q, "https://www.bing.com/search?adlt=strict&setlang=" + Lang + "&q=" + q };
		string[] pages = new string[3];
		var fetchers = new List<Thread>();
		for (int i = 0; i < 3; i++)
		{
			int which = i;
			var fetcher = new Thread(delegate() { string got = null; try { got = Fetch(addresses[which]); } catch { } lock (pages) pages[which] = got; });
			fetcher.IsBackground = true;
			fetcher.Start();
			fetchers.Add(fetcher);
		}
		DateTime until = DateTime.UtcNow.AddSeconds(8);
		foreach (Thread fetcher in fetchers) fetcher.Join(Left(until));
		var all = new List<Result>();
		lock (pages)
			foreach (List<Result> one in new[] { Brave(pages[0]), Encyclopedia(pages[1]), Bing(pages[2]) })
				foreach (Result r in Relevant(one, wanted)) if (!all.Exists(x => x.Address == r.Address)) all.Add(r);
		return all;
	}

	// Brave Search's results page: each web result has the site's own address, its title, and a snippet.
	public static List<Result> Brave(string html)
	{
		var found = new List<Result>();
		foreach (string part in Regex.Split(html ?? "", @"(?=<div class=""snippet[^""]*"" data-pos=""\d+"" data-type=""web"")"))
		{
			if (!part.Begins("<div class=\"snippet") || part.IndexOf("data-type=\"web\"", 0, Math.Min(part.Length, 120), Exact) < 0) continue;
			Match link = Regex.Match(part, @"<a href=""(https?://[^""]+)""");
			Match title = Regex.Match(part, @"class=""title[^""]*""[^>]*\btitle=""([^""]*)""");
			Uri uri;
			if (!link.Success || !title.Success || !Uri.TryCreate(WebUtility.HtmlDecode(link.Groups[1].Value), UriKind.Absolute, out uri) || uri.Host.EndsWith("brave.com", Loose)) continue;
			Match snippet = Regex.Match(part, @"class=""content [^""]*""[^>]*>(.*?)</div>", RegexOptions.Singleline);
			found.Add(new Result { Title = Clip(Flat(title.Groups[1].Value), 120), Address = uri.AbsoluteUri, Snippet = snippet.Success ? Clip(Flat(snippet.Groups[1].Value), 300) : "" });
			if (found.Count == 8) break;
		}
		return found;
	}

	// DuckDuckGo's plain results page, without its ads, which link back to duckduckgo.com.
	public static List<Result> DuckDuckGo(string html)
	{
		var found = new List<Result>();
		foreach (string part in Regex.Split(html ?? "", @"(?=<a\b[^>]*class=""result__a"")"))
		{
			Match link = Regex.Match(part, @"^<a\b[^>]*\bhref=""([^""]*)""[^>]*>(.*?)</a>", RegexOptions.Singleline);
			if (!link.Success) continue;
			string address = WebUtility.HtmlDecode(link.Groups[1].Value);
			Match real = Regex.Match(address, @"[?&]uddg=([^&]+)");
			if (real.Success) address = Uri.UnescapeDataString(real.Groups[1].Value);
			if (address.Begins("//")) address = "https:" + address;
			Uri uri;
			if (!Uri.TryCreate(address, UriKind.Absolute, out uri) || (uri.Scheme != "http" && uri.Scheme != "https") || uri.Host.EndsWith("duckduckgo.com", Loose)) continue;
			Match snippet = Regex.Match(part, @"class=""result__snippet""[^>]*>(.*?)</(a|div|td)>", RegexOptions.Singleline);
			found.Add(new Result { Title = Clip(Flat(link.Groups[2].Value), 120), Address = uri.AbsoluteUri, Snippet = snippet.Success ? Clip(Flat(snippet.Groups[1].Value), 300) : "" });
			if (found.Count == 8) break;
		}
		return found;
	}

	public static List<Result> Encyclopedia(string json)
	{
		var found = new List<Result>();
		foreach (Match hit in Regex.Matches(json ?? "", @"""title""\s*:\s*""((?:[^""\\]|\\.)*)""[^{}]*?""snippet""\s*:\s*""((?:[^""\\]|\\.)*)"""))
		{
			string title = Regex.Unescape(hit.Groups[1].Value);
			found.Add(new Result { Title = title + " - Wikipedia", Address = "https://" + WikiHost + "/wiki/" + Uri.EscapeDataString(title.Replace(' ', '_')), Snippet = Clip(Flat(Regex.Unescape(hit.Groups[2].Value)), 300) });
		}
		return found;
	}

	// A page's best sentences. A Wikipedia article is read from its plain summary, which has the facts up front.
	static string Read(string address, string asked) { return Read(address, asked, 700); }

	static string Read(string address, string asked, int most)
	{
		Match wiki = Regex.Match(address, @"^https://([a-z-]+\.wikipedia\.org)/wiki/([^?#]+)");
		if (!wiki.Success) return Passage(Fetch(address), asked, most);
		Match extract = Regex.Match(Fetch("https://" + wiki.Groups[1].Value + "/api/rest_v1/page/summary/" + wiki.Groups[2].Value) ?? "", @"""extract""\s*:\s*""((?:[^""\\]|\\.)*)""");
		return extract.Success ? Clip(Regex.Replace(Regex.Unescape(extract.Groups[1].Value), @"\s+", " ").Trim(), 900) : null;
	}

	// The sentences of a page that best fit what they asked, in the page's order, about 700 characters at most (or "most").
	public static string Passage(string html, string asked) { return Passage(html, asked, 700); }

	public static string Passage(string html, string asked, int most)
	{
		string page = html ?? "";
		if (page.Length > 400000) page = page.Substring(0, 400000);
		Match main = Regex.Match(page, @"<(main|article)\b.*?</\1\s*>", RegexOptions.Singleline | RegexOptions.IgnoreCase);
		if (main.Success && main.Length > 2000) page = main.Value;
		page = Regex.Replace(Hidden.Replace(page, " "), @"<br\s*/?>|</(p|li|h[1-6]|td|th|tr|div|section|dd|dt|blockquote|figcaption)\s*>", "\n", RegexOptions.IgnoreCase);
		// Footnote marks like [12] or [a] are noise read aloud.
		string text = Regex.Replace(WebUtility.HtmlDecode(Regex.Replace(page, "<[^>]+>", " ")), @"\[\s*(\d+|[a-z]|note \d+|citation needed)\s*\]", "", RegexOptions.IgnoreCase);
		List<string> wanted = Wanted(asked);
		var lines = new List<string>();
		var scores = new List<int>();
		foreach (string piece in Regex.Split(text, @"\n|(?<=[.!?])\s+(?=[\p{Lu}\p{N}""“])"))
		{
			string line = Regex.Replace(piece, @"\s+", " ").Trim();
			if (line.Length < 40 || line.Length > 500 || line.IndexOf('{') >= 0 || line.IndexOf('}') >= 0 || !Regex.IsMatch(line, @"\p{Ll}.*\s.*\p{Ll}") || Regex.IsMatch(line, @"\b(Archived from the original|Retrieved (on )?\d|ISBN|All rights reserved|cookies?)\b", RegexOptions.IgnoreCase)) continue;
			int score = 0;
			foreach (string word in wanted) if (Mentions(line, word)) score++;
			lines.Add(line);
			scores.Add(score);
		}
		if (lines.Count == 0) return null;
		var order = new List<int>();
		for (int i = 0; i < lines.Count; i++) order.Add(i);
		order.Sort((a, b) => scores[a] != scores[b] ? scores[b].CompareTo(scores[a]) : a.CompareTo(b));
		// Nothing matched: the page's opening lines are the best guess.
		if (scores[order[0]] == 0) order.Sort();
		var kept = new List<int>();
		int length = 0;
		foreach (int i in order)
		{
			if (length > 0 && (length + lines[i].Length > most || (most <= 900 && scores[order[0]] > 0 && scores[i] == 0))) break;
			kept.Add(i);
			length += lines[i].Length + 1;
		}
		kept.Sort();
		return Clip(string.Join(" ", kept.ConvertAll(i => lines[i]).ToArray()), Math.Max(900, most));
	}

	// The words of their question worth matching: "when does GTA 6 come out" is gta, 6 and come.
	static List<string> Wanted(string asked)
	{
		var wanted = new List<string>();
		foreach (string word in Regex.Split((asked ?? "").ToLowerInvariant(), @"[^\p{L}\p{N}']+"))
			if ((word.Length >= 3 || Regex.IsMatch(word, @"^\d+$")) && Array.IndexOf(Filler, word) < 0 && !wanted.Contains(word)) wanted.Add(word);
		return wanted;
	}

	// Results whose title or snippet has a third or more of the words of their question.
	static List<Result> Relevant(List<Result> found, List<string> wanted)
	{
		int needed = (wanted.Count + 2) / 3;
		return found.FindAll(result => wanted.FindAll(word => Mentions(result.Title + " " + result.Snippet, word)).Count >= needed);
	}

	// The word on its own or with a plain ending, so "release" finds "released" but "won" doesn't find "wonderful".
	static bool Mentions(string text, string word) { return Regex.IsMatch(text, @"(?<![\p{L}\p{N}])" + Regex.Escape(word) + @"(s|es|d|ed|ing|'s)?(?![\p{L}\p{N}])", RegexOptions.IgnoreCase); }

	static string Flat(string html) { return Regex.Replace(WebUtility.HtmlDecode(Regex.Replace(html ?? "", "<[^>]+>", "")), @"\s+", " ").Trim(); }

	// Her brain's answer on one line, without markdown bold.
	static string BrainLine(string answer) { return Regex.Replace(answer ?? "", @"\s+", " ").Replace("**", "").Trim(); }
	static string Colored(string css, string[] c) { for (int i = 0; i < c.Length; i++) css = css.Replace("%C" + i + "%", c[i]); return css; }
	// A header's text in the theme's colours (red parts stay red), but not its title.
	static void TintHead(Control head, Control title, Look look) { foreach (Control part in head.Controls) if (part != title) part.ForeColor = "red".Equals(part.Tag) ? look.Shade(5) : look.Shade(3); }
	const string NoEngine = "That needs Edge's engine, which isn't set up.";
	const string OpenedHere = "Opened it in Capri Browser on their screen instead. If they asked for more than opening it, keep going with the capri_browser tool ('links', then 'click' or 'type'). Otherwise reply with something short like: It's up in Capri Browser, choom.";
	static string Clip(string text, int most) { return text.Length <= most ? text : text.Substring(0, most - 3).TrimEnd() + "..."; }

	static string Download(string address)
	{
		HttpWebRequest request = (HttpWebRequest)WebRequest.Create(address);
		request.UserAgent = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36";
		request.Headers["Accept-Language"] = Lang == "en" ? "en" : Lang + ",en;q=0.5";
		request.Timeout = 5000;
		request.ReadWriteTimeout = 5000;
		request.AutomaticDecompression = DecompressionMethods.GZip | DecompressionMethods.Deflate;
		try
		{
			using (WebResponse response = request.GetResponse())
			using (var reader = new StreamReader(response.GetResponseStream(), Encoding.UTF8)) return reader.ReadToEnd();
		}
		catch (WebException) { return ""; }
		catch (IOException) { return ""; }
	}
}

// A see-through window that floats over the browser's corner (not over other apps), drawn with per-pixel alpha so her glow shows over the
// page.
// The button at the right of the screen while a full screen video hides her: it shows when the mouse moves, like a player's
// own buttons, and never takes the focus from the video.
internal sealed class HerTab : Form
{
	readonly CapriInternalBrowser mod;
	readonly Bitmap face;
	readonly System.Windows.Forms.Timer tick = new System.Windows.Forms.Timer { Interval = 30 };
	Point seen = Cursor.Position;
	DateTime moved = DateTime.UtcNow;
	float grown;
	bool over;

	public HerTab(CapriInternalBrowser owner)
	{
		mod = owner;
		face = mod.HoloFace();
		FormBorderStyle = FormBorderStyle.None;
		ShowInTaskbar = false;
		StartPosition = FormStartPosition.Manual;
		Size = new Size(58, 74);
		Opacity = 0;
		DoubleBuffered = true;
		Cursor = Cursors.Hand;
		new ToolTip().SetToolTip(this, "Bring Capri back, or hide her again");
		MouseEnter += delegate { over = true; };
		MouseLeave += delegate { over = false; };
		MouseClick += delegate { mod.ShowHer(mod.HerHidden); CapriInternalBrowser.Browser.ToTop(Handle); Invalidate(); };
		tick.Tick += delegate
		{
			if (Cursor.Position != seen) { seen = Cursor.Position; moved = DateTime.UtcNow; }
			double want = over ? 1 : (DateTime.UtcNow - moved).TotalSeconds < 2.5 ? .8 : 0;
			if (Math.Abs(Opacity - want) > .01) Opacity = Math.Abs(Opacity - want) < .06 ? want : Opacity + (want - Opacity) * .2;
			float to = over ? 1 : 0;
			if (Math.Abs(grown - to) > .01f) { grown += (to - grown) * .3f; Invalidate(); }
		};
		tick.Start();
	}

	internal void Put(Form window)
	{
		Rectangle screen = Screen.FromControl(window).Bounds;
		Location = new Point(screen.Right - Width, screen.Top + (screen.Height - Height) / 2);
		using (var p = new GraphicsPath()) { p.AddPolygon(Edge()); Region = new Region(p); }
	}

	PointF[] Edge() { return new[] { new PointF(12, 0), new PointF(Width, 0), new PointF(Width, Height), new PointF(12, Height), new PointF(0, Height - 12), new PointF(0, 12) }; }

	protected override bool ShowWithoutActivation { get { return true; } }
	protected override CreateParams CreateParams { get { CreateParams p = base.CreateParams; p.ExStyle |= 0x08000088; return p; } }
	protected override void OnFormClosed(FormClosedEventArgs e) { tick.Dispose(); base.OnFormClosed(e); }

	protected override void OnPaint(PaintEventArgs e)
	{
		CapriInternalBrowser.Look look = mod.look;
		Graphics g = e.Graphics;
		g.SmoothingMode = SmoothingMode.AntiAlias;
		g.Clear(look.Shade(1));
		if (face != null)
		{
			float tall = 46 + 4 * grown, wide = tall * face.Width / face.Height;
			g.InterpolationMode = InterpolationMode.HighQualityBicubic;
			g.DrawImage(face, 34 - wide / 2, (Height - tall) / 2, wide, tall);
		}
		using (var line = new Pen(look.Shade(5), 2.5f)) g.DrawPolygon(line, Edge());
		// Which way she'll go: in, or out.
		float x = mod.HerHidden ? 10 - 2 * grown : 6 + 2 * grown, d = mod.HerHidden ? -4 : 4, y = Height / 2f;
		using (var arrow = new Pen(look.Shade(4), 2.5f)) g.DrawLines(arrow, new[] { new PointF(x - d / 2, y - 5), new PointF(x + d / 2, y), new PointF(x - d / 2, y + 5) });
	}
}

internal sealed class HoloScreen : Form
{
	[StructLayout(LayoutKind.Sequential)] private struct Spot { public int X, Y; }
	[StructLayout(LayoutKind.Sequential)] private struct Span { public int W, H; }
	[StructLayout(LayoutKind.Sequential, Pack = 1)] private struct Blend { public byte Op, Flags, Alpha, Format; }
	[StructLayout(LayoutKind.Sequential)]
	struct Info { public int Size, Width, Height; public short Planes, Bits; public int Compression, ImageSize, XRes, YRes, Used, Important, Colors; }
	[DllImport("user32.dll")] private static extern IntPtr GetDC(IntPtr hwnd);
	[DllImport("user32.dll")] private static extern int ReleaseDC(IntPtr hwnd, IntPtr dc);
	[DllImport("gdi32.dll")] private static extern IntPtr CreateCompatibleDC(IntPtr dc);
	[DllImport("gdi32.dll")] private static extern bool DeleteDC(IntPtr dc);
	[DllImport("gdi32.dll")] private static extern IntPtr CreateDIBSection(IntPtr dc, ref Info info, uint usage, out IntPtr bits, IntPtr section, uint offset);
	[DllImport("gdi32.dll")] private static extern IntPtr SelectObject(IntPtr dc, IntPtr obj);
	[DllImport("gdi32.dll")] private static extern bool DeleteObject(IntPtr obj);
	[DllImport("user32.dll")] private static extern bool UpdateLayeredWindow(IntPtr hwnd, IntPtr dst, ref Spot at, ref Span size, IntPtr src, ref Spot from, int key, ref Blend blend, int flags);

	internal Graphics Canvas;
	IntPtr screenDc, memDc, dib, old;
	Bitmap canvas;
	readonly Size area;

	internal HoloScreen(Size size)
	{
		area = size;
		FormBorderStyle = FormBorderStyle.None;
		ShowInTaskbar = false;
		StartPosition = FormStartPosition.Manual;
		Size = size;
		Text = "Capri hologram";
	}

	protected override CreateParams CreateParams
	{
		get
		{
			CreateParams cp = base.CreateParams;
			// layered, clicks pass through, no taskbar or alt-tab entry, never takes focus
			cp.ExStyle |= 0x80000 | 0x20 | 0x80 | 0x8000000;
			return cp;
		}
	}

	protected override bool ShowWithoutActivation { get { return true; } }

	internal void Begin(Form owner)
	{
		var info = new Info { Size = 40, Width = area.Width, Height = -area.Height, Planes = 1, Bits = 32 };
		screenDc = GetDC(IntPtr.Zero);
		memDc = CreateCompatibleDC(screenDc);
		IntPtr bits;
		dib = CreateDIBSection(memDc, ref info, 0, out bits, IntPtr.Zero, 0);
		old = SelectObject(memDc, dib);
		canvas = new Bitmap(area.Width, area.Height, area.Width * 4, PixelFormat.Format32bppPArgb, bits);
		Canvas = Graphics.FromImage(canvas);
		Owner = owner;
		Show(owner);
	}

	internal void Flip(Point at)
	{
		Canvas.Flush(FlushIntention.Sync);
		Spot to = new Spot { X = at.X, Y = at.Y }, from = new Spot();
		var size = new Span { W = area.Width, H = area.Height };
		var blend = new Blend { Op = 0, Flags = 0, Alpha = 255, Format = 1 };
		UpdateLayeredWindow(Handle, screenDc, ref to, ref size, memDc, ref from, 0, ref blend, 2);
	}

	protected override void Dispose(bool disposing)
	{
		if (Canvas != null) { Canvas.Dispose(); Canvas = null; }
		if (canvas != null) { canvas.Dispose(); canvas = null; }
		if (memDc != IntPtr.Zero) { SelectObject(memDc, old); DeleteObject(dib); DeleteDC(memDc); memDc = IntPtr.Zero; }
		if (screenDc != IntPtr.Zero) { ReleaseDC(IntPtr.Zero, screenDc); screenDc = IntPtr.Zero; }
		base.Dispose(disposing);
	}
}

// Windows' own way to put the Windows Hello box over a desktop window.
[ComImport, Guid("39E050C3-4E74-441A-8DC0-B81104DF949C"), InterfaceType(ComInterfaceType.InterfaceIsIInspectable)]
interface IHello { [return: MarshalAs(UnmanagedType.IInspectable)] object Ask(IntPtr window, [MarshalAs(UnmanagedType.HString)] string why, [In] ref Guid kind); }

internal static class Short {
	// Web text without the markers that fence it off from instructions.
	internal static string Unmarked(this string text) { return text.Replace("<<<", "").Replace(">>>", ""); }
	internal static bool Begins(this string text, string with) { return text.StartsWith(with, StringComparison.Ordinal); } }
