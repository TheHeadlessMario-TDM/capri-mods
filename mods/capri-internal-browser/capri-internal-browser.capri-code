		void TintSide(Look look)
		{
			side.BackColor = look.Shade(0);
			foreach (KeyValuePair<Button, Bitmap> logo in logos) logo.Key.Image = Reddened(logo.Value);
			notes.BackColor = look.Shade(1);
			noteText.ForeColor = look.Shade(2);
			noteText.BackColor = look.Shade(0);
			if (notePaper != null) notePaper.BackColor = look.Shade(0);
			foreach (Label l in noteBits) l.ForeColor = look.Shade(3);
			noteTint();
			foreach (Label l in labels) l.ForeColor = "title".Equals(l.Tag) ? look.Shade(5) : look.Shade(3);
			foreach (Button b in sideButtons)
			{
				b.BackColor = Color.Transparent;
				b.ForeColor = b.Parent == side ? look.Shade(5) : look.Shade(3);
				b.FlatAppearance.MouseOverBackColor = Mix(look.Shade(0), look.Shade(5), .35f);
				b.FlatAppearance.MouseDownBackColor = look.Shade(5);
			}
			GameLook();
			side.Invalidate(true);
		}

		readonly HashSet<Control> hot = new HashSet<Control>();

		static GraphicsPath Clipped(RectangleF b, bool left)
		{
			var p = new GraphicsPath();
			float c = 5;
			p.AddPolygon(left
				? new[] { new PointF(b.Left, b.Top), new PointF(b.Right, b.Top), new PointF(b.Right, b.Bottom), new PointF(b.Left + c, b.Bottom), new PointF(b.Left, b.Bottom - c) }
				: new[] { new PointF(b.Left, b.Top), new PointF(b.Right, b.Top), new PointF(b.Right, b.Bottom - c), new PointF(b.Right - c, b.Bottom), new PointF(b.Left, b.Bottom) });
			return p;
		}

		void Watch(Control c)
		{
			c.MouseEnter += delegate { hot.Add(c); c.Invalidate(); };
			c.MouseLeave += delegate { hot.Remove(c); c.Invalidate(); };
			c.MouseMove += delegate { c.Invalidate(); };
		}

		// ---- settings as a tab of its own: a section list on the left, the settings on a framed card, her backdrop behind ----

		internal bool Full { get { return full; } }

		// ---- menus ----

		// When a menu last closed, so pressing its button again closes it instead of opening it again.
		DateTime menuShut;
		bool JustShut { get { return (DateTime.Now - menuShut).TotalMilliseconds < 300; } }

		ContextMenuStrip NewMenu()
		{
			Look look = mod.look;
			var m = new ContextMenuStrip { Renderer = new ToolStripProfessionalRenderer(new MenuColors(look)) { RoundedEdges = false }, ShowImageMargin = false, Font = new Font(Ui, 10.5f), BackColor = look.Shade(1), ForeColor = look.Shade(2) };
			var watch = new WinTimer { Interval = 60 };
			watch.Tick += delegate
			{
				if (!m.Visible) return;
				bool clickedOff = Control.MouseButtons != MouseButtons.None && !m.Bounds.Contains(Cursor.Position);
				if (clickedOff || Form.ActiveForm != FindForm()) m.Close();
			};
			m.Opened += delegate { watch.Start(); Blip("menu"); };
			FadeIn(m);
			m.Closed += delegate { watch.Stop(); menuShut = DateTime.Now; Later(delegate { watch.Dispose(); m.Dispose(); }); };
			return m;
		}

		void Item(ToolStripItemCollection into, string text, string keys, bool on, Action run)
		{
			var item = new ToolStripMenuItem(text) { ShortcutKeyDisplayString = keys, Enabled = on, ForeColor = mod.look.Shade(on ? 2 : 3) };
			item.Click += delegate { Later(run); };
			into.Add(item);
		}

		internal ContextMenuStrip PageMenu()
		{
			ContextMenuStrip m = NewMenu();
			ToolStripItemCollection i = m.Items;
			Tab t = tab;
			bool site = t != null && !t.OnReader && t.Address != null, modern = site && t.Viewer.Modern;
			Item(i, T(0), "Ctrl+T", true, NewTab);
			Item(i, T(47), "Ctrl+Shift+N", true, NewPrivate);
			Item(i, T(48), "Ctrl+Shift+T", closed.Count > 0, ReopenClosed);
			i.Add(RecentlyClosed());
			i.Add(new ToolStripSeparator());
			Item(i, T(49), "Ctrl+H", true, ShowHistory);
			Item(i, "Useful information", "", true, ShowWelcome);
			Item(i, "Screenshot to notes", "", t != null && !t.OnReader, delegate { ShotToNotes(t); });
			Item(i, Flag("darkweb", false) ? "Dark mode for sites: on" : "Dark mode for sites: off", "", modern, delegate { SetDarkWeb(!Flag("darkweb", false)); });
			Item(i, "Pop video out", "", t != null && t.Viewer.Modern, delegate { Behind(delegate { mod.PopOut(); }); });
			Item(i, T(43), "Ctrl+J", t != null && t.Viewer.Modern, delegate { t.Viewer.Downloads(); });
			i.Add(new ToolStripSeparator());
			Item(i, T(50) + "  +", "Ctrl+Plus", modern, delegate { t.Viewer.Zoom(1); });
			Item(i, T(50) + "  \u2212", "Ctrl+Minus", modern, delegate { t.Viewer.Zoom(-1); });
			Item(i, T(50) + "  100%", "Ctrl+0", modern, delegate { t.Viewer.Zoom(0); });
			Item(i, T(51), "Ctrl+P", modern, delegate { t.Viewer.Print(); });
			Item(i, T(52), null, modern, delegate { Screenshot(t); });
			Item(i, T(53), null, site, delegate { Translate(t); });
			Item(i, t != null && t.Muted ? T(55) : T(54), "Ctrl+M", t != null && t.Viewer.Modern, delegate { Mute(t); });
			Item(i, T(56), "F11", true, delegate { byKey = !full; SetFullScreen(!full); });
			i.Add(new ToolStripSeparator());
			Item(i, T(57), "Ctrl+Shift+A", t != null && !t.Private && !(t.OnReader && t.Page == null), StartAsking);
			Item(i, T(31), "Ctrl+Shift+S", t != null && !t.Private, Summarise);
			i.Add(new ToolStripSeparator());
			Item(i, T(7), null, true, delegate { SettingsShown = true; });
			Item(i, "Restart", null, true, delegate { Later(delegate { Restart(null); }); });
			return m;
		}

		// Closes Capri Browser and opens it again with the same websites. Private tabs are never kept, so it asks first.
		internal void Restart(Action between)
		{
			if (tabs.Exists(t => t.Private && t.Page == null && !t.OnReader) && MessageBox.Show(FindForm(), "Private tabs aren't kept, so they'll close. Restart anyway?", "Capri Browser", MessageBoxButtons.YesNo, MessageBoxIcon.Question) != DialogResult.Yes) return;
			Remember();
			mod.Restart(FindForm(), tab == null || tab.Private ? null : tab.Address, between);
		}

		internal ContextMenuStrip TabMenu(Tab t)
		{
			ContextMenuStrip m = NewMenu();
			ToolStripItemCollection i = m.Items;
			Item(i, T(0), "Ctrl+T", true, NewTab);
			i.Add(new ToolStripSeparator());
			Item(i, T(58), "F5", true, delegate { if (t.OnReader) ShowReader(t); else t.Viewer.Reload(); });
			Item(i, T(59), null, true, delegate { OpenTab(null, t.OnReader ? null : t.Address, true, t.Private); });
			Item(i, t.Muted ? T(55) : T(54), "Ctrl+M", t.Viewer.Modern, delegate { Mute(t); });
			Item(i, "Add to bookmarks", "Ctrl+D", !t.OnReader && t.Address != null, delegate { AddToDial(t.Address); });
			Item(i, "Copy link address", null, !t.OnReader && t.Address != null, delegate { try { Clipboard.SetText(t.Address); } catch { } });
			i.Add(new ToolStripSeparator());
			if (Split && (t == splitA || t == splitB)) Item(i, "Close split screen", null, true, Unsplit);
			else Item(i, t == tab ? "Split screen" : "Split screen with this tab", null, !t.Hidden && !full, delegate { SplitWith(t); });
			Item(i, "Snooze this tab", null, t != tab && !t.Asleep && !t.OnReader && t.Viewer.Modern, delegate { if (t.Viewer.Sleep()) { t.Asleep = true; Retitle(t, t.Title); } });
			i.Add(new ToolStripSeparator());
			Item(i, T(63), "Ctrl+W", true, delegate { Close(t); });
			Item(i, T(60), null, tabs.Count > 1, delegate { foreach (Tab other in tabs.ToArray()) if (other != t) Close(other); Select(t); });
			Item(i, T(61), null, tabs.IndexOf(t) < tabs.Count - 1, delegate { int at = tabs.IndexOf(t); while (at >= 0 && tabs.Count > at + 1) Close(tabs[tabs.Count - 1]); });
			i.Add(new ToolStripSeparator());
			Item(i, T(48), "Ctrl+Shift+T", closed.Count > 0, ReopenClosed);
			i.Add(RecentlyClosed());
			return m;
		}

		void NewPrivate()
		{
			OpenTab(null, null, true, true);
			address.Focus();
		}

		internal void Mute(Tab t)
		{
			if (t == null || !t.Viewer.Modern) return;
			t.Viewer.Muted = !t.Viewer.Muted;
			t.Muted = t.Viewer.Muted;
			Retitle(t, t.Title);
		}

		internal void Translate(Tab t)
		{
			if (t == null || t.OnReader || t.Address == null) return;
			string hl = Lang == "zh-hans" ? "zh-CN" : Lang == "zh-hant" ? "zh-TW" : Lang == "fil" ? "tl" : Lang;
			Go(t, "https://translate.google.com/translate?sl=auto&tl=" + hl + "&u=" + Uri.EscapeDataString(t.Address));
		}

		Action<string, Image> snapNote;
