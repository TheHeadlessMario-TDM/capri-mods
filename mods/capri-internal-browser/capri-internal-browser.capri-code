		readonly string startProfile;
		readonly bool startPrivate;
		// One Edge environment per profile folder, with extensions on, shared by every tab.
		static readonly Dictionary<string, Task> Environments = new Dictionary<string, Task>();

		void StartEdge(Type type)
		{
			SynchronizationContext ui = SynchronizationContext.Current;
			Task made = null;
			try
			{
				if (ui == null) throw new InvalidOperationException("no UI context");
				lock (Environments)
					if (!Environments.TryGetValue(startProfile, out made))
					{
						Type kind = videoCore.GetType("Microsoft.Web.WebView2.Core.CoreWebView2EnvironmentOptions", true);
						ConstructorInfo make = kind.GetConstructors()[0];
						ParameterInfo[] ps = make.GetParameters();
						object[] values = new object[ps.Length];
						for (int i = 0; i < ps.Length; i++) values[i] = ps[i].HasDefaultValue ? ps[i].DefaultValue : null;
						object options = make.Invoke(values);
						Set(options, "AreBrowserExtensionsEnabled", true);
						Type env = videoCore.GetType("Microsoft.Web.WebView2.Core.CoreWebView2Environment", true);
						MethodInfo create = env.GetMethod("CreateAsync", new[] { typeof(string), typeof(string), kind });
						made = (Task)create.Invoke(null, new object[] { null, startProfile, options });
						Environments[startProfile] = made;
					}
			}
			catch (Exception) { made = null; }
			if (made == null) { StartOldWay(type); return; }
			made.ContinueWith(done =>
			{
				try
				{
					if (done.IsFaulted || view.IsDisposed) throw new InvalidOperationException("no environment");
					object environment = done.GetType().GetProperty("Result").GetValue(done, null);
					object controller = environment.GetType().GetMethod("CreateCoreWebView2ControllerOptions").Invoke(environment, null);
					if (startPrivate) Set(controller, "IsInPrivateModeEnabled", true);
					MethodInfo ensure = null;
					foreach (MethodInfo method in type.GetMethods())
						if (method.Name == "EnsureCoreWebView2Async" && method.GetParameters().Length == 2 && method.GetParameters()[1].ParameterType.Name == "CoreWebView2ControllerOptions") ensure = method;
					if (ensure == null) throw new InvalidOperationException("no controller options");
					ensure.Invoke(view, new[] { environment, controller });
				}
				catch (Exception)
				{
					lock (Environments) if (done.IsFaulted) Environments.Remove(startProfile);
					if (!view.IsDisposed) StartOldWay(type);
				}
			}, TaskScheduler.FromCurrentSynchronizationContext());
		}

		// As before: the control makes its own environment (extensions stay off).
		void StartOldWay(Type type)
		{
			try
			{
				object properties = Activator.CreateInstance(videoForms.GetType("Microsoft.Web.WebView2.WinForms.CoreWebView2CreationProperties", true));
				Set(properties, "UserDataFolder", startProfile);
				if (startPrivate) Set(properties, "IsInPrivateModeEnabled", true);
				Set(view, "CreationProperties", properties);
			}
			catch { }
			MethodInfo ensure = null;
			foreach (MethodInfo method in type.GetMethods()) if (method.Name == "EnsureCoreWebView2Async" && (ensure == null || method.GetParameters().Length < ensure.GetParameters().Length)) ensure = method;
			ensure.Invoke(view, new object[ensure.GetParameters().Length]);
		}

