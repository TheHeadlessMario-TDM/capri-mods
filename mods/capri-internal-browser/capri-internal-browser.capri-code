			case "split": case "unsplit": case "snooze":
				return InBrowser(now => now.TabsSaid(verb));
			case "watch":
				if (!WatchHeard("watch this page" + (rest.Length > 0 ? " and tell me when " + Regex.Replace(rest, @"^(?:when|if)\s+", "", Plain) : ""))) return "Open the page first.";
				return ToldThem;
			case "watchnews":
				List<string[]> watching;
				lock (gate) watching = Watches();
				List<string[]> named = rest.Length > 0 && watching.Count > 0 ? WatchesNamed(rest, watching) : null;
				if (named != null) WatchNow(named); else WatchHeard("any new changes on my page");
				return ToldThem;
			case "worknote":
				Study("solve", SolvePick("work out my " + rest + " notes"), "work out my " + rest + " notes");
				return ToldThem;
			case "factcheck": case "best": case "comparetabs":
				if (rest.Length == 0 && verb != "comparetabs") return "Say what.";
				Study(verb == "factcheck" ? "fact" : verb == "best" ? "best" : "compare", rest, rest.Length > 0 ? rest : "compare my tabs");
				return ToldThem;
			case "fill":
				FillHeard("fill in this form with " + rest);
				return ToldThem;
			case "discordmsg":
				int bar = rest.IndexOf('|');
