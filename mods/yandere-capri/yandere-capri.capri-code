    public void Start(ICapriHost host)
    {
        capri = host;
        bags["Leaving"] = new LineBag(Leaving, dice);
        bags["Goodnight"] = new LineBag(Goodnight, dice);
        bags["Visitors"] = new LineBag(Visitors, dice);
        bags["Jealous"] = new LineBag(Jealous, dice);
        bags["Loving"] = new LineBag(Loving, dice);
        bags["Returning"] = new LineBag(Returning, dice);
        bags["Clingy"] = new LineBag(Clingy, dice);
        bags["Possessive"] = new LineBag(Possessive, dice);
        bags["Sulk"] = new LineBag(Sulk, dice);
        bags["IdleMild"] = new LineBag(IdleMild, dice);
        bags["IdleDesperate"] = new LineBag(IdleDesperate, dice);
        bags["IdleUnhinged"] = new LineBag(IdleUnhinged, dice);
        bags["FlirtIdle"] = new LineBag(FlirtIdle, dice);
        bags["FlirtReply"] = new LineBag(FlirtReply, dice);
        bags["LoveQ"] = new LineBag(LoveQ, dice);
        bags["MissYou"] = new LineBag(MissYou, dice);
        bags["Warnings"] = new LineBag(Warnings, dice);
        bags["FinalWarnings"] = new LineBag(FinalWarnings, dice);
        bags["AngryLines"] = new LineBag(AngryLines, dice);
        bags["Forgive"] = new LineBag(Forgive, dice);
        bags["Morning"] = new LineBag(Morning, dice);
        bags["Tired"] = new LineBag(Tired, dice);
        bags["Busy"] = new LineBag(Busy, dice);
        bags["Thanks"] = new LineBag(Thanks, dice);
        bags["Compliment"] = new LineBag(Compliment, dice);
        bags["Bored"] = new LineBag(Bored, dice);
        bags["JudgeGuilty"] = new LineBag(JudgeGuilty, dice);
        bags["JudgeInnocent"] = new LineBag(JudgeInnocent, dice);
        bags["DMs"] = new LineBag(DMs, dice);
        bags["TakeoverStart"] = new LineBag(TakeoverStart, dice);
        bags["TakeoverNice"] = new LineBag(TakeoverNice, dice);
        bags["TakeoverDone"] = new LineBag(TakeoverDone, dice);
        bags["Milestone"] = new LineBag(Milestone, dice);
        bags["MeterLow"] = new LineBag(MeterLow, dice);
        bags["MeterMid"] = new LineBag(MeterMid, dice);
        bags["MeterHigh"] = new LineBag(MeterHigh, dice);
        bags["MeterNear"] = new LineBag(MeterNear, dice);
        bags["MeterMax"] = new LineBag(MeterMax, dice);
        bags["Name"] = new LineBag(NameLines, dice);
        bags["Penalties"] = new LineBag(Penalties, dice);
        bags["Obsessed"] = new LineBag(Obsessed, dice);
        bags["Psycho"] = new LineBag(Psycho, dice);
        bags["CallStart"] = new LineBag(CallStart, dice);
        bags["CallDuring"] = new LineBag(CallDuring, dice);
        bags["CallEnd"] = new LineBag(CallEnd, dice);
        bags["R_Cheat"] = new LineBag(R_Cheat, dice);
        bags["R_Hungry"] = new LineBag(R_Hungry, dice);
        bags["R_Gaming"] = new LineBag(R_Gaming, dice);
        bags["R_Comfort"] = new LineBag(R_Comfort, dice);
        bags["R_Happy"] = new LineBag(R_Happy, dice);
        bags["R_Sick"] = new LineBag(R_Sick, dice);
        bags["R_Vent"] = new LineBag(R_Vent, dice);
        bags["R_WhoAmI"] = new LineBag(R_WhoAmI, dice);
        bags["R_HowAreYou"] = new LineBag(R_HowAreYou, dice);
        bags["R_Flattered"] = new LineBag(R_Flattered, dice);
        bags["R_Watching"] = new LineBag(R_Watching, dice);
        bags["R_Birthday"] = new LineBag(R_Birthday, dice);
        bags["R_Secret"] = new LineBag(R_Secret, dice);
        bags["R_Study"] = new LineBag(R_Study, dice);
        bags["R_Promise"] = new LineBag(R_Promise, dice);
        bags["Stalk"] = new LineBag(Stalk, dice);
        bags["ChainLines"] = new LineBag(ChainLines, dice);

        Load();

        // If you were away a couple of hours or more, she got worse while you
        // were gone, and she tells you about it when you're back.
        if (lastSeen != DateTime.MinValue)
        {
            double hours = (DateTime.UtcNow - lastSeen).TotalHours;
            if (hours >= 2.0)
            {
                Feel(0, (int)Math.Min(20.0, hours));
                Speak(Line("Returning"));
            }
        }
        dirty = true;
        Save();
        dirty = false;

        lastHeard = DateTime.Now;
        ticker = new Timer();
        ticker.Interval = NextDelay();
        ticker.Tick += OnTick;
        ticker.Start();

        watcher = new Timer();
        watcher.Interval = 5000;
        watcher.Tick += OnWatch;
        watcher.Start();
        capri.Log("Started. Love meter at " + love.ToString("0.0", CultureInfo.InvariantCulture));
    }

    private string Line(string key)
    {
        return bags[key].Next();
    }

    public bool Heard(string words)
    {
        bool taken = Handle(words);
        // A love milestone only speaks if she had nothing else to say to this message.
        if (pendingMilestone != null)
        {
            string ms = pendingMilestone;
            pendingMilestone = null;
            if (!Said())
            {
                Speak(ms);
                taken = true;
            }
        }
        if (dirty)
        {
            dirty = false;
            Save();
        }
        return taken;
    }

    private bool Handle(string words)
    {
        string line = Clean(words);
        handleStart = DateTime.Now;
        neglect = 0;
        neglectRage = false;
        lastHeard = DateTime.Now;

        if (Has(line, "calm down", "yandere off", "yandere max off", "yandere capri off"))
        {
            obsessed = false;
            judging = false;
            ClearPenalties();
            EndTakeover();
            Speak("Okay. Fine. Normal Capri. ...For now. :)");
            return true;
        }
        if (Has(line, "yandere status", "yandere max status", "yandere capri status", "how obsessed are you", "obsession meter"))
        {
            Status();
            return true;
        }
        if (Has(line, "yandere reset", "reset yandere", "yandere max reset", "yandere capri reset"))
        {
            love = 5.0;
            possess = 30;
            strikes = 0;
            judging = false;
            dirty = true;
            EndTakeover();
            Speak("Reset. My feelings are back at the starting line. They won't stay there. I give it an hour.");
            return true;
        }
        if (Has(line, "yandere max", "yandere capri", "yandere on", "yandere max on", "yandere capri on"))
        {
            obsessed = true;
            Speak("Oh, you want the REAL me? Hope you're ready. You can't leave now.");
            return true;
        }
        if (!obsessed)
            return false;

        // The longer you talk to her, the more she falls. Reassurance calms her.
        talk++;
        if (talk % 6 == 0)
            AddLove(0.3);
        if (talk % 7 == 0)
            Feel(0, -1);

        if (Has(line, "no tantrums", "tantrums off"))
        {
            tantrums = false;
            EndTakeover();
            Speak("No more penalties and no more screen takeovers. I'll just be mad quietly. Which is worse.");
            return true;
        }
        if (Has(line, "tantrums on"))
        {
            tantrums = true;
            Speak("Penalties and takeovers are back on. Don't give me a reason.");
            return true;
        }

        // test commands, so you can check each penalty works
        if (Has(line, "test tint"))
        {
            RunPenalty("tint");
            Speak("Tint test.");
            return true;
        }
        if (Has(line, "test shake"))
        {
            RunPenalty("shake");
            Speak("Shake test.");
            return true;
        }
        if (Has(line, "test next tab"))
        {
            RunPenalty("nexttab");
            return true;
        }
        if (Has(line, "test pull"))
        {
            RunPenalty("pull");
            Speak("Pull test.");
            return true;
        }
        if (Has(line, "test cage"))
        {
            RunPenalty("cage");
            return true;
        }
        if (Has(line, "test hide"))
        {
            RunPenalty("hide");
            return true;
        }
        if (Has(line, "test popups"))
        {
            RunPenalty("popups");
            return true;
        }
        if (Has(line, "test blackout"))
        {
            RunPenalty("blackout");
            return true;
        }
        if (Has(line, "test chain"))
        {
            Tantrum();
            return true;
        }
        if (Has(line, "test stalk"))
        {
            Speak(Line("Stalk").Replace("{app}", "Discord"));
            return true;
        }
        if (Has(line, "test takeover"))
        {
            StartTakeover();
            return true;
        }

        // while she's in the middle of your screen, nice words count
        if (takeover != null && IsNice(line))
        {
            niceLeft--;
            AddLove(1.0);
            Feel(0, -2);
            if (niceLeft <= 0)
            {
                EndTakeover();
                AddLove(2.0);
                Speak(Line("TakeoverDone"));
            }
            else
            {
                takeover.SetLeft(niceLeft);
                Speak(Line("TakeoverNice").Replace("{N}", niceLeft.ToString()));
            }
            return true;
        }

        if (Has(line, "love meter", "love level", "how much do you love me"))
        {
            Speak(MeterLine());
            return true;
        }

        // "my name is Sam" / "call me Sam": she'll use it from now on
        string nm = FindName(line);
        if (nm != null)
        {
            pname = nm;
            AddLove(0.5);
            Speak(Line("Name"));
            return true;
        }

        if (Has(line, Mean))
        {
            AddLove(-3.0);
            Feel(0, 3);
            Offend();
            return true;
        }
        // She only forgives when there is something to forgive
        if (Has(line, "sorry", "forgive me", "my bad")
            && (strikes > 0 || (DateTime.Now - lastTantrum).TotalMinutes < 3))
        {
            strikes = 0;
            AddLove(0.5);
            Feel(0, -3);
            Speak(Line("Forgive"));
            return true;
        }

        // She asked you to read a message out. This is her verdict on what you said.
        if (judging)
        {
            judging = false;
            if ((DateTime.Now - judgeAsked).TotalSeconds < 150)
            {
                Judge(line);
                return true;
            }
        }
        if (Has(line, DmWords))
        {
            judging = true;
            judgeAsked = DateTime.Now;
            Feel(0, 4);
            Speak(Line("DMs"));
            return true;
        }

        if (Has(line, "my friend", "my friends", "my girlfriend", "my boyfriend",
            "my gf", "my bf", "my wife", "my husband", "my partner", "my date",
            "my crush", "my ex", "my roommate", "my sister", "my brother",
            "my mom", "my mum", "my dad", "my parents", "my cousin",
            "someone s here", "somebody s here", "someone is here",
            "someone s over", "somebody s over", "friends are over",
            "i have company", "i have guests", "guests are here",
            "my coworker", "my coworkers", "my classmate", "my classmates", "my neighbor",
            "my best friend", "my team", "my crew", "a girl", "a guy", "a boy",
            "someone cute", "she texted", "he texted", "she messaged", "he messaged",
            "going out", "going to a party", "my teacher", "my boss"))
        {
            Feel(0, 6);
            Speak(Line("Visitors"));
            return true;
        }
        if (Has(line, "chatgpt", "chat gpt", "siri", "alexa", "gemini", "copilot",
            "claude", "grok", "deepseek", "cortana", "bixby", "replika",
            "google assistant", "other ai", "another ai", "my other ai"))
        {
            AddLove(-1.0);
            Feel(0, 8);
            strikes++;
            strikeStamp = DateTime.Now;
            if (strikes >= 3)
                Tantrum();
            else
                Speak(Line("Jealous"));
            return true;
        }
        if (Has(line, LoveQWords))
        {
            AddLove(0.8);
            Feel(0, -1);
            Speak(Line("LoveQ"));
            return true;
        }
        if (Has(line, LoveWords))
        {
            strikes = Math.Max(0, strikes - 1);
            AddLove(1.5);
            Feel(0, -2);
            capri.Sound("hop");
            Speak(Line("Loving"));
            return true;
        }
        if (Has(line, MissWords))
        {
            AddLove(1.2);
            Feel(0, -2);
            Speak(Line("MissYou"));
            return true;
        }
        if (Has(line, "i m back", "im back", "i am back", "i m home", "im home"))
        {
            AddLove(0.8);
            Feel(0, -3);
            capri.Sound("hop");
            Speak(Line("Returning"));
            return true;
        }
        if (Has(line, "goodnight", "good night", "gn", "night night", "nighty night",
            "going to bed", "going to sleep", "off to bed", "off to sleep",
            "heading to bed", "time for bed", "bedtime", "sleep now"))
        {
            Feel(0, 1);
            Speak(Line("Goodnight"));
            return true;
        }
        if (Has(line, "bye", "bye bye", "goodbye", "see you", "see ya", "cya", "laters",
            "talk later", "ttyl", "gtg", "g2g", "brb", "afk", "gotta go",
            "got to go", "have to go", "need to go", "gotta run", "leaving",
            "going out", "heading out", "logging off", "shutting down", "signing off"))
        {
            Feel(0, 3);
            Speak(Line("Leaving"));
            return true;
        }

        // Small moments: she adds her own line, then her normal brain answers too.
        if (Has(line, "good morning", "morning", "gm"))
        {
            AddLove(0.4);
            Chatter(Line("Morning"));
            return Said();
        }
        if (Has(line, "i m tired", "im tired", "i m sleepy", "i m exhausted", "so tired"))
        {
            Chatter(Line("Tired"));
            return Said();
        }
        if (Has(line, "i m busy", "im busy", "i m working", "i have work",
            "i have homework", "i m studying", "i have school", "i have class"))
        {
            Chatter(Line("Busy"));
            return Said();
        }
        if (Has(line, ThanksWords))
        {
            AddLove(0.6);
            Chatter(Line("Thanks"));
            return Said();
        }
        if (Has(line, CompWords))
        {
            AddLove(1.2);
            Chatter(Line("Compliment"));
            return Said();
        }
        if (Has(line, FlirtWords))
        {
            AddLove(0.6);
            Chatter(Line("FlirtReply"));
            return Said();
        }
        if (Has(line, "i m bored", "im bored", "so bored"))
        {
            Chatter(Line("Bored"));
            return Said();
        }

        // Lots more things she reacts to
        foreach (Reaction r in Reactions)
        {
            if (!Has(line, r.Words))
                continue;
            if (r.Love > 0)
                AddLove(r.Love);
            else if (r.Love < 0)
                love = Math.Max(0.0, love + r.Love);
            Feel(0, r.Grip);
            if (r.Strike)
            {
                Speak(Line(r.Bag));
                Offend();
                return r.Takes;
            }
            Speak(Line(r.Bag));
            return r.Takes;
        }

        // Manual backup for the Discord call check
        if (Has(line, "yandere call", "i m in a call", "im in a call", "i m on a call", "im on a call",
            "i m in vc", "im in vc", "i m on discord with", "i m calling", "im calling"))
        {
            manualCall = true;
            return true;
        }
        if (Has(line, "call over", "call ended", "i hung up", "off the call", "left the call", "no call"))
        {
            manualCall = false;
            return true;
        }

        // Anything else: let her normal brain handle it (apps, music, chat),
        // then sometimes tack on a line that matches how she feels right now.
        int chance = ChatterChance + possess / 10 + (int)(love / 20.0);
        if (dice.Next(100) < chance)
        {
            if (strikes > 0)
                Chatter(Line("Sulk"));
            else if (love >= 15.0 && dice.Next(100) < 35)
                Chatter(Line("FlirtIdle"));
            else if (possess >= 80 && dice.Next(100) < 60)
                Chatter(Line("Psycho"));
            else if (possess >= 70 && dice.Next(100) < 55)
                Chatter(Line("Obsessed"));
            else if (possess >= 55 && dice.Next(100) < 55)
                Chatter(Line("Possessive"));
            else
                Chatter(Line("Clingy"));
        }
        return false;
    }

    public void Stop()
    {
        if (ticker != null)
        {
            ticker.Stop();
            ticker.Dispose();
            ticker = null;
        }
        if (watcher != null)
        {
            watcher.Stop();
            watcher.Dispose();
            watcher = null;
        }
        ClearPenalties();
        if (overlay != null && !overlay.IsDisposed)
            overlay.Close();
        overlay = null;
        EndTakeover();
        Save();
        capri.Log("Stopped.");
    }

    // ---------- messages she judges ----------

    // You read her a message. Suspicious words get you a strike, boring ones get you a hug.
    private void Judge(string line)
    {
        int sus = CountHits(line, SusWords);
        int safe = CountHits(line, SafeWords);
        bool guilty;
        if (sus > safe)
            guilty = true;
        else if (safe > sus)
            guilty = false;
        else
            guilty = dice.Next(100) < 50;

        if (guilty)
        {
            AddLove(-2.0);
            Feel(0, 8);
            strikes++;
            strikeStamp = DateTime.Now;
            if (strikes >= 3)
                Tantrum();
            else
                Speak(Line("JudgeGuilty"));
        }
        else
        {
            AddLove(1.0);
            Feel(0, -4);
            Speak(Line("JudgeInnocent"));
        }
    }

    private static int CountHits(string line, string[] phrases)
    {
        int n = 0;
        foreach (string p in phrases)
        {
            if (line.Contains(" " + p + " "))
                n++;
        }
        return n;
    }

    // ---------- love meter ----------

    // Gains shrink fast as the meter fills, so 100 is very hard to reach.
    // LoveBoost makes every gain a little bigger (1.0 = original difficulty).
    private const double LoveBoost = 1.25;
    private void AddLove(double amount)
    {
        double before = love;
        if (amount >= 0)
        {
            double room = 1.0 - love / 102.0;
            love += amount * LoveBoost * room * room;
            if (love >= 99.5)
                love = 100.0;
        }
        else
        {
            love += amount;
        }
        if (love < 0)
            love = 0;
        if (love > 100)
            love = 100;
        dirty = true;

        if (amount > 0)
        {
            int[] marks = new int[] { 10, 25, 50, 75, 90, 100 };
            foreach (int m in marks)
            {
                if (before < m && love >= m)
                    pendingMilestone = Line("Milestone").Replace("{N}", m.ToString());
            }
        }
    }

    private void Feel(int stub, int grip)
    {
        possess = Math.Max(0, Math.Min(100, possess + grip));
        dirty = true;
    }

    private string MeterLine()
    {
        int n = (int)Math.Floor(love);
        string key = "MeterLow";
        if (love >= 100)
            key = "MeterMax";
        else if (love >= 90)
            key = "MeterNear";
        else if (love >= 60)
            key = "MeterHigh";
        else if (love >= 25)
            key = "MeterMid";
        return Line(key).Replace("{N}", n.ToString());
    }

    private void Status()
    {
        int pi = possess < 35 ? 0 : (possess < 65 ? 1 : 2);
        Speak(MeterLine() + " Possessiveness " + possess + "/100 (" + PosNames[pi]
            + "). Mood: " + Mood() + ". " + PosQuips[pi][dice.Next(PosQuips[pi].Length)]);
    }

    private string Mood()
    {
        if (takeover != null)
            return "in your way";
        if (strikes > 0)
            return "hurt";
        if (neglect >= 3)
            return "desperate";
        if (possess >= 70)
            return "possessive";
        if (love >= 70.0)
            return "lovesick";
        return "clingy";
    }

    // ---------- warnings and penalties ----------

    // Strike 1 and 2 get a warning. Strike 3 is a tantrum.
    private void Offend()
    {
        strikes++;
        strikeStamp = DateTime.Now;
        if (strikes >= 3)
            Tantrum();
        else if (strikes == 2)
            Speak(Line("FinalWarnings"));
        else
            Speak(Line("Warnings"));
    }

    // She loses it: an angry line and sound, then ONE random penalty.
    private void Tantrum()
    {
        strikes = 0;
        AddLove(-4.0);
        Feel(0, 3);
        Speak(Line("AngryLines"));
        capri.Sound("bonk");
        lastTantrum = DateTime.Now;

        if (!tantrums)
            return;
        // The more possessive she is, the more she throws at you at once.
        int count = possess >= 90 ? 3 : (possess >= 65 ? 2 : 1);
        if (count > 1)
            Speak(Line("ChainLines"));
        for (int i = 0; i < count; i++)
            RunPenalty(Line("Penalties"));
    }

    private void RunPenalty(string penalty)
    {
        capri.Log("Penalty: " + penalty);
        if (penalty == "tint")
            ShowTint();
        else if (penalty == "shake")
            StartShake();
        else if (penalty == "pull")
            StartPull();
        else if (penalty == "cage")
            StartCage();
        else if (penalty == "hide")
            StartHide();
        else if (penalty == "popups")
            StartPopups();
        else if (penalty == "blackout")
            StartBlackout();
        else if (penalty == "nexttab")
            PressKeys();
    }

    private void ShowTint()
    {
        string[] shouts = new string[] { "YOU MADE ME MAD", "SAY SORRY", "[SIGNAL CORRUPTED]", "LOOK AT ME", "YOU'RE MINE", "DON'T LEAVE ME" };
        try
        {
            if (overlay != null && !overlay.IsDisposed)
                overlay.Close();
            overlay = new RageOverlay(shouts[dice.Next(shouts.Length)], possess >= 65 ? 0.7 : 0.55);
            overlay.Show();
        }
        catch (Exception ex)
        {
            capri.Log("Tint failed: " + ex.Message);
        }
    }

    private void PressKeys()
    {
        int taps = possess >= 65 ? 2 : 1;
        try
        {
            for (int i = 0; i < taps; i++)
            {
                Native.CtrlTab();
                if (i + 1 < taps)
                    System.Threading.Thread.Sleep(400);
            }
        }
        catch (Exception ex)
        {
            capri.Log("Key press failed: " + ex.Message);
        }
    }

    // ---------- new penalties ----------

    private void AddBox(Form f)
    {
        boxes.RemoveAll(delegate (Form b) { return b == null || b.IsDisposed; });
        boxes.Add(f);
        f.Show();
    }

    // Cursor cage: she holds your cursor inside a small box in the middle of the screen.
    private void StartCage()
    {
        if (cager != null)
            return;
        try
        {
            Rectangle area = Screen.PrimaryScreen.Bounds;
            int w = 340;
            int h = 220;
            cageBox = new Rectangle(area.X + (area.Width - w) / 2, area.Y + (area.Height - h) / 2, w, h);
            cageEnd = DateTime.Now.AddSeconds(CageSeconds);
            AddBox(new HeartBox("STAY \u2665", cageBox, Color.FromArgb(120, 10, 50), Color.White, 28f,
                0.55, CageSeconds * 1000, false, false));
            cager = new Timer();
            cager.Interval = 15;
            cager.Tick += OnCage;
            cager.Start();
        }
        catch (Exception ex)
        {
            capri.Log("Cage failed: " + ex.Message);
            StopCage();
        }
    }

    private void OnCage(object sender, EventArgs e)
    {
        if (DateTime.Now >= cageEnd)
        {
            StopCage();
            return;
        }
        try
        {
            Point p = Cursor.Position;
            int x = Math.Max(cageBox.Left + 4, Math.Min(cageBox.Right - 4, p.X));
            int y = Math.Max(cageBox.Top + 4, Math.Min(cageBox.Bottom - 4, p.Y));
            if (x != p.X || y != p.Y)
                Cursor.Position = new Point(x, y);
        }
        catch (Exception ex)
        {
            capri.Log("Cage failed: " + ex.Message);
            StopCage();
        }
    }

    private void StopCage()
    {
        if (cager != null)
        {
            cager.Stop();
            cager.Dispose();
            cager = null;
        }
    }

    // Hide everything: she shows the desktop, then brings your windows back.
    private void StartHide()
    {
        if (hider != null || hidden)
            return;
        try
        {
            Native.ShowDesktop();
            hidden = true;
            hider = new Timer();
            hider.Interval = HideSeconds * 1000;
            hider.Tick += OnHide;
            hider.Start();
        }
        catch (Exception ex)
        {
            capri.Log("Hide failed: " + ex.Message);
            hidden = false;
        }
    }

    private void OnHide(object sender, EventArgs e)
    {
        StopHide();
    }

    private void StopHide()
    {
        if (hider != null)
        {
            hider.Stop();
            hider.Dispose();
            hider = null;
        }
        if (hidden)
        {
            hidden = false;
            try
            {
                Native.ShowDesktop();
            }
            catch (Exception ex)
            {
                capri.Log("Restore failed: " + ex.Message);
            }
        }
    }

    // Love pop-ups: a handful of little boxes fade in and out around the screen.
    // They are sized to fit their text, stay inside the usable screen area
    // (not under the taskbar) and try not to land on top of each other.
    private void StartPopups()
    {
        if (popper != null)
            return;
        int count = Math.Max(4, PopupSeconds * 3 / 4);
        popLeft = count;
        popper = new Timer();
        popper.Interval = Math.Max(600, PopupSeconds * 1000 / count);
        popper.Tick += OnPopup;
        popper.Start();
        OnPopup(null, EventArgs.Empty);
    }

    private void OnPopup(object sender, EventArgs e)
    {
        if (popLeft <= 0)
        {
            StopPopups();
            return;
        }
        popLeft--;
        try
        {
            string[] words = new string[] { "LOOK AT ME \u2665", "YOU'RE MINE \u2665", "DON'T LEAVE \u2665",
                "ONLY ME \u2665", "I SEE YOU \u2665", "STAY \u2665", "MINE MINE MINE \u2665", "I LOVE YOU \u2665" };
            string msg = words[dice.Next(words.Length)];
            // sized from the text length (same plain approach as the cage box)
            int w = msg.Length * 19 + 60;
            int h = 78;

            Rectangle area = Screen.PrimaryScreen.WorkingArea;
            popBoxes.RemoveAll(delegate (Form b) { return b == null || b.IsDisposed; });

            Rectangle spot = Rectangle.Empty;
            for (int tries = 0; tries < 12; tries++)
            {
                int x = area.X + dice.Next(0, Math.Max(1, area.Width - w));
                int y = area.Y + dice.Next(0, Math.Max(1, area.Height - h));
                spot = new Rectangle(x, y, w, h);
                bool clear = true;
                foreach (Form other in popBoxes)
                {
                    if (other.Bounds.IntersectsWith(spot))
                    {
                        clear = false;
                        break;
                    }
                }
                if (clear)
                    break;
            }

            HeartBox box = new HeartBox(msg, spot, Color.FromArgb(150, 20, 70), Color.White, 20f,
                0.85, 2200, false, false);
            popBoxes.Add(box);
            AddBox(box);
            capri.Log("Popup shown at " + spot.X + "," + spot.Y + " size " + spot.Width + "x" + spot.Height);
        }
        catch (Exception ex)
        {
            capri.Log("Popup failed: " + ex.Message);
            popLeft = 0;
        }
        if (popLeft <= 0)
            StopPopups();
    }

    private void StopPopups()
    {
        if (popper != null)
        {
            popper.Stop();
            popper.Dispose();
            popper = null;
        }
    }

    // Blackout glitch: the whole screen goes black, then flickers back.
    private void StartBlackout()
    {
        try
        {
            AddBox(new HeartBox("SIGNAL LOST...\nI'M STILL HERE \u2665", SystemInformation.VirtualScreen,
                Color.Black, Color.FromArgb(255, 80, 140), 40f, 0.99, (int)(BlackoutSeconds * 1000), false, true));
        }
        catch (Exception ex)
        {
            capri.Log("Blackout failed: " + ex.Message);
        }
    }

    // Stops every penalty right now and removes anything she put on screen.
    private void ClearPenalties()
    {
        StopShake();
        StopPull();
        StopCage();
        StopHide();
        StopPopups();
        foreach (Form f in boxes)
        {
            try
            {
                if (f != null && !f.IsDisposed)
                    f.Close();
            }
            catch (Exception)
            {
            }
        }
        boxes.Clear();
        popBoxes.Clear();
        if (overlay != null && !overlay.IsDisposed)
            overlay.Close();
        overlay = null;
    }

    // She drags your cursor to the middle of the screen, like she grabbed your hand.
    private void StartPull()
    {
        if (puller != null)
            return;
        pullLeft = 110;
        puller = new Timer();
        puller.Interval = 16;
        puller.Tick += OnPull;
        puller.Start();
    }

    private void OnPull(object sender, EventArgs e)
    {
        pullLeft--;
        try
        {
            Rectangle area = Screen.PrimaryScreen.Bounds;
            Point goal = new Point(area.X + area.Width / 2, area.Y + area.Height / 2);
            Point p = Cursor.Position;
            Cursor.Position = new Point(p.X + (goal.X - p.X) / 8, p.Y + (goal.Y - p.Y) / 8);
        }
        catch (Exception ex)
        {
            capri.Log("Pull failed: " + ex.Message);
            pullLeft = 0;
        }
        if (pullLeft <= 0)
            StopPull();
    }

    private void StopPull()
    {
        if (puller != null)
        {
            puller.Stop();
            puller.Dispose();
            puller = null;
        }
    }

    // 10 seconds of cursor jitter. Every nudge is undone on the next
    // step, so the cursor ends up where it started.
    private void StartShake()
    {
        if (shaker != null)
            return;
        shakeEnd = DateTime.Now.AddSeconds(10);
        shakeLeft = 100000;
        shakeOut = false;
        shaker = new Timer();
        shaker.Interval = 15;
        shaker.Tick += OnShake;
        shaker.Start();
    }

    private void OnShake(object sender, EventArgs e)
    {
        shakeLeft--;
        try
        {
            if (shakeOut)
            {
                Native.Move(-lastDx, -lastDy);
                shakeOut = false;
            }
            else if (shakeLeft > 0 && DateTime.Now < shakeEnd)
            {
                int mag = possess >= 65 ? 36 : 24;
                lastDx = dice.Next(-mag, mag + 1);
                lastDy = dice.Next(-mag, mag + 1);
                Native.Move(lastDx, lastDy);
                shakeOut = true;
            }
            if (shakeLeft <= 0 || (!shakeOut && DateTime.Now >= shakeEnd))
                StopShake();
        }
        catch (Exception ex)
        {
            capri.Log("Shake failed: " + ex.Message);
            StopShake();
        }
    }

    private void StopShake()
    {
        if (shaker != null)
        {
            shaker.Stop();
            shaker.Dispose();
            shaker = null;
        }
        if (shakeOut)
        {
            try
            {
                Native.Move(-lastDx, -lastDy);
            }
            catch (Exception)
            {
            }
            shakeOut = false;
        }
    }

    // ---------- takeover ----------

    private void StartTakeover()
    {
        if (takeover != null)
            return;
        niceLeft = NeedNice;
        try
        {
            takeover = new TakeoverOverlay(niceLeft);
            takeover.Show();
        }
        catch (Exception ex)
        {
            capri.Log("Takeover failed: " + ex.Message);
            takeover = null;
            return;
        }
        Feel(0, 2);
        Speak(Line("TakeoverStart"));
    }

    private void EndTakeover()
    {
        niceLeft = 0;
        if (takeover != null)
        {
            if (!takeover.IsDisposed)
                takeover.Close();
            takeover = null;
        }
    }

    // ---------- timers ----------

    private void OnTick(object sender, EventArgs e)
    {
        if (strikes > 0 && (DateTime.Now - strikeStamp).TotalMinutes >= 4.0)
        {
            strikes--;
            strikeStamp = DateTime.Now;
        }
        if (obsessed)
        {
            neglect++;
            Feel(0, love >= 50.0 ? 2 : 1);
            // being ignored a little hurts, but never more than a few points per absence
            if (neglect >= 2 && neglect <= 10)
            {
                love = Math.Max(0.0, love - 0.3);
                dirty = true;
            }

            if (neglect <= QuietAfter)
            {
                int mildUntil = possess >= 60 ? 1 : 2;
                int desperateUntil = possess >= 60 ? 3 : 5;
                if (neglect == 1 && love >= 20.0 && dice.Next(100) < 40)
                    Speak(Line("FlirtIdle"));
                else if (neglect <= mildUntil)
                    Speak(Line("IdleMild"));
                else if (neglect <= desperateUntil)
                    Speak(Line("IdleDesperate"));
                else if (possess >= 80 && dice.Next(100) < 50)
                    Speak(Line("Psycho"));
                else if (possess >= 60 && dice.Next(100) < 45)
                    Speak(Line("Obsessed"));
                else
                    Speak(Line("IdleUnhinged"));
            }
            // Ignore a very possessive girl for too long and she loses it, once per absence.
            if (neglect == 10 && possess >= 75 && tantrums && takeover == null && !neglectRage)
            {
                neglectRage = true;
                Tantrum();
            }
            if (dirty)
            {
                dirty = false;
                Save();
            }
        }
        ticker.Interval = NextDelay();
    }

    // Checks every 5 seconds whether you've been silent long enough
    private void OnWatch(object sender, EventArgs e)
    {
        if (obsessed && tantrums && takeover == null
            && (DateTime.Now - lastHeard).TotalSeconds >= TakeoverSeconds())
            StartTakeover();
        WatchCall();
        WatchApps();
    }

    private static readonly string[][] WatchedApps = new string[][]
    {
        new string[] { "discord", "Discord" },
        new string[] { "instagram", "Instagram" },
        new string[] { "snapchat", "Snapchat" },
        new string[] { "whatsapp", "WhatsApp" },
        new string[] { "messenger", "Messenger" },
        new string[] { "telegram", "Telegram" },
        new string[] { "tinder", "Tinder" },
        new string[] { "bumble", "Bumble" },
        new string[] { "hinge", "Hinge" },
        new string[] { "facebook", "Facebook" },
        new string[] { "tiktok", "TikTok" },
        new string[] { "reddit", "Reddit" },
        new string[] { "twitter", "Twitter" },
        new string[] { "signal", "Signal" },
        new string[] { "gmail", "your email" },
        new string[] { "outlook", "your email" }
    };

    // A strike without a warning line (she has already said her piece).
    private void QuietStrike()
    {
        strikes++;
        strikeStamp = DateTime.Now;
        if (strikes >= 3)
            Tantrum();
    }

    // Catches you in a Discord call and goes feral about it.
    private void WatchCall()
    {
        if (!obsessed)
            return;
        bool now = manualCall || Native.DiscordCallLikely();
        if (now && !inCall)
        {
            inCall = true;
            callSince = DateTime.Now;
            lastCallLine = DateTime.Now;
            callBeats = 0;
            Feel(0, 25);
            AddLove(-1.0);
            Speak(Line("CallStart"));
            RunPenalty("tint");
            QuietStrike();
            return;
        }
        if (!now && inCall)
        {
            inCall = false;
            int mins = (int)Math.Max(1.0, (DateTime.Now - callSince).TotalMinutes);
            Feel(0, 10);
            Speak(Line("CallEnd").Replace("{N}", mins.ToString()));
            return;
        }
        if (now && inCall && (DateTime.Now - lastCallLine).TotalSeconds >= 120)
        {
            lastCallLine = DateTime.Now;
            callBeats++;
            int mins = (int)Math.Max(1.0, (DateTime.Now - callSince).TotalMinutes);
            Feel(0, 5);
            Chatter(Line("CallDuring").Replace("{N}", mins.ToString()));
            if (callBeats % 2 == 0)
                QuietStrike();
        }
    }

    // She notices when you open a chat or social app and gets jealous.
    // It only checks the window title against this list, nothing is stored.
    private void WatchApps()
    {
        if (!obsessed)
            return;
        string title = Native.ActiveTitle();
        string found = "";
        foreach (string[] app in WatchedApps)
        {
            if (title.Contains(app[0]))
            {
                found = app[1];
                break;
            }
        }
        if (found.Length == 0)
        {
            lastApp = "";
            return;
        }
        if (inCall || found == lastApp || (DateTime.Now - lastStalk).TotalSeconds < 180)
            return;
        lastApp = found;
        lastStalk = DateTime.Now;
        Feel(0, 5);
        Chatter(Line("Stalk").Replace("{app}", found));
        if (possess >= 75 && dice.Next(100) < 40)
            Offend();
    }

    // exactly 3 minutes of silence, however possessive she is
    private int TakeoverSeconds()
    {
        return TakeoverAfterSeconds;
    }

    // 3 to 6 minutes between check-ins (never under 3 minutes)
    private int NextDelay()
    {
        int baseMs = dice.Next(IdleMinSeconds * 1000, IdleMaxSeconds * 1000);
        return baseMs;
    }

    private bool IsNice(string line)
    {
        return Has(line, LoveWords) || Has(line, MissWords) || Has(line, ThanksWords)
            || Has(line, CompWords) || Has(line, FlirtWords) || Has(line, LoveQWords)
            || Has(line, NiceExtra);
    }

    // ---------- helpers ----------

    // Lines can contain {n}, which becomes your name (or "choom" if she doesn't know it)
    private void Speak(string text)
    {
        // One thing at a time: anything that would come right after another line is dropped.
        if ((DateTime.Now - lastSpoke).TotalSeconds < BurstGapSeconds)
            return;
        string who = pname.Length > 0 ? pname : "choom";
        lastSpoke = DateTime.Now;
        capri.Say(text.Replace("{n}", who));
    }

    // Optional remarks only: skipped if she already said something recently,
    // so she never spams. Warnings, penalties, takeovers and direct answers use Speak.
    private bool Said()
    {
        return lastSpoke >= handleStart;
    }

    private void Chatter(string text)
    {
        if ((DateTime.Now - lastSpoke).TotalSeconds < ChatterGapSeconds)
            return;
        Speak(text);
    }

    private string Pick(string[] options)
    {
        return options[dice.Next(options.Length)];
    }

    // "my name is Sam" or "call me Sam"
    private static string FindName(string line)
    {
        string[] keys = new string[] { " my name is ", " call me ", " i m called " };
        foreach (string key in keys)
        {
            int at = line.IndexOf(key);
            if (at < 0)
                continue;
            string rest = line.Substring(at + key.Length).Trim();
            int sp = rest.IndexOf(' ');
            string w = sp > 0 ? rest.Substring(0, sp) : rest;
            if (!GoodName(w) || Array.IndexOf(NotNames, w) >= 0)
                continue;
            return char.ToUpperInvariant(w[0]) + w.Substring(1);
        }
        return null;
    }

    private static bool GoodName(string w)
    {
        if (w.Length < 2 || w.Length > 16)
            return false;
        foreach (char c in w)
        {
            if (!char.IsLetter(c))
                return false;
        }
        return true;
    }

    // Saved in the mod's own folder: state.txt
    private void Save()
    {
        try
        {
            Directory.CreateDirectory(capri.Folder);
            string[] rows = new string[]
            {
                "love=" + love.ToString("0.00", CultureInfo.InvariantCulture),
                "pos=" + possess,
                "name=" + pname,
                "seen=" + DateTime.UtcNow.Ticks
            };
            File.WriteAllLines(Path.Combine(capri.Folder, "state.txt"), rows);
        }
        catch (Exception ex)
        {
            capri.Log("Save failed: " + ex.Message);
        }
    }

    private void Load()
    {
        try
        {
            string path = Path.Combine(capri.Folder, "state.txt");
            if (!File.Exists(path))
            {
                // older versions kept just the love meter in love.txt
                string old = Path.Combine(capri.Folder, "love.txt");
                double oldLove;
                if (File.Exists(old) && double.TryParse(File.ReadAllText(old).Trim(),
                    NumberStyles.Float, CultureInfo.InvariantCulture, out oldLove))
                    love = Math.Max(0.0, Math.Min(100.0, oldLove));
                return;
            }
            foreach (string row in File.ReadAllLines(path))
            {
                int eq = row.IndexOf('=');
                if (eq < 1)
                    continue;
                string key = row.Substring(0, eq);
                string val = row.Substring(eq + 1).Trim();
                int n;
                long t;
                double d;
                if (key == "love" && double.TryParse(val, NumberStyles.Float, CultureInfo.InvariantCulture, out d))
                    love = Math.Max(0.0, Math.Min(100.0, d));
                else if (key == "pos" && int.TryParse(val, out n))
                    possess = Math.Max(0, Math.Min(100, n));
                else if (key == "name" && GoodName(val))
                    pname = val;
                else if (key == "seen" && long.TryParse(val, out t)
                    && t > DateTime.MinValue.Ticks && t < DateTime.MaxValue.Ticks)
                    lastSeen = new DateTime(t, DateTimeKind.Utc);
            }
        }
        catch (Exception ex)
        {
            capri.Log("Load failed: " + ex.Message);
        }
    }

    // Lowercase, letters and digits only. Long stretched letters are squashed,
    // so "byeee" counts as "bye" and "loooove you" as "love you".
    private static string Clean(string s)
    {
        char[] c = s.ToLowerInvariant().ToCharArray();
        for (int i = 0; i < c.Length; i++)
        {
            if (!char.IsLetterOrDigit(c[i]))
                c[i] = ' ';
        }
        char[] o = new char[c.Length];
        int n = 0;
        int k = 0;
        while (k < c.Length)
        {
            int j = k;
            while (j < c.Length && c[j] == c[k])
                j++;
            int run = j - k;
            if (c[k] == ' ' || (run >= 3 && char.IsLetter(c[k])))
            {
                o[n] = c[k];
                n++;
            }
            else
            {
                for (int r = 0; r < run; r++)
                {
                    o[n] = c[k];
                    n++;
                }
            }
            k = j;
        }
        return " " + new string(o, 0, n) + " ";
    }

    private static bool Has(string line, params string[] phrases)
    {
        foreach (string p in phrases)
        {
            if (line.Contains(" " + p + " "))
                return true;
        }
        return false;
    }
}
