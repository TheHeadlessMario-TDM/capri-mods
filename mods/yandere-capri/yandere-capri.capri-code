// Hands out lines in a shuffled order, so nothing repeats
// until every line has been used once.
public class LineBag
{
    private string[] items;
    private int[] order;
    private int pos;
    private int last = -1;
    private Random dice;

    public LineBag(string[] lines, Random random)
    {
        items = lines;
        dice = random;
        Shuffle();
    }

    private void Shuffle()
    {
        order = new int[items.Length];
        for (int i = 0; i < order.Length; i++)
            order[i] = i;
        for (int i = order.Length - 1; i > 0; i--)
        {
            int j = dice.Next(i + 1);
            int tmp = order[i];
            order[i] = order[j];
            order[j] = tmp;
        }
        if (order.Length > 1 && order[0] == last)
        {
            int tmp2 = order[0];
            order[0] = order[1];
            order[1] = tmp2;
        }
        pos = 0;
    }

    public string Next()
    {
        if (pos >= order.Length)
            Shuffle();
        int idx = order[pos];
        pos++;
        last = idx;
        return items[idx];
    }
}

// Real mouse and keyboard input, sent the way a hardware device would.
public static class Native
{
    [DllImport("user32.dll")]
    private static extern void keybd_event(byte vk, byte scan, uint flags, UIntPtr extra);

    [DllImport("user32.dll")]
    private static extern IntPtr GetForegroundWindow();

    [DllImport("user32.dll", CharSet = CharSet.Unicode)]
    private static extern int GetWindowText(IntPtr hWnd, System.Text.StringBuilder text, int count);

    // Moves the cursor by an amount using absolute coordinates, so it always
    // lands where it should no matter the pointer-speed settings.
    public static void Move(int dx, int dy)
    {
        Point p = Cursor.Position;
        Cursor.Position = new Point(p.X + dx, p.Y + dy);
    }

    private static void Key(byte vk, bool up)
    {
        keybd_event(vk, 0, up ? 2u : 0u, UIntPtr.Zero);
        System.Threading.Thread.Sleep(35);
    }

    // Win+D: show the desktop (press again to bring the windows back)
    public static void ShowDesktop()
    {
        Key(0x5B, false);
        Key(0x44, false);
        Key(0x44, true);
        Key(0x5B, true);
    }

    // Ctrl+Tab: next browser tab
    public static void CtrlTab()
    {
        Key(0x11, false);
        Key(0x09, false);
        Key(0x09, true);
        Key(0x11, true);
    }

    private delegate bool EnumProc(IntPtr hWnd, IntPtr lParam);

    [DllImport("user32.dll")]
    private static extern bool EnumWindows(EnumProc cb, IntPtr lParam);

    [DllImport("user32.dll")]
    private static extern bool IsWindowVisible(IntPtr hWnd);

    // Best guess at whether you're in a Discord call: looks through the titles of
    // open windows for Discord plus a call/voice/stream word. Discord does not
    // always put this in its title, so "yandere call" is the manual backup.
    // Titles are only matched against words, never saved or sent anywhere.
    public static bool DiscordCallLikely()
    {
        bool found = false;
        try
        {
            EnumWindows(delegate (IntPtr h, IntPtr l)
            {
                if (!IsWindowVisible(h))
                    return true;
                System.Text.StringBuilder sb = new System.Text.StringBuilder(256);
                GetWindowText(h, sb, 256);
                string t = sb.ToString().ToLowerInvariant();
                if (t.Length == 0 || t.IndexOf("discord") < 0)
                    return true;
                if (t.IndexOf("voice connected") >= 0 || t.IndexOf("voice channel") >= 0
                    || t.IndexOf("in call") >= 0 || t.IndexOf("call with") >= 0
                    || t.IndexOf("incoming call") >= 0 || t.IndexOf("popout") >= 0
                    || t.IndexOf("stream") >= 0 || t.IndexOf("screen share") >= 0
                    || t.IndexOf("vc") >= 0)
                    found = true;
                return !found;
            }, IntPtr.Zero);
        }
        catch (Exception)
        {
        }
        return found;
    }

    // Title of the window you're in right now (lowercase). Only used to spot
    // chat and social apps. It is never saved or sent anywhere.
    public static string ActiveTitle()
    {
        try
        {
            System.Text.StringBuilder sb = new System.Text.StringBuilder(256);
            GetWindowText(GetForegroundWindow(), sb, 256);
            return sb.ToString().ToLowerInvariant();
        }
        catch (Exception)
        {
            return "";
        }
    }
}

// A red tint over the screen that fades out in about 3 seconds.
// It never takes focus and clicks go straight through it.
public class RageOverlay : Form
{
    private Timer fade = new Timer();
    private Label text = new Label();

    private double start = 0.5;

    public RageOverlay(string message) : this(message, 0.5)
    {
    }

    public RageOverlay(string message, double startOpacity)
    {
        start = startOpacity;
        FormBorderStyle = FormBorderStyle.None;
        ShowInTaskbar = false;
        TopMost = true;
        StartPosition = FormStartPosition.Manual;
        Bounds = SystemInformation.VirtualScreen;
        BackColor = Color.DarkRed;
        Opacity = startOpacity;

        text.Text = message;
        text.ForeColor = Color.White;
        text.BackColor = Color.Transparent;
        text.Font = new System.Drawing.Font("Segoe UI", 54, FontStyle.Bold);
        text.TextAlign = ContentAlignment.MiddleCenter;
        text.Dock = DockStyle.Fill;
        Controls.Add(text);

        fade.Interval = 40;
        fade.Tick += OnFade;
        fade.Start();
    }

    protected override bool ShowWithoutActivation
    {
        get { return true; }
    }

    protected override CreateParams CreateParams
    {
        get
        {
            CreateParams cp = base.CreateParams;
            cp.ExStyle |= 0x08000000 | 0x00000080 | 0x00000020;
            return cp;
        }
    }

    private void OnFade(object sender, EventArgs e)
    {
        double next = Opacity - (start / 75.0);
        if (next <= 0)
        {
            fade.Stop();
            fade.Dispose();
            Close();
            return;
        }
        Opacity = next;
    }
}

// A small click-through box (or a full-screen blackout) that never takes focus.
public class HeartBox : Form
{
    private Timer life = new Timer();
    private DateTime born = DateTime.Now;
    private int ms;
    private double start;
    private bool fade;
    private bool flicker;

    public HeartBox(string message, Rectangle area, Color back, Color fore, float fontSize,
        double startOpacity, int lifeMs, bool fadeOut, bool flickerAtEnd)
    {
        AutoScaleMode = AutoScaleMode.None;
        FormBorderStyle = FormBorderStyle.None;
        ShowInTaskbar = false;
        TopMost = true;
        StartPosition = FormStartPosition.Manual;
        Bounds = area;
        BackColor = back;
        Opacity = startOpacity;
        start = startOpacity;
        ms = Math.Max(200, lifeMs);
        fade = fadeOut;
        flicker = flickerAtEnd;

        Label t = new Label();
        t.Text = message;
        t.ForeColor = fore;
        t.BackColor = Color.Transparent;
        t.Font = new System.Drawing.Font("Segoe UI", fontSize, FontStyle.Bold);
        t.TextAlign = ContentAlignment.MiddleCenter;
        t.Dock = DockStyle.Fill;
        Controls.Add(t);

        life.Interval = 40;
        life.Tick += OnLife;
        life.Start();
    }

    protected override bool ShowWithoutActivation
    {
        get { return true; }
    }

    protected override CreateParams CreateParams
    {
        get
        {
            CreateParams cp = base.CreateParams;
            cp.ExStyle |= 0x08000000 | 0x00000080 | 0x00000020 | 0x00080000;  // no-activate, tool window, click-through, layered
            return cp;
        }
    }

    private void OnLife(object sender, EventArgs e)
    {
        double used = (DateTime.Now - born).TotalMilliseconds;
        if (used >= ms)
        {
            life.Stop();
            life.Dispose();
            Close();
            return;
        }
        if (fade)
        {
            // quick fade in, then a long fade out
            double fin = Math.Min(1.0, used / 250.0);
            double fout = Math.Max(0.0, 1.0 - used / ms);
            Opacity = Math.Max(0.0, Math.Min(1.0, start * fin * fout));
        }
        else if (flicker && used > ms - 450)
            Opacity = ((int)(used / 80.0) % 2 == 0) ? start : 0.0;
    }
}

// She sits in the middle of your screen until you say nice things.
// Clicks go straight through it, so it never blocks your work.
public class TakeoverOverlay : Form
{
    private Label big = new Label();
    private Label small = new Label();

    public TakeoverOverlay(int left)
    {
        FormBorderStyle = FormBorderStyle.None;
        ShowInTaskbar = false;
        TopMost = true;
        StartPosition = FormStartPosition.Manual;
        Rectangle area = Screen.PrimaryScreen.Bounds;
        Size = new Size(760, 340);
        Location = new Point(area.X + (area.Width - Width) / 2, area.Y + (area.Height - Height) / 2);
        BackColor = Color.FromArgb(120, 10, 50);
        Opacity = 0.9;

        small.ForeColor = Color.FromArgb(255, 170, 210);
        small.BackColor = Color.Transparent;
        small.Font = new System.Drawing.Font("Segoe UI", 24, FontStyle.Bold);
        small.TextAlign = ContentAlignment.MiddleCenter;
        small.Dock = DockStyle.Fill;

        big.Text = "I'M RIGHT HERE \u2665";
        big.ForeColor = Color.White;
        big.BackColor = Color.Transparent;
        big.Font = new System.Drawing.Font("Segoe UI", 46, FontStyle.Bold);
        big.TextAlign = ContentAlignment.MiddleCenter;
        big.Dock = DockStyle.Top;
        big.Height = 190;

        Controls.Add(small);
        Controls.Add(big);
        SetLeft(left);
    }

    public void SetLeft(int left)
    {
        small.Text = left == 1 ? "say 1 nice thing to me" : "say " + left + " nice things to me";
    }

    protected override bool ShowWithoutActivation
    {
        get { return true; }
    }

    protected override CreateParams CreateParams
    {
        get
        {
            CreateParams cp = base.CreateParams;
            cp.ExStyle |= 0x08000000 | 0x00000080 | 0x00000020;
            return cp;
        }
    }
}

